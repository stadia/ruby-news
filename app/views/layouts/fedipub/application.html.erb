<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-56PSNXG7QG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-56PSNXG7QG');
    </script>
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "u4rt68vefo");
    </script>
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <% set_meta_tags canonical: "https://ruby-news.dev#{request.path}" %>
    <%= display_meta_tags title: content_for(:title) || t("fedipub_layout.title"),
    og: {
      title: content_for(:title) || t("fedipub_layout.title"),
      description: @page_description || t("layout.default_description"),
      site_name: t("fedipub_layout.title"),
      image: image_url("og_main.png"),
      type: "website",
    },
    twitter: {
      title: content_for(:title) || t("fedipub_layout.title"),
      description: @page_description || t("layout.default_description"),
      site_name: t("fedipub_layout.title"),
      image: image_url("og_main.png"),
      type: "website",
    } %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <meta name="theme-color" content="<%= Components::Layout::AssetPreloads::THEME_COLORS[:dark] %>">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap"
      as="style"
    >
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap"
    >
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body
    class="theme-dark bg-app text-content-secondary min-h-screen flex flex-col"
    data-controller="page-loader"
    data-action="
      turbo:before-visit@window->page-loader#beforeTurboVisit
      turbo:load@window->page-loader#afterTurboLoad
    "
  >
    <a
      href="#main-content"
      class="
        sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50
        focus:px-4 focus:py-2 focus:bg-brand-solid focus:text-brand-foreground focus:rounded-lg
      "
    >
      <%= t("layout.skip_to_content") %>
    </a>

    <div
      data-page-loader-target="loader"
      class="
        fixed inset-0 bg-app/75 z-50 hidden items-center justify-center
      "
    >
      <div class="flex flex-col items-center space-y-4">
        <div
          class="
            animate-spin rounded-full h-12 w-12 border-4 border-brand
            border-t-transparent shadow-lg shadow-brand/50
          "
        ></div>
        <div class="text-content font-medium"><%= t("layout.loading") %></div>
      </div>
    </div>

    <nav
      class="
        bg-surface border-b border-border-strong border-t-4 border-t-brand
      "
      aria-label="<%= t("fedipub_layout.nav_aria_label") %>"
    >
      <div class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4">
        <%= link_to main_app.root_path, class: "flex items-center space-x-3 group min-w-0 md:min-w-fit" do %>
          <span
            class="
              self-center text-xl md:text-2xl font-semibold text-content md:whitespace-nowrap
              group-hover:text-brand-soft transition-colors duration-200
            "
          >
            Ruby-News ||
            <span class="text-brand-soft"><%= t("fedipub_layout.brand_subtitle") %></span>
          </span>
        <% end %>

        <input type="checkbox" id="mobile-menu-toggle" class="mobile-menu-toggle peer">
        <label
          for="mobile-menu-toggle"
          class="
            inline-flex items-center p-2 w-11 h-11 justify-center text-sm text-content
            rounded-lg md:hidden hover:bg-surface-muted focus:outline-none focus:ring-2
            focus:ring-brand cursor-pointer
          "
          aria-label="<%= t("layout.nav.menu_toggle") %>"
        >
          <span class="sr-only"><%= t("fedipub_layout.menu") %></span>
          <%= phlex_icon "bars-3", variant: :outline, class: "w-5 h-5" %>
        </label>

        <div
          class="
            items-center justify-between w-full md:flex md:w-auto md:order-1 hidden
            peer-checked:block
          "
          id="navbar-fediverse"
        >
          <ul
            class="
              flex flex-col p-4 md:p-0 mt-4 font-medium border border-border-strong rounded-lg
              bg-surface-muted md:space-x-2 md:flex-row md:mt-0 md:border-0 md:bg-surface
            "
          >
            <%= nav_link_to t("fedipub_layout.nav.home"), main_app.root_path %>
            <% if authenticated? %>
              <%= nav_link_to t("fedipub_layout.nav.feed"), feed_activities_path %>
              <%= nav_link_to t("fedipub_layout.nav.lookup"), lookup_actors_path %>
              <% if Current.user.fedipub_actor %>
                <%= nav_link_to t("fedipub_layout.nav.my_profile"), actor_path(Current.user.fedipub_actor) %>
              <% end %>
              <%= nav_link_to t("sign_out"), main_app.logout_path %>
            <% else %>
              <%= nav_link_to t("sign_in"), main_app.new_session_path %>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main id="main-content" class="container mx-auto px-4 py-8 grow">
      <% if authenticated? && Configs::WebPush.configured? %>
        <div
          data-controller="push-notifications"
          data-push-notifications-public-key-value="<%= Configs::WebPush.public_key %>"
          data-push-notifications-subscription-url-value="<%= main_app.push_subscription_path %>"
          data-push-notifications-service-worker-path-value="<%= main_app.pwa_service_worker_path(format: :js) %>"
          data-push-notifications-cooldown-hours-value="1"
        >
          <%= render Components::PushNotifications::PromptModal.new %>
        </div>
      <% end %>
      <%= render Components::Flash.new %>
      <%= yield %>
    </main>

    <footer
      class="
        bg-surface text-content-secondary rounded-lg shadow-sm m-4 border border-border-strong
        border-t-2 border-t-brand
      "
    >
      <div
        class="
          w-full mx-auto max-w-7xl p-4 md:flex md:items-center md:justify-between
        "
      >
        <span class="text-sm text-content-secondary sm:text-center">
          © 2025
          <%= link_to t("fedipub_layout.title"),
          "https://ruby-news.dev/",
          class: "hover:underline hover:text-content transition-colors duration-200" %>. All Rights Reserved.
        </span>
        <ul
          class="
            flex flex-wrap items-center mt-3 text-sm font-medium text-content-secondary sm:mt-0
            gap-4
          "
        >
          <li>
            <a
              rel="me"
              href="https://ruby.social/@news_kr"
              target="_blank"
              class="hover:underline hover:text-content flex items-center gap-1"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.056.056 0 0 1 .017-.043.051.051 0 0 1 .043-.017c1.513.359 3.072.538 4.657.546 1.828 0 2.298-.081 3.09-.143 1.897-.149 3.566-.867 3.772-1.531.334-1.076.61-3.495.61-3.495 0-.732-.005-1.603-.05-2.447-.041-.832-.126-1.62-.333-2.377z"
                />
              </svg>
              Mastodon
            </a>
          </li>
          <li>
            <a
              href="https://x.com/rubynewskr"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline hover:text-content flex items-center gap-1"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                />
              </svg>
              Twitter/X
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
