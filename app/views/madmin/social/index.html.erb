<%# madmin 레이아웃은 앱 Tailwind(app.css)를 불러오지 않는다. madmin CSS의 header/table/btn만 쓴다. %>
<%= content_for :title, "소셜 미디어 연동" %>

<header class="header">
  <h1>소셜 미디어 연동</h1>
</header>
<p>외부 소셜 미디어 플랫폼과의 OAuth 인증을 관리합니다.</p>

<% @social_list.each do |social| %>
  <section>
    <header class="header">
      <h2><%= social.name %></h2>
      <div class="actions">
        <% if social.access_token %>
          <%= link_to "재인증", social_provider_authorize_path(provider: social.name.split("_").first), class: "btn btn-secondary" %>
        <% else %>
          <%= link_to "#{social.name} 연동하기", social_provider_authorize_path(provider: social.name.split("_").first), class: "btn btn-primary" %>
        <% end %>
      </div>
    </header>

    <div class="table-scroll">
      <table>
        <tbody>
          <tr>
            <th class="label">상태</th>
            <td><%= social.access_token ? "연결됨" : "연결 안됨" %></td>
          </tr>
          <tr>
            <th class="label">권한</th>
            <td>읽기/쓰기 및 사용자 정보 접근</td>
          </tr>
          <% if social.access_token %>
            <tr>
              <th class="label">Access Token</th>
              <td><code><%= social.value["access_token"][0..15] %>...</code></td>
            </tr>
            <% if social.value["expires_at"] %>
              <tr>
                <th class="label">만료 시간</th>
                <td><%= Time.at(social.value["expires_at"]).in_time_zone("Asia/Seoul").strftime("%Y-%m-%d %H:%M") %></td>
              </tr>
            <% end %>
            <% if social.value["token_created_at"] %>
              <tr>
                <th class="label">생성 시간</th>
                <td><%= Time.at(social.value["token_created_at"]).in_time_zone("Asia/Seoul").strftime("%Y-%m-%d %H:%M") %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
