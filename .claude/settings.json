{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": []
      },
      {
        "matcher": "Write",
        "hooks": []
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruby-skills@ruby-skills": true
  }
}
