  # pkg:gem/mxc#lib/mxc/result.rb:36
  def limit_exceeded; end

  # Returns everything the command wrote to standard error.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:14
  def stderr; end

  # Returns everything the command wrote to standard output.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:11
  def stdout; end

  # Returns true when the command exited with status 0 before its timeout.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:52
  def success?; end

  # Returns true when the command ran out of time and was stopped.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:57
  def timed_out?; end

  # Returns the result as a Hash.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:62
  def to_h; end

  # Returns MXC's warnings about the sandbox, as Strings.
  #
  # pkg:gem/mxc#lib/mxc/result.rb:20
  def warnings; end

  private

  # pkg:gem/mxc#lib/mxc/result.rb:74
  def text(bytes); end
end

# A sandbox policy: what a command may read, write and reach, and how long it may run.
#
# Setters return the sandbox, so they chain, and +nil+ resets a setting to its default:
#
#   sandbox = MXC.sandbox
#     .with_readable("app/skills")
#     .with_writable(Rails.root.join("tmp"))
#     .with_network(allow: ["pypi.org", "*.pythonhosted.org"])
#     .with_timeout(30)
#   sandbox.run("python3 app/skills/build.py")
#   sandbox.run("python3", "app/skills/convert.py", params[:filename])
#
# Subclasses declare the same settings with class macros:
#
#   class SkillSandbox < MXC::Sandbox
#     readable "app/skills"
#     writable "tmp/skills"
#     network false
#     timeout 30
#     limits cpu_time: 60, memory: 2 * 1024**3
#     priority :low
#   end
#
#   SkillSandbox.new.run("python3 app/skills/build.py")
#
# pkg:gem/mxc#lib/mxc/sandbox.rb:30
class MXC::Sandbox
  # Returns a new sandbox with the class's defaults, then applies +options+ through
  # the matching setters: <tt>readable:</tt>, <tt>writable:</tt>, <tt>denied:</tt>,
  # <tt>network:</tt>, <tt>env:</tt>, <tt>directory:</tt>, <tt>timeout:</tt>, <tt>backend:</tt>,
  # <tt>limits:</tt> and <tt>priority:</tt>.
  #
  #   MXC::Sandbox.new(readable: "app/skills", network: { allow: ["pypi.org"] }, timeout: 30)
  #   MXC::Sandbox.new(limits: { cpu_time: 60, memory: 2 * 1024**3 }, priority: :low)
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:124
  def initialize(**options); end

  # Returns the Availability of this sandbox on this host, with the reason and
  # remediation when it cannot run.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:355
  def availability; end

  # Returns the backend, falling back to MXC.config.backend.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:165
  def backend; end

  # Returns the paths hidden from the command, as given.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:144
  def denied; end

  # Returns the working directory, or nil for the default.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:159
  def directory; end

  # Returns the environment variables set for the command.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:153
  def env; end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:364
  def inspect; end

  # Returns true when the command can read the libraries its program loads, the default.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:150
  def libraries; end

  # Returns the programs and libraries whose shared libraries the command can load, as given.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:147
  def libraries_of; end

  # Returns the resource limits, such as <tt>{ cpu_time: 60, memory: 2147483648 }</tt>.
  # A limit that is not set is absent.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:169
  def limits; end

  # Returns the network access: +false+, +true+, or <tt>{ allow: [...] }</tt> for an allow-list.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:156
  def network; end

  # Returns the scheduling priority: <tt>:normal</tt>, <tt>:low</tt>, or <tt>:lowest</tt>.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:172
  def priority; end

  # Returns the paths the command can read, as given.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:138
  def readable; end

  # Runs +command+ and returns its Result once it finishes. Like Kernel#system, one
  # String runs through the platform shell: <tt>sh -c</tt>, or <tt>cmd.exe /d /s /c</tt>
  # on Windows. Two or more Strings are a program and its arguments, and each argument
  # reaches the program unchanged, without a shell.
  #
  # With a block, yields each Chunk of output as it arrives.
  #
  # On macOS, the command can read the shared library files its program links outside
  # the system's own, such as Homebrew's, so programs built against them start. The
  # program is the first argument, or the first word of a command for the shell, found
  # on the +PATH+ of #env. See #with_libraries_of for libraries the program opens later,
  # and #with_libraries to turn this off.
  #
  #   sandbox.run("python3 build.py && ls dist")
  #   sandbox.run("python3", "convert.py", params[:filename])
  #   sandbox.run("python3", "build.py") { |chunk| print chunk.content }
  #
  # Raises ArgumentError without a command or when given an Array. On Windows, it also
  # raises ArgumentError for a program and arguments that start a +.bat+ or +.cmd+ file,
  # because Windows runs those through +cmd.exe+, which splits the arguments again.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:330
  def run(*command, &); end

  # Starts +command+ and returns its Process without waiting for it. Takes the command
  # the same way as #run.
  #
  #   sandbox.spawn("python3", "-i", "-q")
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:342
  def spawn(*command); end

  # Returns true when this host can run this sandbox, including its network policy.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:349
  def supported?; end

  # Returns the timeout in seconds, falling back to MXC.config.timeout.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:162
  def timeout; end

  # Sets the backend: <tt>:auto</tt> (Bubblewrap on Linux, Seatbelt on macOS,
  # ProcessContainer on Windows), <tt>:bubblewrap</tt>, <tt>:landlock</tt>, <tt>:seatbelt</tt>,
  # or <tt>:process_container</tt>.
  #
  # On Linux, <tt>:auto</tt> runs on Landlock when Bubblewrap cannot create its namespaces,
  # and says so in Result#warnings. <tt>:bubblewrap</tt> never does. <tt>:landlock</tt>
  # needs Linux 6.2 or newer and runs without network access.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:269
  def with_backend(name); end

  # Adds paths hidden from the command, even inside readable or writable paths.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:187
  def with_denied(*paths); end

  # Sets the directory the command starts in. The sandbox must be able to read it.
  # Without one, the command starts in <tt>/</tt>, or <tt>%SystemRoot%</tt> on Windows.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:250
  def with_directory(path); end

  # Adds environment variables for the command. The sandbox starts from a minimal
  # environment, not the parent's. On Windows, that environment keeps the system
  # variables programs need to start, such as +SYSTEMROOT+ and +PATH+.
  #
  #   sandbox.with_env("LANG" => "C.UTF-8")
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:242
  def with_env(variables); end

  # Sets whether the command can read the shared libraries its program and #libraries_of
  # load, on macOS. +true+ is the default; +false+ grants no library, so the command reads
  # only the system's and those under #readable. +nil+ resets it to +true+.
  #
  #   sandbox.with_libraries(false)
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:208
  def with_libraries(enabled); end

  # Adds programs and libraries whose shared libraries the command loads, such as the
  # extensions an interpreter opens. On macOS, the command can read those library files,
  # and the libraries they load in turn, when they are not the system's own. The program
  # the command runs needs no entry: #run grants its libraries already. Elsewhere, on a
  # Mac without the Command Line Tools, and with <tt>with_libraries(false)</tt>, this
  # grants nothing.
  #
  #   sandbox.with_libraries_of(*Dir[File.join(RbConfig::CONFIG["archdir"], "**", "*.bundle")])
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:199
  def with_libraries_of(*paths); end

  # Sets resource limits. Each process the command starts gets its own CPU time and memory.
  #
  # <tt>cpu_time:</tt> is the CPU time each process may use, in seconds. It accepts
  # anything that responds to +to_f+, such as <tt>90</tt> or <tt>2.minutes</tt>, and is
  # rounded up to whole seconds on Linux and macOS. A process that uses it up is stopped.
  #
  # <tt>memory:</tt> is the memory each process may allocate, in bytes. It accepts
  # anything that responds to +to_i+, such as <tt>2 * 1024**3</tt> or
  # <tt>2.gigabytes</tt>, and is rounded up to whole megabytes. Allocations beyond it
  # fail. Not available on macOS.
  #
  # <tt>processes:</tt> is how many processes the command may run at the same time.
  # Windows only.
  #
  # A limit given as +nil+ is removed, and <tt>with_limits(nil)</tt> removes them all.
  # Raises ArgumentError for an unknown limit or a value that is not positive.
  #
  #   sandbox.with_limits(cpu_time: 2.minutes, memory: 2.gigabytes)
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:292
  def with_limits(reset = T.unsafe(nil), **limits); end

  # Sets network access. The default, +false+, gives the command no network at all.
  # +true+ allows any destination. <tt>allow:</tt> takes a list of hosts the command
  # may reach over HTTP and HTTPS: <tt>"pypi.org"</tt>, <tt>"*.pythonhosted.org"</tt>
  # (subdomains only), or <tt>"example.com:8443"</tt> for another port.
  #
  #   sandbox.with_network(allow: ["pypi.org", "*.pythonhosted.org"])
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:223
  def with_network(enabled = T.unsafe(nil), allow: T.unsafe(nil)); end

  # Sets the scheduling priority of every process the command starts: <tt>:normal</tt>
  # (the default), <tt>:low</tt> (nice 10 on Linux and macOS, below normal on
  # Windows), or <tt>:lowest</tt> (nice 19, or idle on Windows).
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:305
  def with_priority(level); end

  # Adds paths the command can read. Accepts Strings and Pathnames; relative paths
  # are expanded from the current directory when the command runs.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:176
  def with_readable(*paths); end

  # Sets the timeout in seconds. Accepts anything that responds to +to_f+, such as
  # <tt>30</tt>, <tt>2.5</tt> or <tt>1.minute</tt>.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:257
  def with_timeout(seconds); end

  # Adds paths the command can read and write. A path that is also #readable is writable,
  # whichever was added first. A readable path inside a writable one stays read-only.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:182
  def with_writable(*paths); end

  # Returns the paths the command can read and write, as given.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:141
  def writable; end

  protected

  # The resource limits as MXC takes them, or nil when there are none.
  #
  # pkg:gem/mxc#lib/mxc/sandbox.rb:493
  def resources; end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:373
  def settings; end

  private

  # pkg:gem/mxc#lib/mxc/sandbox.rb:421
  def add_paths(name, paths); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:381
  def apply(name, value); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:443
  def command_arguments(command); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:437
  def command_line(arguments); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:453
  def command_line_for_windows(arguments); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:521
  def environment; end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:507
  def expand(paths); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:539
  def hidden_resolver_sockets; end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:377
  def inherit(source); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:132
  def initialize_copy(source); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:528
  def libraries_inspect; end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:532
  def library_files(arguments); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:406
  def limit_amount(name, value); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:511
  def native_path(path); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:399
  def positive_limit(name, value); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:413
  def priority_name(level); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:472
  def request(arguments); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:464
  def resolved_backend(warnings); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:390
  def set_limit(name, value); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:427
  def stream(*command, &); end

  # pkg:gem/mxc#lib/mxc/sandbox.rb:515
  def working_directory; end

  class << self
    # Sets every instance's backend.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:78
    def backend(name); end

    # pkg:gem/mxc#lib/mxc/sandbox.rb:90
    def backend_name(name); end

    # pkg:gem/mxc#lib/mxc/sandbox.rb:86
    def defaults; end

    # Adds paths every instance hides, even inside readable or writable paths.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:56
    def denied(*paths); end

    # Sets every instance's working directory.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:72
    def directory(path); end

    # pkg:gem/mxc#lib/mxc/sandbox.rb:97
    def duration(seconds); end

    # Adds environment variables for every instance.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:69
    def env(variables); end

    # Sets whether every instance can read the libraries its programs load. See #with_libraries.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:63
    def libraries(enabled); end

    # Adds programs and libraries whose shared libraries every instance can load.
    # Takes the same arguments as #with_libraries_of.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:60
    def libraries_of(*paths); end

    # Sets every instance's resource limits. Takes the same arguments as #with_limits.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:81
    def limits(*, **, &); end

    # Sets every instance's network access. Takes the same arguments as #with_network.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:66
    def network(*, **, &); end

    # Sets every instance's scheduling priority: <tt>:normal</tt>, <tt>:low</tt>, or <tt>:lowest</tt>.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:84
    def priority(level); end

    # Adds paths every instance can read.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:50
    def readable(*paths); end

    # Sets every instance's timeout in seconds.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:75
    def timeout(seconds); end

    # Adds paths every instance can read and write.
    #
    # pkg:gem/mxc#lib/mxc/sandbox.rb:53
    def writable(*paths); end

    private

    # pkg:gem/mxc#lib/mxc/sandbox.rb:111
    def configure; end
  end
end

# pkg:gem/mxc#lib/mxc/sandbox.rb:31
MXC::Sandbox::BACKENDS = T.let(T.unsafe(nil), Array)

# pkg:gem/mxc#lib/mxc/sandbox.rb:38
MXC::Sandbox::BATCH_FILE = T.let(T.unsafe(nil), Regexp)

# pkg:gem/mxc#lib/mxc/sandbox.rb:43
MXC::Sandbox::DEFAULTS = T.let(T.unsafe(nil), Hash)

# pkg:gem/mxc#lib/mxc/sandbox.rb:35
MXC::Sandbox::HOST_RESOLVER_SOCKETS = T.let(T.unsafe(nil), Array)

# pkg:gem/mxc#lib/mxc/sandbox.rb:32
MXC::Sandbox::LANDLOCK_FALLBACK = T.let(T.unsafe(nil), Regexp)

# pkg:gem/mxc#lib/mxc/sandbox.rb:40
MXC::Sandbox::LIMITS = T.let(T.unsafe(nil), Array)

# pkg:gem/mxc#lib/mxc/sandbox.rb:39
MXC::Sandbox::MAX_TIMEOUT_MS = T.let(T.unsafe(nil), Integer)

# pkg:gem/mxc#lib/mxc/sandbox.rb:42
MXC::Sandbox::MEGABYTE = T.let(T.unsafe(nil), Integer)

# pkg:gem/mxc#lib/mxc/sandbox.rb:33
MXC::Sandbox::OPTIONS = T.let(T.unsafe(nil), Array)

# pkg:gem/mxc#lib/mxc/sandbox.rb:41
MXC::Sandbox::PRIORITIES = T.let(T.unsafe(nil), Hash)

# pkg:gem/mxc#lib/mxc/sandbox.rb:36
MXC::Sandbox::WINDOWS_ENV = T.let(T.unsafe(nil), Array)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:4
module MXC::StartupFailure
  private

  # pkg:gem/mxc#lib/mxc/startup_failure.rb:40
  def check!(outcome); end

  # pkg:gem/mxc#lib/mxc/startup_failure.rb:23
  def detect(outcome); end

  # pkg:gem/mxc#lib/mxc/startup_failure.rb:36
  def hint(message); end

  class << self
    # pkg:gem/mxc#lib/mxc/startup_failure.rb:40
    def check!(outcome); end

    # pkg:gem/mxc#lib/mxc/startup_failure.rb:23
    def detect(outcome); end

    # pkg:gem/mxc#lib/mxc/startup_failure.rb:36
    def hint(message); end
  end
end

# pkg:gem/mxc#lib/mxc/startup_failure.rb:19
MXC::StartupFailure::BWRAP_LINE = T.let(T.unsafe(nil), Regexp)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:18
MXC::StartupFailure::CHDIR = T.let(T.unsafe(nil), Regexp)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:5
MXC::StartupFailure::DOCKER_GUIDE = T.let(T.unsafe(nil), String)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:9
MXC::StartupFailure::HOST_PROBLEMS = T.let(T.unsafe(nil), Hash)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:6
MXC::StartupFailure::NAMESPACES = T.let(T.unsafe(nil), Regexp)

# pkg:gem/mxc#lib/mxc/startup_failure.rb:8
MXC::StartupFailure::PROC = T.let(T.unsafe(nil), Regexp)

# Raised when this host cannot run the sandbox as configured, such as when Bubblewrap is
# missing, user namespaces are blocked, or a network policy needs tools that are not installed.
# Its +remediation+ says what to change.
#
# pkg:gem/mxc#lib/mxc/error.rb:35
class MXC::UnsupportedError < ::MXC::Error; end

# The gem version.
#
# pkg:gem/mxc#lib/mxc/version.rb:5
MXC::VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/mxc#lib/mxc/windows_arguments.rb:4
module MXC::WindowsArguments
  private

  # Quotes +argument+ so CommandLineToArgvW and the C runtime read it back unchanged.
  #
  # pkg:gem/mxc#lib/mxc/windows_arguments.rb:10
  def quote(argument); end

  class << self
    # Quotes +argument+ so CommandLineToArgvW and the C runtime read it back unchanged.
    #
    # pkg:gem/mxc#lib/mxc/windows_arguments.rb:10
    def quote(argument); end
  end
end

# pkg:gem/mxc#lib/mxc/windows_arguments.rb:5
MXC::WindowsArguments::SPECIAL = T.let(T.unsafe(nil), Regexp)
