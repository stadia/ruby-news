#   h = MyHash.new(:abc => 'def')
#   h[:abc] # => 'def'
#
# pkg:gem/hashie#lib/hashie/extensions/merge_initializer.rb:19
module Hashie::Extensions::MergeInitializer
  # @example Initialize entries and a default value
  #   class InitializedHash < Hash
  #     include Hashie::Extensions::MergeInitializer
  #   end
  #   hash = InitializedHash.new({ name: 'Ada' }, 'unknown')
  #   hash[:name] # => 'Ada'
  #   hash[:missing] # => 'unknown'
  #
  # pkg:gem/hashie#lib/hashie/extensions/merge_initializer.rb:27
  def initialize(hash = T.unsafe(nil), default = T.unsafe(nil), &block); end
end

# A macro module that will automatically include MethodReader,
# MethodWriter, and MethodQuery, giving you the ability to read,
# write, and query keys in a hash using method call shortcuts.
#
# @example Read, write, and query through methods
#   hash = {}.extend(Module.new { include Hashie::Extensions::MethodAccess })
#   hash.name = 'Ada'
#   hash.name # => 'Ada'
#   hash.name? # => true
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:186
module Hashie::Extensions::MethodAccess
  include ::Hashie::Extensions::MethodReader
  include ::Hashie::Extensions::MethodWriter
  include ::Hashie::Extensions::MethodQuery

  class << self
    # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:187
    def included(base); end
  end
end

# A macro module that will automatically include MethodReader,
# MethodOverridingWriter, and MethodQuery, giving you the ability
# to read, write, and query keys in a hash using method call
# shortcuts that can override object methods. Any overridden
# object method is automatically aliased with two leading
# underscores.
#
# @example Initialize, read, write, and query a conflicting key
#   class OverridingHash < Hash
#     include Hashie::Extensions::MethodAccessWithOverride
#   end
#   hash = OverridingHash.new(size: 'large')
#   hash.size # => 'large'
#   hash.size = 'small'
#   hash.size? # => true
#   hash.__size # => 1
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:305
module Hashie::Extensions::MethodAccessWithOverride
  include ::Hashie::Extensions::MethodReader
  include ::Hashie::Extensions::MethodOverridingWriter
  include ::Hashie::Extensions::MethodQuery
  include ::Hashie::Extensions::MethodOverridingInitializer

  class << self
    # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:306
    def included(base); end
  end
end

# MethodOverridingInitializer allows you to override default hash
# methods when passing in values from an existing hash. The overridden
# methods are aliased with two leading underscores.
#
# @example
#   require 'hashie/extensions/method_access'
#   class MyHash < Hash
#     include Hashie::Extensions::MethodOverridingInitializer
#   end
#
#   h = MyHash.new(zip: 'a-dee-doo-dah')
#   h.zip # => 'a-dee-doo-dah'
#   h.__zip # => [[['zip', 'a-dee-doo-dah']]]
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:327
module Hashie::Extensions::MethodOverridingInitializer
  include ::Hashie::Extensions::RedefineMethod

  # @example Initialize conflicting keys and preserve a default
  #   require 'hashie/extensions/method_access'
  #   class OverridingHash < Hash
  #     include Hashie::Extensions::MethodOverridingInitializer
  #   end
  #   hash = OverridingHash.new({ size: 'large' }, false)
  #   hash.size # => 'large'
  #   hash.__size # => 1
  #   hash[:missing] # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:339
  def initialize(hash = T.unsafe(nil), default = T.unsafe(nil), &block); end
end

# MethodOverridingWriter gives you #key_name= shortcuts for
# writing to your hash. It allows methods to be overridden by
# #key_name= shortcuts and aliases those methods with two
# leading underscores.
#
# Keys are written as strings. Override #convert_key if you
# would like to have symbols or something else.
#
# Note that MethodOverridingWriter also overrides
# #respond_to_missing? such that any #method_name= will respond
# appropriately as true.
#
# @example
#   require 'hashie/extensions/method_access'
#   class MyHash < Hash
#     include Hashie::Extensions::MethodOverridingWriter
#   end
#
#   h = MyHash.new
#   h.awesome = 'sauce'
#   h['awesome'] # => 'sauce'
#   h.zip = 'a-dee-doo-dah'
#   h.zip # => 'a-dee-doo-dah'
#   h.__zip # => [[['awesome', 'sauce']], [['zip', 'a-dee-doo-dah']]]
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:245
module Hashie::Extensions::MethodOverridingWriter
  include ::Hashie::Extensions::RedefineMethod

  # @example Normalize keys before storage
  #   require 'hashie/extensions/method_access'
  #   hash = {}.extend(Hashie::Extensions::MethodOverridingWriter)
  #   hash.convert_key(:size) # => 'size'
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:252
  def convert_key(key); end

  # @example Override a Hash method and keep access to the original
  #   require 'hashie/extensions/method_access'
  #   hash = {}.extend(Hashie::Extensions::MethodOverridingWriter)
  #   hash.size = 'large'
  #   hash.size # => 'large'
  #   hash.__size # => 1
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:262
  def method_missing(name, *args); end

  protected

  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:284
  def already_overridden?(name); end

  private

  # @example Advertise method-overriding writers
  #   require 'hashie/extensions/method_access'
  #   hash = {}.extend(Hashie::Extensions::MethodOverridingWriter)
  #   hash.respond_to?(:size=) # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:276
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

# MethodQuery gives you the ability to check for the truthiness
# of a key via method calls. Note that it will return false if
# the key is set to a non-truthful value, not if the key isn't
# set at all. Use #key? for checking if a key has been set.
#
# MethodQuery will check against both string and symbol names
# of the method for existing keys. It also patches #respond_to
# to appropriately detect the query methods.
#
# @example
#   class MyHash < Hash
#     include Hashie::Extensions::MethodQuery
#   end
#
#   h = MyHash.new
#   h['abc'] = 123
#   h.abc? # => true
#   h['def'] = nil
#   h.def? # => false
#   expect { h.hji? }.to raise_error(NoMethodError)
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:129
module Hashie::Extensions::MethodQuery
  # @example Query the truthiness of values
  #   hash = { active: true, disabled: nil }.extend(Hashie::Extensions::MethodQuery)
  #   hash.active? # => true
  #   hash.disabled? # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:146
  def method_missing(name, *args); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:163
  def indifferent_key?(name); end

  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:168
  def key_from_query_method(query_method); end

  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:172
  def query_method?(name); end

  # @example Advertise queries for present keys, including nil values
  #   hash = { name: nil }.extend(Hashie::Extensions::MethodQuery)
  #   hash.respond_to?(:name?) # => true
  #   hash.respond_to?(:missing?) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:134
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

# MethodReader allows you to access keys of the hash
# via method calls. This gives you an OStruct like way
# to access your hash's keys. It will recognize keys
# either as strings or symbols.
#
# Note that while nil keys will be returned as nil,
# undefined keys will raise NoMethodErrors. Also note that
# #respond_to? has been patched to appropriately recognize
# key methods.
#
# @example
#   class User < Hash
#     include Hashie::Extensions::MethodReader
#   end
#
#   user = User.new
#   user['first_name'] = 'Michael'
#   user.first_name # => 'Michael'
#
#   user[:last_name] = 'Bleigh'
#   user.last_name # => 'Bleigh'
#
#   user[:birthday] = nil
#   user.birthday # => nil
#
#   expect { user.not_declared }.to raise_error(NoMethodError)
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:31
module Hashie::Extensions::MethodReader
  # @example Read both symbol and string keys
  #   hash = { name: 'Ada', 'age' => 42 }.extend(Hashie::Extensions::MethodReader)
  #   hash.name # => 'Ada'
  #   hash.age # => 42
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:46
  def method_missing(name, *args); end

  private

  # @example Advertise readers for existing keys
  #   hash = { name: 'Ada' }.extend(Hashie::Extensions::MethodReader)
  #   hash.respond_to?(:name) # => true
  #   hash.respond_to?(:missing) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:36
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

# MethodWriter gives you #key_name= shortcuts for
# writing to your hash. Keys are written as strings,
# override #convert_key if you would like to have symbols
# or something else.
#
# Note that MethodWriter also overrides #respond_to such
# that any #method_name= will respond appropriately as true.
#
# @example
#   class MyHash < Hash
#     include Hashie::Extensions::MethodWriter
#   end
#
#   h = MyHash.new
#   h.awesome = 'sauce'
#   h['awesome'] # => 'sauce'
#
# pkg:gem/hashie#lib/hashie/extensions/method_access.rb:80
module Hashie::Extensions::MethodWriter
  # @example Normalize a writer key
  #   hash = {}.extend(Hashie::Extensions::MethodWriter)
  #   hash.convert_key(:name) # => 'name'
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:104
  def convert_key(key); end

  # @example Write string keys with assignment syntax
  #   hash = {}.extend(Hashie::Extensions::MethodWriter)
  #   hash.name = 'Ada'
  #   hash # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:95
  def method_missing(name, *args); end

  private

  # @example Advertise arbitrary writers
  #   hash = {}.extend(Hashie::Extensions::MethodWriter)
  #   hash.respond_to?(:name=) # => true
  #   hash.respond_to?(:name) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/method_access.rb:85
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

# Parsers used when loading persisted hashes.
#
# @example Select the YAML parser without ERB evaluation
#   Hashie::Extensions::Parsers::YamlParser.respond_to?(:perform) # => true
#
# pkg:gem/hashie#lib/hashie.rb:56
module Hashie::Extensions::Parsers; end

# Parses YAML after evaluating ERB templates.
#
# @example
#   require 'tempfile'
#   file = Tempfile.new(['hashie-example', '.yml'], '.')
#   begin
#     file.write("count: <%= 1 + 2 %>\n")
#     file.close
#     Hashie::Extensions::Parsers::YamlErbParser.perform(file.path) # => {'count' => 3}
#   ensure
#     file.close!
#   end
#
# pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_erb_parser.rb:21
class Hashie::Extensions::Parsers::YamlErbParser < ::Hashie::Extensions::Parsers::YamlParser
  # @example Evaluate ERB before safely loading YAML
  #   require 'tempfile'
  #   file = Tempfile.new(['hashie-example', '.yml'], '.')
  #   begin
  #     file.write("count: <%= 2 * 3 %>\n")
  #     file.close
  #     parser = Hashie::Extensions::Parsers::YamlErbParser.new(file.path)
  #     parser.perform # => {'count' => 6}
  #   ensure
  #     file.close!
  #   end
  #
  # pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_erb_parser.rb:33
  def perform; end
end

# Parses YAML without evaluating ERB templates.
#
# @example
#   require 'tempfile'
#   file = Tempfile.new(['hashie-example', '.yml'], '.')
#   begin
#     file.write("name: Ada\n")
#     file.close
#     Hashie::Extensions::Parsers::YamlParser.perform(file.path) # => {'name' => 'Ada'}
#   ensure
#     file.close!
#   end
#
# pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_parser.rb:21
class Hashie::Extensions::Parsers::YamlParser
  # @example Read a Pathname and retain parsing options
