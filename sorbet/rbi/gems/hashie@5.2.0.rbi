  def translation_exists?(name); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/dash/indifferent_access.rb:135
  def translation_for?(name); end
end

# Loads declared properties on demand from an initializer block.
# Include after other Dash extensions. Hash enumeration only sees loaded
# entries; to_h loads every declared property.
#
# @example Load and memoize a property
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::Lazy
#     property :name
#   end
#   calls = []
#   dash = klass.new { |key| calls << key; 'Ada' }
#   calls # => []
#   dash.name # => 'Ada'
#   dash.name # => 'Ada'
#   calls # => [:name]
#
# pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:21
module Hashie::Extensions::Dash::Lazy
  # @example Hash initialization without a loader retains normal behavior
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name, required: true
  #   end
  #   klass.new(name: 'Ada').name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:28
  def initialize(attributes = T.unsafe(nil), &loader); end

  # @example Read a property without loading its neighbors
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name
  #     property :age
  #   end
  #   dash = klass.new { |key| { name: 'Ada', age: 37 }[key] }
  #   dash[:name] # => 'Ada'
  #   dash.keys # => [:name]
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:43
  def [](property, &block); end

  # @example Load the first property before digging into its value
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :user
  #   end
  #   klass.new { |_key| { name: 'Ada' } }.dig(:user, :name) # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:71
  def dig(property, *path); end

  # @example Fetch a declared value through its loader
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name
  #   end
  #   klass.new { |_key| 'Ada' }.fetch(:name) # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:60
  def fetch(property, *args, &block); end

  # @example Freezing resolves pending values before preventing mutation
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name
  #   end
  #   klass.new { |_key| 'Ada' }.freeze.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:101
  def freeze; end

  # @example Convert all declared properties to a plain hash
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name
  #   end
  #   klass.new { |_key| 'Ada' }.to_h # => { name: 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:82
  def to_h; end

  # @example Convert all declared properties for hash coercion
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::Lazy
  #     property :name
  #   end
  #   klass.new { |_key| 'Ada' }.to_hash # => { name: 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:93
  def to_hash; end

  private

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:114
  def assert_required_attributes_set!; end

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:108
  def initialize_attributes(attributes); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:118
  def initialize_copy(other); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:129
  def lazy_attribute_key(property); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:123
  def lazy_property(property); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/lazy.rb:137
  def load_property(property); end
end

