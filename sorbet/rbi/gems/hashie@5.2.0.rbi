    def included(base); end
  end
end

# Declares and inherits permitted values for properties.
#
# @example
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::PredefinedValues
#     property :status, values: [:open, :closed]
#   end
#   klass.values_for_properties # => {status: [:open, :closed]}
#
# pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:40
module Hashie::Extensions::Dash::PredefinedValues::ClassMethods
  # @example Inherit constraints without sharing the constraint map
  #   parent = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PredefinedValues
  #     property :status, values: [:open, :closed]
  #   end
  #   child = Class.new(parent) { property :age, values: (0..150) }
  #   child.values_for_properties.keys # => [:status, :age]
  #   parent.values_for_properties.keys # => [:status]
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:57
  def inherited(klass); end

  # @example Accept an array or range of values
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PredefinedValues
  #     property :status, values: [:open, :closed]
  #     property :age, values: (0..150)
  #   end
  #   klass.new(status: :open, age: 42).age # => 42
  #   expect { klass.new(status: :unknown) }.to raise_error(ArgumentError, /status/)
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:70
  def property(property_name, options = T.unsafe(nil)); end

  # @example Read the constraints for declared properties
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PredefinedValues
  #     property :age, values: (0..150)
  #   end
  #   klass.values_for_properties # => {age: (0..150)}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:47
  def values_for_properties; end

  private

  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:81
  def assert_predefined_values!(predefined_values); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:91
  def set_predefined_values(property_name, predefined_values); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:87
  def supported_type?(predefined_values); end
end

# Validates property constraints when constructing a Dash.
#
# @example
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::PredefinedValues
#     property :status, values: [:open, :closed]
