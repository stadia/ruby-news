# Class-level property and translation lookup with indifferent keys.
#
# @example
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::IndifferentAccess
#     property :name
#   end
#   klass.property?('name') # => true
#
# pkg:gem/hashie#lib/hashie/extensions/dash/indifferent_access.rb:73
module Hashie::Extensions::Dash::IndifferentAccess::ClassMethods
  # Check to see if the specified property has already been
  # defined.
  #
  # @example
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::IndifferentAccess
  #     property :name
  #   end
