  #     file.write("name: Ada\n")
  #     file.close
  #     parser = Hashie::Extensions::Parsers::YamlParser.new(Pathname.new(file.path), aliases: false)
  #     parser.perform # => {'name' => 'Ada'}
  #   ensure
  #     file.close!
  #   end
  #
  # pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_parser.rb:33
  def initialize(file_path, options = T.unsafe(nil)); end

  # @example Leave ERB untouched when loading YAML
  #   require 'tempfile'
  #   file = Tempfile.new(['hashie-example', '.yml'], '.')
  #   begin
  #     file.write("value: <%= 1 + 2 %>\n")
  #     file.close
  #     parser = Hashie::Extensions::Parsers::YamlParser.new(file.path)
  #     parser.perform # => {'value' => '<%= 1 + 2 %>'}
  #   ensure
  #     file.close!
  #   end
  #
  # pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_parser.rb:50
  def perform; end

  private

  # pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_parser.rb:70
  def yaml_safe_load(content); end

  class << self
    # @example Load YAML in one step
    #   require 'tempfile'
    #   file = Tempfile.new(['hashie-example', '.yml'], '.')
    #   begin
    #     file.write("count: 3\n")
    #     file.close
    #     Hashie::Extensions::Parsers::YamlParser.perform(file.path, aliases: false) # => {'count' => 3}
    #   ensure
    #     file.close!
    #   end
    #
    # pkg:gem/hashie#lib/hashie/extensions/parsers/yaml_parser.rb:64
    def perform(file_path, options = T.unsafe(nil)); end
  end
end

# Opt-in YAML file persistence for classes initialized from a hash.
#
# @example Save and reload a hash subclass
#   class Settings < Hash
#     include Hashie::Extensions::MergeInitializer
#     include Hashie::Extensions::Persistable
#   end
#   file = Tempfile.new(['hashie-example', '.yaml'], Dir.pwd)
#   begin
#     settings = Settings.new('theme' => 'dark')
#     settings.save(file.path)
#     Settings.load(file.path)['theme'] # => 'dark'
#   ensure
#     file.close!
#   end
#
# pkg:gem/hashie#lib/hashie/extensions/persistable.rb:23
module Hashie::Extensions::Persistable
  mixes_in_class_methods ::Hashie::Extensions::Persistable::ClassMethods

  # @example Remember the last successful save location
  #   class Settings < Hash
  #     include Hashie::Extensions::MergeInitializer
  #     include Hashie::Extensions::Persistable
  #   end
  #   file = Tempfile.new(['hashie-example', '.yaml'], Dir.pwd)
  #   begin
  #     settings = Settings.new('theme' => 'dark')
  #     settings.persistable_path # => nil
  #     settings.save(file.path)
  #     settings.persistable_path # => File.expand_path(file.path)
  #   ensure
  #     file.close!
  #   end
  #
  # pkg:gem/hashie#lib/hashie/extensions/persistable.rb:80
  def persistable_path; end

  # @example Save again without repeating the path
  #   class Settings < Hash
  #     include Hashie::Extensions::MergeInitializer
  #     include Hashie::Extensions::Persistable
  #   end
  #   file = Tempfile.new(['hashie-example', '.yaml'], Dir.pwd)
  #   begin
  #     settings = Settings.new('theme' => 'dark')
  #     settings.save(file.path)
  #     settings['theme'] = 'light'
  #     settings.save
  #     Settings.load(file.path)['theme'] # => 'light'
  #   ensure
  #     file.close!
  #   end
  #
  # pkg:gem/hashie#lib/hashie/extensions/persistable.rb:97
  def save(path = T.unsafe(nil)); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/persistable.rb:115
  def persistable_data(value, ancestors = T.unsafe(nil)); end

  class << self
    # pkg:gem/hashie#lib/hashie/extensions/persistable.rb:24
    def included(base); end
  end
end

# @example Add a YAML loader by including Persistable
#   class Settings < Hash
#     include Hashie::Extensions::MergeInitializer
#     include Hashie::Extensions::Persistable
#   end
#   file = Tempfile.new(['hashie-example', '.yaml'], Dir.pwd)
#   begin
#     file.write("---\ntheme: dark\n")
#     file.flush
#     Settings.load(file.path) # => { 'theme' => 'dark' }
#   ensure
#     file.close!
#   end
#
# pkg:gem/hashie#lib/hashie/extensions/persistable.rb:41
module Hashie::Extensions::Persistable::ClassMethods
  # @example Load safe YAML data and remember its path
  #   class Settings < Hash
  #     include Hashie::Extensions::MergeInitializer
  #     include Hashie::Extensions::Persistable
  #   end
  #   file = Tempfile.new(['hashie-example', '.yaml'], Dir.pwd)
  #   begin
  #     file.write("---\ntheme: dark\n")
  #     file.flush
  #     settings = Settings.load(file.path)
  #     settings['theme'] # => 'dark'
