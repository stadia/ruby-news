  # pkg:gem/hashie#lib/hashie/extensions/dash/predefined_values.rb:141
  def values_for_properties(property); end
end

# Extends a Dash with the ability to remap keys from a source hash.
#
# Property translation is useful when you need to read data from another
# application -- such as a Java API -- where the keys are named
# differently from Ruby conventions.
#
# @example Translate inconsistent API keys
#
#   class PersonHash < Hashie::Dash
#     include Hashie::Extensions::Dash::PropertyTranslation
#
#     property :first_name, from: :firstName
#     property :last_name, from: :lastName
#     property :first_name, from: :f_name
#     property :last_name, from: :l_name
#   end
#
#   person = PersonHash.new(firstName: 'Michael', l_name: 'Bleigh')
#   person[:first_name]  #=> 'Michael'
#   person[:last_name]   #=> 'Bleigh'
#
# You can also use a lambda to translate the value. This is particularly
# useful when you want to ensure the type of data you're wrapping.
#
# @example Transform input values
#   require 'time'
#
#   class DataModelHash < Hashie::Dash
#     include Hashie::Extensions::Dash::PropertyTranslation
#
#     property :id, transform_with: ->(value) { value.to_i }
#     property :created_at, from: :created, with: ->(value) { Time.parse(value) }
#   end
#
#   model = DataModelHash.new(id: '123', created: '2014-04-25 22:35:28')
#   model.id.class          #=> Integer
#   model.created_at.class  #=> Time
#
# pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:43
module Hashie::Extensions::Dash::PropertyTranslation
  include ::Hashie::Extensions::Dash::PropertyTranslation::InstanceMethods

  mixes_in_class_methods ::Hashie::Extensions::Dash::PropertyTranslation::ClassMethods
  mixes_in_class_methods ::Hashie::Extensions::DeepMerge

  class << self
    # @example Install translation declarations on a Dash
    #   klass = Class.new(Hashie::Dash) do
    #     include Hashie::Extensions::Dash::PropertyTranslation
    #     property :name, from: :fullName
    #   end
    #   klass.new(fullName: 'Ada').name # => 'Ada'
    #
    # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:50
    def included(base); end
  end
end

# Defines input translations and value transformations.
#
# @example
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::PropertyTranslation
#     property :name, from: :fullName
#   end
#   klass.translations # => {fullName: :name}
#
# pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:66
module Hashie::Extensions::Dash::PropertyTranslation::ClassMethods
  # Ensures that any inheriting classes maintain their translations.
  #
  # * `:default` - The class inheriting the translations.
  #
  # @example Copy translation settings to subclasses
  #   parent = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   child = Class.new(parent) { property :age, from: :years }
  #   child.new(fullName: 'Ada', years: 37).age # => 37
  #   parent.translations # => {fullName: :name}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:88
  def inherited(klass); end

  # @example Map destination properties back to source keys
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   klass.inverse_translations # => {name: :fullName}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:195
  def inverse_translations; end

  # @example List translated input keys alongside untranslated properties
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #     property :age
  #   end
  #   klass.permitted_input_keys # => [:fullName, :age]
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:101
  def permitted_input_keys; end

  # Defines a property on the Trash. Options are as follows:
  #
  # * `:default` - Specify a default value for this property, to be
  # returned before a value is set on the property in a new Dash.
  # * `:from` - Specify the original key name that will be write only.
  # * `:with` - Specify a lambda to be used to convert value.
  # * `:transform_with` - Specify a lambda to be used to convert value
  # without using the :from option. It transform the property itself.
  #
  # @example Declare a translated and converted property
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :age, from: :years, with: ->(value) { value.to_i }
  #   end
  #   klass.new(years: '37').age # => 37
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:122
  def property(property_name, options = T.unsafe(nil)); end

  # @example Check for a property transformer
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :age, transform_with: ->(value) { value.to_i }
  #   end
  #   klass.transformation_exists?(:age) # => true
  #   klass.transformation_exists?(:name) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:155
  def transformation_exists?(name); end

  # @example Apply a declared transformer directly
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :age, transform_with: ->(value) { value.to_i }
  #   end
  #   klass.transformed_property(:age, '37') # => 37
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:144
  def transformed_property(property_name, value); end

  # @example Inspect value transformers
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :age, transform_with: ->(value) { value.to_i }
  #   end
  #   klass.transforms[:age].call('37') # => 37
  #   klass.translations_hash # => {}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:74
  def transforms; end

  # @example Check for a translated source key
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   klass.translation_exists?(:fullName) # => true
  #   klass.translation_exists?(:name) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:166
  def translation_exists?(name); end

  # @example Map source keys to destination properties
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   klass.translations # => {fullName: :name}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:176
  def translations; end

  # @example Inspect value transformers
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :age, transform_with: ->(value) { value.to_i }
  #   end
  #   klass.transforms[:age].call('37') # => 37
  #   klass.translations_hash # => {}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:74
  def translations_hash; end

  private

  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:207
  def define_translation(from, property_name, translator); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:211
  def define_writer_for_source_property(property); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:219
  def fail_self_transformation_error!(property_name); end

  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:224
  def valid_transformer?(transformer); end
end

# Applies translations and transformations during assignment.
#
# @example
#   klass = Class.new(Hashie::Dash) do
#     include Hashie::Extensions::Dash::PropertyTranslation
#     property :name, from: :fullName
#   end
#   klass.new(fullName: 'Ada').name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:237
module Hashie::Extensions::Dash::PropertyTranslation::InstanceMethods
  # Sets a value on the Dash in a Hash-like way.
  #
  # Note: Only works on pre-existing properties.
  #
  # @example Assign through a translated source key
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   dash = klass.new
  #   dash[:fullName] = 'Ada'
  #   dash.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:250
  def []=(property, value); end

  # Deletes any keys that have a translation
  #
  # @example Initialize translated input without modifying the source
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name, from: :fullName
  #   end
  #   attributes = {fullName: 'Ada'}
  #   dash = klass.new
  #   dash.initialize_attributes(attributes)
  #   dash.name # => 'Ada'
  #   attributes # => {fullName: 'Ada'}
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:278
  def initialize_attributes(attributes); end

  # Raises an NoMethodError if the property doesn't exist
  #
  # @example Check for an existing property
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::PropertyTranslation
  #     property :name
  #   end
  #   dash = klass.new
  #   dash.property_exists?(:name) # => true
  #   expect { dash.property_exists?(:missing) }.to raise_error(NoMethodError)
  #
  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:300
  def property_exists?(property); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/dash/property_translation.rb:307
  def __translations; end
end

# Searches a deeply nested data structure for a key path, and returns the associated value.
#
#  options = { user: { location: { address: '123 Street' } } }
#  options.deep_fetch :user, :location, :address #=> '123 Street'
#
# If a block is provided its value will be returned if the key does not exist.
#
#  options.deep_fetch(:user, :non_existent_key) { 'a value' } #=> 'a value'
#
# This is particularly useful for fetching values from deeply nested api responses
#   or params hashes.
#
# @example Traverse hashes and arrays
#   hash = { users: [{ name: 'Ada' }] }.extend(Hashie::Extensions::DeepFetch)
#   hash.deep_fetch(:users, 0, :name) # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/deep_fetch.rb:20
module Hashie::Extensions::DeepFetch
  # @example Use a fallback for a missing path
  #   hash = { user: {} }.extend(Hashie::Extensions::DeepFetch)
  #   hash.deep_fetch(:user, :name) { |key| "missing #{key}" } # => 'missing name'
  #   hash.deep_fetch(:user) # => {}
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_fetch.rb:30
  def deep_fetch(*args, &block); end
end

# @example Report an undefined path
#   error = Hashie::Extensions::DeepFetch::UndefinedPathError.new('missing address')
#   error.message # => 'missing address'
#
# pkg:gem/hashie#lib/hashie/extensions/deep_fetch.rb:24
class Hashie::Extensions::DeepFetch::UndefinedPathError < ::StandardError; end

# @example Find values in nested collections
#   hash = { users: [{ name: 'Ada' }] }.extend(Hashie::Extensions::DeepFind)
#   hash.deep_find(:name) # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:9
module Hashie::Extensions::DeepFind
  # @example Detect the first nested value
  #   hash = { user: { name: 'Ada' } }.extend(Hashie::Extensions::DeepFind)
  #   hash.deep_detect(:name) # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:35
  def deep_detect(key); end

  # Performs a depth-first search on deeply nested data structures for
  # a key and returns the first occurrence of the key.
  #
  #  options = {user: {location: {address: '123 Street'}}}
  #  options.extend(Hashie::Extensions::DeepFind)
  #  options.deep_find(:address) # => '123 Street'
  #
  #  class MyHash < Hash
  #    include Hashie::Extensions::DeepFind
  #  end
  #
  #  my_hash = MyHash.new
  #  my_hash[:user] = {location: {address: '123 Street'}}
  #  my_hash.deep_find(:address) # => '123 Street'
  #
  # @example Return the first value
  #   hash = { users: [{ name: 'Ada' }, { name: 'Grace' }] }.extend(Hashie::Extensions::DeepFind)
  #   hash.deep_find(:name) # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:28
  def deep_find(key); end

  # Performs a depth-first search on deeply nested data structures for
  # a key and returns all occurrences of the key.
  #
  #  options = {
  #    users: [
  #      { location: {address: '123 Street'} },
  #      { location: {address: '234 Street'}}
  #    ]
  #  }
  #  options.extend(Hashie::Extensions::DeepFind)
  #  options.deep_find_all(:address) # => ['123 Street', '234 Street']
  #
  #  class MyHash < Hash
  #    include Hashie::Extensions::DeepFind
  #  end
  #
  #  my_hash = MyHash.new
  #  my_hash[:users] = [
  #    {location: {address: '123 Street'}},
  #    {location: {address: '234 Street'}}
  #  ]
  #  my_hash.deep_find_all(:address) # => ['123 Street', '234 Street']
  #
  # @example Collect all values, or nil if absent
  #   hash = { users: [{ name: 'Ada' }, { name: 'Grace' }] }.extend(Hashie::Extensions::DeepFind)
  #   hash.deep_find_all(:name) # => ['Ada', 'Grace']
  #   hash.deep_find_all(:email) # => nil
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:64
  def deep_find_all(key); end

  # @example Select every nested value
  #   hash = { users: [{ name: 'Ada' }, { name: 'Grace' }] }.extend(Hashie::Extensions::DeepFind)
  #   hash.deep_select(:name) # => ['Ada', 'Grace']
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:72
  def deep_select(key); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:76
  def _deep_find(key, object = T.unsafe(nil)); end

  # pkg:gem/hashie#lib/hashie/extensions/deep_find.rb:80
  def _deep_find_all(key, object = T.unsafe(nil), matches = T.unsafe(nil)); end
end

# Searches nested hashes and arrays for matching string and symbol keys or values.
#
# @example Search a nested collection
#   hash = { people: [{ name: 'Ada' }] }.extend(Hashie::Extensions::DeepGrep)
#   hash.deep_grep(/Ada/) # => [{ name: 'Ada' }]
#
# pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:10
module Hashie::Extensions::DeepGrep
  # @example Match a key and return its subtree
  #   hash = { user: { name: 'Ada' } }.extend(Hashie::Extensions::DeepGrep)
  #   hash.deep_grep(/user/) # => [{ user: { name: 'Ada' } }]
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:14
  def deep_grep(pattern); end

  class << self
    # Returns key/subtree pairs for matching keys, containing hashes for matching
    # scalar values, and matching scalar array elements. Matching keys stop descent.
    #
    # @example Search an array without extending it
    #   Hashie::Extensions::DeepGrep.deep_grep(/Ada/, ['Ada', 'Grace']) # => ['Ada']
    #
    # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:23
    def deep_grep(pattern, object); end

    private

    # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:63
    def matches?(pattern, value); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:29
    def search(pattern, object, results, ancestors); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:56
    def search_array(pattern, object, results, ancestors); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_grep.rb:44
    def search_hash(pattern, object, results, ancestors); end
  end
end

# @example Locate the hash containing a key
#   Hashie::Extensions::DeepLocate.deep_locate(:name, { user: { name: 'Ada' } }) # => [{ name: 'Ada' }]
#
# pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:7
module Hashie::Extensions::DeepLocate
  # Performs a depth-first search on deeply nested data structures for a
  # given comparator callable and returns each Enumerable, for which the
  # callable returns true for at least one the its elements.
  #
  # @example
  #   books = [
  #     {
  #       title: "Ruby for beginners",
  #       pages: 120
  #     },
  #     {
  #       title: "CSS for intermediates",
  #       pages: 80
  #     },
  #     {
  #       title: "Collection of ruby books",
  #       books: [
  #         {
  #           title: "Ruby for the rest of us",
  #           pages: 576
  #         }
  #       ]
  #     }
  #   ]
  #
  #   books.extend(Hashie::Extensions::DeepLocate)
  #
  #   ruby_titles = ->(key, value, _object) { key == :title && value.include?("Ruby") }
  #   books.deep_locate(ruby_titles) # => [{ title: 'Ruby for beginners', pages: 120 }, { title: 'Ruby for the rest of us', pages: 576 }]
  #   short_books = ->(key, value, _object) { key == :pages && value <= 120 }
  #   books.deep_locate(short_books) # => [{ title: 'Ruby for beginners', pages: 120 }, { title: 'CSS for intermediates', pages: 80 }]
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:53
  def deep_locate(comparator); end

  class << self
    # The module level implementation of #deep_locate, in case you do not want
    # to include/extend the base data structure. For further examples please
    # see #deep_locate.
    #
    # @example
    #   books = [{ title: 'Ruby for beginners', pages: 120 }, { pages: 80 }]
    #   comparator = ->(key, _value, _object) { key == :title }
    #   Hashie::Extensions::DeepLocate.deep_locate(comparator, books) # => [{ title: 'Ruby for beginners', pages: 120 }]
    #
    # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:16
    def deep_locate(comparator, object); end

    private

    # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:57
    def _construct_key_comparator(search_key, object); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:69
    def _deep_locate(comparator, object, result = T.unsafe(nil)); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:82
    def _match_comparator?(value, comparator, object); end

    # pkg:gem/hashie#lib/hashie/extensions/deep_locate.rb:93
    def activesupport_indifferent?(object); end
  end
end

# @example Merge nested hashes
#   hash = { user: { name: 'Ada' } }.extend(Hashie::Extensions::DeepMerge)
#   hash.deep_merge(user: { active: true }) # => { user: { name: 'Ada', active: true } }
#
# pkg:gem/hashie#lib/hashie/extensions/deep_merge.rb:8
module Hashie::Extensions::DeepMerge
  # Returns a new hash with +self+ and +other_hash+ merged recursively.
  #
  # @example Merge without changing the receiver
  #   hash = { settings: { count: 1 } }.extend(Hashie::Extensions::DeepMerge)
  #   hash.deep_merge(settings: { count: 2 }) # => { settings: { count: 2 } }
  #   hash # => { settings: { count: 1 } }
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_merge.rb:15
  def deep_merge(other_hash, &block); end

  # Returns a new hash with +self+ and +other_hash+ merged recursively.
  # Modifies the receiver in place.
  #
  # @example Resolve a nested conflict with a block
  #   hash = { settings: { count: 1 } }.extend(Hashie::Extensions::DeepMerge)
  #   hash.deep_merge!({ settings: { count: 2 } }) { |_key, old, new| old + new }
  #   hash # => { settings: { count: 3 } }
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_merge.rb:28
  def deep_merge!(other_hash, &block); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/deep_merge.rb:37
  def _deep_dup(hash); end

  # pkg:gem/hashie#lib/hashie/extensions/deep_merge.rb:52
  def _recursive_merge(hash, other_hash, &block); end
end

# Initializes a Hash subclass, converting nested hashes to the same class.
#
# @example Initialize nested hash instances
#   class NestedHash < Hash
#     include Hashie::Extensions::DeepMergeInitializer
#   end
#   hash = NestedHash.new(user: { name: 'Ada' })
#   hash[:user].class # => NestedHash
#
# pkg:gem/hashie#lib/hashie/extensions/deep_merge_initializer.rb:13
module Hashie::Extensions::DeepMergeInitializer
  # @example Convert hashes inside arrays and retain a default
  #   class NestedHash < Hash
  #     include Hashie::Extensions::DeepMergeInitializer
  #   end
  #   hash = NestedHash.new({ users: [{ name: 'Ada' }] }, false)
  #   hash[:users].first.class # => NestedHash
  #   hash[:users].first[:missing] # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/deep_merge_initializer.rb:21
  def initialize(hash = T.unsafe(nil), default = T.unsafe(nil), &block); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/deep_merge_initializer.rb:30
  def deep_merge_initializer_value(value, default, &block); end
end

# IgnoreUndeclared is a simple mixin that silently ignores
# undeclared properties on initialization instead of
# raising an error. This is useful when using a Trash to
# capture a subset of a larger hash.
#
# Note that attempting to retrieve or set an undeclared property
# will still raise a NoMethodError, even if a value for
# that property was provided at initialization.
#
# @example
#   class Person < Hashie::Trash
#     include Hashie::Extensions::IgnoreUndeclared
#
#     property :first_name
#     property :last_name
#   end
#
#   user_data = {
#      :first_name => 'Freddy',
#      :last_name => 'Nostrils',
#      :email => 'freddy@example.com'
#   }
#
#   p = Person.new(user_data) # 'email' is silently ignored
#
#   p.first_name # => 'Freddy'
#   p.last_name  # => 'Nostrils'
#   expect { p.email }.to raise_error(NoMethodError)
#
# pkg:gem/hashie#lib/hashie/extensions/ignore_undeclared.rb:33
module Hashie::Extensions::IgnoreUndeclared
  # @example Initialize only declared attributes
  #   class Person < Hashie::Trash
  #     include Hashie::Extensions::IgnoreUndeclared
  #     property :name
  #   end
  #   person = Person.new
  #   person.initialize_attributes(name: 'Ada', email: 'ada@example.com')
  #   person.to_h # => { name: 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/ignore_undeclared.rb:42
  def initialize_attributes(attributes); end

  # @example Check the declaration rather than the current value
  #   class Person < Hashie::Trash
  #     include Hashie::Extensions::IgnoreUndeclared
  #     property :name
  #   end
  #   person = Person.new
  #   person.property_exists?(:name) # => true
  #   person.property_exists?(:email) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/ignore_undeclared.rb:59
  def property_exists?(property); end
end

# IndifferentAccess gives you the ability to not care
# whether your hash has string or symbol keys. Made famous
# in Rails for accessing query and POST parameters, this
# is a handy tool for making sure your hash has maximum
# utility.
#
# One unique feature of this mixin is that it will recursively
# inject itself into sub-hash instances without modifying
# the actual class of the sub-hash.
#
# @example
#   class MyHash < Hash
#     include Hashie::Extensions::MergeInitializer
#     include Hashie::Extensions::IndifferentAccess
#   end
#
#   h = MyHash.new(:foo => 'bar', 'baz' => 'blip')
#   h['foo'] # => 'bar'
#   h[:foo]  # => 'bar'
#   h[:baz]  # => 'blip'
#   h['baz'] # => 'blip'
#
# pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:27
module Hashie::Extensions::IndifferentAccess
  # Iterates through the keys and values, reconverting them to
  # their proper indifferent state. Used when IndifferentAccess
  # is injecting itself into member hashes.
  #
  # @example Normalize keys inserted through the original writer
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   hash.regular_writer(:name, 'Ada')
  #   hash.convert!
  #   hash.keys # => ['name']
  #   hash[:name] # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:106
  def convert!; end

  # @example Normalize symbol keys
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   hash.convert_key(:name) # => 'name'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:92
  def convert_key(key); end

  # @example Exclude keys using either representation
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada', age: 42 })
  #   hash.except(:age) # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:258
  def except(*keys); end

  # @example Identify an indifferent hash
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   hash.indifferent_access? # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:192
  def indifferent_access?; end

  # @example Return an existing value or the configured default
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.default = 'unknown'
  #   hash.indifferent_default(:name) # => 'Ada'
  #   hash.indifferent_default(:missing) # => 'unknown'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:132
  def indifferent_default(key = T.unsafe(nil)); end

  # @example Delete a string key through a symbol
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.indifferent_delete(:name) # => 'Ada'
  #   hash # => {}
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:170
  def indifferent_delete(key); end

  # @example Fetch with either key type and support fallbacks
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.indifferent_fetch(:name) # => 'Ada'
  #   hash.indifferent_fetch(:missing, 'unknown') # => 'unknown'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:162
  def indifferent_fetch(key, *, **, &); end

  # @example Recognize both key representations
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.indifferent_key?(:name) # => true
  #   hash.indifferent_key?('name') # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:178
  def indifferent_key?(key); end

  # @example Replace existing data and convert incoming keys
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ old: true })
  #   hash.indifferent_replace(name: 'Ada')
  #   hash # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:200
  def indifferent_replace(other_hash); end

  # @example Normalize incoming keys and nested values
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   hash.indifferent_update(user: { name: 'Ada' })
  #   hash['user']['name'] # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:142
  def indifferent_update(other_hash); end

  # @example Make hashes nested in arrays indifferent
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   value = hash.indifferent_value([{ name: 'Ada' }])
  #   value.first['name'] # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:117
  def indifferent_value(value); end

  # @example Retrieve values using mixed key types
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada', age: 42 })
  #   hash.indifferent_values_at(:name, 'age', :missing) # => ['Ada', 42, nil]
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:185
  def indifferent_values_at(*indices); end

  # @example Store a symbol key as a string
  #   hash = Hashie::Extensions::IndifferentAccess.inject({})
  #   hash.indifferent_writer(:name, 'Ada')
  #   hash # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:154
  def indifferent_writer(key, value); end

  # @example Merge without changing the original
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   merged = hash.merge(age: 42)
  #   merged[:age] # => 42
  #   merged.indifferent_access? # => true
  #   hash.key?(:age) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:212
  def merge(*args); end

  # @example Merge and normalize in place
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.merge!(age: 42)
  #   hash['age'] # => 42
  #   hash.keys.sort # => ['age', 'name']
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:224
  def merge!(*); end

  # @example Select keys using either representation
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada', age: 42 })
  #   hash.slice(:name) # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:250
  def slice(*keys); end

  # @example Export a regular hash, preserving its default
  #   hash = Hashie::Extensions::IndifferentAccess.inject({ name: 'Ada' })
  #   hash.default = 'unknown'
  #   plain = hash.to_hash
  #   plain # => { 'name' => 'Ada' }
  #   plain[:name] # => 'unknown'
  #   plain.respond_to?(:indifferent_access?) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:235
  def to_hash; end

  protected

  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:265
  def hash_lacking_indifference?(other); end

  # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:271
  def hash_with_indifference?(other); end

  class << self
    # @api private
    #
    # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:29
    def convert_key(key); end

    # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:35
    def included(base); end

    # Injects indifferent access into a duplicate of the hash
    # provided. See #inject!
    #
    # @example Leave the original hash's top-level keys unchanged
    #   original = { name: 'Ada' }
    #   hash = Hashie::Extensions::IndifferentAccess.inject(original)
    #   hash['name'] # => 'Ada'
    #   original # => { name: 'Ada' }
    #
    # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:85
    def inject(hash); end

    # This will inject indifferent access into an instance of
    # a hash without modifying the actual class. This is what
    # allows IndifferentAccess to spread to sub-hashes.
    #
    # @example Convert an existing hash in place
    #   hash = { user: { name: 'Ada' } }
    #   Hashie::Extensions::IndifferentAccess.inject!(hash)
    #   hash['user'][:name] # => 'Ada'
    #   hash.class # => Hash
    #
    # pkg:gem/hashie#lib/hashie/extensions/indifferent_access.rb:72
    def inject!(hash); end
  end
end

# @example Opt in to strict numeric coercion
#   klass = Class.new(Hash) do
#     include Hashie::Extensions::Coercion
#     extend Hashie::Extensions::KernelCoercion
#     coerce_key :age, Integer
#   end
#   hash = klass.new
#   hash[:age] = '42'
#   hash[:age] # => 42
#   expect { hash[:age] = 'bad' }.to raise_error(Hashie::CoercionError)
#
# pkg:gem/hashie#lib/hashie/extensions/kernel_coercion.rb:15
module Hashie::Extensions::KernelCoercion
  # Overrides Hashie::Extensions::Coercion::ClassMethods#build_core_type_coercion
  # to use a stricter Kernel method (e.g. Kernel#Integer) for coercing core
  # types, instead of the default, more lenient conversion method (e.g. #to_i).
  #
  #   "abcd".to_i    #=> 0
  #   Integer("abcd") #=> ArgumentError: invalid value for Integer(): "abcd"
  #
  # @example Build a strict conversion and preserve Symbol fallback
  #   klass = Class.new(Hash) do
  #     include Hashie::Extensions::Coercion
  #     extend Hashie::Extensions::KernelCoercion
  #   end
  #   conversion = klass.build_core_type_coercion(Integer)
  #   conversion.call('42') # => 42
  #   expect { conversion.call('42 items') }.to raise_error(ArgumentError)
  #   klass.build_core_type_coercion(Symbol).call('name') # => :name
  #
  # pkg:gem/hashie#lib/hashie/extensions/kernel_coercion.rb:46
  def build_core_type_coercion(type); end
end

# Core types whose values can be coerced with a stricter
# +Kernel+ method (e.g. +Kernel#Integer+) instead of the more
# lenient +#to_i+-style conversion methods used by default.
#
# NOTE: There is no strict Kernel method equivalent for +Symbol+, so
# +Symbol+ coercion is left to the default, lenient +#to_sym+ behavior.
#
# pkg:gem/hashie#lib/hashie/extensions/kernel_coercion.rb:22
Hashie::Extensions::KernelCoercion::STRICT_CORE_TYPES = T.let(T.unsafe(nil), Hash)

# @example Disable conflict warnings on a Mash subclass
#   klass = Class.new(Hashie::Mash)
#   klass.disable_warnings(:size)
#   klass.disable_warnings?(:size) # => true
#   klass.disable_warnings?(:keys) # => false
#
# pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:10
module Hashie::Extensions::KeyConflictWarning
  # Disable the logging of warnings based on keys conflicting keys/methods
  #
  # @api semipublic
  # @return [void]
  # @example Disable warnings for selected methods
  #   klass = Class.new(Hashie::Mash)
  #   klass.disable_warnings(:size, :keys)
  #   klass.disabled_warnings # => [:size, :keys]
  #
  # pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:36
  def disable_warnings(*method_keys); end

  # Checks whether this class disables warnings for conflicting keys/methods
  #
  # @api semipublic
  # @return [Boolean]
  # @example Disable all warnings when no methods are specified
  #   klass = Class.new(Hashie::Mash)
  #   klass.disable_warnings
  #   klass.disable_warnings?(:size) # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:56
  def disable_warnings?(method_key = T.unsafe(nil)); end

  # Returns an array of methods that this class disables warnings for.
  #
  # @api semipublic
  # @return [Array<Symbol>]
  # @example Inspect selected warning exclusions
  #   klass = Class.new(Hashie::Mash)
  #   klass.disable_warnings(:size)
  #   klass.disabled_warnings # => [:size]
  #
  # pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:70
  def disabled_warnings; end

  # Inheritance hook that sets class configuration when inherited.
  #
  # @api semipublic
  # @return [void]
  # @example Inherit selected warning settings
  #   parent = Class.new(Hashie::Mash)
  #   parent.disable_warnings(:size)
  #   child = Class.new(parent)
  #   child.disabled_warnings # => [:size]
  #   child.disable_warnings?(:keys) # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:84
  def inherited(subclass); end
end

# @example Explain why base Mash warnings cannot be disabled
#   require 'hashie/mash'
#   error = Hashie::Extensions::KeyConflictWarning::CannotDisableMashWarnings.new
#   error.message.include?('please subclass the Mash') # => true
#
# pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:15
class Hashie::Extensions::KeyConflictWarning::CannotDisableMashWarnings < ::StandardError
  # @example Construct the warning configuration error
  #   require 'hashie/mash'
  #   error = Hashie::Extensions::KeyConflictWarning::CannotDisableMashWarnings.new
  #   error.message # => 'you cannot disable warnings on the base Mash class; please subclass the Mash and disable it in the subclass'
  #
  # pkg:gem/hashie#lib/hashie/extensions/key_conflict_warning.rb:20
  def initialize; end
end

# @example Include both key conversion extensions
#   class ConvertibleHash < Hash
#     include Hashie::Extensions::KeyConversion
#   end
#   hash = ConvertibleHash[:name, 'Ada']
#   hash.stringify_keys # => { 'name' => 'Ada' }
#   hash.stringify_keys!.symbolize_keys # => { name: 'Ada' }
#
# pkg:gem/hashie#lib/hashie/extensions/key_conversion.rb:12
module Hashie::Extensions::KeyConversion
  include ::Hashie::Extensions::SymbolizeKeys
  include ::Hashie::Extensions::StringifyKeys

  class << self
    # pkg:gem/hashie#lib/hashie/extensions/key_conversion.rb:13
    def included(base); end
  end
end

# Optional extensions for method-accessible hashes.
#
# @example Generate accessors for existing keys
#   mash = Hashie::Mash.new(name: 'Ada')
#   mash.extend(Hashie::Extensions::Mash::DefineAccessors)
#   mash.name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie.rb:83
module Hashie::Extensions::Mash; end

# Generates reusable methods as Mash properties are accessed.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::DefineAccessors
#   end
#   klass.new(name: 'Ada').name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:13
module Hashie::Extensions::Mash::DefineAccessors
  class << self
    # @example Install generated accessors on one Mash
    #   mash = Hashie::Mash.new(quantity: 2)
    #   mash.extend(Hashie::Extensions::Mash::DefineAccessors)
    #   mash.quantity # => 2
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:29
    def extended(obj); end

    # @example Install generated accessors on a subclass
    #   klass = Class.new(Hashie::Mash)
    #   klass.include(Hashie::Extensions::Mash::DefineAccessors)
    #   klass.new(quantity: 2).quantity # => 2
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:18
    def included(klass); end
  end
end

# A module of lazily generated accessors for a Mash class.
#
# @example
#   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
#   klass = Class.new(Hashie::Mash) { include accessors }
#   mash = klass.new(name: 'Ada')
#   accessors.define_reader('name', :name)
#   mash.name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:41
class Hashie::Extensions::Mash::DefineAccessors::Ext < ::Module
  # @example Generate a method on first access
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   klass.new(name: 'Ada').name # => 'Ada'
  #   accessors.instance_methods(false).include?(:name) # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:47
  def initialize; end

  # @example
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   accessors.define_initializing_reader('address', :address!)
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   mash = klass.new
  #   mash.address!.city = 'London'
  #   mash.address.city # => 'London'
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:123
  def define_initializing_reader(key, method_name); end

  # @example
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   accessors.define_predicate('name', :name?)
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   klass.new(name: 'Ada').name? # => true
  #   klass.new.name? # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:106
  def define_predicate(key, method_name); end

  # @example
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   mash = klass.new(name: 'Ada')
  #   accessors.define_reader('name', :name)
  #   mash.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:73
  def define_reader(key, method_name); end

  # @example
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   accessors.define_underbang_reader('address', :address_)
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   mash = klass.new
  #   mash.address_.city = 'London'
  #   mash.key?('address') # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:140
  def define_underbang_reader(key, method_name); end

  # @example
  #   accessors = Hashie::Extensions::Mash::DefineAccessors::Ext.new
  #   accessors.define_writer('name', :name=)
  #   klass = Class.new(Hashie::Mash) { include accessors }
  #   mash = klass.new
  #   mash.name = 'Ada'
  #   mash['name'] # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/define_accessors.rb:90
  def define_writer(key, method_name); end
end

# Overrides the indifferent access of a Mash to keep keys in the
# original format given to the Mash.
#
# @example
#   class KeepingMash < Hashie::Mash
#     include Hashie::Extensions::Mash::KeepOriginalKeys
#   end
#
#   mash = KeepingMash.new(:symbol_key => :symbol, 'string_key' => 'string')
#   mash.to_hash  #=> { :symbol_key => :symbol, 'string_key' => 'string' }
#   mash['string_key'] == mash[:string_key]  #=> true
#   mash[:symbol_key] == mash['symbol_key']  #=> true
#
# pkg:gem/hashie#lib/hashie/extensions/mash/keep_original_keys.rb:18
module Hashie::Extensions::Mash::KeepOriginalKeys
  private

  # Converts symbol/string keys to their alternative formats, but leaves
  # other keys alone.
  #
  # @param [Object, String, Symbol] key the key to convert.
  # @return [Object, String, Symbol] the converted key.
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/keep_original_keys.rb:47
  def __convert(key); end

  # Converts the key when necessary to access the correct Mash key.
  #
  # @param [Object, String, Symbol] key the key to access.
  # @return [Object] the value assigned to the key.
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/keep_original_keys.rb:35
  def convert_key(key); end

  class << self
    # @example Preserve symbol keys when including the extension
    #   klass = Class.new(Hashie::Mash) do
    #     include Hashie::Extensions::Mash::KeepOriginalKeys
    #   end
    #   klass.new(name: 'Ada').keys # => [:name]
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/keep_original_keys.rb:24
    def included(descendant); end
  end
end

# Allow a Mash to properly respond to everything
#
# By default, Mashes only say they respond to methods for keys that exist
# in their key set or any of the affix methods (e.g. setter, underbang,
# etc.). This causes issues when you try to use them within a
# SimpleDelegator or bind to a method for a key that is unset.
#
# This extension allows a Mash to properly respond to `respond_to?` and
# `method` for keys that have not yet been set. This enables full
# compatibility with SimpleDelegator and thunk-oriented programming.
#
# There is a trade-off with this extension: it will run slower than a
# regular Mash; insertions and initializations with keys run approximately
# 20% slower and cost approximately 19KB of memory per class that you
# make permissive.
#
# @api public
# @example Make a new, permissively responding Mash subclass
#   class PermissiveMash < Hashie::Mash
#     include Hashie::Extensions::Mash::PermissiveRespondTo
#   end
#
#   mash = PermissiveMash.new(a: 1)
#   mash.respond_to? :b  #=> true
#
# pkg:gem/hashie#lib/hashie/extensions/mash/permissive_respond_to.rb:30
module Hashie::Extensions::Mash::PermissiveRespondTo
  private

  # Override the Mash logging behavior to account for permissiveness
  #
  # @api private
  # @private
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/permissive_respond_to.rb:55
  def log_collision?(method_key); end

  # The Ruby hook for determining what messages a class might respond to
  #
  # @api private
  # @private
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/permissive_respond_to.rb:45
  def respond_to_missing?(_method_name, _include_private = T.unsafe(nil)); end

  class << self
    # The Ruby hook for behavior when including the module
    #
    # @api private
    # @private
    # @return void
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/permissive_respond_to.rb:36
    def included(base); end
  end
end

# Extends a Mash with the ability to require specific keys to be
# set (non-nil) when constructed, while still allowing arbitrary,
# undeclared keys to be assigned - unlike Hashie::Dash, which
# restricts assignment to only pre-declared properties.
#
# @example
#
#   class PersonMash < Hashie::Mash
#     include Hashie::Extensions::Mash::RequiredKeys
#
#     required_keys :name, :email
#   end
#
#   expect { PersonMash.new(email: 'bob@example.com') }
#     .to raise_error(ArgumentError, 'the following keys are required: `name`')
#
#   person = PersonMash.new(name: 'Bob', email: 'bob@example.com')
#   person.age = 42 # arbitrary, undeclared keys are still allowed
#   person.age # => 42
#
# pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:25
module Hashie::Extensions::Mash::RequiredKeys
  include ::Hashie::Extensions::Mash::RequiredKeys::InstanceMethods

  mixes_in_class_methods ::Hashie::Extensions::Mash::RequiredKeys::ClassMethods

  class << self
    # @example Install required-key declarations
    #   klass = Class.new(Hashie::Mash) do
    #     include Hashie::Extensions::Mash::RequiredKeys
    #   end
    #   klass.required_keys # => []
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:31
    def included(base); end
  end
end

# Class-level required-key declarations inherited by subclasses.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::RequiredKeys
#     required_keys :name
#   end
#   klass.required_keys # => ['name']
#
# pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:45
module Hashie::Extensions::Mash::RequiredKeys::ClassMethods
  # @example Copy required keys when subclassing
  #   parent = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::RequiredKeys
  #     required_keys :name
  #   end
  #   child = Class.new(parent)
  #   child.required_keys :email
  #   child.required_keys # => ['name', 'email']
  #   parent.required_keys # => ['name']
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:55
  def inherited(klass); end

  # With no arguments, returns the keys currently declared as
  # required. With one or more arguments, declares those keys
  # as required. Keys are stored and compared as strings, so
  # both symbol and string keys are accepted.
  #
  # @example
  #   klass = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::RequiredKeys
  #     required_keys :name, 'email', :name
  #   end
  #   klass.required_keys # => ['name', 'email']
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:71
  def required_keys(*keys); end
end

# Checks required values when constructing a Mash.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::RequiredKeys
#     required_keys :name
#   end
#   klass.new(name: 'Ada').name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:86
module Hashie::Extensions::Mash::RequiredKeys::InstanceMethods
  # @example Reject nil or missing required values
  #   klass = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::RequiredKeys
  #     required_keys :name
  #   end
  #   expect { klass.new(name: nil) }.to raise_error(ArgumentError, /name/)
  #   klass.new(name: 'Ada', age: 37).age # => 37
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:94
  def initialize(*args, &block); end

  private

  # pkg:gem/hashie#lib/hashie/extensions/mash/required_keys.rb:101
  def assert_required_keys_set!; end
end

# Rejects assignments that would shadow existing Mash methods.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::SafeAssignment
#   end
#   mash = klass.new
#   expect { mash[:size] = 2 }.to raise_error(ArgumentError, /clashes/)
#   mash.empty? # => true
#
# pkg:gem/hashie#lib/hashie/extensions/mash/safe_assignment.rb:15
module Hashie::Extensions::Mash::SafeAssignment
  # @example
  #   klass = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::SafeAssignment
  #   end
  #   mash = klass.new
  #   mash[:name] = 'Ada'
  #   mash.name # => 'Ada'
  #   expect { mash[:size] = 2 }.to raise_error(ArgumentError, /clashes/)
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/safe_assignment.rb:30
  def []=(*args); end

  # pkg:gem/hashie#lib/hashie/extensions/mash/safe_assignment.rb:16
  def custom_writer(key, *args); end
end

# Overrides Mash's default behavior of returning nil for keys that
# aren't set, raising a KeyError instead.
#
# Unlike Hashie::Extensions::StrictKeyAccess, this extension is aware
# of Mash's special suffixed methods (e.g. +?+, +!+, +_+ and +=+) so
# that they continue to work as expected instead of always raising.
#
# Because nested Hashes are converted into instances of +self.class+,
# this extension is automatically applied to any nested Mash as well.
#
# @example
#   class StrictMash < Hashie::Mash
#     include Hashie::Extensions::Mash::StrictKeyAccess
#   end
#
#   mash = StrictMash.new(name: 'Bob')
#   mash.name  #=> 'Bob'
#   expect { mash.age }.to raise_error(KeyError, 'key not found: `age`')
#
#   mash.name? #=> true
#   mash.age?  #=> false
#
#   mash.address!.city = 'Springfield'
#   mash.address.city  #=> 'Springfield'
#
# @api public
#
# pkg:gem/hashie#lib/hashie/extensions/mash/strict_key_access.rb:32
module Hashie::Extensions::Mash::StrictKeyAccess
  # @api private
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/strict_key_access.rb:44
  def method_missing(method_name, *args, &blk); end

  private

  # @api private
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/strict_key_access.rb:54
  def respond_to_missing?(method_name, *args); end

  class << self
    # Hook for being included in a class
    #
    # @api private
    # @return [void]
    # @raise [ArgumentError] when the base class isn't a Mash
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/strict_key_access.rb:38
    def included(descendant); end
  end
end

# Overrides Mash's default behavior of converting keys to strings
#
# @example
#   class LazyResponse < Hashie::Mash
#     include Hashie::Extensions::Mash::SymbolizeKeys
#   end
#
#   response = LazyResponse.new("id" => 123, "name" => "Rey").to_h
#   response # => {id: 123, name: "Rey"}
#
# @api public
#
# pkg:gem/hashie#lib/hashie/extensions/mash/symbolize_keys.rb:17
module Hashie::Extensions::Mash::SymbolizeKeys
  private

  # Converts a key to a symbol, if possible
  #
  # @api private
  # @param [<K>] key the key to attempt convert to a symbol
  # @return [Symbol, K]
  #
