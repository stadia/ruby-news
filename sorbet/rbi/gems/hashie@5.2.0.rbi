#   klass.new(name: 'Ada')['name'] # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/dash/indifferent_access.rb:14
module Hashie::Extensions::Dash::IndifferentAccess
  mixes_in_class_methods ::Hashie::Extensions::Dash::IndifferentAccess::ClassMethods

  # @example Include defaults under string keys in the returned hash
  #   klass = Class.new(Hashie::Dash) do
  #     include Hashie::Extensions::Dash::IndifferentAccess
  #     property :name, default: 'Ada'
