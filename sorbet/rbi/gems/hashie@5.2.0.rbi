# @example Add version checks to a class
#   klass = Class.new { include Hashie::Extensions::RubyVersionCheck }
#   klass.with_minimum_ruby?('0.0.0') # => true
#   klass.with_minimum_ruby?('999.0.0') # => false
#
# pkg:gem/hashie#lib/hashie/extensions/ruby_version_check.rb:19
module Hashie::Extensions::RubyVersionCheck::ClassMethods
  # @example Run the block only when the minimum is satisfied
  #   klass = Class.new { include Hashie::Extensions::RubyVersionCheck }
  #   klass.with_minimum_ruby('0.0.0') { 'supported' } # => 'supported'
  #   klass.with_minimum_ruby('999.0.0') { raise 'not reached' } # => nil
  #
  # pkg:gem/hashie#lib/hashie/extensions/ruby_version_check.rb:24
  def with_minimum_ruby(version); end

  # @example Accept the current version as a minimum
  #   klass = Class.new { include Hashie::Extensions::RubyVersionCheck }
  #   klass.with_minimum_ruby?(RUBY_VERSION) # => true
  #   klass.with_minimum_ruby?('999.0.0') # => false
  #
  # pkg:gem/hashie#lib/hashie/extensions/ruby_version_check.rb:32
  def with_minimum_ruby?(version); end
end

# SRP: This extension will fail an error whenever a key is accessed
#   that does not exist in the hash.
#
#   EXAMPLE:
#
#     class StrictKeyAccessHash < Hash
#       include Hashie::Extensions::StrictKeyAccess
#     end
#
#     >> hash = StrictKeyAccessHash[foo: "bar"]
#     => {:foo=>"bar"}
#     >> hash[:foo]
#     => "bar"
#     >> hash[:cow]
#       KeyError: key not found: :cow
#
# NOTE: For googlers coming from Python to Ruby, this extension makes a Hash
# behave more like a "Dictionary".
#
# @example Raise on missing keys
#   hash = { name: 'Ada' }.extend(Hashie::Extensions::StrictKeyAccess)
#   hash[:name] # => 'Ada'
#   expect { hash[:missing] }.to raise_error(KeyError)
#
# pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:28
module Hashie::Extensions::StrictKeyAccess
  # NOTE: Defaults don't make any sense with a StrictKeyAccess.
  # NOTE: When key lookup fails a KeyError is raised.
  #
  # Normal:
  #
  #     >> a = Hash.new(123)
  #     => {}
  #     >> a["noes"]
  #     => 123
  #
  # With StrictKeyAccess:
  #
  #     >> a = StrictKeyAccessHash.new(123)
  #     => {}
  #     >> a["noes"]
  #       KeyError: key not found: "noes"
  #
  # @example Fetch an existing value without a default fallback
  #   hash = { name: 'Ada' }.extend(Hashie::Extensions::StrictKeyAccess)
  #   hash[:name] # => 'Ada'
  #   expect { hash[:missing] }.to raise_error(KeyError)
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:64
  def [](key); end

  # @example Reject reading the default value
  #   hash = {}.extend(Hashie::Extensions::StrictKeyAccess)
  #   error_class = begin
  #     hash.default
  #   rescue Hashie::Extensions::StrictKeyAccess::DefaultError => error
  #     error.class
  #   end
  #   error_class # => Hashie::Extensions::StrictKeyAccess::DefaultError
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:76
  def default(_ = T.unsafe(nil)); end

  # @example Reject assigning a default value
  #   hash = {}.extend(Hashie::Extensions::StrictKeyAccess)
  #   rejected = begin
  #     hash.default = 'unknown'
  #     false
  #   rescue Hashie::Extensions::StrictKeyAccess::DefaultError
  #     true
  #   end
  #   rejected # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:89
  def default=(_); end

  # @example Reject reading a default proc
  #   hash = {}.extend(Hashie::Extensions::StrictKeyAccess)
  #   rejected = begin
  #     hash.default_proc
  #     false
  #   rescue Hashie::Extensions::StrictKeyAccess::DefaultError
  #     true
  #   end
  #   rejected # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:102
  def default_proc; end

  # @example Reject assigning a default proc
  #   hash = {}.extend(Hashie::Extensions::StrictKeyAccess)
  #   rejected = begin
  #     hash.default_proc = ->(_hash, _key) { 'unknown' }
  #     false
  #   rescue Hashie::Extensions::StrictKeyAccess::DefaultError
  #     true
  #   end
  #   rejected # => true
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:115
  def default_proc=(_); end

  # @example Find an existing key and reject missing values
  #   hash = { name: 'Ada', nil => false }.extend(Hashie::Extensions::StrictKeyAccess)
  #   hash.key('Ada') # => :name
  #   hash.key(false) # => nil
  #   expect { hash.key('Grace') }.to raise_error(KeyError)
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:124
  def key(value); end
end

# @example Explain why defaults are unsupported
#   error = Hashie::Extensions::StrictKeyAccess::DefaultError.new
#   error.message # => 'Setting or using a default with Hashie::Extensions::StrictKeyAccess does not make sense'
#
# pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:32
class Hashie::Extensions::StrictKeyAccess::DefaultError < ::StandardError
  # @example Construct a default-access error
  #   error = Hashie::Extensions::StrictKeyAccess::DefaultError.new
  #   error.message # => 'Setting or using a default with Hashie::Extensions::StrictKeyAccess does not make sense'
  #
  # pkg:gem/hashie#lib/hashie/extensions/strict_key_access.rb:36
  def initialize; end
end

# Extends a Hash with the ability to convert its keys to strings.
#
# @example Extend a pre-existing Hash object
#   hash = { test: 'value' }
#   hash.extend(Hashie::Extensions::StringifyKeys)
#   hash.stringify_keys!
#   hash # => { 'test' => 'value' }
#
# @example Create a Hash class with this capability
#   class StringifyingHash < Hash
#     include Hashie::Extensions::StringifyKeys
#   end
#
#   hash = StringifyingHash.new
#   hash[:test] = 'value'
#   hash.stringify_keys!
#   hash # => { 'test' => 'value' }
#
# @example Use the module function to stringify keys in a hash
#   hash = { test: 'value' }
#   Hashie::Extensions::StringifyKeys.stringify_keys!(hash)
#   hash # => { 'test' => 'value' }
#
# pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:27
module Hashie::Extensions::StringifyKeys
  extend ::Hashie::Extensions::StringifyKeys::ClassMethods

  # Returns a shallow copy with all keys recursively converted to strings.
  # Nested hashes and arrays are shared with the original and are modified.
  #
  # @example Copy a flat hash without modifying the original
  #   test = { abc: 'def' }
  #   test.extend(Hashie::Extensions::StringifyKeys)
  #   test.stringify_keys # => { 'abc' => 'def' }
  #   test # => { abc: 'def' }
  #
  # @example Nested values are shared, not deep copied
  #   test = { abc: [{ def: 'value' }] }
  #   test.extend(Hashie::Extensions::StringifyKeys)
  #   test.stringify_keys # => { 'abc' => [{ 'def' => 'value' }] }
  #   test # => { abc: [{ 'def' => 'value' }] }
  #
  # @api public
  # @return [Hash] a shallow copy with stringified keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:60
  def stringify_keys; end

  # Converts all keys in the hash and nested hashes and arrays to strings.
  #
  # @example Convert keys in place
  #   test = { abc: [{ def: 'value' }] }
  #   test.extend(Hashie::Extensions::StringifyKeys)
  #   test.stringify_keys!
  #   test # => { 'abc' => [{ 'def' => 'value' }] }
  #
  # @api public
  # @return [Hash] the receiver with its keys converted to strings
  #
  # pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:38
  def stringify_keys!; end
end

# @example Add recursive conversion functions to an object
#   converter = Object.new.extend(Hashie::Extensions::StringifyKeys::ClassMethods)
#   converter.stringify_keys(user: { name: 'Ada' }) # => { 'user' => { 'name' => 'Ada' } }
#
# pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:67
module Hashie::Extensions::StringifyKeys::ClassMethods
  # Returns a shallow copy of a hash with recursively stringified keys.
  # Nested hashes and arrays are shared with the original and are modified.
  #
  # @example Copy keys through Hashie's module function
  #   test = { abc: 'def' }
  #   Hashie.stringify_keys(test) # => { 'abc' => 'def' }
  #   test # => { abc: 'def' }
  #
  # @api public
  # @param [Hash] hash
  # @return [Hash] a shallow copy with stringified keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:112
  def stringify_keys(hash); end

  # Converts all keys in a hash recursively to strings, in place.
  #
  # @example Convert keys through Hashie's module function
  #   test = { abc: 'def' }
  #   Hashie.stringify_keys!(test)
  #   test # => { 'abc' => 'def' }
  #
  # @api public
  # @param [Hash] hash
  # @return [Hash] the passed hash with stringified keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:92
  def stringify_keys!(hash); end

  # Stringify all keys recursively within nested
  # hashes and arrays.
  # @api private
  #
  # pkg:gem/hashie#lib/hashie/extensions/stringify_keys.rb:71
  def stringify_keys_recursively!(object); end
end

# Extends a Hash with the ability to convert its keys to symbols.
# Keys that do not respond to #to_sym are preserved.
#
# @example Extend a pre-existing Hash object
#   hash = { 'test' => 'value' }
#   hash.extend(Hashie::Extensions::SymbolizeKeys)
#   hash.symbolize_keys!
#   hash # => { test: 'value' }
#
# @example Create a Hash class with this capability
#   class SymbolizableHash < Hash
#     include Hashie::Extensions::SymbolizeKeys
#   end
#
#   hash = SymbolizableHash.new
#   hash['test'] = 'value'
#   hash.symbolize_keys!
#   hash # => { test: 'value' }
#
# @example Use the module function to symbolize keys in a hash
#   hash = { 'test' => 'value', 123 => 'number' }
#   Hashie::Extensions::SymbolizeKeys.symbolize_keys!(hash)
#   hash # => { test: 'value', 123 => 'number' }
#
# pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:28
module Hashie::Extensions::SymbolizeKeys
  extend ::Hashie::Extensions::SymbolizeKeys::ClassMethods

  # Returns a shallow copy with keys recursively converted to symbols.
  # Nested hashes and arrays are shared with the original and are modified.
  #
  # @example Copy a flat hash without modifying the original
  #   test = { 'abc' => 'def' }
  #   test.extend(Hashie::Extensions::SymbolizeKeys)
  #   test.symbolize_keys # => { abc: 'def' }
  #   test # => { 'abc' => 'def' }
  #
  # @example Nested values are shared, not deep copied
  #   test = { 'abc' => [{ 'def' => 'value' }] }
  #   test.extend(Hashie::Extensions::SymbolizeKeys)
  #   test.symbolize_keys # => { abc: [{ def: 'value' }] }
  #   test # => { 'abc' => [{ def: 'value' }] }
  #
  # @api public
  # @return [Hash] a shallow copy with symbolized keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:61
  def symbolize_keys; end

  # Converts keys in the hash and nested hashes and arrays to symbols.
  #
  # @example Convert keys in place
  #   test = { 'abc' => [{ 'def' => 'value' }] }
  #   test.extend(Hashie::Extensions::SymbolizeKeys)
  #   test.symbolize_keys!
  #   test # => { abc: [{ def: 'value' }] }
  #
  # @api public
  # @return [Hash] the receiver with its keys symbolized where possible
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:39
  def symbolize_keys!; end
end

# @example Add recursive conversion functions to an object
#   converter = Object.new.extend(Hashie::Extensions::SymbolizeKeys::ClassMethods)
#   converter.symbolize_keys('user' => { 'name' => 'Ada' }) # => { user: { name: 'Ada' } }
#
# pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:68
module Hashie::Extensions::SymbolizeKeys::ClassMethods
  # Returns a shallow copy of a hash with recursively symbolized keys.
  # Nested hashes and arrays are shared with the original and are modified.
  #
  # @example Copy keys through Hashie's module function
  #   test = { 'abc' => 'def' }
  #   Hashie.symbolize_keys(test) # => { abc: 'def' }
  #   test # => { 'abc' => 'def' }
  #
  # @api public
  # @param [Hash] hash
  # @return [Hash] a shallow copy with symbolized keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:113
  def symbolize_keys(hash); end

  # Converts keys in a hash recursively to symbols, in place.
  #
  # @example Convert keys through Hashie's module function
  #   test = { 'abc' => 'def' }
  #   Hashie.symbolize_keys!(test)
  #   test # => { abc: 'def' }
  #
  # @api public
  # @param [Hash] hash
  # @return [Hash] the passed hash with symbolized keys
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:93
  def symbolize_keys!(hash); end

  # Symbolize all keys recursively within nested
  # hashes and arrays.
  # @api private
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:72
  def symbolize_keys_recursively!(object); end

  private

  # Converts a key to a symbol, if possible
  #
  # @api private
  # @param [<K>] key the key to attempt convert to a symbol
  # @return [Symbol, K]
  #
  # pkg:gem/hashie#lib/hashie/extensions/symbolize_keys.rb:128
  def convert_key(key); end
end

# A Hashie Hash is simply a Hash that has convenience
# functions baked in such as stringify_keys that may
# not be available in all libraries.
#
# @example Convert keys using the built-in extensions
#   Hashie::Hash[name: 'Ada'].stringify_keys # => { 'name' => 'Ada' }
#
# pkg:gem/hashie#lib/hashie/hash.rb:13
class Hashie::Hash < ::Hash
  include ::Hashie::Extensions::PrettyInspect
  include ::Hashie::Extensions::StringifyKeys

  # pkg:gem/hashie#lib/hashie/hash.rb:14
  def hash_inspect; end

  # pkg:gem/hashie#lib/hashie/hash.rb:14
  def inspect; end

  # Converts a mash back to a hash (with stringified or symbolized keys)
  #
  # @example Recursively convert nested hashes and their keys
  #   hash = Hashie::Hash[user: Hashie::Hash[name: 'Ada']]
  #   hash.to_hash(stringify_keys: true) # => { 'user' => { 'name' => 'Ada' } }
  #
  # pkg:gem/hashie#lib/hashie/hash.rb:30
  def to_hash(options = T.unsafe(nil)); end

  # The C generator for the json gem doesn't like mashies
  #
  # @example Serialize as an ordinary JSON object
  #   require 'json'
  #   JSON.parse(Hashie::Hash[name: 'Ada'].to_json) # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/hash.rb:58
  def to_json(*args); end

  # Convert this hash into a Mash
  #
  # @example Read converted data through methods
  #   Hashie::Hash[name: 'Ada'].to_mash.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/hash.rb:21
  def to_mash; end

  private

  # pkg:gem/hashie#lib/hashie/hash.rb:70
  def flexibly_convert_to_hash(object, options = T.unsafe(nil)); end

  # pkg:gem/hashie#lib/hashie/hash.rb:64
  def maybe_convert_to_hash(object, options); end
end

# Mash allows you to create pseudo-objects that have method-like
# accessors for hash keys. This is useful for such implementations
# as an API-accessing library that wants to fake robust objects
# without the overhead of actually doing so. Think of it as OpenStruct
# with some additional goodies.
#
# A Mash will look at the methods you pass it and perform operations
# based on the following rules:
#
# * No punctuation: Returns the value of the hash for that key, or nil if none exists.
# * Assignment (`=`): Sets the attribute of the given method name.
# * Truthiness (`?`): Returns true or false depending on the truthiness of
#   the attribute, or false if the key is not set.
# * Bang (`!`): Forces the existence of this key, used for deep Mashes. Think of it
#   as "touch" for mashes.
# * Under Bang (`_`): Like Bang, but returns a new Mash rather than creating a key.
#   Used to test existence in deep Mashes.
#
# == Basic Example
#
#   mash = Mash.new
#   mash.name? # => false
#   mash.name = "Bob"
#   mash.name # => "Bob"
#   mash.name? # => true
#
# == Hash Conversion  Example
#
#   hash = {:a => {:b => 23, :d => {:e => "abc"}}, :f => [{:g => 44, :h => 29}, 12]}
#   mash = Mash.new(hash)
#   mash.a.b # => 23
#   mash.a.d.e # => "abc"
#   mash.f.first.g # => 44
#   mash.f.last # => 12
#
# == Bang Example
#
#   mash = Mash.new
#   mash.author # => nil
#   mash.author! # => <Mash>
#
#   mash = Mash.new
#   mash.author!.name = "Michael Bleigh"
#   mash.author # => <Mash name="Michael Bleigh">
#
# == Under Bang Example
#
#   mash = Mash.new
#   mash.author # => nil
#   mash.author_ # => <Mash>
#   mash.author_.name # => nil
#
#   mash = Mash.new
#   mash.author_.name = "Michael Bleigh"  (assigned to temp object)
#   mash.author # => <Mash>
#
# @example Read nested hashes through method access
#   mash = Hashie::Mash.new(author: { name: 'Ada' })
#   mash.author.name # => 'Ada'
#   mash.missing? # => false
#
# pkg:gem/hashie#lib/hashie/mash.rb:70
class Hashie::Mash < ::Hashie::Hash
  include ::Hashie::Extensions::ActiveSupport::CoreExt::Hash
  extend ::Hashie::Extensions::KeyConflictWarning

  # If you pass in an existing hash, it will
  # convert it to a Mash including recursively
  # descending into arrays and hashes, converting
  # them as well.
  #
  # @example Recursively convert hashes nested in arrays
  #   mash = Hashie::Mash.new(users: [{ name: 'Ada' }])
  #   mash.users.first.name # => 'Ada'
  #   mash.users.class # => Hashie::Array
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:138
  def initialize(source_hash = T.unsafe(nil), default = T.unsafe(nil), &blk); end

  # @example Read symbol and string keys interchangeably
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash[:name] # => 'Ada'
  #   mash['name'] # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:213
  def [](key); end

  # @example Convert assigned hashes to nested Mashes
  #   mash = Hashie::Mash.new
  #   mash[:user] = { name: 'Ada' }
  #   mash.user.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:219
  def []=(key, value, convert = T.unsafe(nil)); end

  # Assigns a value to a key
  #
  # @example Assign a property by name
  #   mash = Hashie::Mash.new
  #   mash.assign_property(:name, 'Ada')
  #   mash.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:430
  def assign_property(name, value); end

  # Returns a new instance of the class it was called on, with nil values
  # removed.
  #
  # @example Remove nils while preserving false
  #   Hashie::Mash.new(name: nil, active: false).compact.to_hash # => { 'active' => false }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:556
  def compact; end

  # Retrieves an attribute set in the Mash. Will convert a key passed in
  # as a symbol to a string before retrieving.
  #
  # @example Read a symbol key and yield the result
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   observed = []
  #   mash.custom_reader(:name) { |value| observed << value } # => 'Ada'
  #   observed # => ['Ada']
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:188
  def custom_reader(key); end

  # Sets an attribute in the Mash. Symbol keys will be converted to
  # strings before being set, and Hashes will be converted into Mashes
  # for nesting purposes.
  #
  # @example Normalize assigned keys and recursively convert values
  #   mash = Hashie::Mash.new
  #   mash.custom_writer(:user, { name: 'Ada' })
  #   mash.keys # => ['user']
  #   mash.user.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:204
  def custom_writer(key, value, convert = T.unsafe(nil)); end

  # Performs a deep_update on a duplicate of the
  # current mash.
  #
  # @example Recursively merge without modifying the receiver
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   merged = mash.deep_merge(user: { age: 36 })
  #   merged.user.to_hash # => { 'name' => 'Ada', 'age' => 36 }
  #   mash.user.key?(:age) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:365
  def deep_merge(*other_hashes, &blk); end

  # @example Recursively merge into the receiver
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   mash.deep_merge!(user: { age: 36 })
  #   mash.user.to_hash # => { 'name' => 'Ada', 'age' => 36 }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:395
  def deep_merge!(*other_hashes, &blk); end

  # Recursively merges this mash with the passed
  # in hash, merging each hash in the hierarchy.
  #
  # @example Update nested values in place with conflict resolution
  #   mash = Hashie::Mash.new(user: { visits: 2 })
  #   mash.deep_update(user: { visits: 3 }) { |_key, old, new| old + new }
  #   mash.user.visits # => 5
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:376
  def deep_update(*other_hashes, &blk); end

  # @example Delete a string-backed key using a symbol
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.delete(:name) # => 'Ada'
  #   mash.empty? # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:262
  def delete(key); end

  # @example Traverse nested Mashes with symbol keys
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   mash.dig(:user, :name) # => 'Ada'
  #   mash.dig(:missing, :name) # => nil
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:539
  def dig(*keys); end

  # Duplicates the current mash as a new mash.
  #
  # @example Duplicate nested Mashes independently
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   copy = mash.dup
  #   copy.user.name = 'Grace'
  #   mash.user.name # => 'Ada'
  #   copy.user.name # => 'Grace'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:326
  def dup; end

  # @example Exclude symbol keys from a copy
  #   mash = Hashie::Mash.new(name: 'Ada', age: 36)
  #   mash.except(:age).to_hash # => { 'name' => 'Ada' }
  #   mash.age # => 36
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:579
  def except(*keys); end

  # play nice with ActiveSupport Array#extract_options!
  #
  # @example Identify a Mash as eligible for options extraction
  #   Hashie::Mash.new(name: 'Ada').extractable_options? # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:522
  def extractable_options?; end

  # @example Fetch symbol keys and supply a fallback for missing keys
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.fetch(:name) # => 'Ada'
  #   mash.fetch(:missing, 'unknown') # => 'unknown'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:254
  def fetch(key, *args); end

  # @example Test key presence even for a nil value
  #   Hashie::Mash.new(name: nil).has_key?(:name) # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:347
  def has_key?(key); end

  # @example Test membership with a symbol key
  #   Hashie::Mash.new(name: 'Ada').include?(:name) # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:351
  def include?(key); end

  # This is the bang method reader, it will return a new Mash
  # if there isn't a value already assigned to the key requested.
  #
  # @example Persist an initially empty nested Mash
  #   mash = Hashie::Mash.new
  #   mash.initializing_reader(:user).name = 'Ada'
  #   mash.user.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:228
  def initializing_reader(key); end

  # Returns a new instance of the class it was called on, using its keys as
  # values, and its values as keys. The new values and keys will always be
  # strings.
  #
  # @example Swap keys and values while retaining Mash behavior
  #   inverted = Hashie::Mash.new(name: :author).invert
  #   inverted.author # => 'name'
  #   inverted.class # => Hashie::Mash
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:280
  def invert; end

  # @example Recognize symbol and string versions of a key
  #   mash = Hashie::Mash.new(name: nil)
  #   mash.key?(:name) # => true
  #   mash.key?('name') # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:342
  def key?(key); end

  # @example Test membership with a string key
  #   Hashie::Mash.new(name: 'Ada').member?('name') # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:355
  def member?(key); end

  # Alias these lexically so they get the correctly defined
  # #deep_merge and #deep_update based on ruby version.
  #
  # @example Merge nested hashes into a copy
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   mash.merge(user: { age: 36 }).user.to_hash # => { 'name' => 'Ada', 'age' => 36 }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:389
  def merge(*other_hashes, &blk); end

  # @example Merge multiple hashes into the receiver
  #   mash = Hashie::Mash.new
  #   mash.merge!({ name: 'Ada' }, { age: 36 })
  #   mash.to_hash # => { 'name' => 'Ada', 'age' => 36 }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:408
  def merge!(*other_hashes, &blk); end

  # @example Use dynamic assignment, queries, and nested initialization
  #   mash = Hashie::Mash.new
  #   mash.user!.name = 'Ada'
  #   mash.user.name # => 'Ada'
  #   mash.user? # => true
  #   mash.missing_.empty? # => true
  #   mash.key?(:missing) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:500
  def method_missing(method_name, *args, &blk); end

  # @example Recognize suffix methods for existing keys
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.prefix_method?(:name?) # => true
  #   mash.prefix_method?(:missing?) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:488
  def prefix_method?(method_name); end

  # @example Make a shallow copy using the original Hash duplication
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   copy = mash.regular_dup
  #   copy.equal?(mash) # => false
  #   copy.user.equal?(mash.user) # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:311
  def regular_dup; end

  # @example Check the exact stored key without symbol conversion
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.regular_key?('name') # => true
  #   mash.regular_key?(:name) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:336
  def regular_key?(_arg0); end

  # @example Read stored string keys without key conversion
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.regular_reader('name') # => 'Ada'
  #   mash.regular_reader(:name) # => nil
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:171
  def regular_reader(_arg0); end

  # @example Store a value without recursively converting it
  #   mash = Hashie::Mash.new
  #   mash.regular_writer('user', { name: 'Ada' })
  #   mash['user'].class # => Hash
  #   mash['user'] # => { name: 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:178
  def regular_writer(_arg0, _arg1); end

  # Returns a new instance of the class it was called on, containing elements
  # for which the given block returns false.
  #
  # @example Remove selected entries from a copy
  #   mash = Hashie::Mash.new(name: 'Ada', age: 36)
  #   mash.reject { |key, _value| key == 'age' }.to_hash # => { 'name' => 'Ada' }
  #   mash.age # => 36
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:291
  def reject(&blk); end

  # @example Discard omitted attributes and convert replacement keys
  #   mash = Hashie::Mash.new(name: 'Ada', age: 36)
  #   mash.replace(name: 'Grace')
  #   mash.to_hash # => { 'name' => 'Grace' }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:462
  def replace(other_hash); end

  # another ActiveSupport method, see issue #270
  #
  # @example Supply defaults without overwriting existing values
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.reverse_merge(name: 'Grace', active: true).to_hash # => { 'name' => 'Ada', 'active' => true }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:531
  def reverse_merge(other_hash); end

  # Returns a new instance of the class it was called on, containing elements
  # for which the given block returns true.
  #
  # @example Keep matching entries in a new Mash
  #   selected = Hashie::Mash.new(name: 'Ada', age: 36).select { |key, _value| key == 'name' }
  #   selected.name # => 'Ada'
  #   selected.key?(:age) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:302
  def select(&blk); end

  # Performs a shallow_update on a duplicate of the current mash
  #
  # @example Replace a nested hash in a copy rather than merging it
  #   mash = Hashie::Mash.new(user: { name: 'Ada', age: 36 })
  #   mash.shallow_merge(user: { name: 'Grace' }).user.to_hash # => { 'name' => 'Grace' }
  #   mash.user.age # => 36
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:440
  def shallow_merge(other_hash); end

  # Merges (non-recursively) the hash from the argument,
  # changing the receiving hash
  #
  # @example Replace a nested value in place
  #   mash = Hashie::Mash.new(user: { name: 'Ada', age: 36 })
  #   mash.shallow_update(user: { name: 'Grace' })
  #   mash.user.to_hash # => { 'name' => 'Grace' }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:451
  def shallow_update(other_hash); end

  # @example Select keys with either symbol or string names
  #   Hashie::Mash.new(name: 'Ada', age: 36).slice(:name).to_hash # => { 'name' => 'Ada' }
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:562
  def slice(*keys); end

  # @example Expose a Mash from an included module
  #   settings = Hashie::Mash.new(name: 'Ada')
  #   klass = Class.new { include settings.to_module(:configuration) }
  #   klass.new.configuration.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:107
  def to_module(mash_method_name = T.unsafe(nil)); end

  # @example Inspect the Mash's attributes
  #   Hashie::Mash.new(name: 'Ada').to_s # => '#<Hashie::Mash name="Ada">'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:127
  def to_s; end

  # @example Transform keys into a new Mash
  #   transformed = Hashie::Mash.new(name: 'Ada').transform_keys(&:upcase)
  #   transformed['NAME'] # => 'Ada'
  #   transformed.class # => Hashie::Mash
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:571
  def transform_keys(&blk); end

  # @example Transform values into a new Mash
  #   transformed = Hashie::Mash.new(visits: 2).transform_values { |value| value * 3 }
  #   transformed.visits # => 6
  #   transformed.class # => Hashie::Mash
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:547
  def transform_values(&blk); end

  # This is the under bang method reader, it will return a temporary new Mash
  # if there isn't a value already assigned to the key requested.
  #
  # @example Read an absent branch without storing it
  #   mash = Hashie::Mash.new
  #   mash.underbang_reader(:user).empty? # => true
  #   mash.key?(:user) # => false
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:241
  def underbang_reader(key); end

  # @example Update the receiver with nested keys
  #   mash = Hashie::Mash.new(user: { name: 'Ada' })
  #   mash.update(user: { age: 36 })
  #   mash.user.age # => 36
  #   mash.user.name # => 'Ada'
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:402
  def update(*other_hashes, &blk); end

  # @example Retrieve multiple keys using either key form
  #   Hashie::Mash.new(name: 'Ada', age: 36).values_at(:name, 'age', :missing) # => ['Ada', 36, nil]
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:268
  def values_at(*keys); end

  # @example Generate real methods for existing keys
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.with_accessors!
  #   mash.name # => 'Ada'
  #   mash.method(:name).owner.instance_methods(false).include?(:name) # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:121
  def with_accessors!; end

  protected

  # Symbol#name returns the symbol's interned frozen string, where
  # Symbol#to_s allocates a new one on every read and write.
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:602
  def convert_key(key); end

  # pkg:gem/hashie#lib/hashie/mash.rb:608
  def convert_value(val, duping = T.unsafe(nil)); end

  # pkg:gem/hashie#lib/hashie/mash.rb:586
  def method_name_and_suffix(method_name); end

  # pkg:gem/hashie#lib/hashie/mash.rb:595
  def method_suffix(method_name); end

  private

  # pkg:gem/hashie#lib/hashie/mash.rb:410
  def _deep_update(other_hash, &blk); end

  # pkg:gem/hashie#lib/hashie/mash.rb:626
  def log_built_in_message(method_key); end

  # pkg:gem/hashie#lib/hashie/mash.rb:639
  def log_collision?(method_key); end

  # @example Discover dynamic readers and suffix methods
  #   mash = Hashie::Mash.new(name: 'Ada')
  #   mash.respond_to?(:name) # => true
  #   mash.respond_to?(:missing) # => false
  #   mash.respond_to?(:missing!) # => true
  #
  # pkg:gem/hashie#lib/hashie/mash.rb:473
  def respond_to_missing?(method_name, *args); end

  class << self
    # @example Construct a Mash with bracket notation
    #   Hashie::Mash[name: 'Ada'].name # => 'Ada'
    #
    # pkg:gem/hashie#lib/hashie/mash.rb:164
    def [](*_arg0); end

    # Loads a YAML file. The default parser evaluates ERB templates, so only
    # use this default with trusted files. Pass YamlParser to avoid ERB.
    #
    # @example Load and cache a frozen configuration from a YAML file
    #   require 'tempfile'
    #   file = Tempfile.new(['hashie-example', '.yml'], Dir.pwd)
    #   begin
    #     file.write("name: Ada\n")
    #     file.close
    #     settings = Hashie::Mash.load(file.path, parser: Hashie::Extensions::Parsers::YamlParser)
    #     settings.name # => 'Ada'
    #     settings.frozen? # => true
    #     File.write(file.path, "name: Grace\n")
    #     Hashie::Mash.load(file.path).to_hash # => { 'name' => 'Ada' }
    #   ensure
    #     file.close!
    #   end
    #
    # pkg:gem/hashie#lib/hashie/mash.rb:92
    def load(path, options = T.unsafe(nil)); end

    # Creates a new anonymous subclass with key conflict
    # warnings disabled. You may pass an array of method
    # symbols to restrict the disabled warnings to.
    # Hashie::Mash.quiet.new(hash) all warnings disabled.
    # Hashie::Mash.quiet(:zip).new(hash) only zip warning
    # is disabled.
    #
    # @example Disable warnings for a conflicting key on a subclass
    #   klass = Hashie::Mash.quiet(:zip)
    #   klass.new(zip: '12345')[:zip] # => '12345'
    #   klass.disable_warnings?(:zip) # => true
    #
    # pkg:gem/hashie#lib/hashie/mash.rb:154
    def quiet(*method_keys); end
  end
end

# pkg:gem/hashie#lib/hashie/mash.rb:73
Hashie::Mash::ALLOWED_SUFFIXES = T.let(T.unsafe(nil), Array)

# Hash's own readers, since a key like "default" can override them.
#
# pkg:gem/hashie#lib/hashie/mash.rb:314
Hashie::Mash::HASH_DEFAULT = T.let(T.unsafe(nil), UnboundMethod)

# pkg:gem/hashie#lib/hashie/mash.rb:315
Hashie::Mash::HASH_DEFAULT_PROC = T.let(T.unsafe(nil), UnboundMethod)

# pkg:gem/hashie#lib/hashie/railtie.rb:7
class Hashie::Railtie < ::Rails::Railtie; end

# Rash is a Hash whose keys can be Regexps, or Ranges, which will
# match many input keys.
#
# A good use case for this class is routing URLs in a web framework.
# The Rash's keys match URL patterns, and the values specify actions
# which can handle the URL. When the Rash's value is proc, the proc
# will be automatically called with the regexp's matched groups as
# block arguments.
#
# Usage example:
#
#     greeting = Hashie::Rash.new( /^Mr./ => "Hello sir!", /^Mrs./ => "Evening, madame." )
#     greeting["Mr. Steve Austin"] #=> "Hello sir!"
#     greeting["Mrs. Steve Austin"] #=> "Evening, madame."
#
# Note: The Rash is automatically optimized every 500 accesses
#       (Regexps get sorted by how often they get matched).
#       If this is too low or too high, you can tune it by
#       setting: `rash.optimize_every = n`
#
# @example Match strings and numbers using pattern keys
#   rash = Hashie::Rash.new(/^Mr\./ => 'Hello sir!', (1..5) => 'small')
#   rash['Mr. Austin'] # => 'Hello sir!'
#   rash[3] # => 'small'
#
# pkg:gem/hashie#lib/hashie/rash.rb:29
class Hashie::Rash
  # @example Initialize literal, regular-expression, and range keys
  #   rash = Hashie::Rash.new('home' => 'index', /^user/ => 'profile', (1..5) => 'small')
  #   rash['home'] # => 'index'
  #   rash['user/1'] # => 'profile'
  #   rash[2] # => 'small'
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:42
  def initialize(initial = T.unsafe(nil)); end

  # Return the first thing that matches the key.
  #
  # @example Prefer literal matches and return nil for missing keys
  #   rash = Hashie::Rash.new(/^user/ => 'profile', 'user/admin' => 'admin')
  #   rash['user/admin'] # => 'admin'
  #   rash['user/1'] # => 'profile'
  #   rash['missing'] # => nil
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:89
  def [](key); end

  # @example Assign a pattern with a callable value
  #   rash = Hashie::Rash.new
  #   rash[/^hello (.+)$/] = ->(match) { "Hello, #{match[1]}!" }
  #   rash['hello Ada'] # => 'Hello, Ada!'
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:70
  def []=(key, value); end

  # Return everything that matches the query.
  #
  # @example Enumerate all matching patterns
  #   rash = Hashie::Rash.new(/^user/ => 'profile', /admin$/ => 'admin')
  #   rash.all('user/admin').to_a # => ['profile', 'admin']
  #   values = []
  #   rash.all('user/admin') { |value| values << value }
  #   values # => ['profile', 'admin']
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:138
  def all(query); end

  # Raise (or yield) unless something matches the key.
  #
  # @example Fetch a match or compute a fallback
  #   rash = Hashie::Rash.new(/^user/ => 'profile')
  #   rash.fetch('user/1') # => 'profile'
  #   rash.fetch('missing', 'fallback') # => 'fallback'
  #   rash.fetch('missing') { |key| "unknown: #{key}" } # => 'unknown: missing'
  #
  # @example Raise for an unmatched key without a fallback
  #   error = begin
  #     Hashie::Rash.new.fetch('missing')
  #   rescue KeyError => exception
  #     exception
  #   end
  #   error.class # => KeyError
  #   error.message # => 'key not found: `"missing"`'
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:110
  def fetch(*args); end

  # @example Delegate ordinary hash operations to stored entries
  #   rash = Hashie::Rash.new('home' => 'index')
  #   rash.keys # => ['home']
  #   rash.size # => 1
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:182
  def method_missing(*, **, &); end

  # @example Configure the interval between regular-expression optimizations
  #   rash = Hashie::Rash.new
  #   rash.optimize_every # => 500
  #   rash.optimize_every = 10
  #   rash.optimize_every # => 10
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:35
  def optimize_every; end

  # @example Configure the interval between regular-expression optimizations
  #   rash = Hashie::Rash.new
  #   rash.optimize_every # => 500
  #   rash.optimize_every = 10
  #   rash.optimize_every # => 10
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:35
  def optimize_every=(_arg0); end

  # @example Add patterns and overwrite existing literal keys
  #   rash = Hashie::Rash.new('home' => 'old')
  #   rash.update('home' => 'index', /^user/ => 'profile')
  #   rash['home'] # => 'index'
  #   rash['user/1'] # => 'profile'
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:58
  def update(other); end

  private

  # pkg:gem/hashie#lib/hashie/rash.rb:196
  def optimize_if_necessary!; end

  # @example Advertise delegated hash operations
  #   rash = Hashie::Rash.new
  #   rash.respond_to?(:keys) # => true
  #   rash.respond_to?(:unknown_operation) # => false
  #
  # pkg:gem/hashie#lib/hashie/rash.rb:190
  def respond_to_missing?(method_name, _include_private = T.unsafe(nil)); end
end

# A Trash is a 'translated' Dash where the keys can be remapped from a source
# hash.
#
# Trashes are useful when you need to read data from another application,
# such as a Java api, where the keys are named differently from how we would
# in Ruby.
#
# @example Translate incoming property names
#   klass = Class.new(Hashie::Trash) do
#     property :first_name, from: :firstName
#   end
#   klass.new(firstName: 'Ada').first_name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/trash.rb:19
class Hashie::Trash < ::Hashie::Dash
  include ::Hashie::Extensions::Dash::PropertyTranslation
  include ::Hashie::Extensions::Dash::PropertyTranslation::InstanceMethods
  extend ::Hashie::Extensions::Dash::PropertyTranslation::ClassMethods
  extend ::Hashie::Extensions::DeepMerge
end

# A collection of helper methods that can be used throughout the gem.
#
# @example Duplicate mutable values safely
#   Hashie::Utils.safe_dup(['Ada']) # => ['Ada']
#
# pkg:gem/hashie#lib/hashie/utils.rb:8
module Hashie::Utils
  class << self
    # Lists the classes Ruby uses for integers
    #
    # @api private
    # @return [Array<Class>]
    #
    # pkg:gem/hashie#lib/hashie/utils.rb:51
    def integer_classes; end

    # Describes a method by where it was defined.
    #
    # @param bound_method [Method] The method to describe.
    # @return [String]
    #
    # @example Describe a built-in method
    #   Hashie::Utils.method_information('name'.method(:upcase)) # => 'defined in String'
    #
    # pkg:gem/hashie#lib/hashie/utils.rb:16
    def method_information(bound_method); end

    # Duplicates a value or returns the value when it is not duplicable
    #
    # @api public
    #
    # @param value [Object] the value to safely duplicate
    # @return [Object] the duplicated value
    #
    # @example Copy a mutable value without copying immutable symbols
    #   original = ['Ada']
    #   copy = Hashie::Utils.safe_dup(original)
    #   copy << 'Grace'
    #   original # => ['Ada']
    #   copy # => ['Ada', 'Grace']
    #   Hashie::Utils.safe_dup(:name) # => :name
    #
    # pkg:gem/hashie#lib/hashie/utils.rb:38
    def safe_dup(value); end
  end
end

# pkg:gem/hashie#lib/hashie/version.rb:4
Hashie::VERSION = T.let(T.unsafe(nil), String)
