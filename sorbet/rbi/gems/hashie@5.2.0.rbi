# pkg:gem/hashie#lib/hashie/extensions/coercion.rb:37
Hashie::Extensions::Coercion::ABSTRACT_CORE_TYPES = T.let(T.unsafe(nil), Hash)

# pkg:gem/hashie#lib/hashie/extensions/coercion.rb:28
Hashie::Extensions::Coercion::CORE_TYPES = T.let(T.unsafe(nil), Hash)

# @example Configure coercion rules on a hash subclass
#   class Record < Hash
#     include Hashie::Extensions::Coercion
#     coerce_key :count, Integer
#   end
#   Record.key_coercion(:count) # => Integer
#
# pkg:gem/hashie#lib/hashie/extensions/coercion.rb:131
module Hashie::Extensions::Coercion::ClassMethods
  # @example Build scalar and nested collection conversions
  #   klass = Class.new(Hash) { include Hashie::Extensions::Coercion }
  #   klass.build_coercion(Integer).call('3') # => 3
  #   klass.build_coercion([Integer]).call(['3', '4']) # => [3, 4]
