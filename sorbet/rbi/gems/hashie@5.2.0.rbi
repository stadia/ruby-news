  def convert_key(key); end

  class << self
    # Hook for being included in a class
    #
    # @api private
    # @return [void]
    # @raise [ArgumentError] when the base class isn't a Mash
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/symbolize_keys.rb:23
    def included(base); end
  end
end

# Applies a class-configured normalization to string and symbol Mash keys.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::TransformKeys
#     transform_keys_with(&:downcase)
#   end
#   klass.new('NAME' => 'Ada').name # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:14
module Hashie::Extensions::Mash::TransformKeys
  private

  # pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:74
  def convert_key(key); end

  class << self
    # @example Install class-level transformation configuration
    #   klass = Class.new(Hashie::Mash) do
    #     include Hashie::Extensions::Mash::TransformKeys
    #   end
    #   klass.key_transformer # => nil
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:20
    def included(base); end
  end
end

# Configures key normalization independently for each subclass.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::TransformKeys
#     transform_keys_with(&:downcase)
#   end
#   klass.new('NAME' => 'Ada')['name'] # => 'Ada'
#
# pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:34
module Hashie::Extensions::Mash::TransformKeys::ClassMethods
  # @example Inherit a transformer without sharing later configuration
  #   parent = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::TransformKeys
  #     transform_keys_with(&:downcase)
  #   end
  #   child = Class.new(parent)
  #   child.new('NAME' => 'Ada').name # => 'Ada'
  #   child.transform_keys_with(&:upcase)
  #   parent.new('NAME' => 'Ada').keys # => ['name']
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:44
  def inherited(klass); end

  # @example Read the configured callable
  #   klass = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::TransformKeys
  #     transform_keys_with(&:downcase)
  #   end
  #   klass.key_transformer.call('NAME') # => 'name'
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:69
  def key_transformer; end

  # @example Configure with a callable or a block
  #   klass = Class.new(Hashie::Mash) do
  #     include Hashie::Extensions::Mash::TransformKeys
  #     transform_keys_with(->(key) { key.downcase })
  #   end
  #   klass.new('NAME' => 'Ada').keys # => ['name']
  #   klass.transform_keys_with { |key| key.upcase }
  #   klass.new(name: 'Ada').keys # => ['NAME']
  #
  # pkg:gem/hashie#lib/hashie/extensions/mash/transform_keys.rb:57
  def transform_keys_with(callable = T.unsafe(nil), &block); end
end

# Normalizes camel-case and hyphenated Mash keys to lowercase underscores.
#
# @example
#   klass = Class.new(Hashie::Mash) do
#     include Hashie::Extensions::Mash::UnderscoreKeys
#   end
#   klass.new('firstName' => 'Ada', 'last-name' => 'Lovelace').to_h # => {'first_name' => 'Ada', 'last_name' => 'Lovelace'}
#
# pkg:gem/hashie#lib/hashie/extensions/mash/underscore_keys.rb:15
module Hashie::Extensions::Mash::UnderscoreKeys
  class << self
    # @example Configure underscore normalization on inclusion
    #   klass = Class.new(Hashie::Mash) do
    #     include Hashie::Extensions::Mash::UnderscoreKeys
    #   end
    #   klass.key_transformer.call('HTTPStatus') # => 'http_status'
    #
    # pkg:gem/hashie#lib/hashie/extensions/mash/underscore_keys.rb:21
    def included(base); end
  end
end

# The MergeInitializer is a super-simple mixin that allows
# you to initialize a subclass of Hash with another Hash
# to give you faster startup time for Hash subclasses. Note
# that you can still provide a default value as a second
# argument to the initializer.
#
# @example
#   class MyHash < Hash
#     include Hashie::Extensions::MergeInitializer
#   end
