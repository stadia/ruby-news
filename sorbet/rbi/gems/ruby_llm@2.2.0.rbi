  def hidden_associations_message(associations); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_column_guard.rb:29
  def hidden_by_ruby_llm?(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_column_guard.rb:33
  def hidden_columns_message(hidden); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_column_guard.rb:18
  def load_schema!; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_column_guard.rb:14
RubyLLM::ActiveRecord::ChatColumnGuard::OWNERS = T.let(T.unsafe(nil), Array)

# A file in a persisted chat's FileStore, in RubyLLM's
