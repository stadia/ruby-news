  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:83
  def render_content(content, attachments = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:37
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:33
  def render_role(role); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:70
  def render_thinking(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:99
  def render_video(video); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:75
  def supported_attachment?(attachment); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:47
    def apply_end_user(payload, identifier); end

    # Files uploaded to Z.ai are referenced by id; other documents are not inlined.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:109
    def document_attachments(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:31
    def finish_reasons; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:95
    def inline_video?(attachment); end

    # Z.ai caches prompt prefixes by itself and takes no cache controls.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:66
    def openai_prompt_caching?; end

    # Sources from the web_search tool arrive in a top-level web_search
    # array, on the last chunk when streaming.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:53
    def parse_root_citations(data); end

    # The GLM-5.3-Flash series is the one that reads files.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:25
    def reads_files?(model); end

    # The API fetches a remote PDF itself.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:104
    def remote_pdf?(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:83
    def render_content(content, attachments = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:37
    def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:33
    def render_role(role); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:70
    def render_thinking(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:99
    def render_video(video); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/zai/chat.rb:75
    def supported_attachment?(attachment); end
  end
end

