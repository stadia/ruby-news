# formats a message
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:450
class RubyLLM::Protocols::Gemini::Chat::MessageFormatter
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:451
  def initialize(provider, messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:459
  def format; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:526
  def build_standard_message(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:516
