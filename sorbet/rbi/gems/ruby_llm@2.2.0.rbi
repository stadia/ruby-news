    # missing them. The file goes in last, after provider options.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:23
    def render_transcription_payload(file_part, model:, language:, provider_options: T.unsafe(nil), temperature: T.unsafe(nil), **); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:16
    def transcription_url; end
  end
end

