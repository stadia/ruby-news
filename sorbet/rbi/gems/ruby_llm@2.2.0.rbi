  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/files.rb:55
  def start_resumable_upload(attachment, resource:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/files.rb:70
  def upload_file_bytes(upload_url, attachment); end
end

