  private

  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:76
  def run_rescue_handler(handler, exception); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:10
    def included(base); end
  end
end

# The class side of Rescuable.
#
# pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:15
