# AWS Bedrock integration.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:6
class RubyLLM::Providers::Bedrock < ::RubyLLM::Provider
  include ::RubyLLM::Providers::Bedrock::Auth
  include ::RubyLLM::Providers::Bedrock::Models

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:62
  def initialize(config); end

  # Uploads are objects in the configured bucket, readable with any
  # credentials the bucket admits.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:109
  def account_identity; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:119
  def agent_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:124
  def agent_connection; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:102
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:150
  def batch_cost_multiplier(**); end

  # Claude speaks the Anthropic Messages API through InvokeModel, which
  # keeps features Converse drops, such as tool search.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:82
  def claude_model?(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:114
  def control_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:156
  def embedding_batch_protocol(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:232
  def ensure_configured!; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:138
  def guardrail_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:134
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:152
  def invoke_model_batch_protocol(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:185
  def list_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:93
  def mantle_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:98
  def mantle_connection; end

  # Un-versioned ids such as anthropic.claude-sonnet-5 and
  # openai.gpt-oss-20b are served by the bedrock-mantle endpoint rather
  # than by Converse.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:89
  def mantle_model?(model_id); end

  # bedrock-mantle nests code, message, and type under "error" rather
  # than answering with a bare string.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:180
  def nested_error_message(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:163
  def parse_error(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:171
  def parse_error_code(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:67
  def protocol_for(model, operation: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:128
  def rerank_model_arn(model_id); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:273
  def anthropic_payload?(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:258
  def batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:281
  def bedrock_credentials_requirement; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:340
  def bedrock_model_id_pattern(prefix); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:277
  def bedrock_region; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:298
  def chat_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:264
  def embedding_batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:311
  def embedding_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:327
  def image_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:289
  def list_converse_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:293
  def list_mantle_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:304
  def mantle_protocol_for(model_id); end

  # Signs each attempt as it is sent, so a retry never replays a
  # signature that expired while the previous attempt waited.
  #
