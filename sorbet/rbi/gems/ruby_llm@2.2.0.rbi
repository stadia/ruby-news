# Streaming implementation for Bedrock ConverseStream (AWS Event Stream).
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:9
module RubyLLM::Protocols::Converse::Streaming
  include ::RubyLLM::Protocols::Bedrock::EventStream

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:35
  def build_chunk(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:259
  def event_block_index(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:72
  def event_usage(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:183
  def extract_tool_calls(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:123
  def finished_citation_blocks(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:265
  def normalized_delta(event); end

  # A citation delta arrives before the text it supports, so a block's
  # citations wait for the block to stop and take its span of the response.
  # A block still open when the message stops gives up what it has.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:107
  def parse_block_citations(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:88
  def parse_cache_read_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:92
  def parse_cache_write_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:100
  def parse_content_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:68
  def parse_finish_reason(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:79
  def parse_input_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:84
  def parse_output_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:96
  def parse_reasoning_tokens(metadata_usage, usage); end

  # Server-executed tool steps stream as typed toolUse and toolResult
  # block starts. Their input deltas are not function-call arguments,
  # so the block index is remembered and its deltas skipped.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:229
  def parse_server_tool_call_events(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:166
  def parse_signature_from_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:172
  def parse_signature_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:138
  def parse_thinking_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:149
  def parse_thinking_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:156
  def parse_thinking_signature(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:217
  def parse_tool_call_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:198
  def parse_tool_call_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:246
  def remember_server_tool_block(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:254
  def server_tool_block_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:18
  def stream_response(payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:14
  def stream_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:62
  def streamed_thinking_blocks(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:130
  def take_block_citations(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:194
  def tool_call_delta_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:190
  def tool_call_start_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:112
  def track_citation_block(event); end
end

