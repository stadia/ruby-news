  def mime_type; end

  # The template's name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:26
  def name; end

  # Asks the server to complete a variable's partial value. Pass one
  # variable to complete and any others that are already filled in.
  # Returns an Array of suggested values.
  #
  #   template.suggest(path: "app/mo")  # => ["app/models/"]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:89
  def suggest(**variables); end

  # A human-readable title, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:29
  def title; end

  # The URI template, such as <tt>"file:///{path}"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:23
  def uri; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:95
  def inspect_attributes; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:69
    def encode(value, reserved); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:37
    def expand(template, variables); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:44
    def expand_expression(operator, specs, variables); end

    # Expands one variable with its prefix (+:3+) and explode (+*+)
