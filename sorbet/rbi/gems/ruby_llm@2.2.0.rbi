# Google credentials shared by every Vertex AI provider in the process.
# googleauth keeps the access token on the credentials object and
# refreshes it a minute before it expires, so sharing the object shares
# the token. With a token timeout, token requests go through the
# middleware and adapter of Faraday's default connection, as googleauth's
# own would, with that timeout and its proxy. Faraday 1 drops a
# builder's adapter when it duplicates a builder without middleware, so
# the builder is shared, not duplicated. The connection is built for
# each token fetch, so it takes the proxy the default connection would
# use at that moment, from its settings or the environment.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:19
class RubyLLM::Providers::VertexAI::Credentials
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:41
  def initialize(service_account_key, token_timeout: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:22
  def authorizer; end

  # One caller fetches an expiring token while the others wait for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:48
  def headers; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:54
  def build(service_account_key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:70
  def google_credentials(service_account_key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:62
  def token_connection; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:30
    def cache; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:24
    def for(config); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:34
    def source(key); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:20
RubyLLM::Providers::VertexAI::Credentials::CACHE = T.let(T.unsafe(nil), RubyLLM::Support::ProcessCache)

