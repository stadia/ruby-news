# AWS event stream framing for Bedrock's streaming APIs, ConverseStream
# and InvokeModelWithResponseStream. Each frame carries one JSON event,
# bare or base64-encoded under "bytes", or an error.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:12
module RubyLLM::Protocols::Bedrock::EventStream
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:102
  def chunk_error_message(parsed); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:153
  def decode_error_frame(headers); end

  # Modeled errors arrive as a frame after the 200, with the type in the
  # frame headers and a bare message as the payload. Rewrap it under the
  # exception name so raise_stream_error classifies it instead of the
  # frame passing for an empty event.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:136
  def decode_event(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:172
  def decode_event_payload(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:109
  def decode_events(decoder, raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:167
  def event_header(headers, name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:45
  def event_stream_decoder; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:65
  def failed_stream_buffer(env); end

  # The error body arrives in as many reads as the adapter hands out, so
  # it accumulates on the env, which ErrorMiddleware clears per attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:56
  def handle_failed_stream(chunk, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:80
  def handle_non_eventstream_error_chunk(raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:69
  def parse_stream_chunk(decoder, raw_chunk, progress); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:189
  def raise_stream_error(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:94
  def raise_streaming_chunk_error(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:185
  def stream_error_event?(event); end

  # Failures the API does not model arrive as an error frame instead,
  # with the code and message in the headers and nothing in the payload.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:149
  def stream_error_frame?(message); end

  # Posts +body+ as an event stream request, yielding each decoded
  # event Hash and raising the errors the stream reports. Returns the
  # Faraday response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:28
  def stream_events(url, body, additional_headers = T.unsafe(nil), &handler); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:160
  def stream_exception_type(message); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:15
RubyLLM::Protocols::Bedrock::EventStream::EXCEPTION_STATUSES = T.let(T.unsafe(nil), Hash)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
class RubyLLM::Protocols::Bedrock::EventStream::ErrorResponse < ::Struct
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
  def body; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
  def body=(_); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
  def status; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
  def status=(_); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
    def [](*_arg0); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
    def inspect; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
    def keyword_init?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
    def members; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/bedrock/event_stream.rb:13
    def new(*_arg0); end
  end
end

