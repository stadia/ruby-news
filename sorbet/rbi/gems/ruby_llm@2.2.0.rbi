  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:391
  def media_type(mime_type); end

  # Text content loaded as binary is retagged so payloads serialize as
  # UTF-8. An IO can return text already tagged, with bytes its encoding
  # does not allow.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:377
  def normalize_text_encoding; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:472
  def provider_file_mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:440
  def source_filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:484
  def source_is_a?(class_name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:430
  def source_type_cast; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:85
    def from_h(data, config: T.unsafe(nil)); end

    # :startdoc:
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:67
    def wrap(sources, config: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:75
    def coerce(source, config:); end
  end
end

