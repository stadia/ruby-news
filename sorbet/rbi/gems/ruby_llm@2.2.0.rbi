# Tools methods of the OpenAI Responses API. Function definitions are
# flat rather than nested under a `function` key.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:8
module RubyLLM::Protocols::Responses::Tools
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:77
  def apply_provider_tools(*); end

  # The API requires a search tool next to deferred tools, and rejects
  # search items in the input of a request that declares none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:61
  def apply_tool_search(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:99
  def build_tool_choice(tool_choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:43
  def deferred?(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:89
  def defers_loading?(tools); end

  # Tool search loads a deferred function declared outside any
  # namespace under a namespace of its own name, and the API refuses a
  # call to it that lacks the namespace.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:50
  def namespace_searched_calls(input, tools); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:29
  def render_tools(tools); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:95
  def search_tool?(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:55
  def searched_call?(item, searched); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:14
  def tool_for(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:85
  def web_search_tool?(tool); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:77
    def apply_provider_tools(*); end

    # The API requires a search tool next to deferred tools, and rejects
    # search items in the input of a request that declares none.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:61
    def apply_tool_search(payload); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:99
    def build_tool_choice(tool_choice); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:43
    def deferred?(tool); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:89
    def defers_loading?(tools); end

    # Tool search loads a deferred function declared outside any
    # namespace under a namespace of its own name, and the API refuses a
    # call to it that lacks the namespace.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:50
    def namespace_searched_calls(input, tools); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:29
    def render_tools(tools); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:95
    def search_tool?(tool); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:55
    def searched_call?(item, searched); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:14
    def tool_for(tool); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/tools.rb:85
    def web_search_tool?(tool); end
  end
end

