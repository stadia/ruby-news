# pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:11
module RubyLLM::Protocols::Meta; end

# Muse Voice Transcribe on /v1/asr/transcribe. The settings travel as a
# JSON multipart part beside the WAV audio. The mode decides what comes
# back: one transcript by default, timed turns with ENDPOINTING, and
# turns labelled with a speaker with DIARIZATION. Accepting an event
# stream returns the same events as Meta's realtime endpoint.
# https://dev.meta.ai/docs/speech-to-text
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:12
module RubyLLM::Protocols::Meta::Transcription
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:43
  def parse_transcription_response(response, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:15
  def rejected_options(operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:19
  def render_transcription_options(timestamps:, streaming:, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:33
  def render_transcription_payload(file_part, model:, language:, speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:54
  def stream_transcription(payload, model:, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:29
  def transcription_url; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:70
  def parse_transcription_turn(turn); end

  # Meta answers "Malformed multipart body" to a part with its own
  # Content-Length, which a file part always carries.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:64
  def render_transcription_audio(file_part); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription.rb:13
RubyLLM::Protocols::Meta::Transcription::STREAM_HEADERS = T.let(T.unsafe(nil), Hash)

# Assembles a transcript from Meta's voice events. Without turns the
# transcript arrives whole in the final transcript event. With turns
# each speechComplete carries a turn's final text, and the transcript,
# speaker, and timing events between speechStart and it belong to the
# most recently opened turn. Turns can overlap and finish out of order,
# so each is held until every turn opened before it has finished.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:13
class RubyLLM::Protocols::Meta::Transcription::Stream
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:14
  def initialize(model:, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:35
  def finish; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:22
  def process(event); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:101
  def complete?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:69
  def complete_turn(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:77
  def emit_completed_turns; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:85
  def emit_turn(turn); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:57
  def finish_transcript(text, event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:64
  def open_turn(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:49
  def process_transcript(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/meta/transcription/stream.rb:95
  def turn_segment(turn_id, text, turn, event); end
end

