# Azure's dialect of the Chat Completions API. Endpoints depend on how
# the configured api_base is shaped (deployment, resource, or openai/v1).
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:8
class RubyLLM::Providers::Azure::ChatCompletions < ::RubyLLM::Protocols::ChatCompletions
  include ::RubyLLM::Providers::Azure::Chat
  include ::RubyLLM::Providers::Azure::Embeddings
  include ::RubyLLM::Providers::Azure::Media
  include ::RubyLLM::Providers::Azure::Models
  include ::RubyLLM::Providers::Azure::Videos
  include ::RubyLLM::Providers::Azure::Images
  include ::RubyLLM::Providers::Azure::Audio
