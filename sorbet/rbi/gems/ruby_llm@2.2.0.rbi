  def each(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:687
  def end_user(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:687
  def fallbacks(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:687
  def file_store(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:170
  def find_tool_call(tool_call_id); end

  # Makes a single generation attempt, persists the response, and returns it as a
  # RubyLLM::Message. Tool calls in the response are not executed. See
