# A resource on an MCP server: a file, a record, or any data the server
# names with a URI. Pass one to a chat like any attachment, or save it.
#
#   readme = files.resource("file:///project/README.md")
#   readme.content                 # => "# My Project..."
#   readme.save("README.md")
#   chat.ask "Summarize this", with: readme
#
# Resources from MCP#resources are read from the server the first time
# their content is needed.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:15
class RubyLLM::MCP::Resource
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Files::Saving

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:40
  def initialize(mcp, data); end

  # Returns the resource's content: text for text resources, bytes for
  # binary ones.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:53
  def content; end

  # What the resource is, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:29
  def description; end

  # The +_meta+ the server sent with the resource, as a Hash with String
  # keys, empty when there is none. A resource read with MCP#resource
  # has the +_meta+ of its contents; one from MCP#resources has the
  # +_meta+ of the listing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:38
  def meta; end

  # The MIME type the server reports, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:32
  def mime_type; end

  # The resource's name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:23
  def name; end

  # A human-readable title, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:26
  def title; end

  # Returns the resource as an Attachment, which is how chats take it
  # through +with:+. The attachment has the MIME type the server reports
  # when the URI has no file extension.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:75
  def to_attachment; end

  # Returns the content as a String of bytes.
