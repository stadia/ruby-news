# Raised when the server's process exits or does not answer in time.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:28
class RubyLLM::MCP::Stdio::Unavailable < ::RubyLLM::MCP::Error; end

# A tool call that an MCP server runs in the background, as the Tasks
# extension describes. Declare MCP.extension :tasks, and a server may
# answer a long call with a task instead of a result.
#
# A chat never waits for a task. It pauses the tool call, and
# Chat#pending_tasks returns the tasks it waits on. #refresh checks on
# a task once; Chat#complete checks on every one again and resumes the
# chat once they are done:
#
#   task = chat.pending_tasks.first
#   task.refresh
#   task.status         # => :working
#   task.status_message # => "Rendering page 3 of 12"
#   task.poll_interval  # => 5.0
#
# MCP#call waits for the task of a tool you call directly.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:21
class RubyLLM::MCP::Task < ::RubyLLM::Task
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:31
  def initialize(mcp, data, answered: T.unsafe(nil), tool_call: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:25
  def answered; end

  # Asks the server to cancel the task, and returns +self+. The server
  # may still finish it, so check with #refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:93
  def cancel; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:98
  def error; end

  # When the server may forget the task, as a Time, or +nil+ when it
  # keeps the task for good.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:59
  def expires_at; end

  # The task's id on its server.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:23
  def id; end

  # How many seconds the server asks you to wait before checking on the
  # task again, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:53
  def poll_interval; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:105
  def record_answers(keys); end

  # Checks on the task once and returns +self+, which now tells whether
  # the task is #complete? and how soon to check again. Does nothing once
  # the task is #complete?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:74
  def refresh; end

  # Returns the MCP::Result once the task #succeeded?, and +nil+ until
  # then. Raises MCP::Error when the task failed or was cancelled.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:65
  def result; end

  # The task's state: +:working+, +:input_required+, +:completed+,
  # +:failed+, or +:cancelled+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:41
  def status; end

  # What the server says about the task's state, such as how far it
  # got, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:47
  def status_message; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:109
  def to_h; end

  # Checks on the task until it is #complete?, sleeping #poll_interval
  # seconds in between, and returns +self+. Answers the server's
  # requests for input with MCP.before_input_request callbacks.
  # +timeout+ defaults to the server's MCP.timeout, and the task is
  # cancelled when it runs out or the chat is cancelled.
  #
  # Raises MCP::Error when the task fails or the time runs out, and
  # MCP::InputRequiredError when no callback answers a request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:87
  def wait(timeout: T.unsafe(nil), interval: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:115
  def connected; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:119
  def inspect_attributes; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/task.rb:27
    def load(mcp, state, tool_call: T.unsafe(nil)); end
  end
end

# A tool offered by an MCP server. It works anywhere a Tool does: a
# chat renders its name, description, and schema for the model, and
# calling it calls the server.
#
#   tool = linear.tools.first
#   tool.read_only?  # => true
#   chat.with_tools(tool)
#
# The behavior predicates read the server's annotations. They are hints
# from the server, so trust them only as far as you trust the server.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:15
class RubyLLM::MCP::Tool < ::RubyLLM::Tool
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:53
  def initialize(mcp, definition, prefix: T.unsafe(nil), as: T.unsafe(nil), description: T.unsafe(nil), fixed_arguments: T.unsafe(nil), wrap: T.unsafe(nil)); end

  # Calls the tool on the server and returns its MCP::Result, what the
  # +wrap:+ method made of it, or <tt>{ error: }</tt> when the tool
  # failed, or when the server failed the call: it could not be
  # reached, answered HTTP 429 or a 5xx status, or answered with a
  # JSON-RPC error. A server that could not be reached sits out the
  # chat's next requests, as when listing its tools. A refusal, such as
  # missing credentials, still raises. A tool with a UI returns its
  # failed MCP::Result instead, so your app can still render the UI. A
  # chat sends the model the result's content. When the server runs
  # the call as a task, returns the MCP::Task without waiting, and a
  # chat pauses the tool call until the task is done.
  # Raises MCP::InputRequiredError when the server needs input that no
  # MCP.before_input_request callback gave.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:111
  def call(**arguments); end

  # The description the model sees.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:22
  def description; end

  # Returns whether the tool may destroy or overwrite data. Tools that
  # are not read-only count as destructive unless the server says
  # otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:76
  def destructive?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:46
  def fixed_arguments; end

  # Returns whether calling the tool again with the same arguments has
  # no further effect. Only these calls are sent again when a stream
  # breaks before the answer.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:83
  def idempotent?; end

  # The tool's +_meta+ as the server sent it: a Hash with String keys,
  # empty when there is none. Extensions keep their own vocabulary
  # there.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:33
  def meta; end

  # The name the model calls this tool by.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:19
  def name; end

  # Returns whether the tool reaches beyond the server, such as the web.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:88
  def open_world?; end

  # The JSON Schema for the arguments the model provides.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:25
  def parameters_schema; end

  # Returns whether the server says the tool only reads.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:69
  def read_only?; end

  # Returns whether the tool pauses for approval, as declared with
  # MCP.requires_approval.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:94
  def requires_approval?(_tool_call = T.unsafe(nil)); end

  # Runs the handler the MCP class declares for +exception+, or else
  # one declared on this class.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:131
  def rescue_with_handler(exception); end

  # The fixed arguments, with lambdas called on the MCP instance.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:49
  def resolved_fixed_arguments; end

  # Resumes a call that paused on +task+, which it checks on once.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:116
  def resume(task, **arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:125
  def resume_call(state, arguments, **); end

  # The tool's name on the server.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:28
  def server_name; end

  # Returns the MCP::Task a call paused on, from its saved state.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:121
  def task(state, tool_call: T.unsafe(nil)); end

  # The URI of the tool's UI, the +ui://+ resource an MCP App renders
  # next to the tool's results, or +nil+ for a tool without one. Read
  # it with MCP#resource.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:38
  def ui_uri; end

  # Who may call the tool, as Symbols: +:model+ when chats offer it to
  # the model, +:app+ when a UI from the same server may call it. Tools
  # say nothing about it unless they belong to an MCP App, which makes
  # them <tt>[:model, :app]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:44
  def visibility; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:46
  def wrap; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:148
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/tool.rb:139
  def model_schema(schema); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:48
RubyLLM::MCP::UNKNOWN_TOOL_ERRORS = T.let(T.unsafe(nil), Array)

# A Message is a single entry in a chat conversation: a user prompt, an
# assistant reply, a system instruction, or a tool result. Chat#ask
# returns the model's reply as a Message, and Chat#messages holds the
# transcript as an array of them.
#
#   response = chat.ask "What is the capital of France?"
#   response.role          # => :assistant
#   response.content       # => "The capital of France is Paris."
#   response.finish_reason # => :stop
#
# A Message also carries everything else the provider returned: token
# usage (#tokens), reasoning output (#thinking), source citations
# (#citations), and requested tool calls (#tool_calls).
#
# pkg:gem/ruby_llm#lib/ruby_llm/message.rb:17
class RubyLLM::Message
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:132
  def initialize(options = T.unsafe(nil)); end

  # The files sent or returned with the message, as an array of
  # Attachment objects.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:33
  def attachments; end

  # Returns the cache lifetime given to this message's boundary, such as
  # <tt>"1h"</tt>, or +nil+ when the chat's caching policy applies.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:398
  def cache_ttl; end

  # Marks this message as an explicit prompt cache boundary. Providers
  # with boundary controls use the conversation up to and including this
  # message as the cacheable prefix. Pass +ttl:+, in any form
  # Chat#with_caching takes, to give this boundary its own cache lifetime
  # instead of the +ttl:+ from Chat#with_caching, on
  # providers that set a lifetime per boundary. Returns +self+.
  #
  #   chat.add_message(role: :user, content: long_context).cache_until_here
  #   chat.add_message(role: :user, content: handbook).cache_until_here(ttl: "1h")
  #
  # To mark system instructions, pass +cache_until_here:+ to
  # Chat#with_instructions.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:390
  def cache_until_here(ttl: T.unsafe(nil)); end

  # Returns +true+ if the message carries an explicit prompt cache
  # boundary, +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:411
  def cache_until_here?; end

  # Returns whether this is the part of a streamed reply the chat kept
  # when it was cancelled (see Chat#cancel), or the result that closed a
  # tool call it left unfinished. Its finish reason is +:cancelled+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:245
  def cancelled?; end

  # The source citations as an array of Citation objects, normalized
  # across providers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:84
  def citations; end

  # The message text as a String. Empty for assistant messages that only
  # request tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:29
  def content; end

  # Returns +true+ if a provider safety filter stopped the response,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:352
  def content_filtered?; end

  # The ContentFilter verdicts the provider reported on the request and
  # this response, or an empty Array. Read them to see which filter ended
  # a response that is #content_filtered?. Only the live response carries
  # them: #to_h leaves them out, so a persisted chat never stores them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:96
  def content_filters; end

  # The provider's opaque state for an assistant message it has not
  # finished, which a later request sends back to continue it. +nil+ once
  # the message is complete.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:126
  def continuation; end

  # The Chat this message belongs to, set when it is added to a
  # conversation. Backs #tool_results.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:130
  def conversation; end

  # The Chat this message belongs to, set when it is added to a
  # conversation. Backs #tool_results.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:130
  def conversation=(_arg0); end

  # Returns a Cost pricing this message's token usage in US dollars.
  # Uses recorded attempt costs, an explicitly supplied +cost:+, or pricing
  # from #model_info. An explicit +model:+ overrides those costs for repricing.
  #
  #   response.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:371
  def cost(model: T.unsafe(nil)); end

  # Why the model stopped: +:stop+, +:max_tokens+, +:tool_calls+, or
  # +:content_filter+. Any other reason comes through as the provider
  # named it, as a lowercase Symbol, such as Anthropic's +:pause_turn+ or
  # Gemini's +:malformed_function_call+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:90
  def finish_reason; end

  # Returns whether a tool ended the turn with this result, with
  # Tool#halt. Its finish reason is +:halted+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:238
  def halted?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:262
  def mark_cancelled; end

  # Returns +true+ if the response was cut off by a token limit,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:339
  def max_tokens?; end

  # The MCP::Result behind a tool result message, when the MCP tool that
  # returned it has a UI and did not fail, so your app can render the UI
  # again with the result. +nil+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:106
  def mcp_result; end

  # The ID of the model that produced the message, +nil+ on user messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:36
  def model; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:37
  def model_id; end

  # Returns the response's Model from its provider's registry, falling
  # back to the requested model when the response ID is unknown.
  # Restored messages use the last successful attempt's provider and model.
  # Messages without request context look up #model, or return +nil+ if unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:451
  def model_info; end

  # Returns the response's Model from its provider's registry, falling
  # back to the requested model when the response ID is unknown.
  # Restored messages use the last successful attempt's provider and model.
  # Messages without request context look up #model, or return +nil+ if unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:39
  def model_info=(_arg0); end

  # Returns #content parsed as JSON, memoized after the first call.
  # Useful for reading structured output responses. When the provider
  # marks part of the turn as commentary before the final answer, only
  # the final answer is parsed.
  #
  #   response = chat.with_schema(PersonSchema).ask "Generate a person"
  #   response.parsed # => {"name" => "Alice", "age" => 30}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:179
  def parsed; end

  # The provider's label for this assistant text within its turn, such as
  # OpenAI's +commentary+ or +final_answer+, kept so later requests can
  # send it back. +nil+ when the provider gave none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:121
  def phase; end

  # Returns the slug of the provider that produced the message, from its
  # last successful attempt, or +nil+ when none is recorded, as on user
  # messages. A reply from a model given to Chat#with_fallbacks names that
  # model's provider.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:45
  def provider; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:303
  def provider_call_id; end

  # The raw provider response: a Faraday::Response, or the result body
  # Hash for messages retrieved from a Batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:76
  def raw; end

  # The provider-shaped content blocks of this assistant message, kept
  # verbatim when the response used server tools so later requests can
  # replay the turn exactly. +nil+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:111
  def raw_content; end

  # The provider-shaped reasoning payload of this assistant message, kept
  # verbatim so later requests can replay the model's reasoning exactly.
  # +nil+ when the provider returned none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:116
  def raw_reasoning; end

  # The role of the message: +:system+, +:user+, +:assistant+, or +:tool+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:25
  def role; end

  # The provider-executed tool steps in this response, as an array of
  # ServerToolCall objects. Empty unless the chat enabled tools with
  # Chat#with_provider_tools and the model used one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:101
  def server_tool_calls; end

  # Returns the path, in the chat's files, of the whole of a tool result
  # too long to send whole, or +nil+ when the result went whole. A chat
  # with a file store keeps such a result in a file and sends the model
  # its start and this path (see Chat#with_file_store).
  #
  #   if (path = message.spilled_path)
  #     chat.file_store.read(path)
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:258
  def spilled_path; end

  # Marks the message as the work of a fallback model.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:50
  def stood_in(model:, provider:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:57
  def stood_in?; end

  # Returns +true+ if #finish_reason indicates the model finished
  # normally, +false+ otherwise. A turn that stopped to call tools is
  # reported by #tool_call_stop? instead, whatever the provider named it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:328
  def stopped?; end

  # The model's reasoning output as a Thinking object, or +nil+ when the
  # provider returned none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:80
  def thinking; end

  # Returns a Hash of the message's attributes, with token counts merged
  # in as +:input_tokens+, +:output_tokens+, and related keys. Omits
  # +nil+ values and empty attachment and citation lists. Includes +:cost+
  # only when supplied explicitly, preserving unknown costs on round-trip,
  # and +:reported_cost+ when the provider reported its own price.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:420
  def to_h; end

  # Returns usage aggregated across every provider attempt that produced this
  # message. Messages constructed by hand report the token counts they were
  # built with.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:359
  def tokens; end

  # Returns +true+ if the assistant requested one or more tool calls,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:293
  def tool_call?; end

  # The ID of the tool call this message answers. Set only on tool result
  # messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:72
  def tool_call_id; end

  # Returns +true+ if the model stopped to request tool calls,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:346
  def tool_call_stop?; end

  # The tool calls the assistant requested, as an Enumerable of ToolCall
  # objects in provider order, also readable by call ID. Empty when there
  # are none.
  #
  #   response.tool_calls.map(&:name) # => ["weather"]
  #   response.tool_calls["call_1"]   # => #<RubyLLM::ToolCall ...>
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:68
  def tool_calls; end

  # Returns the error text of a failed tool result, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:333
  def tool_error_message; end

  # Returns +true+ if the message carries the result of a tool call,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:299
  def tool_result?; end

  # Returns the tool result messages answering this message's tool calls,
  # or an empty array when it made none. Mirrors the +tool_results+
  # association on acts_as_message records.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:317
  def tool_results; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:342
  def truncated?; end

  # Returns the pages a hosted web search returned for this message, as an
  # array of WebSource objects with each address once. Reads what the message
  # keeps, so a restored message answers the same. Empty when the message
  # ran no search or its provider reports no sources.
  #
  #   response = chat.with_provider_tools(:web_search).ask "What changed in Ruby 4.0?"
  #   response.web_sources.map(&:url)
  #
  # Sources come from the outside world and are not a safe allowlist on their
  # own: a result can be attacker-controlled, and OpenAI can list a page the
  # model chose to open beside what its search found.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:198
  def web_sources; end

  # Returns a copy of the message with the given fields changed, like
  # Data#with. The message itself is left alone. Change +content+ or
  # +attachments+:
  #
  #   message.with(content: "[left out]")
  #
  # New content also drops what holds the old text: on an assistant
  # message its thinking, citations, server tool calls, raw response, and
  # native response blocks, and on a tool result its MCP result. Raises
  # ArgumentError for another field.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:214
  def with(**changes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:267
  def with_attachments(attachments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:223
  def with_content(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:276
  def with_tool_call_id(tool_call_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:272
  def with_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:280
  def without_native_content(raw_content: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:466
  def answer_text; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:526
  def coerce_list(values, klass); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:530
  def coerce_mcp_result(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:513
  def coerce_thinking(thinking, signature); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:484
  def coerce_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:522
  def coerce_value(value, klass); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:543
  def ensure_valid_role; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:547
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:480
  def list_to_h(list); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:534
  def normalize_content(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:497
  def tool_call_from_h(id, call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:507
  def tool_calls_without_thought_signatures; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:471
  def tool_result_payload; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:400
    def cache_boundary_options(value); end
  end
end

# The valid message roles: +:system+, +:user+, +:assistant+, and +:tool+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/message.rb:22
RubyLLM::Message::ROLES = T.let(T.unsafe(nil), Array)

# A Model describes one entry in the model registry: the model's identity,
# capabilities, modalities, pricing, and provider metadata. Instances come
# from the registry through RubyLLM.models and from Chat#model.
#
#   model = RubyLLM.models.find('gpt-6.1-sol')
#   model.name              # => "GPT-5.6"
#   model.provider          # => "openai"
#   model.context_window    # => 1050000
#   model.supports?(:vision) # => true
#
# pkg:gem/ruby_llm#lib/ruby_llm/model.rb:14
class RubyLLM::Model
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:76
  def initialize(data); end

  # The model's capability names as an array of Strings,
  # e.g. <tt>["function_calling", "streaming"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:50
  def capabilities; end

  # The maximum number of input tokens the model accepts, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:33
  def context_window; end

  # Builds a Cost for +tokens+ (a Tokens object, or anything responding
  # to +tokens+) using this model's pricing. A Chat or Message is priced
  # one provider request at a time, so each request pays the context
  # tier its own prompt reached.
  #
  #   cost = model.cost_for(response.tokens)
  #   puts cost.total
  #
  # Pass <tt>tier: :batch</tt> to use the model's explicit batch rates.
  # Amounts the model has no batch price for are +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:163
  def cost_for(tokens, tier: T.unsafe(nil)); end

  # The model's release timestamp as a UTC Time, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:30
  def created_at; end

  # The model family as a String, e.g. <tt>"gpt"</tt>, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:27
  def family; end

  # The provider's identifier for the model, e.g. <tt>"gpt-6.1-sol"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:18
  def id; end

  # The model's training data cutoff as a Date, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:39
  def knowledge_cutoff; end

  # Returns the provider display name and model name combined,
  # e.g. <tt>"OpenAI - GPT-5.6"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:115
  def label; end

  # The maximum number of tokens the model can generate, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:36
  def max_output_tokens; end

  # Provider-specific metadata as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:56
  def metadata; end

  # The supported input and output modalities as a Model::Modalities object.
  #
  #   model.modalities.input   # => ["text", "image", "pdf"]
  #   model.modalities.output  # => ["text"]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:46
  def modalities; end

  # The human-readable model name, e.g. <tt>"GPT-5.6"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:21
  def name; end

  # Returns the standard text-token price for +kind+ in USD per million
  # tokens, or +nil+ if the registry has no such price. Valid kinds are
  # +:input+, +:output+, +:cache_read+, and +:cache_write+.
  #
  #   model.price(:input)   # => 2.5
  #   model.price(:output)  # => 10.0
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:145
  def price(kind); end

  # The model's pricing as a Model::Pricing object, in USD per million tokens.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:53
  def pricing; end

  # The provider slug as a String, e.g. <tt>"openai"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:24
  def provider; end

  # Returns the Provider class registered for this model's provider slug,
  # or +nil+ if no such provider is registered.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:176
  def provider_class; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:120
  def reasoning_option(type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:124
  def reasoning_option_values(type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:63
  def reasoning_options; end

  # Returns whether #capabilities includes +capability+, given as a String
  # or Symbol.
  #
  #   model.supports?(:function_calling) # => true
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:99
  def supports?(capability); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:196
  def to_h; end

  # Returns the model's primary function, inferred from its output
  # modalities: +:chat+, +:embedding+, +:moderation+, +:image+, +:audio+,
  # +:video+, +:rerank+, or +:judgment+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:183
  def type; end

  # Returns whether the configured provider has stopped listing the model.
  # An unlisted model is kept only because application records still
  # reference it, and it may already be failing at the provider.
  #
  #   model.unlisted? # => false
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:109
  def unlisted?; end

  # The time the configured provider stopped listing the model, as a UTC
  # Time, or +nil+ while the provider still lists it. Only a store that keeps
  # unlisted entries, such as the Rails model table, sets it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:61
  def unlisted_at; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:264
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:252
  def normalize_reasoning_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:225
  def pricing_data_with_long_context(pricing); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:241
  def reasoning_options_from(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:245
  def store_reasoning_options_metadata; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:218
  def usage_entries_of(source); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:65
    def default(model_id, provider); end
  end
end

# A Model::Modalities lists the kinds of content a model accepts and
# produces, as arrays of Strings. Instances come from Model#modalities.
#
#   model = RubyLLM.models.find('gpt-6.1-sol')
#   model.modalities.input   # => ["text", "image", "pdf"]
#   model.modalities.output  # => ["text"]
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:12
class RubyLLM::Model::Modalities
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:21
  def initialize(data); end

  # The input modalities as an array of Strings,
  # e.g. <tt>["text", "image", "pdf"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:15
  def input; end

  # The output modalities as an array of Strings,
  # e.g. <tt>["text"]</tt> or <tt>["embeddings"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:19
  def output; end

  # Returns the modalities as a Hash with +:input+ and +:output+ keys.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:27
  def to_h; end
end

# The standard text-token price columns, keyed by the symbol #price
# accepts.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model.rb:130
RubyLLM::Model::PRICES = T.let(T.unsafe(nil), Hash)

# A Pricing groups a model's prices by usage category: text tokens,
# images, audio tokens, and embeddings, plus the characters, audio
# seconds, and search units some operations bill instead of tokens.
# Each category is a PricingCategory. Prices are in USD per million
# units of the category. Instances come from Model#pricing.
#
#   model = RubyLLM.models.find "claude-sonnet-5"
#   model.pricing.text_tokens.input   # => 3
#   model.pricing.text_tokens.output  # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:15
class RubyLLM::Model::Pricing
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:19
  def initialize(data); end

  # Returns the PricingCategory for prices per million seconds of
  # input audio, such as a transcription model's, or an empty category
  # if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:61
  def audio_seconds; end

  # Returns the PricingCategory for audio token prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:41
  def audio_tokens; end

  # Returns the PricingCategory for prices per million input
  # characters, such as a text-to-speech model's, or an empty category
  # if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:54
  def characters; end

  # Returns the PricingCategory for embedding prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:47
  def embeddings; end

  # Returns the PricingCategory for image generation prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:35
  def images; end

  # Returns the PricingCategory for prices per million search units,
  # such as a rerank model's, or an empty category if the model has
  # none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:68
  def search_units; end

  # Returns the PricingCategory for text token prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:29
  def text_tokens; end

  # Returns the pricing data as a nested Hash keyed by category.
  # Categories without prices are omitted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:74
  def to_h; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:80
  def category(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:84
  def empty_pricing?(data); end
end

# The pricing categories a model may define.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:17
RubyLLM::Model::Pricing::CATEGORIES = T.let(T.unsafe(nil), Array)

# A PricingCategory holds the standard, batch, and long-context pricing
# tiers for one kind of model usage, such as text tokens or images.
# Model#pricing returns a Pricing collection whose categories are
# PricingCategory instances. Prices are in USD per million tokens, or
# per million units for categories billed in characters, audio seconds,
# or search units.
#
#   model    = RubyLLM.models.find "claude-sonnet-5"
#   category = model.pricing.text_tokens
#   category.input  # => 3
#   category.output # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:17
class RubyLLM::Model::PricingCategory
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:37
  def initialize(data = T.unsafe(nil)); end

  # The batch-tier PricingTier, or +nil+ when the model has no batch
  # pricing for this category.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:27
  def batch; end

  # Returns the standard-tier cache read price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:61
  def cache_read_input; end

  # Returns the standard-tier cache write price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:67
  def cache_write_input; end

  # Returns the standard-tier input price in USD per million tokens,
  # or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:49
  def input; end

  # The long-context PricingTier, or +nil+ when the model has no
  # separate rates for prompts above #long_context_threshold.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:31
  def long_context; end

  # Prompt-size threshold (in tokens) above which long-context rates
  # apply, or +nil+ when the model has no long-context tier.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:35
  def long_context_threshold; end

  # Returns the standard-tier output price in USD per million tokens,
  # or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:55
  def output; end

  # Returns the standard-tier reasoning output price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:73
  def reasoning_output; end

  # The standard-tier PricingTier, or +nil+ when the model has no
  # standard pricing for this category.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:23
  def standard; end

  # Returns the PricingTier that applies for a prompt of the given size.
  # Uses the largest context tier +prompt_tokens+ is greater than, such
  # as #long_context above #long_context_threshold; otherwise returns
  # #standard.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:81
  def tier_for(prompt_tokens); end

  # Returns a Hash with present tier hashes and optional
  # +:long_context_threshold+, omitting absent entries.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:87
  def to_h; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:150
  def context_tiers_from(tiers); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:162
  def empty_tier?(tier_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:156
  def tier_from(tier_data); end

  class << self
    # Returns every context tier in +cost+ as <tt>[size, rates]</tt>. The
    # registry schema holds one long-context tier, so a model with more
    # keeps the rest in its metadata.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:114
    def context_tiers_from_cost(cost); end

    # Builds long-context rates and threshold from a models.dev-style cost
    # Hash (as stored on Model#metadata under +:cost+). Returns
    # <tt>[rates_hash, threshold]</tt>, or <tt>[nil, nil]</tt> when the
    # cost has no context tier.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:100
    def long_context_from_cost(cost); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:137
    def context_cost(cost); end

    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:133
    def context_entries(cost); end

    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:123
    def context_rates(entry); end
  end
end

# The billing tiers a category may define.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:19
RubyLLM::Model::PricingCategory::TIERS = T.let(T.unsafe(nil), Array)

# A PricingTier holds the prices a model charges within one billing tier,
# such as standard, batch, or long_context. Each price is in USD per one
# million tokens, or per million units of a category billed in other
# units, such as Pricing#characters. Prices missing from the registry
# read as +nil+. A zero price means the usage is free.
#
# Instances come from PricingCategory#standard, #batch, and #long_context:
#
#   model = RubyLLM.models.find "claude-sonnet-5"
#   tier  = model.pricing.text_tokens.standard
#   tier.input_per_million  # => 3
#   tier.output_per_million # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:18
class RubyLLM::Model::PricingTier
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:28
  def initialize(data = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:69
  def cache_read_input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:69
  def cache_write_input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:69
  def input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:69
  def output_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:69
  def reasoning_output_per_million; end

  # Returns a new Hash of the tier's prices with Symbol keys. Missing
  # prices are omitted.
  #
  #   tier.to_h
  #   # => {input_per_million: 3, output_per_million: 15, ...}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:80
  def to_h; end
end

# The names of the price readers a tier responds to.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:20
RubyLLM::Model::PricingTier::ATTRIBUTES = T.let(T.unsafe(nil), Array)

# Raised when a requested model id is not in the model registry.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:189
class RubyLLM::ModelNotFoundError < ::StandardError; end

# Raised when a model registry cannot be fetched, parsed, or persisted.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:192
class RubyLLM::ModelRegistryError < ::StandardError; end

# A Models registry is the catalog of AI models RubyLLM knows about,
# including their capabilities, context windows, and pricing. The global
# registry is available through RubyLLM.models.
#
#   RubyLLM.models.find 'claude-sonnet-5'
#   RubyLLM.models.by_provider(:openai).chat_models
#   RubyLLM.models.refresh
#
# Filter methods return new Models instances, so calls chain. Models is
# enumerable over its Model entries. Class-level calls such as
# Models.find delegate to the global registry.
#
# pkg:gem/ruby_llm#lib/ruby_llm/models.rb:17
class RubyLLM::Models
  include ::Enumerable
  include ::RubyLLM::Models::Lookup

  # :startdoc:
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:530
  def initialize(models = T.unsafe(nil)); end

  # Returns an array of the Model entries the configured provider still
  # lists. Models it has stopped listing are left out; #find still resolves
  # them, and #unlisted reports them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:567
  def all; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:585
  def all_including_unlisted; end

  # Returns a new Models registry containing only models with audio
  # output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:634
  def audio_models; end

  # Returns a new Models registry containing only models in +family+.
  #
  #   RubyLLM.models.by_family('claude-sonnet')
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:648
  def by_family(family); end

  # Returns a new Models registry containing only models from +provider+.
  # Accepts a symbol or a string.
  #
  #   RubyLLM.models.by_provider(:openai).select { |model| model.supports?(:vision) }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:657
  def by_provider(provider); end

  # Returns a new Models registry containing only chat models.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:623
  def chat_models; end

  # Yields each Model in the registry.
  #
  #   RubyLLM.models.each { |model| puts model.id }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:593
  def each(&); end

  # Returns a new Models registry containing only embedding models.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:628
  def embedding_models; end

  # Returns the Model matching +model_id+, resolving aliases along the
  # way. Without +provider+, picks the preferred provider that carries
  # the model, first-party providers before aggregators. Raises
  # RubyLLM::ModelNotFoundError if no model matches.
  #
  #   RubyLLM.models.find 'gpt-6.1-sol'
  #   RubyLLM.models.find 'claude-sonnet-5', provider: :bedrock
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:605
  def find(model_id, provider: T.unsafe(nil), config: T.unsafe(nil)); end

  # Returns the Model that resolution uses for +model_id+. Without
  # +provider+, it prefers providers configured in +config+, falling back
  # to #find's choice when none of them carries the model.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:616
  def find_configured(model_id, provider: T.unsafe(nil), config: T.unsafe(nil)); end

  # Returns a new Models registry containing only models with image
  # output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:640
  def image_models; end

  # Returns an array of the Model entries the configured provider still
  # lists. Reads the same as #all, which already excludes the rest.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:583
  def listed; end

  # Replaces the models in this registry with those read from the JSON
  # +file+. The default is the configured
  # <tt>RubyLLM.config.model_registry_file</tt>. A missing or invalid
  # file falls back to the registry bundled with the gem.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:538
  def load_from_json(file = T.unsafe(nil)); end

  # Replaces the models in this registry with entries from the configured
  # model-registry store.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:545
  def load_from_store; end

  # Replaces the registry with the latest published RubyLLM catalog,
  # merged with models discovered from configured providers. The result is
  # saved to the platform cache, or to the database in Rails applications.
  # Pass +remote_only:+ +true+ to skip local providers such as Ollama and
  # GPUStack. Returns +self+.
  #
  # Raises ModelRegistryError when the catalog cannot be fetched or the
  # result cannot be persisted, leaving the current registry unchanged.
  #
  #   RubyLLM.models.refresh
  #   RubyLLM.models.refresh(remote_only: true).chat_models
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:673
  def refresh(remote_only: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:686
  def refresh_from_providers(remote_only: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:691
  def resolve(model_id, provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), config: T.unsafe(nil)); end

  # Exports this registry to +file+ as pretty-printed JSON. The default is
  # the configured <tt>RubyLLM.config.model_registry_file</tt>. A regular
  # #refresh already persists to the active registry store.
  #
  #   RubyLLM.models.save_to_json('/tmp/models.json')
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:559
  def save_to_json(file = T.unsafe(nil)); end

  # Returns an array of the Model entries the configured provider has
  # stopped listing. Only a store that keeps them, such as the Rails model
  # table, ever reports one.
  #
  #   RubyLLM.models.unlisted.map(&:id)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:577
  def unlisted; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:722
  def fetch_published_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:708
  def file_store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:736
  def merge_discovered_models(published, payload, remote_only:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:754
  def persist_registry!(models, published:); end

  # A provider that answered replaces its own models and the published
  # catalog replaces what it covers. Everything else survives the refresh,
  # including the local providers a remote_only run never asks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:747
  def preserved_providers(provider_fetch, published); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:729
  def published_catalog; end

  # The ETag identifies the published catalog, not the merged registry, so
  # it may only be sent while the catalog it stands for is still on disk.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:717
  def published_store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:697
  def replace_models(models); end

  # Filters keep the unlisted entries so #find and #unlisted still see them
  # after a chain such as by_provider(:openai).unlisted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:704
  def select_models(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:792
  def store_description(store); end

  # A store keeps entries the merge dropped, such as the unlisted rows a
  # Rails application still references, so its answer wins over the merge.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:777
  def stored_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:788
  def write_published_catalog(published); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:331
    def add_provider_metadata(models_dev_model, provider_model); end

    # Returns an array of the Model entries the configured provider still
    # lists. Models it has stopped listing are left out; #find still resolves
    # them, and #unlisted reports them.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def all(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def all?(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def any?(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def as_json(*args, **kwargs, &block); end

    # Returns a new Models registry containing only models with audio
    # output.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def audio_models(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:363
    def augment_capabilities(provider_slug, capabilities, model_id, modalities); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:356
    def augment_model_capabilities(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:391
    def blank_value?(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:64
    def bundled_registry_file; end

    # Returns a new Models registry containing only models in +family+.
    #
    #   RubyLLM.models.by_family('claude-sonnet')
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def by_family(*args, **kwargs, &block); end

    # Returns a new Models registry containing only models from +provider+.
    # Accepts a symbol or a string.
    #
    #   RubyLLM.models.by_provider(:openai).select { |model| model.supports?(:vision) }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def by_provider(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def chain(*args, **kwargs, &block); end

    # Returns a new Models registry containing only chat models.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def chat_models(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def chunk(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def chunk_while(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def collect(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def collect_concat(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def compact(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def compact_blank(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def count(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def cycle(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def detect(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def drop(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def drop_while(*args, **kwargs, &block); end

    # Yields each Model in the registry.
    #
    #   RubyLLM.models.each { |model| puts model.id }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def each(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def each_cons(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
