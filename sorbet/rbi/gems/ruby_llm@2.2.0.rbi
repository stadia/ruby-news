end

# Chat methods for Bedrock Converse API.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:9
module RubyLLM::Protocols::Converse::Chat
  private

  # Bedrock's own caching of Claude and Nova prompts is best effort, so
  # with caching on RubyLLM places explicit points: at the end of the
  # conversation, so the next tool round or question can read what was
  # sent so far; after the system prompt (or the tools without one),
  # which stays cached when a later message changes; and after the
  # previous assistant message, because Bedrock looks for an earlier
  # cache entry only about 20 content blocks back from each point, and
  # a round of parallel tool calls can be longer than that. Points the
  # messages already mark count toward the limit of four, and an
  # automatic point never puts a shorter lifetime before a longer one,
  # which Bedrock refuses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:348
  def add_automatic_cache_points(payload, model, caching); end

  # A citationsContent block replaces the text block for a cited span:
  # the generated text lives in its content member, and each citation
  # points back at the source document or search result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:582
  def append_citations_content(citations_content, text, citations); end

  # Claude refuses a cache point right after an Office document, so the
  # point goes after the last block that takes one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:366
  def automatic_cache_point_index(blocks); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:380
  def automatic_cache_points?(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:386
  def automatic_cache_targets(payload, model); end

  # Bound from the first request, as on the Anthropic API, so the
  # thinking setting never changes mid-conversation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:509
  def bind_thinking(fields, model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:517
  def build_output_config(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:333
  def cache_boundary?(message, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:412
  def cache_lifetime(point); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:407
  def cache_lifetimes_descend?(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:441
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:418
  def cache_point?(block); end

  # In the order Bedrock reads them: tools, system, then messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:401
  def cache_points(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:164
  def cache_write_by_ttl(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:625
  def citation_source_index(location); end

  # Search result citations carry the developer-provided source string.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:620
  def citation_url(data, location); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:46
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:422
  def converse_cache_block_for(caching, ttl: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:88
  def count_tokens_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:710
  def default_input_schema; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:117
