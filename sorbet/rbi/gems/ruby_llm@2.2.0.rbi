  # pkg:gem/ruby_llm#lib/ruby_llm/chat/context_budget.rb:110
  def size_of_all(list); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/chat/context_budget.rb:21
    def normalize(budget, **shares); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/context_budget.rb:36
    def validate_share(name, share); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/context_budget.rb:42
    def validate_window(window); end
  end
end

