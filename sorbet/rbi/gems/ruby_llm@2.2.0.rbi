  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:802
  def provider_file_attachable?(_attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:724
  def provider_file_references?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:806
  def provider_file_upload_options(_attachment); end

  # Uploads are memoized per provider on the attachment itself, so a chat
  # that switches providers uploads once to each rather than replaying
  # another provider's file reference. An upload past its provider
  # retention window is replaced rather than reused.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:757
  def provider_upload(attachment); end

  # A file id belongs to the account that uploaded it, so the memo is keyed
  # by the credentials in play as well as the provider: a chat moved to
  # another Context uploads again instead of replaying a foreign id. The
  # credentials themselves are hashed so the attachment never carries them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:771
  def provider_upload_scope; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:740
  def replace_unsupported_attachment(attachment, handler, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:650
  def resolve_provider_tools_for_request(entries); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:736
  def supported_message_attachment?(_message, attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:843
  def sync_response(payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:693
  def track_usage(operation, on_finish: T.unsafe(nil), model_id: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:631
  def unsupported_parameter_error(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:793
  def upload_large_attachment?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:816
  def validate_animate_inputs!(with:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:810
  def validate_paint_inputs!(with:, mask:); end

  class << self
    # Declares seam methods that raise NotImplementedError until a subclass
    # overrides them: render_* serializes a request to wire form, *_url names an
    # endpoint, and parse_* reads a wire response back into RubyLLM objects.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:64
    def abstract(*names); end
  end
end

