# Streaming methods of the Anthropic API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:9
module RubyLLM::Protocols::Anthropic::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:110
  def append_stream_text(block, key, text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:35
  def build_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:115
  def finalize_stream_block(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:186
  def json_delta?(data); end

  # A citation delta arrives before the text it supports, so a block's
  # citations wait for the block to stop and take its span of the response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:152
  def parse_block_citations(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:144
  def parse_content_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:61
  def parse_server_tool_use(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:179
  def parse_signature_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:123
  def parse_stream_block_input(json, block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:190
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:172
  def parse_thinking_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:79
  def reset_stream_blocks; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:140
  def stream_block_list; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:129
  def stream_end_fields(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:25
  def stream_response(payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:166
  def stream_text_length_before(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:31
  def stream_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:96
  def track_stream_block_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:85
  def track_stream_block_start(data); end

  # Reconstructs the response's content blocks from stream events so
  # turns that used server tools can be replayed verbatim, exactly as
  # the non-streaming path does with the response body.
  # Resetting on message_start matters for pause_turn continuations,
  # which stream several messages through one protocol instance.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:70
  def track_stream_blocks(data, delta_type); end
end

