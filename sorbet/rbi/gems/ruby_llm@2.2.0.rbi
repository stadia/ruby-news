  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/operation.rb:52
  def payload(fields); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/operation.rb:60
  def report(event, result); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/operation.rb:44
  def resolve(model, default, operation, **options); end
end

