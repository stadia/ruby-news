# pkg:gem/ruby_llm#lib/ruby_llm/question.rb:35
RubyLLM::Question::TYPES = T.let(T.unsafe(nil), Hash)

# A user message waiting to join a conversation, from Chat#queue. The
# conversation loop takes it between two of its moves, where it becomes
# an ordinary user Message.
#
#   queued = chat.queue "Use the EU file instead"
#   chat.queued_messages # => [#<RubyLLM::QueuedMessage ...>]
#   queued.withdraw # => true
#
# pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:14
class RubyLLM::QueuedMessage
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:33
  def initialize(content:, attachments: T.unsafe(nil), steer: T.unsafe(nil), sender: T.unsafe(nil), queue: T.unsafe(nil)); end

  # The attachments given with +with:+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:24
  def attachments; end

  # The text of the message, as given to Chat#queue.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:21
  def content; end

  # A String that identifies this message among the chat's queued ones.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:18
  def id; end

  # The Time the message was queued.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:31
  def queued_at; end

  # Returns a copy of the message that a copied chat's +queue+ holds, so
  # #withdraw takes it out of that chat's queue.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:62
  def requeue(queue); end

  # Whoever queued the message, as given with +sender:+, or +nil+.
  # RubyLLM stores it and hands it back without interpreting it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:28
  def sender; end

  # Returns whether the message steers the turn that is running, joining
  # it at the next step, rather than waiting for the turn to end.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:45
  def steer?; end

  # Takes the message out of the queue of the chat it was queued on, as
  # Chat#withdraw does. Returns +true+, or +false+ when it is no longer
  # queued: the loop took it into the conversation, or it was withdrawn
  # already.
  #
  #   queued.withdraw # => true
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:56
  def withdraw; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/queued_message.rb:70
  def inspect_attributes; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/railtie.rb:5
class RubyLLM::Railtie < ::Rails::Railtie; end

# pkg:gem/ruby_llm#lib/ruby_llm/railtie.rb:7
RubyLLM::Railtie::JAVASCRIPTS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/railtie.rb:6
RubyLLM::Railtie::ROOT = T.let(T.unsafe(nil), String)

# Raised for HTTP 429 responses when the provider rate limit is exceeded.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:319
class RubyLLM::RateLimitError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:320
    def default_message; end
  end
end

# A RequestShape describes a conversation request as the provider received
# it, without its contents: each turn's role and parts with their sizes,
# the tools on offer, the thinking settings, and the problems RubyLLM finds
# in it, such as a part with no data or a tool call with no result. Read it
# from Error#request_shape when a provider rejects a request without saying
# what is wrong with it.
#
#   begin
#     chat.ask "What's due today?"
#   rescue RubyLLM::BadRequestError => e
#     Rails.logger.error("#{e.message}\n#{e.request_shape}")
#     Rails.error.report(e, context: { request_shape: e.request_shape.to_h })
#     raise
#   end
#
# A shape holds no text, tool arguments, tool results, signatures, URLs,
# file data, or setting values beyond thinking settings, so you can log it
# and send it to an error tracker. A long conversation keeps its first 10
# and last 50 turns.
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:23
class RubyLLM::RequestShape
  include ::RubyLLM::Support::Inspectable

  # Creates a shape. Protocols build shapes in
  # Protocol#parse_request_shape; every attribute but +turns+ is optional.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:71
  def initialize(turns:, provider: T.unsafe(nil), model: T.unsafe(nil), step: T.unsafe(nil), payload_keys: T.unsafe(nil), thinking_settings: T.unsafe(nil), instructions: T.unsafe(nil), turn_count: T.unsafe(nil), omitted_turns: T.unsafe(nil), tool_names: T.unsafe(nil), tool_rounds: T.unsafe(nil), problems: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:117
  def inspect_attributes; end

  # The Part objects of the instructions the request sends apart from its
  # turns, or an empty Array when the provider takes instructions as a turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:46
  def instructions; end

  # The id of the model the request went to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:30
  def model; end

  # The number of turns left out of #turns.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:56
  def omitted_turns; end

  # The names of the payload's top-level fields, without their values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:38
  def payload_keys; end

  # The Problem objects RubyLLM finds in the request, across every turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:67
  def problems; end

  # The provider's slug, such as <tt>"gemini"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:27
  def provider; end

  # Which model call of the current turn the request makes, counting from
  # 1, so +3+ follows two tool rounds. Returns +nil+ when the request holds
  # no user turn to count from.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:35
  def step; end

  # The thinking settings the request sends, such as an effort or a budget,
  # as a Hash of the provider's setting names and values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:42
  def thinking_settings; end

  # Returns the shape as a Hash with the same keys every time, for
  # structured logs and error trackers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:108
  def to_h; end

  # Returns the shape as text, one turn per line:
  #
  #   gemini, gemini-2.5-flash, model call 1 of the turn
  #   payload keys: contents, generationConfig, tools
  #   thinking: includeThoughts true, thinkingBudget -1
  #   #0 user: text (17 chars)
  #   #1 model: call find_tasks (args 40 chars), signed
  #   #2 user: result find_tasks (6859 chars)
  #   #3 model: thinking (no text), signed, text (1075 chars)
  #   #4 user: text (31 chars)
  #   tools: find_tasks
  #   tool round at #1: 1 call, 1 result, paired
  #   problem at #3, part 0: thinking part carries no data
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:101
  def to_s; end

  # The names of the tools the request offers, in order. Provider tools
  # keep the name their provider's API gives them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:60
  def tool_names; end

  # The ToolRound objects of the turns kept, one for each model turn that
  # called tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:64
  def tool_rounds; end

  # The number of turns the request sends, including omitted ones.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:53
  def turn_count; end

  # The Turn objects of the conversation, in the order the request sends
  # them. A long conversation keeps its first 10 and last 50 turns.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:50
  def turns; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:151
  def gap_line(turn, following); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:138
  def list_line(label, items); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:156
  def problem_lines; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:142
  def settings_line; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:128
  def step_description; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:123
  def summary_line; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:146
  def turn_lines; end
end

# A Part describes one piece of a turn by its kind and size, never by
# its content.
#
#   part.kind    # => :tool_call
#   part.name    # => "find_tasks"
#   part.size    # => 42
#   part.unit    # => :chars
#   part.signed? # => true
#   part.to_s    # => "call find_tasks (args 42 chars), signed"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:15
class RubyLLM::RequestShape::Part
  include ::RubyLLM::Support::Inspectable

  # Creates a part. Every attribute but +kind+ is optional. A +size+
  # counts characters unless +unit+ says +:bytes+; pass +signed: true+
  # when the piece carries a thinking signature.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:54
  def initialize(kind:, size: T.unsafe(nil), unit: T.unsafe(nil), name: T.unsafe(nil), source: T.unsafe(nil), mime_type: T.unsafe(nil), signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:90
  def inspect_attributes; end

  # The kind of piece: +:text+, +:thinking+, +:image+, +:audio+,
  # +:video+, +:document+, +:tool_call+, +:tool_result+, or +:other+
  # for a piece RubyLLM does not classify, such as a provider tool step.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:24
  def kind; end

  # The MIME type of media, as the request gives it or as its format
  # implies, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:49
  def mime_type; end

  # The tool's name for a tool call, and for a tool result the name of
  # the call it answers, which is +nil+ when no call in the request
  # matches it. For an +:other+ piece, the provider's name for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:40
  def name; end

  # Returns whether the piece carries a thinking signature, the token a
  # provider issues to verify replayed thinking or tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:66
  def signed?; end

  # The size of the piece as the request sends it, in #unit: the
  # characters of text, thinking, tool call arguments, and a tool
  # result's text, or of its JSON when it is structured data, and the
  # bytes of inline media. Media inside a tool result follows it as
  # parts of its own. Returns +nil+ when there is nothing to measure,
  # such as media sent by URL or thinking the provider encrypted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:32
  def size; end

  # Where media comes from: +:inline+ for bytes in the request, +:url+
  # for a link the provider fetches, or +:file+ for a file stored with
  # the provider. Returns +nil+ for pieces that are not media.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:45
  def source; end

  # Returns the part as a Hash, with its size under its unit, omitting
  # attributes it does not have.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:84
  def to_h; end

  # Returns the part in words, with its size and unit:
  #
  #   text (13 chars)
  #   image/png (34512 bytes)
  #   document (url)
  #   result find_tasks (6859 chars)
  #   thinking (no text), signed
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:78
  def to_s; end

  # The unit of #size: +:chars+ or +:bytes+, or +nil+ without a size.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:35
  def unit; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:96
  def description; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:105
  def measured; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:110
  def missing; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:18
RubyLLM::RequestShape::Part::TEXT_KINDS = T.let(T.unsafe(nil), Array)

# A Problem is something in a request that providers are known to
# reject, found by the protocol that rendered it: a part with no data, a
# tool round whose calls and results do not pair up, a step that lacks
# the signature the provider requires, or roles out of order.
#
#   problem.kind    # => :part_without_data
#   problem.turn    # => 3
#   problem.part    # => 0
#   problem.to_s    # => "problem at #3, part 0: thinking part carries no data"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:15
class RubyLLM::RequestShape::Problem
  include ::RubyLLM::Support::Inspectable

  # Creates a problem of +kind+ described by +message+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:38
  def initialize(kind:, message:, turn: T.unsafe(nil), part: T.unsafe(nil), call_id: T.unsafe(nil)); end

  # The id of the call an unmatched tool result names, the only id a
  # shape shows, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:32
  def call_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:58
  def inspect_attributes; end

  # What is wrong: +:part_without_data+, +:empty_turn+,
  # +:unpaired_round+, +:unmatched_result+, +:unsigned_call+,
  # +:unsigned_thinking+, or +:role_order+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:21
  def kind; end

  # The problem in words.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:35
  def message; end

  # The position of the part in the turn's parts, or +nil+ when the
  # problem concerns the whole turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:28
  def part; end

  # Returns the problem as a Hash, omitting attributes it does not have.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:54
  def to_h; end

  # Returns the problem as one line, with where it is.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:47
  def to_s; end

  # The index of the turn the problem is in, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:24
  def turn; end
end

# A ToolRound describes a model turn that called tools and the results
# the request sends back before the next model turn: how many of each,
# and whether they pair up the way the provider matches them.
#
#   round.turn    # => 1
#   round.calls   # => 2
#   round.results # => 1
#   round.paired? # => false
#   round.to_s    # => "tool round at #1: 2 calls, 1 result, not paired"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:15
class RubyLLM::RequestShape::ToolRound
  include ::RubyLLM::Support::Inspectable

  # Creates a round at +turn+ with the number of +calls+ and +results+,
  # and whether they are +paired+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:29
  def initialize(turn:, calls:, results:, paired:); end

  # The number of tool calls in the round.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:22
  def calls; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:53
  def inspect_attributes; end

  # Returns whether every call has its result, matched the way the
  # provider matches them: by call id, or by position and tool name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:38
  def paired?; end

  # The number of tool results sent back for the round.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:25
  def results; end

  # Returns the round as a Hash with its turn, counts, and pairing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:49
  def to_h; end

  # Returns the round in words.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:43
  def to_s; end

  # The index of the turn that made the calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:19
  def turn; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:59
  def counted(count, noun); end
end

# A Turn describes one entry of a request's conversation: a message, or
# one item where the provider sends a model's reasoning and tool calls as
# items of their own.
#
#   turn = error.request_shape.turns.last
#   turn.index # => 4
#   turn.role  # => "user"
#   turn.to_s  # => "#4 user: text (31 chars)"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:14
class RubyLLM::RequestShape::Turn
  include ::RubyLLM::Support::Inspectable

  # Creates a turn at +index+ with +role+ and +parts+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:30
  def initialize(index:, role:, parts: T.unsafe(nil)); end

  # The turn's 0-indexed position in the request, the position a
  # provider's error message counts from.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:19
  def index; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:49
  def inspect_attributes; end

  # The Part objects of the turn, in order.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:27
  def parts; end

  # The turn's role as the payload names it, such as <tt>"model"</tt>,
  # or for an entry that names no role, its type, such as
  # <tt>"function_call"</tt>. Returns +nil+ when the entry names neither.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:24
  def role; end

  # Returns the turn as a Hash with its index, role, and parts.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:45
  def to_h; end

  # Returns the turn as one line: its index, its role, and its parts.
  #
  #   turn.to_s # => "#3 model: thinking (11 chars), text (13 chars), signed"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/turn.rb:40
  def to_s; end
end

# A Rerank is the result of ordering documents by relevance to a query.
# RubyLLM.rerank returns one:
#
#   rerank = RubyLLM.rerank("what is ruby",
#                           ["Ruby is a programming language", "Paris is in France"],
#                           model: "voyageai/rerank-2.5-lite", provider: :openrouter)
#   rerank.results.first.document # => "Ruby is a programming language"
#   rerank.results.first.score    # => 0.80078125
#
# pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:13
class RubyLLM::Rerank
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result
  include ::RubyLLM::Accounting::Usage::ModelInfo

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:31
  def initialize(results:, model:, raw: T.unsafe(nil), input_tokens: T.unsafe(nil), search_units: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # Returns the rerank cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:48
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:54
  def inspect_attributes; end

  # The id of the model that ranked the documents, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:26
  def model; end

  # The raw provider response body.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:29
  def raw; end

  # The reranked results, most relevant first, as an array of Result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:23
  def results; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:41
  def tokens; end

  class << self
    # Ranks +documents+ (an array of strings) by relevance to +query+ and
    # returns a Rerank. +model:+ is required; rerank catalogs are
    # provider-specific and have no cross-provider default. +top_n:+
    # limits how many results come back. +provider_options:+ merges
    # options into the request in the provider's vocabulary.
    # +owner:+ attributes the usage to a record, such as a user, and wins
    # over RubyLLM.with_owner.
    #
    #   RubyLLM.rerank "what is ruby", docs, model: "voyageai/rerank-2.5-lite", provider: :openrouter
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:68
    def rerank(query, documents, model:, provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), top_n: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end
  end
end

