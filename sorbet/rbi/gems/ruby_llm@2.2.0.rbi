  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:388
  def feed(chunk, _size = T.unsafe(nil), env = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:350
