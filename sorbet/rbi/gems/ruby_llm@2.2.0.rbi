# The Anthropic Messages API on Bedrock's InvokeModel endpoints, which
# serve every Claude model and cross-region inference profile. Unlike
# Converse, it carries Anthropic's own features, such as tool search,
# so a prompt cache survives the tools a model loads on demand.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:12
class RubyLLM::Providers::Bedrock::Anthropic < ::RubyLLM::Protocols::Anthropic
  include ::RubyLLM::Protocols::Bedrock::EventStream

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:53
  def called_model_id(named); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:18
  def completion_url; end

  # Bedrock counts tokens for the foundation model, not for the
  # inference profiles that serve it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:28
  def count_tokens_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:39
  def parse_count_tokens_response(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:49
  def parse_model_id(data); end

  # The body names the foundation model; pricing and the transcript
  # follow the inference profile or ARN that was called.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:45
  def parse_response_model_id(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:57
  def provider_file_references?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:32
  def render_payload(messages, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:22
  def stream_url; end

  private

  # Bedrock still gates the tool search tool behind its beta.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:85
  def beta_headers(additional_headers, payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:121
  def inline_url_source(block); end

  # Bedrock does not fetch URLs, so remote images and documents travel
  # as their bytes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:105
  def inline_url_sources(blocks); end

  # Application inference profile ARNs contain '/', which Bedrock
  # expects escaped inside the model segment.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:128
  def model_path(model_id, action); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:77
  def post_count_tokens(payload); end

  # InvokeModel takes Anthropic's betas in the body, not as a header.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:92
  def render_invoke_body(payload, headers); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:72
  def stream_events(url, payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:63
  def sync_response(payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:116
  def url_source?(block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:99
  def without_beta_header(headers); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic.rb:15
RubyLLM::Providers::Bedrock::Anthropic::ANTHROPIC_VERSION = T.let(T.unsafe(nil), String)

# Bedrock Model Invocation Jobs whose records are InvokeModel bodies
# in the Anthropic Messages format.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic/batches.rb:9
module RubyLLM::Providers::Bedrock::Anthropic::Batches
  include ::RubyLLM::Batch::Helpers
  include ::RubyLLM::Protocols::Bedrock::Batches

  private

