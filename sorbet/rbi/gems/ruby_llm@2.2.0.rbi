# Raised when polling exceeds its deadline. The independent job may
# still be running; Error#job retains its ID.
#
# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:33
class RubyLLM::ResearchJob::TimeoutError < ::RubyLLM::ResearchJob::Error; end

# A sandbox runs commands RubyLLM did not write, such as the code a model
# sends to Chat#with_code_execution, and holds the whole policy for them:
# what they may read and write, which hosts they reach, where they start,
# and how long they run. Define one as an MXC::Sandbox class from the mxc
# gem:
#
#   class ReadOnlySandbox < MXC::Sandbox
#     timeout 120
#   end
#
#   class WorkspaceSandbox < MXC::Sandbox
#     directory Rails.root.join("storage/workspace")
#     writable Rails.root.join("storage/workspace")
#     timeout 300
#   end
#
#   RubyLLM.configure do |config|
#     config.sandbox = "ReadOnlySandbox"
#   end
#
# A String names the class and is looked up whenever a chat needs it,
# so in Rails the classes live in +app/sandboxes+, autoload, and reload
# like the rest of the application.
#
# A sandbox may be an MXC::Sandbox class or instance, or any other class
# or object whose instances answer two methods:
#
#   class RemoteSandbox
#     def supported?
#       true
#     end
#
#     def run(*command, timeout:, readable: [], writable: [], denied: [], directory: nil, env: {}, network: nil)
#       # Runs +command+ and returns an object answering stdout, stderr,
#       # exit_code, and timed_out?
#     end
#   end
#
# +run+ takes the command like Kernel#system: one String for the shell,
# or a program and its arguments. The keywords are what RubyLLM adds to
# the sandbox's own policy for one run: +readable+ and +writable+ paths
# holding the run's files, +denied+ paths it must not see, even inside
# readable ones, the +directory+ to start in when the sandbox has none of
# its own, and +env+, the environment the run's languages and packages
# need. +timeout+ is the sandbox's own, or 120 seconds when it answers
# +timeout+ with +nil+ or not at all. +network+ is +nil+ for the
# sandbox's own access; RubyLLM passes <tt>{ allow: [...] }</tt> only to
# install declared packages from their registries. With a block, +run+
# may yield each line of output as it arrives, from standard output and
# standard error, like IO#each_line, and code execution reports the
# lines as progress; a sandbox may ignore the block. The result may also
# answer +blocked+, the hosts the network policy refused. A sandbox may
# answer +reason+, which RubyLLM adds to the error it raises when
# #supported? is false, and +with_libraries_of+, taking paths and
# returning a sandbox whose runs may load the libraries those files
# link, which RubyLLM calls with Ruby and its extensions. It may also
# answer +readable+, +writable+, +network+, +directory+, and +timeout+,
# which describe it to the model and to the person approving an
# escalation.
#
# pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:63
module RubyLLM::Sandbox
  class << self
    # Returns the class a String names. Raises ConfigurationError when
    # nothing by that name is defined.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:114
    def constant(name); end

    # Returns the name the model uses for +value+: its class name without
    # a +Sandbox+ suffix, in snake case, so WorkspaceSandbox is
    # +workspace+.
    #
    # Raises ArgumentError when the class has no name.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:95
    def name_for(value); end

    # Returns a runner for the sandbox +value+ describes, or +nil+ for
    # none. A String names the sandbox class, looked up on each call.
    # An MXC::Sandbox runs on +backend+ on Linux unless it names its own.
    #
    # Raises ConfigurationError for a value that is not a sandbox, or for
    # a backend other than those in BACKENDS.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:77
    def resolve(value, backend: T.unsafe(nil)); end

    # Raises ConfigurationError unless +sandbox+ can run on this machine.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:105
    def verify(sandbox); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:122
    def backend_name(backend); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:130
    def class_name(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:136
    def mxc?(value); end
  end
end

# The values Configuration#sandbox_backend accepts.
#
# pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:68
RubyLLM::Sandbox::BACKENDS = T.let(T.unsafe(nil), Array)

# Seconds a run may take when the sandbox sets no timeout.
#
# pkg:gem/ruby_llm#lib/ruby_llm/sandbox.rb:65
RubyLLM::Sandbox::DEFAULT_TIMEOUT = T.let(T.unsafe(nil), Integer)

# Rewrites a policy for Landlock, which grants whole directory trees
# and cannot take part of one away. Each readable or writable path that
# holds a denied one is replaced by the entries around it, down to the
# denied path, so the policy hides the same paths without denying
# anything inside a granted tree. Entries added later to a directory
# granted entry by entry stay hidden. A writable path cannot be split
# that way, since creating files needs the directory itself, so a
# denied path inside one raises ConfigurationError. Paths compare by
# where they really lead, since that is what Landlock grants.
#
# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:14
module RubyLLM::Sandbox::Landlock
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:40
  def around(paths, denied); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:44
  def entries(path, denied); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:53
  def hidden?(path, denied); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:73
  def inside?(path, root); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:17
  def policy(sandbox); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:57
  def reaches?(path, denied); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:66
  def real(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:30
  def refuse_writable(writable, denied); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:40
    def around(paths, denied); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:44
    def entries(path, denied); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:53
    def hidden?(path, denied); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:73
    def inside?(path, root); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:17
    def policy(sandbox); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:57
    def reaches?(path, denied); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:66
    def real(path); end

    # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/landlock.rb:30
    def refuse_writable(writable, denied); end
  end
end

# Runs commands with an MXC::Sandbox class or instance from the mxc gem:
# Bubblewrap on Linux, unless Configuration#sandbox_backend or the
# sandbox asks for Landlock, Seatbelt on macOS, and process containers
# on Windows. Each run starts from a fresh copy of the sandbox's policy
# and adds only what RubyLLM passes for that run.
#
# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:10
class RubyLLM::Sandbox::MXC
  # Raises ConfigurationError when the installed mxc is older than
  # MINIMUM_VERSION.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:29
  def initialize(policy, backend: T.unsafe(nil), libraries: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:48
  def backend; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:52
  def directory; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:79
  def inspect; end

  # Returns a runner for a sandbox with none of this one's access, on
  # the same backend, for RubyLLM's own package installs.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:58
  def isolated; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:25
  def libraries; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:54
  def limits; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:51
  def network; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:25
  def policy; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:49
  def readable; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:40
  def reason; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:69
  def run(*command, timeout:, readable: T.unsafe(nil), writable: T.unsafe(nil), denied: T.unsafe(nil), directory: T.unsafe(nil), env: T.unsafe(nil), network: T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:36
  def supported?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:53
  def timeout; end

  # Returns a runner whose commands may load the libraries +binaries+
  # link, such as an interpreter's extensions. mxc before 0.4 cannot
  # grant them, and runs without.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:65
  def with_libraries_of(*binaries); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:50
  def writable; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:130
  def apply_network(run, network); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:126
  def linux?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:119
  def remediation(backend, availability); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:85
  def require_minimum_version; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:95
  def run_by_line(run, command); end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:114
  def sandbox; end

  # pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:110
  def text(bytes); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:13
RubyLLM::Sandbox::MXC::BUBBLEWRAP_REMEDIATION = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:11
RubyLLM::Sandbox::MXC::DOCS = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:20
RubyLLM::Sandbox::MXC::LANDLOCK_OPT_IN = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:22
RubyLLM::Sandbox::MXC::MINIMUM_VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/sandbox/mxc.rb:12
RubyLLM::Sandbox::MXC::NAMESPACES = T.let(T.unsafe(nil), Regexp)

# A probability-weighted position on a judgment's ordered levels.
#
# pkg:gem/ruby_llm#lib/ruby_llm/score.rb:5
class RubyLLM::Score
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:20
  def initialize(score:, levels:, probabilities:, confidence:); end

  # Returns the provider's confidence in the distribution, between 0 and 1.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:18
  def confidence; end

  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:38
  def inspect_attributes; end

  # Returns the ordered descriptions, preserving structured Hashes and Arrays.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:12
  def levels; end

  # Returns each zero-based Integer level index's probability.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:15
  def probabilities; end

  # Returns the weighted score, which can fall between level indexes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:9
  def score; end

  # Returns the answer as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:34
  def to_h; end

  # Returns :score.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/score.rb:29
  def type; end
end

# A SearchResults wraps documents a Tool returns so the model can cite
# each source. RubyLLM renders them in the selected provider's citation
# format; cited passages appear on Message#citations.
#
#   def execute(query:)
#     docs = MyVectorStore.search(query)
#
#     RubyLLM::SearchResults.new(
#       *docs.map { |doc| { title: doc.name, url: doc.link, text: doc.body } }
#     )
#   end
#
# Cited passages come back on the response as Message#citations. Give a
# result a +:source_id+ String, such as a Global ID, to identify it to
# your app; its citations return it as Citation#source_id.
#
#   RubyLLM::SearchResults.new(title: doc.name, source_id: doc.to_global_id.to_s, text: doc.body)
#
# pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:21
class RubyLLM::SearchResults
  # Returns a new SearchResults built from one or more result hashes, or
  # from a single result given as keywords.
  #
  #   RubyLLM::SearchResults.new(title: 'Q4 Report', url: report_url, text: report_text)
  #   RubyLLM::SearchResults.new({ title: 'A', text: '...' }, { title: 'B', text: '...' })
  #
  # Each result is reduced to its +:title+, +:url+, +:source_id+, and
  # +:text+ entries.
  # Raises ArgumentError if no results are given or a result is missing
  # +:title+ or +:text+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:38
  def initialize(*results, **result); end

  # The normalized results, as an array of hashes with +:title+, +:text+,
