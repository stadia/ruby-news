  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic/batches.rb:20
  def bedrock_model_input(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic/batches.rb:25
  def parse_bedrock_model_output(body, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/anthropic/batches.rb:18
