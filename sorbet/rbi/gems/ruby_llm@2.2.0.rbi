# pkg:gem/ruby_llm#lib/ruby_llm/transport/signing_middleware.rb:10
class RubyLLM::Transport::SigningMiddleware < ::Faraday::Middleware
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/signing_middleware.rb:13
  def call(env); end

  private

  # A nil value removes a header an earlier attempt was signed with.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/signing_middleware.rb:22
  def sign(headers, signed); end
end

