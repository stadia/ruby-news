  def signed_connection(base_url, service: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:334
  def video_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:254
  def voxtral_transcription?(operation, model_id); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:32
    def between_tools_off?(model_id); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:40
