# Shared plumbing for protocols served by the bedrock-mantle endpoint.
# Mantle speaks the vendors' own wire formats rather than Converse, so
# each protocol subclasses its family and mixes this in to borrow the
# provider's mantle connection and SigV4-sign every request for the
# bedrock-mantle service.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:11
module RubyLLM::Providers::Bedrock::Mantle
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:26
  def initialize(provider, model = T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:54
  def mantle_headers; end

  # OpenAI's GPT models answer only under /openai/v1, and every other
  # model, gpt-oss included, only under /v1.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:35
  def openai_api_path; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:44
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:50
  def stream_response(payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:40
  def sync_response(payload, additional_headers = T.unsafe(nil)); end
end

