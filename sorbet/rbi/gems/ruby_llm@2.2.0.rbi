# A Provider connects RubyLLM to one AI service. It knows where to talk
# (host, authentication headers, configuration) and which protocol to
# speak for a given model and request. The wire formats themselves live
# under RubyLLM::Protocols.
#
# Subclass Provider to support a new service, then make it available
# with ::register:
#
#   class Acme < RubyLLM::Provider
#     protocol :chat_completions, RubyLLM::Protocols::ChatCompletions
#
#     def self.configuration_options
#       %i[acme_api_key]
#     end
#
#     def api_base
#       'https://api.acme.ai/v1'
#     end
#
#     def headers
#       { 'Authorization' => "Bearer #{@config.acme_api_key}" }
#     end
#   end
#
#   RubyLLM::Provider.register :acme, Acme
#
# See the custom providers guide for the full walkthrough.
#
# pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:35
class RubyLLM::Provider
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:52
  def initialize(config); end

  # Returns a String naming the account that owns the files this provider
  # uploads, or +nil+ to keep each upload within the process that made it.
  # The base implementation returns +nil+. Rails chats reuse an upload in
  # later processes only under the same identity, so build it from what
  # decides where uploaded files live, such as the endpoint and API key,
  # an organization or project, or a storage bucket. Digest anything
  # secret, and leave out credentials that rotate, such as session tokens:
  #
  #   def account_identity
  #     Digest::SHA256.hexdigest([api_base, @config.acme_api_key].join("\0"))
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:332
  def account_identity; end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:377
  def animate_later(prompt, model:, with: T.unsafe(nil), extend: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # Returns the base URL that relative endpoint paths resolve against.
  # The base implementation raises NotImplementedError, so every
  # subclass must define it.
  #
  #   def api_base
  #     @config.acme_api_base || 'https://api.acme.ai/v1'
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:66
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:488
  def assume_models_exist?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:275
  def batch_cost(tokens, model:, category: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:292
  def batch_cost_amounts(standard:, batch:, batch_tier:, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:286
  def batch_cost_missing(amounts, standard); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:305
  def batch_cost_multiplier(**); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:313
  def batch_protocol_name(protocol); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:260
  def batch_results(id, batch_protocol: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:266
  def batch_status(raw_status, completed:, batch_protocol: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:240
  def batches?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:442
  def cache_content(content, model:, ttl: T.unsafe(nil), instructions: T.unsafe(nil), with: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:227
  def cache_key?(model:, protocol: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:255
  def cancel_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:106
  def capabilities; end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:180
  def compact(messages, model:, protocol: T.unsafe(nil), headers: T.unsafe(nil), before_request: T.unsafe(nil), usage_recorder: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:140
  def complete(messages, tools:, temperature:, model:, provider_options: T.unsafe(nil), headers: T.unsafe(nil), schema: T.unsafe(nil), max_output_tokens: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil), protocol: T.unsafe(nil), before_request: T.unsafe(nil), usage_recorder: T.unsafe(nil), progress_recorder: T.unsafe(nil), provider_tools: T.unsafe(nil), compaction: T.unsafe(nil), end_user: T.unsafe(nil), &); end

  # The Configuration the provider was built with.
  #
