  #   message.full_inspect
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/support/inspectable.rb:35
  def full_inspect; end

  # Returns a one-line summary of the object built from its
  # +inspect_attributes+, omitting empty ones and truncating long values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/support/inspectable.rb:16
  def inspect; end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/inspectable.rb:26
  def pretty_print(printer); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/support/inspectable.rb:41
  def format_for_inspect(value); end
end

