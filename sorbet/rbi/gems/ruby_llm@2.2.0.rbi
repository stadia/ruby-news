  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:1105
  def idempotent?(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:1161
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:1062
  def listened_changes(uris, ids); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:1051
  def listener; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:955
