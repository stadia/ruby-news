# A Transcription is text produced from spoken audio. RubyLLM.transcribe
# returns one. It holds the transcript along with any metadata the provider
# reports, such as language, duration, and timed segments.
#
#   transcription = RubyLLM.transcribe("meeting.wav")
#   transcription.text   # => "Welcome to today's meeting..."
#   transcription.model  # => "gpt-transcribe"
#
# pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:12
class RubyLLM::Transcription
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result
  include ::RubyLLM::Accounting::Usage::ModelInfo

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:40
  def initialize(text:, model:, **attributes); end

  # Returns the transcription cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:62
  def cost; end

  # The audio duration in seconds, or +nil+ when the provider does not
  # report it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:28
  def duration; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:140
  def inspect_attributes; end

  # The language of the audio, or +nil+ when the provider does not report it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:24
  def language; end

  # The id of the model that produced the transcription.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:21
  def model; end

  # The timed segments of the transcript as an array of Segment objects,
  # or +nil+ when the provider does not return segments. Diarization
  # models add a speaker label to each segment.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:33
  def segments; end

  # The transcribed text.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:18
  def text; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:54
  def tokens; end

  # Word timing and speaker labels as an array of Segment objects, or
  # +nil+ when the provider does not return them. Request timing with
  # +timestamps:+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:38
  def words; end

  class << self
    # Transcribes +audio_file+ and returns a Transcription. The file may be
    # a path, URL, IO object, or Attachment. Uses
    # <tt>config.default_transcription_model</tt> unless +model:+ is given.
    # Pass +provider:+ and <tt>assume_model_exists: true</tt> to use a model
    # that is not in the registry.
    #
    #   RubyLLM.transcribe("meeting.wav")
    #   RubyLLM.transcribe("entrevista.mp3", language: "es")
    #   RubyLLM.transcribe(
    #     "team-meeting.wav",
    #     model: "gpt-4o-transcribe-diarize",
    #     speaker_names: ["Alice", "Bob"],
    #     speaker_references: ["alice-voice.wav", "bob-voice.wav"]
    #   )
    #
    # +language:+ hints at the spoken language using the provider's accepted
    # ISO 639-1 or BCP-47 language code. Some providers also take an Array
    # of candidate languages and report the one spoken as #language.
    # +prompt:+ gives the model vocabulary or formatting guidance, and
    # +temperature:+ adjusts sampling. +format:+ selects the transcript
    # format in the provider's own vocabulary: OpenAI takes values such as
    # <tt>"text"</tt>, <tt>"verbose_json"</tt>, or <tt>"diarized_json"</tt>,
    # while Gemini takes a MIME type such as <tt>"text/plain"</tt>.
    # +speaker_names:+ and +speaker_references:+ label the speakers on
    # models that support diarization; references may be paths, URLs, IO
    # objects, or Attachments. Option support depends on the selected model
    # and provider.
    # +timestamps:+ requests +:word+ timestamps. Some providers also accept
    # +:segment+ or +:character+; unsupported granularities raise ArgumentError.
    # +provider_options:+ takes options in the provider's request vocabulary
    # and merges them into the rendered request as-is.
    # +owner:+ attributes the usage to a record, such as a user, and wins
    # over RubyLLM.with_owner.
    #
    # Given a block, the transcript streams: each TranscriptionChunk is
    # yielded as it arrives and the completed Transcription is still
    # returned. Partial chunks replace earlier tentative text; only
    # +delta+ fields append to the committed transcript. WebSocket-based
    # providers require the optional +websocket-driver+ gem.
    #
    #   transcription = RubyLLM.transcribe("meeting.wav", model: "gpt-4o-transcribe") do |chunk|
    #     print chunk.delta
    #   end
    #
    # Raises RubyLLM::ModelNotFoundError if +model:+ is not in the registry,
    # and RubyLLM::Error when a block is given to a provider that does not
    # stream transcriptions.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:115
    def transcribe(audio_file, model: T.unsafe(nil), language: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), prompt: T.unsafe(nil), temperature: T.unsafe(nil), format: T.unsafe(nil), timestamps: T.unsafe(nil), speaker_names: T.unsafe(nil), speaker_references: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil), &block); end
  end
end

# A timed piece of a transcript: an entry of Transcription#segments or
# Transcription#words, or the TranscriptionChunk#segment a stream
# completed. Readers cover what providers share; #[] and #to_h reach
# the rest under the provider's own field names.
#
#   transcription.segments.each do |segment|
#     puts "#{segment.speaker} at #{segment.start}s: #{segment.text}"
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:14
class RubyLLM::Transcription::Segment
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:21
  def initialize(attributes); end

  # Returns +true+ for a Segment or Hash holding the same fields.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:56
  def ==(other); end

  # Returns the provider's field named +key+, a String or Symbol.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:38
  def [](key); end

  # When the text ends, in seconds from the start of the audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:35
  def end; end

  # Returns the provider's field named +key+ the way Hash#fetch does.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:43
  def fetch(key, *, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:49
  def has_key?(key); end

  # Returns +true+ when the provider sent a field named +key+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:48
  def key?(key); end

  # The speaker label, or +nil+ on models that do not separate speakers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:29
  def speaker; end

  # When the text starts, in seconds from the start of the audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:32
  def start; end

  # The spoken text, or +nil+ when the provider reports none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:26
  def text; end

  # Returns the provider's fields as a Hash with String keys.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:52
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:53
  def to_hash; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:62
  def inspect_attributes; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/transcription/segment.rb:17
    def wrap(segments); end
  end
end

