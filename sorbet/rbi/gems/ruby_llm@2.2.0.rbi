  # pkg:gem/ruby_llm#lib/ruby_llm/judgment.rb:68
  def inspect_attributes; end

  # Returns the actual model ID reported by the provider.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/judgment.rb:22
