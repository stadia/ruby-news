  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/outline.rb:89
  def render(format, count, level); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/outline.rb:60
  def resolve(id); end

