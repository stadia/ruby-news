  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:34
  def run_with_threads(rounds, paused:, on_result:, config:, &execute); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:141
