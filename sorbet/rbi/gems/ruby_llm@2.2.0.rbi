# Google Vertex AI implementation
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:6
class RubyLLM::Providers::VertexAI < ::RubyLLM::Provider
  include ::RubyLLM::Protocols::Gemini::RetryInfo

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:63
  def initialize(config); end

  # Uploads are objects in the configured bucket, readable with any
  # credentials the bucket admits.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:137
  def account_identity; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:131
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:142
  def api_base_for(location); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:124
  def batch_cost_multiplier(model:, component:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:117
  def find_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:192
  def google_credentials; end

  # The rescue can't name Google::Auth::AuthorizationError directly:
  # when googleauth is missing, evaluating the constant would replace
  # the helpful install error with a NameError.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:184
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:89
  def location_path; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:93
  def model_path(model, publisher: T.unsafe(nil)); end

  # Vertex AI hosts models from several publishers, each speaking its
  # native protocol. Publisher-prefixed ids are MaaS models served
  # through the OpenAI-compatible endpoint.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:71
  def protocol_for(model, operation: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:155
  def ranking_config; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:160
  def ranking_connection; end

  # Signs each attempt as it is sent, so a retry never replays an access
  # token that expired while the previous attempt waited.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:177
  def signed_connection(base_url, headers: T.unsafe(nil)); end

  # Cloud Text-to-Speech answers at the multi-region or region named by
  # vertexai_location, never at the global endpoint unless asked for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:169
  def text_to_speech_connection; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:223
  def audio_protocol_for(id, operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:97
  def batch_protocol; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:101
  def batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:246
  def batch_protocol_for_model_path(model_path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:237
  def batch_protocol_name_for(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:217
  def text_to_speech_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:230
  def transcription_protocol_for(id); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:32
    def between_tools_off?(model_id); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:40
    def cache_write_input_multiplier(model_id, ttl); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:28
    def capabilities; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:197
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:210
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:44
    def models_dev_alias(*, **, &); end

    # models.dev pins Vertex AI models to a version (claude-haiku-4-5@20251001);
    # Vertex AI serves them by bare name.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:50
    def models_dev_model_id(id); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:58
    def models_dev_provider_ids; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:54
    def open_telemetry_name; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:36
    def thinking_off_control(model_id); end
  end
end

