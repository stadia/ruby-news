# Counts a request through Mistral's Responses input-token endpoint,
# the only token counting route Mistral offers, whichever protocol the
# chat itself runs on.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/input_tokens.rb:9
class RubyLLM::Providers::Mistral::InputTokens < ::RubyLLM::Protocols::Responses
  include ::RubyLLM::Protocols::Responses::TokenCounting

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/input_tokens.rb:12
  def render_count_tokens_payload(messages, **); end

  private

  # Native content from other protocols doesn't fit Responses input,
  # and the endpoint can't take unsigned thinking, so thinking goes in
  # as text to keep it in the count.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/input_tokens.rb:27
  def countable_messages(message); end

  # Mistral rejects an input item that doesn't name its type.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/input_tokens.rb:20
  def typed_item(item); end
end

