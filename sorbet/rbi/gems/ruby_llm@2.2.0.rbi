# A prompt an MCP server offers: messages written by the server and
# filled in with your arguments. Ask a chat with it like a question.
#
#   github.prompts                     # => [#<RubyLLM::MCP::Prompt name: "code_review", ...>]
#   review = github.prompt(:code_review, code: diff)
#   review.messages                    # => [#<RubyLLM::Message role: :user, ...>]
#   chat.ask review
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:13
class RubyLLM::MCP::Prompt
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:36
  def initialize(mcp, data, messages: T.unsafe(nil)); end

  # The arguments the prompt takes, as Argument objects.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:34
  def arguments; end

  # What the prompt does, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:31
  def description; end

  # Returns the prompt's messages as Message objects. A prompt from
  # MCP#prompts has none until you fill it in with MCP#prompt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:50
  def messages; end

  # The prompt's name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:25
  def name; end

  # Asks the server to complete an argument's partial value. Pass one
  # argument to complete and any others that are already filled in.
  # Returns an Array of suggested values.
  #
  #   github.prompts.first.suggest(language: "ru")  # => ["ruby", "rust"]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:60
  def suggest(**arguments); end

  # A human-readable title, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:28
  def title; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:66
  def inspect_attributes; end
end

# An argument a prompt takes.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
class RubyLLM::MCP::Prompt::Argument < ::Struct
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
