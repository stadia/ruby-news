# Sits outside everything on a connection without retries, so an error
# leaves it without the credentials of the request it answers.
#
# pkg:gem/ruby_llm#lib/ruby_llm/transport/release_request.rb:9
class RubyLLM::Transport::ReleaseRequest < ::Faraday::Middleware
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/release_request.rb:27
  def call(env); end

  class << self
    # The response outlives the call as Message#raw, Error#response, and
    # other results, which applications log and report. The request holds
    # the API key in its headers, the whole serialized conversation in its
    # body, and the provider and signer in its context, and a streaming
    # callback closes over the payload it was built from.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/transport/release_request.rb:15
    def release(response); end
  end
end

# Sits inside Faraday retry middleware so every transport attempt is
# signed when it is sent, over the body it sends. A signature computed
# once before the first attempt can expire before a retry goes out.
