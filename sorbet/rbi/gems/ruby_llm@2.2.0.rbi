# Chat methods for the Cohere v2 API implementation
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:7
module RubyLLM::Protocols::Cohere::Chat
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:51
  def add_optional_fields(payload, messages, temperature:, max_output_tokens:, citations:, schema:); end

  # Reasoning is on by default for models that support it, so an
  # explicit disable is as meaningful as an explicit enable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:85
  def add_thinking(payload, thinking); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:65
  def add_tools(payload, tools, tool_prefs); end

  # Cohere takes a bare JSON Schema under json_schema, with no name or
  # strict wrapper.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:75
  def build_response_format(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:43
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:214
  def citation_span(data, offsets); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:234
  def citation_url(document); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:22
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:14
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:16
  def normalize_finish_reason(reason); end

  # Only citations of the response text carry offsets into #content.
  # Citations of the thinking blocks or the tool plan point into text
  # RubyLLM exposes elsewhere, so they keep their snippet without a span.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:197
  def parse_citation(data, offsets = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:190
  def parse_citations(citations, offsets); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:117
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:138
  def parse_completion_usage(data); end

  # Returns the joined text of the response along with the offset each
  # content block starts at, so citation spans resolve against the
  # content string RubyLLM exposes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:168
  def parse_text(blocks); end

  # The tool plan is the model's reasoning for a tool-calling turn, and
  # is the only reasoning Cohere returns when thinking blocks are absent.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:184
  def parse_thinking(blocks, message_data); end

  # Cohere answers a generation that failed on its side with an ERROR
  # finish reason instead of an error status.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:144
  def raise_failed_generation(message, response: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:45
  def reject_caching_options(caching); end

  # Cohere returns tool_plan alongside tool calls, and RubyLLM surfaces
  # it as thinking, but the newer models reject it on the way back in.
  # It is optional in a request, so the plan stays out of the history.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:109
  def render_assistant_message(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:96
  def render_message(msg, citations: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:92
  def render_messages(messages, citations: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:26
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:228
  def source_document(source); end

  # Documents RubyLLM sends, and those Cohere numbers itself, are
  # identified as doc:N where N is the document's position.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:247
  def source_index(source); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:223
  def text_citation?(data); end

  # Cohere cites a tool output by the id its document was sent with,
  # so a search result comes back with its source_id or URL.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:241
  def tool_output_id(source); end

  # Cohere reports what it charges for under billed_units and what the
  # model processed under tokens. The processed counts and cached_tokens
  # include Cohere's own preamble, which it does not bill, so a reply's
  # usage is its billed units.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:154
  def usage_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:58
  def warn_unsupported_citations(model); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:51
    def add_optional_fields(payload, messages, temperature:, max_output_tokens:, citations:, schema:); end

    # Reasoning is on by default for models that support it, so an
    # explicit disable is as meaningful as an explicit enable.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:85
    def add_thinking(payload, thinking); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:65
    def add_tools(payload, tools, tool_prefs); end

    # Cohere takes a bare JSON Schema under json_schema, with no name or
    # strict wrapper.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:75
    def build_response_format(schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:43
    def cache_option_names; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:214
    def citation_span(data, offsets); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:234
    def citation_url(document); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:22
    def completion_url; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:14
    def finish_reasons; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:16
    def normalize_finish_reason(reason); end

    # Only citations of the response text carry offsets into #content.
    # Citations of the thinking blocks or the tool plan point into text
    # RubyLLM exposes elsewhere, so they keep their snippet without a span.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:197
    def parse_citation(data, offsets = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:190
    def parse_citations(citations, offsets); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:117
    def parse_completion_body(data, raw:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:138
    def parse_completion_usage(data); end

    # Returns the joined text of the response along with the offset each
    # content block starts at, so citation spans resolve against the
    # content string RubyLLM exposes.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:168
    def parse_text(blocks); end

    # The tool plan is the model's reasoning for a tool-calling turn, and
    # is the only reasoning Cohere returns when thinking blocks are absent.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:184
    def parse_thinking(blocks, message_data); end

    # Cohere answers a generation that failed on its side with an ERROR
    # finish reason instead of an error status.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:144
    def raise_failed_generation(message, response: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:45
    def reject_caching_options(caching); end

    # Cohere returns tool_plan alongside tool calls, and RubyLLM surfaces
    # it as thinking, but the newer models reject it on the way back in.
    # It is optional in a request, so the plan stays out of the history.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:109
    def render_assistant_message(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:96
    def render_message(msg, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:92
    def render_messages(messages, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:26
    def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:228
    def source_document(source); end

    # Documents RubyLLM sends, and those Cohere numbers itself, are
    # identified as doc:N where N is the document's position.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:247
    def source_index(source); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:223
    def text_citation?(data); end

    # Cohere cites a tool output by the id its document was sent with,
    # so a search result comes back with its source_id or URL.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:241
    def tool_output_id(source); end

    # Cohere reports what it charges for under billed_units and what the
    # model processed under tokens. The processed counts and cached_tokens
    # include Cohere's own preamble, which it does not bill, so a reply's
    # usage is its billed units.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:154
    def usage_tokens(usage); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:58
    def warn_unsupported_citations(model); end
  end
end

