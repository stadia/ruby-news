  # pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:356
  def moderate(input, model:, with: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # Returns the human-readable provider name, delegating to
  # ::display_name.
  #
