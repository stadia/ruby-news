# A file in a FileStore: its path, size, content type, and a digest of
# its content. FileStore#list and FileStore#find return them, and
# Chat#after_file_write callbacks receive each one the conversation
# writes.
#
#   chat.file_store.list
#   # => [#<RubyLLM::StoredFile path: "report.pdf", byte_size: 2201344, content_type: "application/pdf">]
#
# pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:12
class RubyLLM::StoredFile
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:37
  def initialize(path:, byte_size:, content_type:, digest: T.unsafe(nil), updated_at: T.unsafe(nil), owner: T.unsafe(nil)); end

  # Returns whether +other+ is a StoredFile with the same path, size,
  # content type, and digest.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:74
  def ==(other); end

  # The size of the file in bytes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:20
  def byte_size; end

  # The MIME type of the file, such as <tt>"application/pdf"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:23
  def content_type; end

  # A digest of the file's content that changes whenever the content
  # does, or +nil+ when the store does not know one without reading the
  # file. Stores in the box use SHA-256 in hex.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:28
  def digest; end

  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:77
  def eql?(other); end

  # Returns the last part of #path.
  #
  #   file.path     # => "reports/q3.pdf"
  #   file.filename # => "q3.pdf"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:51
  def filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:79
  def hash; end

  # Returns the file's size for people and models to read, such as
  # <tt>"2.1 MB"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:63
  def human_size; end

  # Who wrote the file, for stores that keep one, or +nil+. RubyLLM
  # stores it and hands it back without interpreting it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:35
  def owner; end

  # The path of the file inside its store, relative and with forward
  # slashes, such as <tt>"reports/q3.pdf"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:17
  def path; end

  # Returns whether the content is text, like source code, CSV, or
  # Markdown, judged by its content type.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:57
  def text?; end

  # Returns the attributes as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:84
  def to_h; end

  # When the file was last written, or +nil+ when the store does not say.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:31
  def updated_at; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/stored_file.rb:90
  def inspect_attributes; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/provider.rb:36
module RubyLLM::Support; end

# Lets work that runs inside a chat operation, such as a tool waiting on
# a remote server, stop when the chat is cancelled. The chat installs a
# checkpoint for the current fiber; #check raises CancelledError once
# the chat has been cancelled.
#
# pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:9
module RubyLLM::Support::Cancellation
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:23
  def check; end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:27
  def pause(seconds); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:15
  def watch(checkpoint); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:23
    def check; end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:27
    def pause(seconds); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/cancellation.rb:15
    def watch(checkpoint); end
