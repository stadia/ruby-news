# Chat methods of the OpenAI API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:7
module RubyLLM::Protocols::ChatCompletions::Chat
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:25
  def completion_url; end

  # OpenAI names the rejected parameter in +param+ and why in +code+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:30
  def parse_unsupported_parameter(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:42
  def unsupported_parameter_error?(error); end

  # The wire parameters that carry RubyLLM settings, by name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:49
  def wire_parameters; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:270
  def annotated_text(content, start_index, end_index); end

  # safety_identifier is an OpenAI parameter; the other services on
  # this wire format reject or ignore it, so only OpenAI's own
  # endpoints receive it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:470
  def apply_end_user(payload, identifier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:299
  def apply_prompt_cache_params(payload, caching); end

  # Assistant messages take only text, so a replayed turn's attachments
  # ride a user message after it, as on Responses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:405
  def assistant_attachment_message(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:409
  def attachment_message(label, attachments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:383
  def attachments_only_assistant_message?(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:319
  def build_prompt_cache_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:436
  def cache_breakpoint_parts(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:352
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:228
  def cache_read_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:232
  def cache_write_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:379
  def carrier?(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:480
  def default_large_file_upload_threshold; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:245
  def extract_citations(message_data, data, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:53
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:354
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:220
  def generated_tokens_from_total(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:428
  def inject_cache_breakpoint(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:200
  def input_tokens(usage); end

  # OpenAI and Azure reject max_tokens on their reasoning models and
  # accept max_completion_tokens on every model; the rest of the wire
  # format only knows max_tokens.
  #
