    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:27
    def rounds(tool_calls, exclusive); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:80
    def run_fiber_round(task, round, results, caller_context, contexts, on_result:, &execute); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:61
