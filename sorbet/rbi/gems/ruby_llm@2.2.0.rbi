  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:54
  def initialize(type:, raw:, name: T.unsafe(nil), id: T.unsafe(nil), input: T.unsafe(nil), result: T.unsafe(nil), search_suggestions: T.unsafe(nil)); end

  # The provider's identifier for the call, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:28
  def id; end

  # The input the model gave the tool (a query, code to run), in the
  # provider's shape, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:32
  def input; end

  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:77
  def inspect_attributes; end

  # The tool name when the provider reports one, such as
  # <tt>"web_search"</tt>, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:25
  def name; end

  # The complete provider block as received, used verbatim when the
  # conversation is sent back to the provider.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:40
  def raw; end

  # The tool's output in the provider's shape, or +nil+ for blocks that
  # only record the invocation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:36
  def result; end

  # The HTML of the search suggestions the provider requires you to show
  # with a grounded answer, such as Google's for Google Search grounding,
  # or +nil+. Only the live response carries them: #to_h leaves them out,
  # so a persisted chat never stores them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:46
  def search_suggestions; end

  # Returns the call's attributes as a Hash, omitting +nil+ values and
  # #search_suggestions.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:66
  def to_h; end

  # The provider's block or item type, such as <tt>"server_tool_use"</tt>,
  # <tt>"web_search_tool_result"</tt>, or <tt>"web_search_call"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:21
  def type; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:48
    def from_h(data); end
  end
end

