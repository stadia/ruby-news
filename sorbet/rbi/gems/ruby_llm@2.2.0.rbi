# pkg:gem/ruby_llm#lib/ruby_llm/code_execution/ruby_installation.rb:19
RubyLLM::CodeExecution::RubyInstallation::BUILD_MARKER = T.let(T.unsafe(nil), String)

# Ruby's bundled gems that Gem::BUNDLED_GEMS::SINCE may leave out, by
# the Ruby version that first bundled them. SINCE lists only the gems
# that recently stopped being default gems, and an installed Ruby
# keeps no other list of them.
#
# pkg:gem/ruby_llm#lib/ruby_llm/code_execution/ruby_installation.rb:25
RubyLLM::CodeExecution::RubyInstallation::BUNDLED_GEMS = T.let(T.unsafe(nil), Hash)

# pkg:gem/ruby_llm#lib/ruby_llm/code_execution/ruby_installation.rb:18
RubyLLM::CodeExecution::RubyInstallation::HIDDEN_DIRECTORIES = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:50
RubyLLM::CodeExecution::USAGE_COUNTER = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:49
RubyLLM::CodeExecution::USAGE_PROVIDER = T.let(T.unsafe(nil), String)

# The directories one run gets: a fresh working directory holding a
# link, +attachments+, to read-only copies of the conversation's files
# beside it, writable copies of the files named from a chat's FileStore,
# links to read-only mounts, separate home and temporary directories, and the
# source file. Nothing read-only sits inside the writable working
# directory, which Landlock could not keep read-only. Everything is
# removed when the run ends. Links to mounts placed in a store's own
# folder stay until the last run in that folder ends.
#
# pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:18
class RubyLLM::CodeExecution::Workspace
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:102
  def initialize(root, attachments: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:220
  def close_outputs; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:181
  def copy_files(store, files); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:162
  def copy_in(attachments); end

  # Copies +files+, StoredFiles of the conversation's files, to
  # +attachments/+ at their paths in +store+, where the model finds them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:173
  def copy_stored_inputs(store, files); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def directory; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def home; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def inputs; end

  # Returns +files+, from #outputs, copied to tempfiles that outlive
  # the workspace, one file at a time.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:212
  def keep(files); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:158
  def link_packages(node_modules); end

  # Links each mount into +into+ and returns the targets. Into a folder
  # other than the working directory, a link reuses one already there
  # to the same target, leaves a path that holds anything else alone
  # (see #unmounted), and is removed with the folders it made by
  # #remove_links.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:129
  def mount(mounts, into: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:193
  def outputs(max_files:, max_size:, unchanged: T.unsafe(nil)); end

  # Ends this run in a store's folder. The last run there removes what
  # the runs placed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:141
  def remove_links; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def source; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def tmp; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:30
  def unmounted; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:154
  def write_source(language, code); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:253
  def make_parents(folder, root); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:273
  def make_room(path, base); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:309
  def open_output(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:283
  def output_paths; end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:294
  def output_size(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:237
  def place(link, target); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:226
  def place_all(mounts, into); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:242
  def place_in_store(link, target, root); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:263
  def remove_placed(path, target); end

  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:303
  def unchanged?(path, size, copied); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:51
    def filename(name); end

    # Returns each attachment's name under +attachments/+, newest first:
    # the newest keeps its name, as it would on a disk, and an older one
    # stays readable beside it. Names compare without case, for the
    # filesystems that do, and files with equal content share one.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:67
    def input_names(attachments); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:59
    def invalid_name(name); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:115
    def mount_path(name); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:32
    def open(attachments: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:43
    def unlock(root); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:82
    def different?(holder, attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:87
    def input_folders(attachments); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:95
    def numbered_names(name); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:22
RubyLLM::CodeExecution::Workspace::ATTACHMENTS = T.let(T.unsafe(nil), String)

