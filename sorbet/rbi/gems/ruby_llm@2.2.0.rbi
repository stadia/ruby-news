RubyLLM::Transport::EventStreamParser::LF = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:13
RubyLLM::Transport::EventStreamParser::LINE_BREAK = T.let(T.unsafe(nil), Regexp)

# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:17
RubyLLM::Transport::EventStreamParser::SPACE = T.let(T.unsafe(nil), Integer)

