# Interprets a text/event-stream as the HTML standard describes, fed in
# whatever pieces the network delivers. Each dispatched event is yielded
# as its type, data, and last event ID. The last event ID and the
# reconnection time the server asked for stay readable between events.
# The standard ignores a line that names no known field; +on_unknown_line+
# receives each one, undecoded, for a caller that wants to look at it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:11
class RubyLLM::Transport::EventStreamParser
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:21
  def initialize(on_unknown_line: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:35
  def feed(chunk, &); end

  # Reads a last line the stream ended without a line break. It can't
  # complete an event, which needs a blank line after it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:51
  def finish; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:19
  def last_event_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:19
  def reconnection_time; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:61
  def compact; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:129
  def decode(bytes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:117
  def dispatch; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:88
  def line_end(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:107
  def process_field(field, value, line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:96
  def process_line(line, &); end

  # A carriage return that ended the previous piece may be the first
  # half of a CRLF pair.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:81
  def skip_line_feed_after_carriage_return; end

  # The stream decodes as UTF-8, which drops one byte order mark at its
  # very start, so the first bytes wait until they can be told apart.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:71
  def start; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:12
RubyLLM::Transport::EventStreamParser::BOM = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:15
RubyLLM::Transport::EventStreamParser::CR = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:14
RubyLLM::Transport::EventStreamParser::DIGITS = T.let(T.unsafe(nil), Regexp)

