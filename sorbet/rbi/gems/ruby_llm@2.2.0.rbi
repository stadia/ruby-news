RubyLLM::Agent::COPIED_INHERITED_CONFIG = T.let(T.unsafe(nil), Array)

# The Agent callback macros, such as Agent::after_message, which
# register the Chat callback of the same name on every chat an agent
# builds or finds. Each runs on the agent instance, like a Rails
# callback on its record. An agent that configures a chat again, as
# Agent.new(chat:) does for a chat from Agent::chat, takes over the
# callbacks already registered instead of adding them twice. As for
# Agent::rescue_from handlers, the agent behind a chat from Agent::chat
# or Agent::find is bound to it without running +initialize+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:13
module RubyLLM::Agent::Callbacks
  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def after_fallback(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def after_file_write(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def after_message(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def after_tool_progress(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def after_tool_result(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:82
  def apply_configuration(chat, input_values:, agent: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def around_tool_call(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def before_fallback(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def before_message(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def before_request(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:67
  def before_tool_call(method_name = T.unsafe(nil), **conditions, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:73
  def chat_callbacks; end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:77
  def inherited(subclass); end
end

# A declared callback: a method name or a block, with the +if:+ and
# +unless:+ conditions that guard it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:21
class RubyLLM::Agent::Callbacks::Callback
  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:22
  def initialize(hook, method_name, block, conditions); end

  # Runs the handler with +args+, passing +block+ on to it, as an
  # around callback's +run+. A skipped around callback runs +block+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:37
  def run(agent, args, &block); end

  private

  # instance_exec cannot pass a block on, so a handler that takes one
  # runs as a method of the agent instead.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:61
  def bound(handler); end

  # pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:46
  def call(agent, handler, args, &block); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/agent/callbacks.rb:14
RubyLLM::Agent::Callbacks::HOOKS = T.let(T.unsafe(nil), Array)

