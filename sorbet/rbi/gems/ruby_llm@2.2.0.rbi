  private

  # Whether the +name+ environment variable is set to something that means
  # yes, so that <tt>RUBYLLM_DEBUG=false</tt> reads as off rather than as
  # merely set.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:499
  def env_says_yes?(name); end

  # Copies file_converters too, so registering one on a context's copy,
  # <tt>config.file_converters["image/*"] = ...</tt>, leaves the
  # original alone.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:476
  def initialize_copy(source); end

  class << self
    # Returns the names of all declared options as an array of symbols,
    # including options registered by providers.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:50
    def options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:44
    def register_provider_options(options); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:57
    def defaults; end

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:28
    def option(key, default = T.unsafe(nil), &normalize); end

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:56
    def option_keys; end
  end
end

# Raised when required configuration, such as a provider API key, is
# missing, or when a setup can't do what a chat asks of it, such as a
# subagent added with +tools+ that stops to wait (see AgentTool).
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:143
class RubyLLM::ConfigurationError < ::StandardError; end

# Raised when a request never gets an answer from the provider or an
# MCP server: the connection is refused or drops, TLS fails, or the
# request times out. RubyLLM retries provider requests first, following
# Configuration#max_retries. The original Faraday error is its +cause+.
#
#   rescue RubyLLM::ConnectionError => e
#     retry_later if e.timeout?
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:347
class RubyLLM::ConnectionError < ::RubyLLM::Error
  # Returns whether the request timed out, including while opening the
  # connection or waiting for the next bytes of a stream, rather than
  # failing to connect.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:351
  def timeout?; end
end

# Some adapters, such as async-http-faraday, report a read that waited
# too long as a failed connection wrapping IO::TimeoutError.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:359
RubyLLM::ConnectionError::TIMEOUTS = T.let(T.unsafe(nil), Array)

# A ContentFilter is one verdict of the provider's content filtering on a
# request or its response, such as Azure's hate or protected material
# filters. They appear on Message#content_filters for providers that
# report them, whether or not they stopped the response, so you can see
# why a reply ended with Message#content_filtered? or what came close.
#
#   response = chat.ask "Summarize this paper"
#   response.content_filtered?                       # => true
#   response.content_filters.select(&:filtered?).map(&:category) # => ["hate"]
#
# A verdict names a category and a severity, never the text it judged.
#
# pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:15
class RubyLLM::ContentFilter
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:39
  def initialize(source:, category:, severity: T.unsafe(nil), filtered: T.unsafe(nil), detected: T.unsafe(nil)); end

  # The provider's name for the category, such as <tt>"hate"</tt>,
  # <tt>"jailbreak"</tt>, or <tt>"protected_material_text"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:26
  def category; end

  # Returns whether the provider detected what the category looks for,
  # such as a jailbreak attempt or protected material, or +nil+ for a
  # category judged by severity.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:55
  def detected?; end

  # Returns whether the filter blocked or cut the text it judged.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:48
  def filtered?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:64
  def inspect_attributes; end

  # The severity the provider gave, such as <tt>"safe"</tt>,
  # <tt>"low"</tt>, or <tt>"medium"</tt>, or +nil+ for a category
  # judged only as detected or not.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:31
  def severity; end

  # Which side was judged: +:prompt+ for the request, +:completion+ for
  # the response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:22
  def source; end

  # Returns the verdict as a Hash, omitting +nil+ values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:60
  def to_h; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:33
    def from_h(data); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/content_filter.rb:18
RubyLLM::ContentFilter::SOURCES = T.let(T.unsafe(nil), Array)

# Raised when the provider's content filters block a transcription and
# no transcript comes back. The message names the provider's reason,
# such as +SAFETY+. Chat responses report a block through
# Message#content_filtered? instead of raising.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:300
class RubyLLM::ContentFilterError < ::RubyLLM::Error; end

# A Context is an isolated configuration scope. It offers the same entry
# points as the top-level RubyLLM module but reads from its own
# Configuration copy instead of the global one, which suits multi-tenant
# applications and per-request overrides.
#
# Contexts are created with RubyLLM.context:
#
#   ctx = RubyLLM.context do |config|
#     config.openai_api_key = ENV.fetch('TENANT_OPENAI_API_KEY')
#     config.request_timeout = 180
#   end
#
#   ctx.chat.ask "Explain Ruby blocks."
#   ctx.paint("A paper boat in the rain").save("boat.png")
#   ctx.transcribe("meeting.wav").text
#
# The global configuration is left untouched.
#
# Batch submission uses each chat's own configuration (a chat carries
# the config it was built with), so there is no context entry point for
# it. To look up an existing batch, where no chats carry the config,
# pass a context to Batch.find:
#
#   RubyLLM::Batch.find(id, provider: :anthropic, context: ctx)
#
# pkg:gem/ruby_llm#lib/ruby_llm/context.rb:29
class RubyLLM::Context
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:32
  def initialize(config); end

  # Generates a video using this context's configuration, blocking
  # until it is ready. Accepts the same arguments as RubyLLM.animate.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:80
  def animate(*, **, &); end

  # Submits a video generation job using this context's configuration.
  # Accepts the same arguments as RubyLLM.animate_later.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:86
  def animate_later(*, **, &); end

