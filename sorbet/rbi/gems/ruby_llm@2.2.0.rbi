RubyLLM::Protocols::Gemini::SERVER_TOOL_ALIASES = T.let(T.unsafe(nil), Hash)

# JSON Schemas as Gemini accepts them. Gemini refuses a schema nested
# more than 32 levels deep with a bare "Request contains an invalid
# argument", so a deeper one goes with its deep subschemas moved into
# $defs and referenced from where they were, which describes the same
# values in fewer levels.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:11
module RubyLLM::Protocols::Gemini::Schemas
  private

  # Only a whole definition, since a pointer into one could pass
  # through a subschema that moved.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:56
  def definition_reference?(reference); end

  # A nested $id starts a resource of its own, whose references
  # resolve against it rather than the root.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:63
  def identified?(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:29
  def movable?(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:33
  def nesting(value); end

  # A reference into the schema's own structure, such as
  # "#/properties/address", would point at a subschema that moved.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:43
  def references_only_definitions?(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:22
  def render_schema(schema); end

  class << self
    # Only a whole definition, since a pointer into one could pass
    # through a subschema that moved.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:56
    def definition_reference?(reference); end

    # A nested $id starts a resource of its own, whose references
    # resolve against it rather than the root.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:63
    def identified?(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:29
    def movable?(schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:33
    def nesting(value); end

    # A reference into the schema's own structure, such as
    # "#/properties/address", would point at a subschema that moved.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:43
    def references_only_definitions?(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/schemas.rb:22
    def render_schema(schema); end
  end
end

