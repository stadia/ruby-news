    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def each_slice(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def each_with_index(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def each_with_object(*args, **kwargs, &block); end

    # Returns a new Models registry containing only embedding models.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def embedding_models(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def entries(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def exclude?(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def excluding(*args, **kwargs, &block); end

    # Fetches and merges models directly from upstream provider APIs and
    # models.dev for the maintainer registry builder.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:131
    def fetch_merged_models(remote_only: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:207
    def fetch_models_dev_models(existing_models); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:153
    def fetch_provider_models(remote_only: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:112
    def fetch_published_registry(etag: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def filter(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:55
    def filter_map(*args, **kwargs, &block); end

    # Returns the Model matching +model_id+, resolving aliases along the
