  private

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/acts_as.rb:193
  def ruby_llm_attachments; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/acts_as.rb:203
  def ruby_llm_broadcasting(broadcasts); end
end

