    def isolated(caller_context); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:109
    def paused?(round, results, paused); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:167
    def rails_executor; end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:96
    def require_async; end

    # Groups the calls in the order the model gave them, so an exclusive
    # call waits for the calls before it and the calls after it wait for
    # it, as with a fair read-write lock.
