RubyLLM::Providers::MiniMax::Anthropic::RESPONSES_ITEMS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:10
RubyLLM::Providers::MiniMax::Anthropic::SERVER_TOOL_ALIASES = T.let(T.unsafe(nil), Hash)

# MiniMax's own Chat Completion v2 route, used only for structured
# output on the one model that applies response_format. That model
# nests its answer under the schema name, so parsing removes the
# wrapper, which cannot be done part by part on a stream.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:10
class RubyLLM::Providers::MiniMax::ChatCompletions < ::RubyLLM::Protocols::ChatCompletions
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:11
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:22
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:15
  def render_payload(messages, schema: T.unsafe(nil), stream: T.unsafe(nil), **); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:40
  def parse_json(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/chat_completions.rb:28
  def unwrap_schema_result(data); end
end

# The HTTP status each MiniMax status code stands for on endpoints that
# answer 200 and report the failure in base_resp.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:21
RubyLLM::Providers::MiniMax::FAILURE_STATUSES = T.let(T.unsafe(nil), Hash)

# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:13
RubyLLM::Providers::MiniMax::MEDIA_OPERATIONS = T.let(T.unsafe(nil), Array)

# MiniMax's Responses route, used for web search because only this
# endpoint returns citations. It holds no state: store is always false.
# https://platform.minimax.io/docs/api-reference/responses-create
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:9
class RubyLLM::Providers::MiniMax::Responses < ::RubyLLM::Protocols::Responses
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:21
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:25
  def server_tool_aliases; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:46
  def offset_citations(citations, *); end

  # MiniMax sends url_citation annotations with both offsets at 0, so
  # they say nothing about the span they support. Its content field is
  # the quoted snippet.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:38
  def parse_annotations(annotations, _content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:31
  def provider_file_references?; end

  class << self
    # MiniMax reports a search's pages only through its citations.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:15
    def parse_web_sources(message); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/responses.rb:10
RubyLLM::Providers::MiniMax::Responses::SERVER_TOOL_ALIASES = T.let(T.unsafe(nil), Hash)

# The one MiniMax model that applies a response_format, on Chat
