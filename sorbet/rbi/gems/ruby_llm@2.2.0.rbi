# Chat methods of the OpenAI Responses API
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:7
module RubyLLM::Protocols::Responses::Chat
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:20
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:8
  def native_tool_namespace?(_namespace); end

  # Tool search loads a deferred function declared outside any
  # namespace as a namespace named after the function, and the model
  # calls it under that namespace.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:13
  def searched_tool_namespace?(call, tools); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:24
  def wire_parameters; end

  private

  # OpenAI names the threshold compact_threshold and takes the entries
  # as a flat array, where Anthropic nests a trigger object under
  # context_management.edits. It writes the summary itself, so there is
  # nothing to steer with instructions and no pausing to opt into.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:116
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:297
  def build_prompt_cache_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:430
  def cache_breakpoint_parts(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:329
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:576
  def default_large_file_upload_threshold; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:505
  def empty_content?(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:534
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:331
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:422
  def inject_cache_breakpoint(item); end

  # A message carries one thinking signature and one phase, so output
  # with more reasoning items or phases than that only replays whole
  # from its raw items.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:142
  def keep_raw_output?(output, server_tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:166
  def message_phases(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:170
  def namespaced_call?(item); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:281
  def normalize_annotation(annotation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:268
  def offset_citations(citations, offset, content, markers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:243
  def parse_annotations(annotations, content); end

  # Structured output lives in the final_answer items, and a turn is
  # read whole only when none of its items carries a phase, as in
  # OpenAI's SDKs. Commentary, unphased text beside a final answer,
  # and phases OpenAI adds later are not the answer. A turn whose
  # items carry different phases keeps them in raw_content; otherwise
  # its one phase tells.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:157
  def parse_answer_text(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:222
  def parse_citations(data, output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:540
  def parse_completed_reason(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:73
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:103
  def parse_completion_usage(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:254
  def parse_file_citation(annotation, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:536
  def parse_finish_reason(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:546
  def parse_function_calls(output, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:227
  def parse_output_citations(output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:512
  def parse_output_text(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:147
  def parse_phase(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:568
  def parse_reasoning_signature(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:560
  def parse_reasoning_summary(output); end

  # Output items beyond text, reasoning, and function calls record
  # provider-executed tool steps (web_search_call, code_interpreter_call,
  # and whatever OpenAI ships next). They are kept raw and replayed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:186
  def parse_server_tool_items(output); end

  # Searches are billed by tool_usage, not by the web_search_call items
  # in the output, which can each run several.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:352
  def parse_server_tool_use(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:335
  def parse_usage(usage); end

  # Only what a search returned. The address in an open_page or
  # find_in_page action is the model's own choice and need not be a
  # result, so text the model read could steer it there.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:215
  def parse_web_sources(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:174
  def portable_raw_content(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:320
  def prompt_cache_options(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:287
  def prompt_cache_params(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:580
  def provider_file_attachable?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:572
  def provider_file_references?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:584
  def provider_file_upload_options(_attachment); end

  # Assistant output is text-only on the wire, so the attachments of a
  # replayed assistant turn ride a user item spliced in after it.
  #
