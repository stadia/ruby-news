# The servers that could not be reached lately, for this whole process.
# A server waits this long, or as long as its Retry-After asks, before
# anyone tries it again, since a server that never answers would
# otherwise hold up every request, and each request in a job builds its
# MCP objects anew. A server that answers that it is unavailable, with
# HTTP 429 or a 5xx status, counts as one that can't be reached; one
# that refuses the credentials or the request does not, since trying
# again won't fix that.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:13
module RubyLLM::MCP::Outages
  class << self
    # Yields to call one of +server+'s tools, and returns the tool error
    # when the server fails the call, or right away while the server
    # sits out. A handler declared on the server's class or on MCP::Tool
    # takes the error instead, but not one every Tool inherits, so a
    # catch-all on RubyLLM::Tool keeps the outage handling. Checking on
    # a task still raises, since the task may still be running.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:45
    def calling(server, tool, input); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:82
    def clear; end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:75
    def down?(server); end

    # Returns the tool error for a call +server+ failed, or +nil+ for an
    # error the call should raise: one that is not the server's, or a
    # refusal such as missing credentials or an unknown endpoint. A
    # server that is unavailable sits out until its backoff ends. The
    # model reads what the server wrote, even with redacted error
    # messages, since it is the one deciding what to do next.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:64
    def failed_call(server, tool, error); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:28
    def tools(server); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:127
    def backoff(error); end

    # What the server wrote, or the error's own message when it wrote
    # nothing, as an empty message would tell the model nothing.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:100
    def failure_text(server, tool, error); end

    # Settings, not classes, since RubyLLM.mcp builds a class per call.
    # Settings that depend on runtime state can differ per object, and so
    # can the connection settings of an object's context, so one tenant's
    # server never sidelines another's.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:156
    def key(server); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:166
    def monotonic_now; end

    # A call that broke off, or that the server failed with a 5xx
    # status, may have done some of its work before it stopped, unless
    # the tool says it has no effect or the same call again has none.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:109
    def partly_run?(tool, error); end

    # Returns whether this caller started the backoff.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:140
    def record(server, backoff); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:119
    def refused_status?(status); end

    # Names the error by its class and status, never its message, since
    # a connection error's message can carry the server's host or URL.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:90
    def report(server, error); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:133
    def seconds_until(date); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:115
    def unavailable?(error); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/outages.rb:123
    def unavailable_status?(status); end
  end
end

