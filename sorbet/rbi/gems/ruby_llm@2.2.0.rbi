# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:67
RubyLLM::Agent::UNRESOLVED_CONTEXT = T.let(T.unsafe(nil), Object)

# The Tool an Agent class becomes when it goes wherever tools go, so a
# model can hand work to it: a subagent. Agent::to_tool returns one, and
# Chat#with_tools and Agent::tools convert an Agent class themselves.
#
#   class ResearchAgent < RubyLLM::Agent
#     description "Researches a question across the web and reports back"
#     tools WebSearch, ReadPage
#   end
#
#   chat.with_tools(ResearchAgent).ask "What changed in Ruby 4.0?"
#
# The tool is named after the agent (+research_agent+, or
# +billing_research_agent+ for <tt>Billing::ResearchAgent</tt>) and takes
# a +task+, everything the agent needs written to stand alone, plus the
# agent's ::inputs that ::to_tool was not given. Each call runs a fresh
# instance of the agent on the task, under the owner of the chat that
# called it, and returns the content of its last answer.
#
# The agent lives only as long as its call, so it has to finish within
# it. When it stops to wait instead, for an approval, a question, or a
# task, the call raises ConfigurationError. To let a subagent wait for a
# person, give it a chat of its own, as the Agents guide shows.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:26
class RubyLLM::AgentTool < ::RubyLLM::Tool
  # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:61
  def initialize(inputs = T.unsafe(nil)); end

  # Runs a fresh instance of the agent on +task+, with the inputs given to
  # Agent::to_tool and those the model chose, and returns the content of
  # its last answer. Raises ConfigurationError, naming what the agent
  # waits for, when it stops to wait instead of answering.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:70
  def execute(task:, **inputs); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:82
  def stopped(agent); end

  class << self
    # The Agent class this tool runs.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:32
    def agent_class; end

    # Returns a Tool class for +agent_class+, with the inputs in +given+
    # left out of its parameters.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:39
    def for(agent_class, given); end

    # The agent's ::inputs that the model supplies, as parameters.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:35
    def input_parameters; end

    # Returns the agent's name in snake case, such as +research_agent+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:56
    def tool_name; end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/agent_tool.rb:27
RubyLLM::AgentTool::GUIDE = T.let(T.unsafe(nil), String)

# An Attachment is a file sent to the model alongside a message. The source
# can be a local path, an http(s) URL, an IO-like object, an ActiveStorage
# object, or a provider-managed UploadedFile. Chat#ask builds attachments
# for you from its +with:+ option:
#
#   chat.ask "What's in this image?", with: "ruby_conf.jpg"
#
# Build one explicitly to return a file from a Tool:
#
#   RubyLLM::Attachment.new(doc.download_path)
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:19
class RubyLLM::Attachment
  include ::RubyLLM::Support::Inspectable

  # Creates an attachment from +source+: a file path, URL, IO-like object,
  # ActiveStorage object, or UploadedFile. Derives the filename from the
  # source when +filename:+ is not given, then detects the MIME type.
  #
  #   RubyLLM::Attachment.new("diagram.png")
  #   RubyLLM::Attachment.new(StringIO.new(data), filename: "report.pdf")
  #
  # +resolution:+ asks the provider to spend more or fewer tokens on an
  # image, video, or PDF. +:original+ requests original image detail where
  # supported, or the highest available resolution. Providers without
  # the setting ignore it.
  #
  #   RubyLLM::Attachment.new("page-3.png", resolution: :ultra_high)
  #
  # +processing:+ chooses how the model reads a video. +:static+ samples
  # frames across the whole video up front. +:agentic+ lets the model
  # navigate a long video and load only the parts it needs. Providers
  # without the setting ignore it.
  #
  #   RubyLLM::Attachment.new("lecture.mp4", processing: :agentic)
  #
  # +mime_type:+ states the file's type, for a source RubyLLM cannot tell
  # it from, such as an IO, instead of detecting it. A <tt>charset</tt>
  # says how to read binary text; #mime_type leaves parameters out. A
  # Rails attachment's type comes from its blob, so set it there for one.
  #
  #   RubyLLM::Attachment.new(io, filename: "export.csv", mime_type: "text/csv")
  #
  # +config:+ is the Configuration a URL source is downloaded with. It
  # defaults to that of the chat or operation the attachment is given to,
  # then to the global one.
  #
  # Paths and URLs must be trusted and authorized by the application.
  # They can be read or fetched during construction to detect the MIME type.
  # Validate upload parameters before passing them here: an unchecked String
  # can access local files or internal network endpoints.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:128
  def initialize(source, filename: T.unsafe(nil), mime_type: T.unsafe(nil), resolution: T.unsafe(nil), processing: T.unsafe(nil), config: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:191
  def active_storage?; end

  # Returns whether the attachment is audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:252
  def audio?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:309
  def byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:144
  def config; end

  # Returns the raw bytes of the attachment, fetching or reading the source
  # on the first call. Text content is returned as UTF-8.
  #
  # Raises RubyLLM::Error if the attachment is a provider-managed file,
  # which has no local content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:200
  def content; end

  # Returns whether the attachment is a non-PDF, non-text document format
  # such as Word or Excel, judged by MIME type or file extension.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:274
  def document?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:210
  def encoded; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:280
  def extension; end

  # The filename given at construction or derived from the source.
  # May be +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:28
  def filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:214
  def for_llm; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:256
  def format; end

  # Returns whether the attachment is an image.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:242
  def image?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:187
  def io_like?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:299
  def mark_partial; end

  # The detected MIME type string, such as <tt>"image/png"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:31
  def mime_type; end

  # Returns whether the attachment holds only the start of a text, the
  # way a chat with a file store sends a file longer than its inline
  # limit (see Chat#with_file_store). The whole file stays in the chat's
  # files, and the text says where. An attachment you make is never
  # partial.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:295
  def partial?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:183
  def path?; end

  # Returns whether the attachment is a PDF.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:268
  def pdf?; end

  # How the model reads a video: +:static+, +:agentic+, or +nil+ for the
  # provider default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:42
  def processing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:157
  def provider_file?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:175
  def provider_file_id; end

  # Where uploads of this attachment outlive the process: an object that
  # responds to <tt>fetch(provider:, account:)</tt>,
  # <tt>store(upload, provider:, account:)</tt>, and
  # <tt>forget(id, provider:, account:)</tt>. The Rails integration sets
  # one for files kept in Active Storage.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:173
  def provider_file_store; end

  # Where uploads of this attachment outlive the process: an object that
  # responds to <tt>fetch(provider:, account:)</tt>,
  # <tt>store(upload, provider:, account:)</tt>, and
  # <tt>forget(id, provider:, account:)</tt>. The Rails integration sets
  # one for files kept in Active Storage.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:173
  def provider_file_store=(_arg0); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:179
  def provider_file_uri; end

  # Files this attachment has been auto-uploaded to, keyed by provider and
  # credentials. Kept on the attachment so request-time preprocessing
  # uploads once per account while history keeps the original source.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:164
  def provider_uploads; end

  # The requested media resolution: +:low+, +:medium+, +:high+,
  # +:ultra_high+, +:original+, or +nil+ for the provider default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:35
  def resolution; end

  # The underlying source: a URI, Pathname, IO-like object, ActiveStorage
  # object, or UploadedFile.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:24
  def source; end

  # Returns whether the attachment is textual, like source code or CSV.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:286
  def text?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:304
  def to_h; end

  # Returns the attachment category as a Symbol: +:image+, +:video+,
  # +:audio+, +:pdf+, +:text+, +:document+, or +:unknown+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:230
  def type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:153
  def url?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:224
  def url_or_data_uri; end

  # Returns whether the attachment is a video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:247
  def video?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:148
  def with_default_config(config); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:476
  def active_storage_blob; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:336
  def active_storage_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:468
  def active_storage_content_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:319
  def check_option(name, value, allowed); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:353
  def content_byte_size; end

  # An IO's bytes were examined already, so it isn't read in full for a
