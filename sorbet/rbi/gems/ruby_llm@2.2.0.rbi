# The Azure AI Speech API on an Azure AI Services resource. Only fast
# transcription is implemented; chat, embeddings, and images go through
# the resource's OpenAI-compatible protocols.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech.rb:9
class RubyLLM::Protocols::Azure::Speech < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Azure::Speech::Transcription
end

# Fast transcription on Azure AI Speech. The request is multipart:
# the audio, and a JSON definition carrying the options. Several
# languages make a candidate list Azure identifies the spoken one
# from, a prompt becomes a phrase list, and asking for speakers
# turns on diarization.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:14
module RubyLLM::Protocols::Azure::Speech::Transcription
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:66
  def parse_transcription_response(response, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:27
  def rejected_options(operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:44
  def render_transcription_definition(language: T.unsafe(nil), speaker_names: T.unsafe(nil), prompt: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:21
  def render_transcription_options(timestamps:, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:35
  def render_transcription_payload(file_part, language: T.unsafe(nil), speaker_names: T.unsafe(nil), prompt: T.unsafe(nil), provider_options: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:52
  def transcribe(audio_file, model:, language:, speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:31
  def transcription_url; end

  private

  # Azure bills whole seconds and reports them in a header, as
  # <tt>CognitiveServices.SpeechServices.BatchSpeechtoTextSync=4</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:104
  def billed_seconds(response); end

  # Given candidate languages, Azure answers silence with a 422 that
  # bills nothing, where every other provider returns an empty
  # transcript.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:93
  def no_language_identified?(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:84
  def post_transcription(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:114
  def timed(part); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:108
  def words_in(phrases); end
end

# Azure masks profanity unless told otherwise. Turned off so the
# transcript reads like the transcripts every other provider
# returns; pass <tt>provider_options: { profanityFilterMode: "Masked" }</tt>
# to mask it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/azure/speech/transcription.rb:19
RubyLLM::Protocols::Azure::Speech::Transcription::DEFAULT_DEFINITION = T.let(T.unsafe(nil), Hash)

