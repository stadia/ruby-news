  # Renders a partial with locals. A bare name is looked up next to the
  # current prompt only. A name with a path is looked up in the prompt roots.
  #
  #   <%= render "tone" %>
  #   <%= render "shared/safety", product_name: product_name %>
  #   <%= render partial: "shared/safety", locals: { product_name: product_name } %>
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/prompt/context.rb:33
  def render(options = T.unsafe(nil), locals = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/prompt/context.rb:39
  def scope; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/prompt/context.rb:47
  def partial(name); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/prompt/context.rb:10
RubyLLM::Prompt::Context::LOCAL_VARIABLE_NAME = T.let(T.unsafe(nil), Regexp)

# The ordered directories searched for prompt files, and for skills
# through Skill.roots. The application's directory is always first, so
# an application can override any prompt or skill an engine ships by
# placing its own at the same relative path. Engines append their own
# directories in an initializer:
#
#   initializer "my_engine.prompts" do
#     RubyLLM::Prompt.roots << MyEngine::Engine.root.join("app/prompts")
#     RubyLLM::Skill.roots << MyEngine::Engine.root.join("app/skills")
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/prompt.rb:20
class RubyLLM::Prompt::Roots
  include ::Enumerable

  # pkg:gem/ruby_llm#lib/ruby_llm/prompt.rb:23
  def initialize(&default); end

  # Appends a prompt directory and returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/prompt.rb:29
  def <<(path); end

  # Yields each prompt directory in lookup order. Returns an Enumerator without a block.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/prompt.rb:36
  def each(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/prompt.rb:33
  def push(path); end
end

# Raised when RubyLLM.render_prompt cannot find the named prompt file.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:146
class RubyLLM::PromptNotFoundError < ::StandardError; end

# A Protocol knows how to talk to a family of provider APIs: rendering
# request payloads, parsing responses, streaming chunks, and naming the
# endpoints involved. Its counterpart, Provider, knows where to talk and
# who it is. The protocols that ship with the gem live under
# RubyLLM::Protocols.
#
# Subclass Protocol, or a shipped subclass such as
# RubyLLM::Protocols::ChatCompletions, to support a new wire format. Each
# operation (chat, embeddings, moderation, image generation, video
# generation, speech, transcription, OCR, reranking, token counting, and
# model listing) is served by three kinds of seam method you override:
#
# - <tt>render_*</tt> serializes a RubyLLM request into the wire payload,
#   such as +render_payload+ for chat or +render_embedding_payload+.
# - <tt>*_url</tt> names the endpoint, such as +completion_url+ or
#   +embedding_url+.
# - <tt>parse_*</tt> turns the wire response back into RubyLLM objects, such
#   as +parse_completion_body+ or +parse_embedding_response+.
#
# Override the seams for the operations you support; the rest raise
# NotImplementedError. For example:
#
#   class ChatCompletions < RubyLLM::Protocols::ChatCompletions
#     def completion_url
#       'v2/chat'
#     end
#   end
#
# A protocol instance is constructed by its Provider and borrows the
# provider's Connection, so subclasses never build HTTP clients
# themselves.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:37
class RubyLLM::Protocol
  include ::RubyLLM::Protocol::UnsupportedOperations
  include ::RubyLLM::Protocol::ToolNamespaces
  include ::RubyLLM::Protocol::Streaming
  include ::RubyLLM::Protocol::BinaryStreaming
  include ::RubyLLM::Protocol::RequestShapes
  include ::RubyLLM::Protocol::NativeContent

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:90
  def initialize(provider, model = T.unsafe(nil)); end

  # Video generation is asynchronous on every provider: this submits the
  # job and returns a VideoJob, whose #refresh and #video poll and
  # download through this protocol instance.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:371
  def animate_later(*args, **options, &block); end

  # Writes the chat's context compaction options into the request payload
  # and returns it. +compaction+ is the provider-neutral Hash from
  # Chat#with_compaction, whose keys are Chat::COMPACTION_OPTIONS. The
  # default drops it with a debug log, so providers that manage context
  # themselves simply ignore the request. Protocols whose API compacts
  # server-side override this, mapping the options they support and
  # logging the ones they do not.
  #
  #   def apply_compaction(payload, compaction)
  #     payload.merge(context_management: [{ type: 'compaction' }])
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:253
  def apply_compaction(payload, compaction); end

  # Returns the completion request's HTTP headers with anything context
  # compaction requires added. The default changes nothing; protocols that
  # gate compaction behind a beta header override this.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:263
  def apply_compaction_headers(headers, _compaction); end

  # Writes the chat's safety identifier into the request payload and
  # returns it. The default drops the value with a debug log, so
  # providers with no equivalent field simply omit it. Protocols whose
  # API accepts one override this.
  #
  #   def apply_end_user(payload, identifier)
  #     payload.merge(safety_identifier: identifier)
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:234
  def apply_end_user(payload, identifier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:523
  def cache_content(*args, **options, &block); end

  # Returns whether this wire format takes a cache key.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:221
  def cache_key?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:66
  def cache_url(*_args, **_opts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:66
  def caches_url(*_args, **_opts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:302
  def compact(*args, **options, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:66
  def compaction_url(*_args, **_opts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:123
