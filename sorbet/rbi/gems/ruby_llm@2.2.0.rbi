  # pkg:gem/ruby_llm#lib/ruby_llm/providers/xai/responses.rb:32
  def server_tool_aliases; end

  # xAI answers tool_search and defer_loading with 403 for every
  # account outside its alpha, so Chat brings its own search.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/xai/responses.rb:38
