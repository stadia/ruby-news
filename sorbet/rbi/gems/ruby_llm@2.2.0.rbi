  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:103
  def feed_answer(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:68
  def feed_start(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:87
  def feed_thinking(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:123
  def hold(buffer); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:82
  def open_block(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:119
  def partial_close_length(buffer); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:140
  def presence(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:58
  def stop(text, thinking); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:134
  def take_held; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:113
  def whitespace_length(text, limit); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:128
