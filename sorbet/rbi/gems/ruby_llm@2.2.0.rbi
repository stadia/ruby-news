  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:66
  def completion_url(*_args, **_opts); end

  # The provider's Configuration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:49
  def config; end

  # The provider's HTTP connection. Subclasses use it to reach their
  # endpoints.
