# pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:6
RubyLLM::Evaluation::Runner::USAGE_CONTEXT_KEY = T.let(T.unsafe(nil), Symbol)

# The recorded outcome of one case and repetition, including failed attempts.
#
# pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:6
class RubyLLM::Evaluation::Trial
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:31
  def initialize(test_case:, repetition:, task_usage: T.unsafe(nil), evaluator_usage: T.unsafe(nil), **attributes); end

  # Returns the number of Ruby assertions attempted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:23
  def assertion_count; end

  # Returns an assertion failure, or nil.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:25
  def assertion_failure; end

  # Returns a Cost aggregate for this trial, including task and evaluator requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:48
  def cost; end

  # Returns elapsed wall-clock seconds, including evaluators.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:29
  def duration; end

  # Returns an execution or evidence-conversion error, or nil.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:27
  def error; end

  # Returns each criterion's Evaluation::Result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:21
  def evaluations; end

  # Returns the cost of the evaluators and their tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:68
  def evaluator_cost; end

  # Returns the tokens used by the evaluators and their tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:58
  def evaluator_tokens; end

  # Returns the frozen evidence supplied to evaluators.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:19
  def evidence; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:96
  def inspect_attributes; end

  # Returns the primary output extracted from the returned value.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:17
  def output; end

  # Returns whether every assessment passed and no error occurred.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:82
  def passed?; end

  # Returns the one-based repetition number.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:13
  def repetition; end

  # Returns the original value returned by perform, when it completed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:15
  def result; end

  # Returns :passed, :failed, :measured, :unassessed, or :error. Empty trials are never passes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:73
  def status; end

  # Returns the task's cost, including setup, assertions, and teardown requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:63
  def task_cost; end

  # Returns the task's tokens, including setup, assertions, and teardown requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:53
  def task_tokens; end

  # Returns the case whose inputs were executed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:11
  def test_case; end

  # Returns the portable trial record, excluding the live application object.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:87
  def to_h; end

  # Returns a Tokens aggregate for every provider attempt made during this trial.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/trial.rb:43
  def tokens; end
end

# A Fallback is a fallback model target configured with Chat#with_fallbacks.
# When the active model fails with a matching error, the chat retries the
# request with each fallback in order. Instances are yielded to
# Chat#before_fallback and Chat#after_fallback callbacks, enriched with the
# details of that attempt. With <tt>drop_unsupported: true</tt>, a retry
# of the same model without a parameter it rejected is an attempt too:
# its #from and #to are that model, and #dropped_parameter names what
# it left out.
#
#   chat = RubyLLM.chat(model: "gpt-4.1")
#                 .with_fallbacks("gpt-4.1-mini", "claude-haiku-4-5")
#
#   chat.before_fallback do |fallback|
#     puts "Falling back from #{fallback.from.id} to #{fallback.to.id}"
#   end
#
#   chat.after_fallback do |fallback|
#     puts "Fallback #{fallback.succeeded? ? 'succeeded' : 'failed'}"
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:23
class RubyLLM::Fallback
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:112
  def initialize(id: T.unsafe(nil), provider: T.unsafe(nil), model: T.unsafe(nil), **attributes); end

  # The fallback attempt number, starting at 1.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:60
  def attempt; end

  # The Chat performing the fallback attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:48
  def chat; end

  # Returns whether the failed model already yielded stream chunks before
  # the fallback.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:145
  def chunks_yielded?; end

  # The parameter a retry on the same model left out, as
  # UnsupportedParameterError#parameter names it, or +nil+ for a fallback
  # to another model. See Chat#with_fallbacks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:65
  def dropped_parameter; end

  # The error that triggered the fallback.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:51
  def error; end

  # Returns +true+ if the fallback attempt raised an error, +false+
  # otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:151
  def failed?; end

  # The error raised by the fallback attempt itself, or +nil+ if it
  # succeeded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:72
  def fallback_error; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:132
  def finish(response: T.unsafe(nil), fallback_error: T.unsafe(nil)); end

  # The Model the chat is falling back from.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:54
  def from; end

  # The model id of the fallback target, or of the model a retry without a
  # rejected parameter runs on.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:38
  def id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:108
  def inspect_attributes; end

  # The Model object the fallback was configured with, or +nil+ when it was
  # configured with a model id.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:45
  def model; end

  # The provider slug of the fallback target as a String, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:41
  def provider; end

  # The response Message from a successful fallback attempt, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:68
  def response; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:74
  def streaming; end

  # Returns whether the fallback happened during a streaming request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:139
  def streaming?; end

  # Returns +true+ if the fallback attempt produced a response without
  # error, +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:157
  def succeeded?; end

  # The Model the chat is falling back to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:57
  def to; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:128
  def with_attempt(**attributes); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:76
    def build(value); end

    # Returns whether +error+ is one of +errors+ and may move on to a
    # fallback. A cancellation never does.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:91
    def error?(error, errors); end

    # Takes fallbacks off +queue+ until the block accepts one, skipping
    # those whose model can't be resolved. Returns the fallback and the
    # block's value, or +nil+ when none is left.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:98
    def next_usable(queue); end
  end
end

# The error classes that trigger a fallback when Chat#with_fallbacks is
# called without +on:+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:28
RubyLLM::Fallback::DEFAULT_ERRORS = T.let(T.unsafe(nil), Array)

# Raised when a FileStore has no file at the path asked for.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:156
class RubyLLM::FileNotFoundError < ::StandardError; end

# A FileStore keeps a chat's files: what people attach, what tools
# return, long tool results, and what code writes. Chat#with_file_store gives
# a chat one, and the model works with it through tools that list, read,
# search, write, and edit its files, so a file reaches the model only
# when the model asks for it.
#
#   chat = RubyLLM.chat.with_file_store
#   chat.ask "Which clauses changed?", with: ["contract-v1.pdf", "contract-v2.pdf"]
#   chat.file_store.list.map(&:path) # => ["contract-v1.pdf", "contract-v2.pdf"]
#
# RubyLLM ships FileStore::Memory, the default, and FileStore::Directory,
# which keeps the files in a folder. The Rails integration keeps a
# persisted chat's files in Active Storage.
#
#   chat.with_file_store("tmp/work")
#
# Write your own store by subclassing FileStore and implementing #list,
# #[], #read, #write, and #delete. RubyLLM only ever passes them paths
# FileStore.path accepts: relative, with forward slashes, and without
# empty, <tt>.</tt>, or <tt>..</tt> parts.
#
#   class BucketStore < RubyLLM::FileStore
#     def initialize(bucket, prefix)
#       super()
#       @bucket = bucket
#       @prefix = prefix
#     end
#
#     def list(prefix = nil) = ...
#     def [](path) = ...
#     def read(path) = ...
#     def write(path, content, content_type: nil) = ...
#     def delete(path) = ...
#   end
#
# The model must read a file before its tools change it, and a file that
# changed since it read it must be read again. The store remembers what
# the model read, and #with_lock keeps two changes to the files from
# interleaving. Override #with_lock in a store that several processes
# share.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:48
class RubyLLM::FileStore
  include ::Enumerable

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:139
  def initialize; end

  # Returns the StoredFile at +path+, or +nil+ when there is none.
  #
  #   chat.file_store["notes/plan.md"] # => #<RubyLLM::StoredFile path: "notes/plan.md", ...>
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:158
  def [](path); end

  # Returns the file at +path+ as an Attachment, to send it to a model.
  # Raises FileNotFoundError when there is none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:266
  def attachment(path, file: T.unsafe(nil)); end

  # Keeps +text+ as the conversion of +file+, in memory.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:277
  def cache_text(file, text); end

  # Returns the converted text kept for +file+, or +nil+, from memory.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:272
  def cached_text(file); end

  # Deletes the file at +path+ and returns its StoredFile, or +nil+ when
  # there was none. Raises ArgumentError when +path+ is a folder.
  #
  #   chat.file_store.delete("notes/plan.md")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:189
  def delete(path); end

  # Deletes everything inside the folder +path+ and returns the deleted
  # StoredFile objects, sorted by path. Raises ArgumentError when +path+
  # is a file.
  #
  #   chat.file_store.delete_folder("reports") # => [#<RubyLLM::StoredFile path: "reports/q3.pdf", ...>]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:198
  def delete_folder(path); end

  # Yields each StoredFile, as #list returns them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:215
  def each(&); end

  # Returns whether there is a file at +path+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:220
  def exist?(path); end

  # Returns the StoredFile at +path+. Raises FileNotFoundError when there
  # is none.
  #
  #   chat.file_store.find("notes/plan.md")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:166
  def find(path); end

  # Returns the files inside the folder +prefix+, or every file, as
  # StoredFile objects sorted by path.
  #
  #   chat.file_store.list("reports")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:151
  def list(prefix = T.unsafe(nil)); end

  # Returns the folder on disk that holds the files, or +nil+. A store
  # with one has code execution run in that folder, reading and writing
  # the files in place; a store without one has each run read the
  # attachments in +attachments/+ and copy in the files it names.
  # FileStore::Directory returns its root.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:210
  def local_root; end

  # Returns the content of the file at +path+ as a binary String.
  # Raises FileNotFoundError when there is none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:172
  def read(path); end

  # Returns the digest of the content the model last read at +path+, or
  # +nil+ when it has not read it. The file tools compare it with the
  # file's digest before they change the file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:227
  def read_digest(path); end

  # Remembers that the model read +digest+, a digest of the content, at
  # +path+, in memory.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:233
  def record_read(path, digest); end

  # Writes +attachment+ under its file name and returns its StoredFile,
  # yielding it when it is new. A file already there with the same
  # content is reused; one with other content keeps its place, and the
  # attachment gets a numbered name beside it, such as
  # <tt>report-2.pdf</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:289
  def store_attachment(attachment); end

  # Returns the text of the file at +path+: its content when it is text,
  # or what a converter makes of it, such as the text OCR reads from a
  # PDF. Returns +nil+ when no converter can read the file.
  # Conversions are kept, so each version of a file is converted once.
  # Raises FileNotFoundError when there is no file at +path+.
  #
  #   chat.file_store.text("contract.pdf") # => "## Page 1\n\nThis agreement..."
  #
  # See Configuration#file_converters for adding converters.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:254
  def text(path, config: T.unsafe(nil)); end

  # Runs the block with the store locked and returns its value, so a tool
  # that reads a file and writes it back sees no other change in
  # between. It is reentrant. Stores lock within this process unless
  # they override it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:241
  def with_lock(&); end

  # Writes +content+, a String or an IO, to +path+, replacing any file
  # there, and returns its StoredFile. The content type is detected from
  # the path and the content unless given.
  #
  #   chat.file_store.write("notes/plan.md", "# Plan")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:181
  def write(path, content, content_type: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:321
  def candidates(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:305
  def folder?(_path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:313
  def refuse_file(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:309
  def refuse_folder(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:330
  def same_content?(file, content, digest); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:334
  def text_key(file); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:317
  def write_attachment(path, attachment, content); end

  class << self
    # Returns the bytes of +content+, a String or an IO.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:133
    def bytes(content); end

    # Returns the MIME type of +content+, a String or an IO that can
    # rewind, written to +path+. An IO is sniffed from its start and
    # left there.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:125
    def content_type_for(path, content); end

    # Returns the SHA-256 of +content+, a String or an IO read to its
    # end in chunks, in hex.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:113
    def digest(content); end

    # Returns a safe file name for an attachment called +name+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:106
    def filename(name); end

    # Returns whether +path+ is inside the folder +prefix+, or is it.
    # Every path is inside a +nil+ or empty prefix.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:82
    def inside?(path, prefix); end

    # Returns whether +path+ matches the glob +pattern+. A pattern
    # without a slash matches the file name in any folder; one with a
    # slash matches the whole path, or the path inside the folder
    # +inside+. <tt>**</tt> matches any number of folders, a trailing
    # <tt>/**</tt> everything under a folder, and <tt>{a,b}</tt> either.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:94
    def match?(path, pattern, inside: T.unsafe(nil)); end

    # Returns +name+ as a path inside a store: relative, with forward
    # slashes, and with a leading <tt>./</tt> or <tt>/</tt> and repeated
    # slashes removed.
    #
    #   RubyLLM::FileStore.path("./reports//q3.pdf") # => "reports/q3.pdf"
    #
    # Raises ArgumentError for an empty path or one with <tt>.</tt> or
    # <tt>..</tt> parts.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:70
    def path(name); end
  end
end

# Converted texts each store keeps in memory, by default.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store.rb:55
RubyLLM::FileStore::CACHED_TEXTS = T.let(T.unsafe(nil), Integer)

# Converters turn files into text the model can read and search. A
# converter is any object that answers +call+ with an Attachment and
# returns the file's text, or +nil+ when it cannot read that file, so
# the next converter gets a turn. FileStore#text tries the converters
# in Configuration#file_converters first, then reads text files,
# including source code, CSV, JSON, and Markdown, as they are.
#
# Converters::Office reads Word, Excel, and PowerPoint files without
# any setup. The OCR converter reads PDFs, scans, and photos with
# RubyLLM.ocr. It costs a request per file, so it only runs where you
# register it. Converters::Text reads a file as it is, for other types
# that hold plain text.
#
# A converter that answers +local?+ with +true+ reads files on this
# machine for free, so a chat runs it as soon as it keeps an
# attachment, while it prepares the request, so keep it fast, and
# search_files finds the text without a read_file first. The others wait
# for read_file, or for a request that must send as text a file the
# provider cannot take.
#
#   RubyLLM.configure do |config|
#     config.file_converters["image/*"] = RubyLLM::FileStore::Converters::OCR.new
#     config.file_converters["application/pdf"] = RubyLLM::FileStore::Converters::OCR.new
#     config.file_converters["application/x-subrip"] = RubyLLM::FileStore::Converters::Text
#     config.file_converters["application/vnd.oasis.opendocument.text"] = ->(file) { OdtText.call(file.content) }
#   end
#
# Converters for other formats can ship as gems named
# <tt>ruby_llm-converters-NAME</tt>, like provider gems.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:34
module RubyLLM::FileStore::Converters
  class << self
    # Returns the text the first converter for +attachment+ makes of it,
    # or +nil+ when none can read it.
    # With <tt>local: true</tt>, stops at the first converter that does
    # not run on this machine for free, so one that may cost money, or
    # that was registered to go first, is never passed over.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:41
    def convert(attachment, config: T.unsafe(nil), local: T.unsafe(nil)); end

    # Returns the converters for files of +type+, in the order they are
    # tried.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:56
    def for_type(type, config: T.unsafe(nil)); end

    # Returns whether +converter+ reads files on this machine for free.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:63
    def local?(converter); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:76
    def built_in(type); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters.rb:69
    def matches?(pattern, type); end
  end
end

# Reads scans, photos, and PDFs with RubyLLM.ocr. Each file costs one
# OCR request the first time the model reads or searches it, and is
# kept after that. Register it in Configuration#file_converters for
# the types it should read:
#
#   config.file_converters["image/*"] = RubyLLM::FileStore::Converters::OCR.new
#   config.file_converters["application/pdf"] = OCR.new(model: "mistral-ocr-latest")
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/ocr.rb:14
class RubyLLM::FileStore::Converters::OCR
  # Creates a converter that calls RubyLLM.ocr with +options+, such as
  # +model:+, +provider:+, or +context:+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/ocr.rb:17
  def initialize(**options); end

  # Returns the Markdown RubyLLM.ocr reads from +attachment+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/ocr.rb:22
  def call(attachment); end
end

# Reads the text of Word documents, Excel workbooks, and PowerPoint
# decks (.docx, .xlsx, .pptx) on this machine, with no service and no
# cost: a paragraph per line, a table or sheet row per line with tabs
# between cells, and a heading for each sheet and slide, with a slide's
# speaker notes under it. Excel dates read as dates, like 2026-03-31.
# Text comes back in document order, without layout or images.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:14
module RubyLLM::FileStore::Converters::Office
  class << self
    # Returns the text of +attachment+, or +nil+ when it is not a
    # document, workbook, or deck it can read. A file it can't read
    # never raises.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:26
    def call(attachment); end

    # Returns +true+: it reads files on this machine, for free.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:39
    def local?; end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:55
    def deck(zip); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:45
    def document(zip); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:65
    def notes_of(zip, slide); end

    # Returns each part the +owner+ lists with a +tag+, in its order,
    # with that tag, or the parts matching +fallback+ in name order
    # when the listing doesn't resolve.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:73
    def parts(zip, owner, tag, fallback); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:84
    def relationships(zip, part); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:92
    def resolve(folder, target); end

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:50
    def workbook(zip); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office.rb:20
RubyLLM::FileStore::Converters::Office::MAX_SIZE = T.let(T.unsafe(nil), Integer)

# Walks the tags of an Office XML part from left to right, so its
# time grows with the part's size whatever the part holds: nothing
# backtracks over unclosed tags. Names lose their prefix, since
# generators pick their own. Parts are binary Strings.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:11
class RubyLLM::FileStore::Converters::Office::Markup
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:83
  def initialize(xml, skip, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:92
  def run; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:125
  def closing(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:132
  def count(name, empty); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:141
  def name_of(source); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:116
  def opening(source); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:136
  def start_skipping(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:105
  def tag(start, finish); end

  class << self
    # Returns the value of an attribute in a tag's source, unescaped.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:43
    def attribute(tag, name); end

    # Returns the value of an attribute under any prefix, or none.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:49
    def prefixed(tag, name); end

    # Returns the prefixed +id+ attribute of a tag's source, whatever
    # its prefix, which is how a part refers to a relationship.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:56
    def relationship_id(tag); end

    # Yields <tt>:open</tt>, <tt>:empty</tt>, or <tt>:close</tt> with
    # each tag's name and its source, and <tt>:text</tt> with nil and
    # the text between tags, leaving out the elements named in +skip+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:31
    def scan(xml, skip: T.unsafe(nil), &); end

    # Returns the source of each tag named +name+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:36
    def tags(xml, name); end

    # Returns +text+ as UTF-8, with the entities XML defines replaced.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:62
    def unescape(text); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/office/markup.rb:76
    def character(code); end
  end
end

