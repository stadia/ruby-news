# A run's trials and summary. Persist with #save for review and comparisons.
#
# pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:6
class RubyLLM::Evaluation::Report
  include ::Enumerable
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:22
  def initialize(name:, trials:, id:, started_at:, definitions:); end

  # Returns the Cost aggregate across every case and repetition.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:43
  def cost; end

  # Returns trial counts keyed by status.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:48
  def counts; end

  # Returns the criterion definitions and evaluator identities captured for this run.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:20
  def definitions; end

  # Yields each trial, or returns an Enumerator.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:33
  def each(&); end

  # Returns the unique run identifier.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:14
  def id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:85
  def inspect_attributes; end

  # Returns the evaluation class name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:12
  def name; end

  # Returns the passing fraction of all trials, including errors and ungraded measurements.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:54
  def pass_rate; end

  # Returns true only when the run is nonempty and every trial passed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:59
  def passed?; end

  # Writes a JSON report and returns the supplied path.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:70
  def save(path); end

  # Returns the UTC time the run started.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:18
  def started_at; end

  # Returns all trial evidence, measurements, and run identity as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:64
  def to_h; end

  # Returns a readable per-case report followed by counts, and the total
  # cost when every amount is known.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:77
  def to_s; end

  # Returns the Tokens aggregate across every case and repetition.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:38
  def tokens; end

  # Returns the trials in dataset and repetition order.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:16
  def trials; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:98
  def failure_messages(trial); end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/report.rb:91
  def trial_description(trial); end
end

