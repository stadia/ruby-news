    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:479
    def render_thinking_blocks(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:452
    def render_tool_call_with_thinking(msg, caching: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:618
    def resolve_effort(thinking); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:85
    def separate_messages(messages); end

    # Any block that is not text, thinking, or a function tool_use is a
    # provider-executed tool step. Matching by shape rather than by an
    # allowlist keeps tools Anthropic ships later flowing through.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:288
    def server_tool_block?(block); end

    # Hosts that don't take the binding's beta override this.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:125
    def thinking_block_binding?; end

    # Effort alone never turns thinking on; Claude needs a thinking block.
    # Generations that take a budget get one sized from the effort with
    # the levels Bedrock publishes. Generations without a budget option
    # think adaptively, and so does a bare switch, except on generations
    # that only take a budget, which get the smallest one.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:573
    def thinking_mode(thinking, model, effort, max_tokens); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:610
    def thinking_off_type(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:588
    def toggle_mode(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:78
    def warn_unsupported_citations(model); end
  end
end

