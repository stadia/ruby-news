# Content filter verdicts as Azure reports them beside a completion:
# prompt_filter_results and each choice's content_filter_results on
# Chat Completions, a content_filters list on the Responses API.
# Each category is an object with filtered and either a severity or
# detected.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:11
module RubyLLM::Protocols::ChatCompletions::ContentFilters
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:14
  def parse_content_filters(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:25
  def parse_filter_results(results, source); end

  # Custom blocklists come as a list, one verdict for each blocklist.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:36
  def parse_verdict(verdict, category, source); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:14
    def parse_content_filters(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:25
    def parse_filter_results(results, source); end

    # Custom blocklists come as a list, one verdict for each blocklist.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/content_filters.rb:36
    def parse_verdict(verdict, category, source); end
  end
end

# The endpoint paths a base URL of an OpenAI-compatible API must not
