# Shows a chat's messages live with Turbo when
# Configuration#broadcast_messages, or the model's +broadcasts:+
# option, is on. An empty assistant reply is
# appended when it is created, so its chunks have a place to land, and
# each chunk is appended as a numbered span that the chat UI's Stimulus
# controller puts back in order. A saved message replaces itself, a
# destroyed one is removed, and every change refreshes the chat page.
# A refresh carries no request id, so it reaches the page whose request
# made the change too, and Turbo never skips a burst of refreshes as
# that page's own. Broadcasts go to the chat record's stream:
#
#   <%= turbo_stream_from @chat %>
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:20
module RubyLLM::ActiveRecord::MessageBroadcasting
  extend ::ActiveSupport::Concern

  mixes_in_class_methods ::RubyLLM::ActiveRecord::MessageBroadcasting::ClassMethods

  # Appends the content of +chunk+, a RubyLLM::Chunk streamed into this
  # message, to the message's <tt><dom_id>_stream</tt> element as
  # <tt><span data-seq="index"></tt>, escaped. Each span names the
  # index of the span before it in <tt>data-after</tt>, so the page can
  # order them. A chunk can reach the page before the message does, and
  # Turbo drops an append with no target, so a page of your own must hold
  # it, as the chat UI's Stimulus controller does. Returns +nil+ for a
  # chunk without content. Raises
  # RubyLLM::ConfigurationError when the message does not broadcast.
  #
  #   chat.ask("Tell me a story") { |chunk| chunk.message.broadcast_chunk(chunk) }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:62
  def broadcast_chunk(chunk); end

  # Returns whether this model's messages broadcast: its
  # +broadcasts:+ option when given, Configuration#broadcast_messages
  # otherwise.
  # Returns whether this message broadcasts. See ::broadcasting?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:46
  def broadcasting?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:79
  def chunk_span(chunk, after); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:75
  def streaming_placeholder?; end

  class << self
    # Returns whether Turbo broadcasting can run: turbo-rails and Action
    # Cable are loaded.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:25
    def available?; end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:36
module RubyLLM::ActiveRecord::MessageBroadcasting::ClassMethods
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/message_broadcasting.rb:40
  def broadcasting?; end
end

