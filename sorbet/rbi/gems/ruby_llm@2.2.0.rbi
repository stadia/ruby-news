class RubyLLM::Tokenization
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/tokenization.rb:44
  def initialize(ids:, model:, raw: T.unsafe(nil)); end

  # Returns the number of tokens in the text.
