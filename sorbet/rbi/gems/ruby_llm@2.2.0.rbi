# Finds registry entries by model id, resolving aliases, provider
# registry ids, and deployments, and preferring first-party providers.
#
# pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:7
module RubyLLM::Models::Lookup
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:86
  def aliased_matches(model_id, resolved_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:54
  def bare_matches(model_id); end

  # Bare-name matches come first so they win ties; each configured
  # provider then adds what it serves under its own alias or registry
  # id, as with provider:.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:73
  def configured_candidates(model_id, config, errors); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:24
  def find_deployed_model(deployment, model_id, provider, config); end

  # One provider's configuration problem, such as a stale Azure
  # deployment, must not hide another provider that serves the name,
  # so it is raised only when nothing else resolves it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:63
  def find_on_configured_providers(model_id, config); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:31
  def find_registered(model_id, provider, config); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:17
  def find_with_provider(model_id, provider, config = T.unsafe(nil)); end

  # A name can be one provider's exact id and another's alias:
  # claude-opus-4 is exact on vertexai, an alias on anthropic.
  # Provider preference settles it, not the kind of match.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:50
  def find_without_provider(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:10
  def models_by_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:103
  def preferred_match(candidates); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:92
  def raise_model_not_found(model_id, provider: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:99
  def refresh_registry_guidance; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models/lookup.rb:40
  def resolve_provider_registry_id(model_id, provider, config = T.unsafe(nil)); end
end

