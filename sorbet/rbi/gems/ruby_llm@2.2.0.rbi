# pkg:gem/ruby_llm#lib/ruby_llm/providers/perplexity/models.rb:14
module RubyLLM::Protocols::Perplexity; end

# Perplexity's Agent API, a dialect of the Responses API. A request names
# either a preset, which bundles a model, search settings, and
# instructions, or a model in provider/model form.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:9
class RubyLLM::Protocols::Perplexity::Agent < ::RubyLLM::Protocols::Responses
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:26
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:30
  def render_payload(messages, model:, max_output_tokens: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:22
  def server_tool_aliases; end

  private

  # Perplexity sends each function call whole, without argument deltas,
  # and announces its own web searches as function calls whose items
  # finish as search_results. Only a finished function_call item is a
  # call for the application to run.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:70
  def build_item_added_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:74
  def build_item_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:41
  def default_max_output_tokens(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:45
  def parse_citations(data, output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:60
  def parse_server_tool_use(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:53
  def parse_usage(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:94
  def provider_file_references?; end

  # Perplexity rejects its own search_results and fetch_url_results
  # items as input, so a replayed turn keeps only messages, reasoning,
  # and function calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:87
  def render_assistant_items(msg); end
end

