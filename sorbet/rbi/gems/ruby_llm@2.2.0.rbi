# A Cost prices token usage in US dollars using pricing from the model
# registry. Usage entries own accounting events; Message and Chat aggregate
# calls, and Model#cost_for prices any token usage against a specific model.
#
#   response = chat.ask "Summarize Ruby's object model."
#   response.cost.total
#
#   cost = model.cost_for(response.tokens)
#   cost.input
#   cost.output
#
# The components are RubyLLM's normalized token buckets: #input, #output,
# #cache_read, #cache_write, and #thinking, plus #characters,
# #audio_seconds, and #search_units for operations billed in those units.
# When the registry lacks pricing for usage that was reported, the
# affected component and #total return +nil+ instead of a false zero.
#
#   speech = RubyLLM.speak "Hello"
#   speech.cost.characters # => 0.00015, or nil when no price is known
#
#
# When the provider reports the exact cost of a call, #total returns the
# reported amount instead of a registry-price estimate, even when
# registry pricing is missing.
#
# Costs are computed when the object is built. Readers do not recalculate
# them when registry prices change.
# ::aggregate and ::from_h return the same class, so a single call, a
# whole chat, and a stored breakdown all read the same way.
#
# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:33
class RubyLLM::Cost
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:115
  def initialize(tokens: T.unsafe(nil), model: T.unsafe(nil), category: T.unsafe(nil), input_details: T.unsafe(nil), tier: T.unsafe(nil), amounts: T.unsafe(nil), missing: T.unsafe(nil), reported: T.unsafe(nil), complete: T.unsafe(nil), total: T.unsafe(nil)); end

  # Returns the cost of billed audio seconds in US dollars, or +nil+ when
  # the duration or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:172
  def audio_seconds; end

  # Returns the cost of cache-read input tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:144
  def cache_read; end

  # Returns the cost of cache-write input tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable. Writes with a
  # longer lifetime, reported in Tokens#cache_write_by_ttl, are priced at
  # the provider's rate for that lifetime.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:152
  def cache_write; end

  # Returns the cost of billed characters in US dollars, or +nil+ when
  # the count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:166
  def characters; end

  # Returns the cost of input tokens in US dollars, or +nil+ when the
  # token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:132
  def input; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:209
  def missing?(component); end

  # Returns the cost of billable output tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:138
  def output; end

  # Returns the cost of billed search units in US dollars, or +nil+ when
  # the count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:178
  def search_units; end

  # Returns the cost of thinking tokens in US dollars, or +nil+ when
  # the model does not price reasoning output separately from regular
  # output or the token count is unavailable. When not priced
  # separately, thinking tokens are part of #output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:160
  def thinking; end

  # Returns a hash of component costs in US dollars, plus +:total+,
  # omitting +nil+ values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:201
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:205
  def tokens?; end

  # Returns the sum of all components in US dollars, or the exact amount
  # the provider reported when it reported one. Returns +nil+ when there
  # is no token usage, or when pricing is missing for tokens that were
  # used and the provider reported no cost. A calculated total covers only
  # the counts the provider reported, so partial usage can leave out charges.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:187
  def total; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:237
  def amount_for(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:340
  def cache_write_amount; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:369
  def cache_write_by_ttl; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:344
  def cache_write_missing?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:359
  def cache_write_multipliers; end

  # Cache writes as [count, price] pairs: lifetimes the provider prices
  # from the input price, then the rest at the registry's cache-write price.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:350
  def cache_write_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:327
  def category_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:377
  def detailed_image_input?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:373
  def image_cost?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:381
  def image_input_amount; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:391
  def image_input_missing?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:397
  def image_input_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:323
  def image_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:404
  def input_detail(key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:289
  def input_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:425
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:230
  def missing_component?(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:415
  def normalize_model(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:295
  def output_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:270
  def price_for(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:215
  def price_tokens(tokens, model, category, input_details, tier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:315
  def prompt_tokens; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:226
  def reported_total; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:336
  def repriced_cache_writes?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:301
  def text_input_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:305
  def text_output_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:309
  def text_price(attribute, standard_price); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:319
  def text_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:408
  def thinking_priced_separately?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:251
  def tokens_for(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:281
  def unit_price(unit); end

  class << self
    # Combines several costs into one Cost that sums each component.
    # Ignores +nil+ entries. A component returns +nil+ when pricing was
    # missing for one of the calls, or when no call has a cost for that
    # component. Pass <tt>complete: false</tt> when some requests are still
    # running or their costs are unknown; #total then remains +nil+.
    #
    #   cost = RubyLLM::Cost.aggregate(messages.map(&:cost))
    #   cost.total
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:50
    def aggregate(costs, complete: T.unsafe(nil)); end

    # Rebuilds a cost from a stored breakdown Hash, as produced by #to_h
    # and persisted alongside a usage entry. Keys may be Strings or
    # Symbols, and amounts may be numeric Strings, as JSON encodes
    # decimals. The component readers return the recorded amounts and
    # #total equals the recorded +:total+. A breakdown with a total omits
    # the components that had no usage, so ::aggregate still sums them
    # across costs. Pass +tokens+ to mark used components without a
    # recorded amount as missing pricing.
    #
    #   RubyLLM::Cost.from_h({ input: 0.0001, total: 0.0003 }).total
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:76
    def from_h(hash, tokens: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:92
    def aggregate_total(costs); end

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:97
    def missing_recorded_components(amounts, tokens, total); end

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:87
    def recorded_amount(hash, key); end

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:107
    def recorded_tokens?(amounts, tokens, total_recorded); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:37
RubyLLM::Cost::COMPONENTS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:38
RubyLLM::Cost::PER_MILLION = T.let(T.unsafe(nil), Float)

# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:36
RubyLLM::Cost::UNITS = T.let(T.unsafe(nil), Array)

# Raised when a deprecated API is used and
# Configuration#deprecation_behavior is +:raise+. With the default
# +:warn+, deprecations are logged instead.
#
#   RubyLLM.configure do |config|
#     config.deprecation_behavior = :raise
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:138
class RubyLLM::DeprecationError < ::StandardError; end

# A DownloadedFile contains a provider file's bytes. Save it with #save
# or read the bytes with #to_blob. It is also a String, so parsers and
# existing string operations work directly on the result.
#
#   RubyLLM.download(file.id, provider: :openai).save("report.pdf")
#
# pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:10
class RubyLLM::DownloadedFile < ::String
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Files::Saving

  # Returns the raw file bytes as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:24
  def to_blob; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:30
  def inspect_attributes; end
end

# An Embedding is the result of turning text into numerical vectors.
# RubyLLM.embed returns one:
#
#   embedding = RubyLLM.embed("Ruby is a programmer's best friend")
#   embedding.vector # => [0.018, -0.027, ...]
#
# Pass an array to embed several texts in one call on supported models:
#
#   RubyLLM.embed(["Ruby", "Rails"]).vectors # => [[...], [...]]
#
# Store the vectors for similarity search. #tokens and #cost report
# usage when the provider supplies it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:17
class RubyLLM::Embedding
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result
  include ::RubyLLM::Accounting::Usage::ModelInfo

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:48
  def initialize(vectors:, model:, sparse_vectors: T.unsafe(nil), input_tokens: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # Returns the embedding cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:64
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:147
  def inspect_attributes; end

  # The id of the model that produced the vectors, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:34
  def model; end

  # The sparse vectors, for models that return one beside the dense
  # vector, as a Hash mapping token id to weight. Shaped like #vectors:
  # one Hash for a single text, an array of them for an array of texts.
  # +nil+ on models that return only dense vectors.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:31
  def sparse_vectors; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:57
  def tokens; end

  # Returns the only vector of this result. Raises Error when it holds
  # several, one for each text of an array, so read #vectors instead.
  #
  #   RubyLLM.embed("Ruby").vector # => [0.018, -0.027, ...]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:41
  def vector; end

  # The embedding vectors. A flat array of floats when a single text
  # was embedded, an array of such arrays when an array of texts was
  # embedded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:25
  def vectors; end

  class << self
    # Generates embeddings for +text+ and returns an Embedding. +text+
    # may be a single string or, on supported models, an array of strings.
    # An array produces one vector per string in a single API call.
    #
    #   RubyLLM.embed "Ruby is a programmer's best friend"
    #   RubyLLM.embed ["Ruby", "Python", "JavaScript"]
    #   RubyLLM.embed "This is a test sentence",
    #                 model: "text-embedding-3-large",
    #                 dimensions: 512
    #   RubyLLM.embed "RubyLLM makes provider APIs feel native to Ruby.",
    #                 model: "gemini-embedding-001",
    #                 provider: :vertexai,
    #                 task_type: "RETRIEVAL_DOCUMENT",
    #                 title: "RubyLLM docs"
    #   RubyLLM.embed "The Ruby logo",
    #                 model: "gemini-embedding-2",
    #                 with: "logo.png"
    #
    # +model:+ selects the embedding model and defaults to the
    # configured +default_embedding_model+. +provider:+ forces a specific
    # provider, and <tt>assume_model_exists: true</tt> skips the model
    # registry check. +context:+ supplies a Context whose configuration
    # is used instead of the global one. +dimensions:+ requests a
    # specific vector size on models that support it. +task_type:+ names
    # the embedding task in the provider's own vocabulary: Vertex AI and
    # Gemini take values such as <tt>"RETRIEVAL_QUERY"</tt> or
    # <tt>"RETRIEVAL_DOCUMENT"</tt>, while Bedrock Cohere takes an input
    # type such as <tt>"search_document"</tt>. +title:+ labels the
    # document on Vertex AI and Gemini retrieval tasks. Providers that
    # cannot carry either raise ArgumentError. +with:+ passes one or more media
    # attachments (images, audio, video, PDFs) to embed alongside the
    # text on multimodal embedding models such as Gemini's
    # gemini-embedding-2; providers without multimodal embeddings raise
    # UnsupportedAttachmentError. +provider_options:+ takes options
    # in the provider's request vocabulary and merges them into the
    # request as-is. +metadata:+ is not sent to the provider; it is
    # attached to the emitted +embedding.ruby_llm+ instrumentation event.
    # +owner:+ attributes the usage to a record, such as a user, and wins
    # over RubyLLM.with_owner.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:109
    def embed(text, model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), dimensions: T.unsafe(nil), task_type: T.unsafe(nil), title: T.unsafe(nil), with: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:143
    def embedding_count(vectors); end

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:138
    def vector_dimensions(vectors); end
  end
end

# An EmbeddingRequest is an embedding awaiting a provider-side batch.
# RubyLLM.embed_later stages one; submit an array of them with
# RubyLLM.batch, and once the batch completes, collecting the results
# fills in #result:
#
#   requests = texts.map { |text| RubyLLM.embed_later(text) }
#   batch = RubyLLM.batch(requests)
#   # later, once batch.refresh.complete?
#   batch.results
#   requests.first.result.vector
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:15
class RubyLLM::EmbeddingRequest
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:35
  def initialize(text, model: T.unsafe(nil), provider: T.unsafe(nil), dimensions: T.unsafe(nil), context: T.unsafe(nil)); end

  # The requested vector size, or +nil+ for the model's default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:25
  def dimensions; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:49
  def inspect_attributes; end

  # The Model of the embedding model the request targets.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:22
  def model; end

  # The Provider the request will be submitted through.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:28
  def provider; end

  # Returns the request payload this embedding request would send to the
  # provider, in the provider's wire format.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:45
  def render; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result=(_arg0); end

  # The text staged for embedding.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:19
  def text; end
end

# Error is the base class for provider-operation errors raised by
# RubyLLM, including API, network, capability, and provider response-shape
# failures. When an HTTP response is available, it wraps that response and
# normalizes the message across providers. Subclasses map common HTTP
# status codes: BadRequestError (400), UnauthorizedError (401),
# PaymentRequiredError (402), ForbiddenError (403), RateLimitError (429),
# ServerError (500), ServiceUnavailableError (502 to 504), and
# OverloadedError (529).
#
#   begin
#     RubyLLM.chat.ask "Translate 'hello' to French."
#   rescue RubyLLM::RateLimitError
#     puts "Rate limit hit. Please wait a moment."
#   rescue RubyLLM::Error => e
#     puts "API error: #{e.message}"
#     puts e.response&.status
#   end
#
# Providers often quote the request back in their error, so with
# Configuration#redact_error_messages the message carries only the HTTP
# status, the provider, and the provider's error code. What the provider
# wrote stays on #provider_message and its raw body on #response_body.
#
# Local setup and programming errors, such as ConfigurationError and
# ModelNotFoundError, inherit from StandardError directly and are not
# caught by rescuing Error.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:30
class RubyLLM::Error < ::StandardError
  # Creates an error with +message+. Pass +response:+ to attach the HTTP
  # response, +provider:+ to name the provider's slug, +error_code:+ for
  # the provider's code, kept only when it reads like one, and
  # +provider_message:+ for what the provider wrote, which follows
  # +message+, or stands in for it when +message+ is +nil+. Without
  # either, the response body supplies the message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:68
  def initialize(message = T.unsafe(nil), response: T.unsafe(nil), provider: T.unsafe(nil), provider_message: T.unsafe(nil), error_code: T.unsafe(nil), redact: T.unsafe(nil)); end

  # The provider's code for the error, such as
  # <tt>"invalid_request_error"</tt> or <tt>"INVALID_ARGUMENT"</tt>, or
  # +nil+ when it gave none that reads like a code.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:42
  def error_code; end

  # The slug of the provider that answered, such as <tt>"openai"</tt>, or
  # +nil+ when it is not known.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:37
  def provider; end

  # What the provider wrote about the error, or +nil+ when it wrote
  # nothing RubyLLM could read. It can quote the request, so
  # Configuration#redact_error_messages keeps it out of #message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:47
  def provider_message; end

  # The payload request_protocol rendered for the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:54
  def request_payload; end

  # The payload request_protocol rendered for the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:54
  def request_payload=(_arg0); end

  # The Protocol that rendered the request the error answered, which
  # reads its payload back for #request_shape.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:51
  def request_protocol; end

  # The Protocol that rendered the request the error answered, which
  # reads its payload back for #request_shape.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:51
  def request_protocol=(_arg0); end

  # Returns a RequestShape describing the conversation request the error
  # answered: each turn's parts and their sizes, never their contents,
  # and the problems providers are known to refuse. Returns +nil+ for
  # errors raised before a request goes out, such as an unsupported
  # attachment, and for operations that send no conversation, such as
  # embeddings.
  #
  #   rescue RubyLLM::BadRequestError => e
  #     Rails.logger.error("#{e.message}\n#{e.request_shape}")
  #     Rails.error.report(e, context: { request_shape: e.request_shape&.to_h })
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:95
  def request_shape; end

  # The HTTP response that caused the error, or +nil+ when none is
  # available. Its +status+ and +body+ carry the provider's reply.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:33
  def response; end

  # Returns the body of #response, or +nil+ without one. It can quote the
  # request, so Configuration#redact_error_messages keeps it out of
  # #message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:80
  def response_body; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:104
  def full_message_for(message, redact:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:115
  def redacted_message; end

  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:121
  def redacted_source; end

  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:111
  def remote?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:125
  def response_body_message; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:56
    def default_message; end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:60
RubyLLM::Error::ERROR_CODE = T.let(T.unsafe(nil), Regexp)

# Defines reusable evaluations with a dataset, semantic criteria, and Ruby assertions.
# Datasets default to app/evals/<class_name>.yml, .yaml, .json, or .jsonl.
# Without declared criteria, evaluates correctness against each case's expected_output.
#
#   class SupportEvaluation < RubyLLM::Evaluation
#     def perform(input)
#       SupportAgent.new.ask(input)
#     end
#   end
#
#   SupportEvaluation.run.save("tmp/support.json")
#
# pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:15
class RubyLLM::Evaluation
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:281
  def assertion_context; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:285
  def assertion_count; end

  # Runs Ruby assertions after perform. Override to use assert, refute, and the Minitest assertion family.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:205
  def assertions; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:276
  def execute; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:195
  def expected_output; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:195
  def input; end

  # Returns retained messages from a Chat, Agent, or Message result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:219
  def messages; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:195
  def metadata; end

  # :stopdoc:
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:256
  def method_missing(name, *, **, &); end

  # Returns the primary answer or value extracted from result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:214
  def output; end

  # Runs the application under evaluation. Override in your evaluation class.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:200
  def perform(_input); end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:270
  def prepare(test_case); end

  # Returns the original value returned by perform.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:197
  def result; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:266
  def run_case(test_case, repetition, groups, run_id:); end

  # Runs before perform on each fresh case instance. Override for application fixtures.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:208
  def setup; end

  # Runs after each case, even when setup, perform, or an assertion fails.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:211
  def teardown; end

  # Returns tool calls recorded in the returned conversation or message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:224
  def tool_calls; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:262
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end

  class << self
    # Converts a custom result into evaluation evidence. The original stays available as result.
    #
    #   adapt Invoice do |invoice|
    #     invoice.attributes.slice("total", "currency")
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:75
    def adapt(type, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:129
    def adapters; end

    # Returns the dataset cases without running the application or its evaluators.
    # Supply only to select one or more case names, raising when any name is missing.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:83
    def cases(dataset: T.unsafe(nil), only: T.unsafe(nil)); end

    # Sets the dataset path, enumerable of cases, or block returning cases.
    # With no argument, returns the configured source. The default is discovered by class name.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:30
    def dataset(source = T.unsafe(nil), &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:125
    def definitions; end

    # Declares a semantic criterion. A minimum applies to a native probability or score;
    # without one, numeric decisions are measured but do not count as passes.
    # Omit instructions to set a minimum on a question already defined by a Judge.
    # Declared criteria replace implicit correctness. Use evaluation :correctness
    # without instructions to include the built-in reference comparison explicitly.
    # Supply evaluator to override the class evaluator for this criterion.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:58
    def evaluation(name, instructions = T.unsafe(nil), minimum: T.unsafe(nil), evaluator: T.unsafe(nil)); end

    # Sets the default evaluator: a model, Agent class, or Judge class.
    # Model keywords accept provider, protocol, and context as Chat does.
    # Without a declaration, uses the default chat model and built-in reviewer.
    # Pass false to disable model grading and run only Ruby assertions.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:42
    def evaluator(target = T.unsafe(nil), **options); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:20
    def inherited(subclass); end

    # Executes fresh instances for every case and repetition and returns an Evaluation::Report.
    # A supplied dataset overrides discovery for this run. Configuration errors raise;
    # task, assertion, and evaluator failures are recorded per case.
    # Yields each completed Trial before starting the next. Exceptions from the block propagate.
    # Supply id to correlate reports and instrumentation with an application record or job.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:99
    def run(dataset: T.unsafe(nil), only: T.unsafe(nil), repetitions: T.unsafe(nil), id: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:186
    def correctness_instructions(cases); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:161
    def evaluation_groups(cases); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:174
    def prepare_criterion(backend, criterion, cases); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:135
    def run_trial(test_case, repetition, groups, run); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:154
    def validate_criterion(name, minimum); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:144
    def validate_run(repetitions); end
  end
end

