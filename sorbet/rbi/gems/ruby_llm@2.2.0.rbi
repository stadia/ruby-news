    def provider_file_attachable?(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:113
    def provider_file_references?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:160
    def reasoning_tokens(usage); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:498
    def render_additional_model_request_fields(thinking, model, max_output_tokens = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:92
    def render_count_tokens_payload(messages, tools:, model:, tool_prefs: T.unsafe(nil), thinking: T.unsafe(nil), schema: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:447
    def render_inference_config(_model, temperature, max_output_tokens = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:219
    def render_message_content(msg, caching: T.unsafe(nil), citations: T.unsafe(nil), tool_text: T.unsafe(nil)); end

    # Converse refuses toolUse and toolResult blocks in a request without
    # a toolConfig, and has no tool choice of none, so a request that
    # declares no tools, such as a summary of a chat that called them,
    # gets its tool rounds as text (+tool_text+).
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:177
    def render_messages(messages, caching: T.unsafe(nil), citations: T.unsafe(nil), search_results: T.unsafe(nil), tool_text: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:209
    def render_non_tool_message(msg, caching: T.unsafe(nil), citations: T.unsafe(nil), tool_text: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:57
    def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:319
    def render_role(role); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:244
    def render_structured_message_content(msg, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:326
    def render_system(messages, caching: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:543
    def render_thinking_block(thinking); end

    # Reasoning rebuilt from thinking text goes back only to the provider
    # that produced it: Claude refuses another provider's signature, and
    # a block without one.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:257
    def render_thinking_blocks(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:479
    def render_tool(tool); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:466
    def render_tool_choice(choice); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:454
    def render_tool_config(tools, tool_prefs); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:276
    def render_tool_result_block(msg, citations: T.unsafe(nil), search_results: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:265
    def render_tool_result_blocks(msg, caching: T.unsafe(nil), citations: T.unsafe(nil), search_results: T.unsafe(nil), tool_text: T.unsafe(nil), call: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:293
    def render_tool_result_content(msg, citations: T.unsafe(nil), search_results: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:285
    def render_tool_result_text(msg, call, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:302
    def search_result_block(result); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:375
    def search_results?(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:690
    def server_tool_result?(tool_result); end

    # Provider-executed tool steps come back with a distinguishing type,
    # such as server_tool_use; function calls carry no type or the plain
    # tool_use type.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:685
    def server_tool_use?(tool_use); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:393
    def stable_prefix_blocks(payload, model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:313
    def text_tool_result_block(text); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:240
    def tool_call_text_block(tool_call); end
  end
end

