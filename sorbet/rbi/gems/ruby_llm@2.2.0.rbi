  def normalize(tools, tools_with_options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:77
  def normalize_positional(tool); end

  # Entries that already went through normalize (an Agent's declared
  # provider_tools, for example) pass through unchanged.
