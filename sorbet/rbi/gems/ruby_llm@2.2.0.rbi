  # :call-seq:
  #   with_file_store(store = active_storage_store, inline_limit: 10_000, tools: %i[read write edit])
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_files.rb:23
  def with_file_store(store = T.unsafe(nil), **); end
end

# View helpers for a chat's page, available in every view of a Rails
# app. The views <tt>bin/rails generate ruby_llm:chat_ui</tt> writes use
# them.
#
#   <%= render tool_call_partial(tool_call), message:, tool_call: %>
#   Cost so far: <%= cost_label(@chat.cost) %>
#
# To change one, define a method with the same name in a helper of
# your own, such as +app/helpers/messages_helper.rb+: it takes the
# place of RubyLLM's. An app whose chat UI was generated before
# RubyLLM shipped these keeps the +MessagesHelper+ the generator wrote,
# and its methods win the same way.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:18
module RubyLLM::ActiveRecord::ChatHelper
  # Returns +cost+, a RubyLLM::Cost, in US dollars to four decimal
  # places, such as "$0.0123". RubyLLM prices every cost in US dollars,
  # so the label is in dollars whatever the app's locale.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:28
  def cost_label(cost); end

  # Returns the label of the configured default model, such as
  # "Default: GPT-6.1 Sol", for the empty choice of a model picker.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:21
  def default_model_display_name; end

  # Returns the partial that renders +tool_call+, a RubyLLM::ToolCall:
  # the one named after its tool in the +tool_calls+ folder beside the
  # current template, as <tt>bin/rails generate ruby_llm:tool</tt>
  # writes it, or that folder's +default+ partial.
  #
  #   tool_call_partial(tool_call) # => "messages/tool_calls/weather"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:39
  def tool_call_partial(tool_call); end

  # Returns a tool's +name+ for a person to read, such as "Weather"
  # for +weather+, or "Tool" without one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:52
  def tool_label(name); end

  # Returns the label of the tool whose result +message+ holds. See
  # #tool_label.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:58
  def tool_result_label(message); end

  # Returns the partial that renders +message+, a tool result, from
  # the +tool_results+ folder beside the current template, as
  # #tool_call_partial does for a call.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:46
  def tool_result_partial(message); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_helper.rb:64
  def ruby_llm_tool_partial(folder, name); end
end

# ChatMethods provides the RubyLLM::Chat API on ActiveRecord models
# declared with <tt>acts_as_chat</tt>, persisting every message to the
# database. Configuration methods return +self+ so calls can be chained.
#
#   class Chat < ApplicationRecord
#     acts_as_chat
#   end
#
#   chat = Chat.create!(model: 'gpt-6-luna')
#   chat.ask "What is the capital of France?"
#   chat.messages.count # => 2
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:32
module RubyLLM::ActiveRecord::ChatMethods
  include ::RubyLLM::Chat::AgentRun
  include ::RubyLLM::Chat::Rescuable
  include ::RubyLLM::ActiveRecord::ChatAgentHooks
  include ::ActiveSupport::ToJsonWithActiveSupportEncoder
  include ::Enumerable
  include ::RubyLLM::Support::DeprecatedEnumerable
