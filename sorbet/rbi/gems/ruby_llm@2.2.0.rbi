# pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:8
module RubyLLM::Protocol::Streaming
  private

  # Some adapters omit the env, so ErrorMiddleware also resets the
  # request's fallback state before each attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:127
  def build_on_data_handler(progress = T.unsafe(nil), fallback_state: T.unsafe(nil), &handler); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:270
  def build_stream_error_response(parsed_data, env, status); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:281
  def failed_http_status(env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:106
  def faraday_1?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:234
  def handle_data(data, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:243
  def handle_error_event(data, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:203
  def handle_failed_response(chunk, buffer, env); end

  # Faraday 1 knows the status only once the response ends, so the error
  # waits in the buffer until the error middleware reports it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:176
  def handle_json_body(chunk, state, env); end

  # Marking progress just before a chunk reaches the user lets the retry
  # middleware know this stream already delivered, so a mid-stream failure
  # must not be retried into the same accumulator and user block. An error
  # event raises out of handle_data first, leaving the stream retriable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:217
  def handle_sse(chunk, parser, env, progress); end

  # Adapters cut reads anywhere, so a read inside an event can start with
  # "{". Only the first bytes of a body can open a bare JSON error.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:169
  def json_body?(chunk, state); end

  # Faraday 1 knows the status only once the response ends, so a failure
  # body that is not JSON has to be kept until then.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:163
  def keep_for_failure(chunk, state); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:263
  def parse_error_from_json(data, env, error_message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:247
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:110
  def post_stream(url, payload, on_data:, progress:, on_reset:, on_failure: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:145
  def process_stream_chunk(chunk, state, env, progress, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:185
  def raise_buffered_error(state, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:157
  def raise_stray_error(state, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:256
  def raise_stream_error(raw_data, parsed_data, env); end

  # Runs once the response has ended, when a body that never parsed as
  # JSON is the only account of the failure.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:194
  def raise_stream_failure(state, env); end

  # Posts +payload+ to +url+ as a server-sent event stream, yielding each
  # parsed event Hash. Returns the Faraday response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:88
  def stream_events(url, payload, additional_headers = T.unsafe(nil), &handler); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:121
  def stream_failure(fallback_state); end

  # Returns a last Chunk for text a protocol held back while streaming,
  # or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:82
  def stream_remainder; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:58
  def stream_response(payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:139
  def stream_state(env, fallback_state); end

  class << self
    # Posts +payload+ to +url+ as a server-sent event stream, yielding each
    # parsed event Hash. Returns the Faraday response.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:88
    def stream_events(url, payload, additional_headers = T.unsafe(nil), &handler); end

    # Returns a last Chunk for text a protocol held back while streaming,
    # or +nil+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:82
    def stream_remainder; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:58
    def stream_response(payload, additional_headers = T.unsafe(nil), &block); end
  end
end

