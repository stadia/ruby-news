# Chat methods of the OpenRouter API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:7
module RubyLLM::Providers::OpenRouter::Chat
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:82
  def add_reasoning_toggle(reasoning, thinking); end

  # OpenRouter compacts through its context-compression plugin, which
  # drops messages from the middle of the conversation once the prompt
  # would overflow the model's context window. It summarizes nothing
  # and takes no threshold of its own, so the portable options have
  # nowhere to go.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:24
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:15
  def apply_end_user(payload, identifier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:71
  def build_reasoning(thinking); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:145
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:171
  def default_large_file_upload_threshold; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:147
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:113
  def inject_cache_control(content, caching: T.unsafe(nil), ttl: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:29
  def log_ignored_compaction_options(compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:151
  def openai_prompt_caching?; end

  # OpenRouter requires the reasoning_details array back untouched for
  # signed reasoning to survive multi-turn tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:213
  def parse_raw_reasoning(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:198
  def parse_thinking_signature(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:179
  def parse_thinking_text(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:125
  def prompt_cache_control(caching = T.unsafe(nil), ttl: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:134
  def prompt_cache_options(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:175
  def provider_file_attachable?(attachment); end

