  # extra_content carries Gemini's thought signatures on Google's
  # OpenAI-compatible endpoints, and Mistral refuses any field it does
  # not define.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:82
  def render_tool_calls(tool_calls); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:133
    def append_formatted_content(content_blocks, formatted_content); end

