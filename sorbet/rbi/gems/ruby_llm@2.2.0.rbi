# MiniMax API integration, through its Anthropic-compatible endpoint.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:6
class RubyLLM::Providers::MiniMax < ::RubyLLM::Provider
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:49
  def account_identity; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:37
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:53
  def error_status(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:45
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:41
  def media_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:58
  def parse_error(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:30
  def protocol_for(model, schema: T.unsafe(nil), thinking: T.unsafe(nil), tool_prefs: T.unsafe(nil), provider_tools: T.unsafe(nil), messages: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:25
  def resolve_protocol(name, model, operation: T.unsafe(nil), **options); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:95
  def failure_code(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:91
  def messages_only_request?(schema, thinking, tool_prefs); end

  # Only Responses cites web pages, but it ignores an attached PDF, so a
  # chat that holds one stays on Messages, which reads it. Messages also
  # raises on what MiniMax cannot carry and honours a thinking budget or
  # off switch, all of which Responses would drop.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:84
  def web_search_route?(schema, thinking, tool_prefs, provider_tools, messages); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:69
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:73
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax.rb:65
    def models_dev_provider_ids; end
  end
end

# MiniMax's dialect of the Anthropic Messages API. MiniMax has no
# Files API on this endpoint, and web search is the one server tool it
# runs, in Anthropic's first version.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:9
class RubyLLM::Providers::MiniMax::Anthropic < ::RubyLLM::Protocols::Anthropic
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:32
  def provider_file_references?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:24
  def render_count_tokens_payload(messages, tool_prefs: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:17
  def render_payload(messages, tools:, schema: T.unsafe(nil), tool_prefs: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:28
  def server_tool_aliases; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:36
  def supported_attachment?(attachment); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:60
  def append_formatted_content(content_blocks, msg, citations: T.unsafe(nil)); end

  # A web search turn answered on Responses keeps that route's output
  # items, which a Messages request cannot carry.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:83
  def foreign_native_content?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:52
  def render_content(content, attachments = T.unsafe(nil), citations: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:67
  def render_video(video); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:87
  def responses_output?(raw_content); end

  # A video block is documented for user messages only; tool results
  # and system prompts take the attachments Anthropic's format does.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:46
  def supported_message_attachment?(message, attachment); end

  # MiniMax's fetcher is refused by many hosts, so remote videos travel inline.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/minimax/anthropic.rb:74
  def video_source(video); end
end

