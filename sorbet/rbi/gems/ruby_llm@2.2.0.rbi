# Gives each RubyLLM::Chunk streamed from a persisted chat the message
# record it streams into.
#
#   chat.ask("Tell me a story", &:broadcast)
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:10
module RubyLLM::ActiveRecord::ChunkMethods
  # Appends this chunk to its message on the chat's page. See
  # MessageBroadcasting#broadcast_chunk. Raises
  # RubyLLM::ConfigurationError when the message does not broadcast.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:42
  def broadcast; end

  # Returns the persisted message record this chunk streams into.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:37
  def message; end

  # Returns the persisted message record this chunk streams into.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:37
  def message=(_arg0); end

  class << self
    # Gives +chunk+ the record +message+ it streams into. Returns +chunk+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:30
    def attach(chunk, message); end

    # Returns a block that gives each chunk the record +message+ returns
    # before passing it to +block+, or +nil+ without a block. Calls
    # +on_error+ when +block+ raises, then re-raises the error.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:18
    def streaming(block, on_error: T.unsafe(nil), &message); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chunk_methods.rb:11
RubyLLM::ActiveRecord::ChunkMethods::BROADCASTING_OFF = T.let(T.unsafe(nil), String)

# Calls its block every +interval+ seconds from a thread of its own
# until stopped. The thread connects as the starting thread did, to the
# same roles and shards, and each beat checks out a connection from the
# pool of each of +models+ and returns it, so the thread holds none
# between beats.
#
# A beat that fails is skipped, and the next one tries again. A lease
# spans at least four intervals, so a claim outlasts a skipped beat,
# but after two in a row it may lapse before the next one lands, so
# the second logs a warning.
#
# Once its process is about to exit, ::hurry_all makes every live
# heartbeat beat at once and then every HURRIED_INTERVAL seconds, so a
# claim a run wrote just before learning of the exit is cut back too.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:19
class RubyLLM::ActiveRecord::ClaimHeartbeat
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:41
  def initialize(models, interval, &beat); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:63
  def hurry; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:54
  def stop; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:91
  def beat; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:99
  def beat_failed(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:109
  def busy?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:113
  def connected(pools, deadline, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:139
  def gvl_held_while_busy?(connection); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:144
  def monotonic_now; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:73
  def start(connected_to); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:83
  def stopped_after_interval?; end

  # Before Rails 8, SQLite waits for a lock through busy_timeout, which
  # holds the GVL and stops every thread in the process, including the
  # run whose transaction holds the lock. The beat waits with the GVL
  # released instead, until its deadline, and then disconnects, so the
  # next query on that connection reconnects with the application's own
  # busy settings. An in-memory database has no other connection to wait
  # for, and disconnecting would drop it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:128
  def waiting_until(connection, deadline); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:32
    def add(heartbeat); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:36
    def delete(heartbeat); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:28
    def hurry_all; end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:20
RubyLLM::ActiveRecord::ClaimHeartbeat::HURRIED_INTERVAL = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/active_record/claim_heartbeat.rb:22
RubyLLM::ActiveRecord::ClaimHeartbeat::LIVE_LOCK = T.let(T.unsafe(nil), Thread::Mutex)

# Keeps a persisted chat's files in +ruby_llm_chat_files+, with their
# content in Active Storage, so they live on whatever service Active
# Storage uses: a disk now, a bucket later. A persisted chat uses one
# when ChatFiles#with_file_store is given no store.
#
#   chat.with_file_store
#   chat.file_store.list
#
# The store writes files for the chat's owner, the record
# <tt>acts_as_chat owner:</tt> names or one set with
# ChatMethods#with_owner, and sees only their files and the files
# without an owner, so in a chat several people share, one person's
# tool results stay theirs:
#
#   chat.with_owner(Current.user).with_file_store
#
# What the model last read of a file is kept in the row's
# +read_digest+ column, so it holds across processes, and #with_lock
# locks the chat's row. Converted text is kept in the row's +text+
# column. Encrypt it, like
# anything else the model reads, with
# <tt>RubyLLM::ActiveRecord::ChatFile.encrypts :text</tt>.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:30
class RubyLLM::ActiveRecord::FileStore < ::RubyLLM::FileStore
  # Creates a store for the files of the +chat+ record, writing them for
  # +owner+ when given, and otherwise for the chat's owner.
  #
  # Raises ArgumentError when +chat+ is not an +acts_as_chat+ record,
  # and ConfigurationError when Active Storage is not loaded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:39
  def initialize(chat, owner: T.unsafe(nil)); end

  # Returns the StoredFile at +path+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:71
  def [](path); end

  # Keeps +text+ for +file+ in its row.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:153
  def cache_text(file, text); end

  # Returns the text kept for +file+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:147
  def cached_text(file); end

  # The chat record the files belong to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:32
  def chat; end

  # Deletes the file at +path+ and returns its StoredFile, or +nil+. A
  # store with an owner deletes only that owner's files.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:96
  def delete(path); end

  # Deletes everything inside the folder +path+ and returns the deleted
  # StoredFile objects. A store with an owner deletes only that
  # owner's files.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:109
  def delete_folder(path); end

  # Returns the files inside the folder +prefix+, or every file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:65
  def list(prefix = T.unsafe(nil)); end

  # Returns the owner the store writes files for: the one it was
  # created with, or else the chat's owner when that is a record.
  # Returns +nil+ when there is neither.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:57
  def owner; end

  # Returns the content of the file at +path+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:76
  def read(path); end

  # Returns the digest of what the model last read at +path+, from the
  # file's row, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:120
  def read_digest(path); end

  # Keeps +digest+ as what the model read at +path+, in the file's row.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:127
  def record_read(path, digest); end

  # Keeps an attachment from Active Storage by its blob, without
  # copying it: the file and the message share the blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:160
  def store_attachment(attachment); end

  # Runs the block in a transaction that locks the chat's row, past
  # the query cache, so other processes wait for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:135
  def with_lock; end

  # Writes +content+ to +path+ and returns its StoredFile.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:82
  def write(path, content, content_type: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:183
  def at_start?(io); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:261
  def blob_of(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:252
  def inside(folder, scope = T.unsafe(nil)); end

  # SQLite has no row locks, and a deferred transaction that reads
  # first fails when it later writes beside another writer, so it takes
  # the write lock at once with a no-op update.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:222
  def lock_chat; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:248
  def owned; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:257
  def path(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:235
  def preferred(records); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:189
  def read_digests?; end

  # Active Storage reads an IO from its start, so one that cannot
  # rewind, or stands past its start, is copied to a tempfile first.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:172
  def rewindable(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:231
  def row(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:239
  def rows; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:193
  def rows_in_folder(folder, scope = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:207
  def save(path, byte_size, content_type, digest); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:243
  def visible; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/file_store.rb:198
  def write_attachment(path, attachment, content); end
end

# The OAuth state RubyLLM::MCP keeps for a server, in RubyLLM's
# +ruby_llm_mcp_credentials+ table. +data+ is encrypted with Active
# Record encryption, so the application needs encryption keys.
#
#   RubyLLM::ActiveRecord::MCPCredential.where(owner: current_user).pluck(:updated_at)
#
# Each row has an optional polymorphic +owner+, the record the
# credentials were authorized for. Its columns:
#
# [+key+] The key RubyLLM stores the state under, unique across the table.
# [+data+] Tokens, client registrations, and signing keys, as a Hash.
#          Treat it as a secret.
#
# RubyLLM writes these rows. Read and query them, and add scopes or
# columns of your own, but do not create, update, or delete them: call
# +deauthorize+ on the server to forget a user's credentials.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:21
class RubyLLM::ActiveRecord::MCPCredential < ::RubyLLM::ActiveRecord::Record
  include ::RubyLLM::ActiveRecord::MCPCredential::GeneratedAttributeMethods
  include ::RubyLLM::ActiveRecord::MCPCredential::GeneratedAssociationMethods

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
  def _run_save_callbacks(&block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
  def autosave_associated_records_for_owner(*args); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:42
    def delete(key); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:32
    def read(key); end

    # Updating the row locks it on every adapter; SQLite ignores FOR UPDATE.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:47
    def synchronize(key); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:36
    def write(key, data, owner: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
    def __class_attr___callbacks; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
    def __class_attr___callbacks=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
    def __class_attr__reflections; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:24
    def __class_attr__reflections=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:21
    def __class_attr__validators; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:21
    def __class_attr__validators=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:21
    def __class_attr_defined_enums; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:21
    def __class_attr_defined_enums=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/mcp_credential.rb:27
