  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:415
  def interrupted?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:419
  def last_event_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:384
  def raised?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:368
  def read(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:406
  def replies; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:423
  def retry_after; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:433
  def abandon_if_answered; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:450
