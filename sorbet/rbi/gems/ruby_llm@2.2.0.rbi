# Speaks JSON-RPC to one MCP server over a transport. It speaks the
# 2026-07-28 revision and falls back to the initialize handshake for
# servers that predate it, declaring only its extensions so those
# servers never call back. A server that rejects 2026-07-28 while
# listing it gets the request once more; one that rejects it while
# listing a revision from LEGACY_VERSIONS, or without listing any,
# gets the handshake instead; one that answers the handshake with a
# revision missing from LEGACY_VERSIONS is disconnected.
#
# Servers that predate 2026-07-28 may announce that their tools,
# prompts, or resources changed on the stream of any request. Those
# notifications reach the block given to ::new once the request is
# answered, so the block can make requests of its own. #listen opens a
# subscription for them instead: subscriptions/listen on newer servers,
# resources/subscribe and the session's own stream on older ones, which
# never announce the status of tasks. Their subscription counts as
# acknowledged once a ping confirms the session, starting a new one if
# it ended.
#
# An MCP builds its own client. Applications use one only to read
# #meta, when they send a server requests of their own.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:26
class RubyLLM::MCP::Client
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:53
  def initialize(transport, capabilities: T.unsafe(nil), &on_change); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:101
  def close; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:73
  def list(method, key); end

  # Subscribes to +changes+, a subscriptions/listen filter, and yields
  # each notification of the subscription, starting with the server's
  # acknowledgment. Returns when the server ends the subscription and
  # raises Error when it refuses one or the stream breaks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:90
  def listen(changes, &); end

  # Returns the +_meta+ the client adds to every request it sends a
  # server on the 2026-07-28 revision: the revision, the client's name
  # and version, and its capabilities. Merge it into requests you send
  # the server yourself, so they describe the client the same way:
  #
  #   meta = RubyLLM::MCP::Client.new(transport).meta
  #   # => { "io.modelcontextprotocol/protocolVersion" => "2026-07-28",
  #   #      "io.modelcontextprotocol/clientInfo" => { name: "ruby_llm", version: "2.2.0" },
  #   #      "io.modelcontextprotocol/clientCapabilities" => {} }
  #   params = { name: "roots", arguments: {}, _meta: meta }
  #
  # Servers on an older revision get none of these fields: they learn
  # the same from the initialize handshake.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:123
  def meta; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:97
  def modern?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:65
  def request(method, params = T.unsafe(nil), headers: T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:61
  def server; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:51
  def version; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:219
  def answer(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:158
  def call(method, params = T.unsafe(nil), timeout: T.unsafe(nil), headers: T.unsafe(nil), retried: T.unsafe(nil), &on_notification); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:215
  def cancel(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:211
  def cancels?(notification, request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:247
  def client_info; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:133
  def discover; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:167
  def exchange(request, timeout:, headers:, &on_notification); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:141
  def handshake; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:193
  def listen_to_session(changes, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:242
  def message(method, params = T.unsafe(nil), id: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:226
  def offers_version?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:230
  def predates_revision?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:207
  def reconnect(expired); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:179
  def subscribe(changes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:237
  def supported_versions(error); end

  class << self
    # The answer to a request the server sends: RubyLLM only answers pings.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:43
    def reply(request); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:35
RubyLLM::MCP::Client::ACKNOWLEDGED = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:36
RubyLLM::MCP::Client::CHANGES = T.let(T.unsafe(nil), Array)

