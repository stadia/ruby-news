  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:36
  def offset; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:97
