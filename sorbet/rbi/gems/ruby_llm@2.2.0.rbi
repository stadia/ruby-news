  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:146
  def transcription_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:17
