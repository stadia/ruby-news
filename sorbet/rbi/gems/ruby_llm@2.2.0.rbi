# Azure AI Foundry / OpenAI-compatible API integration.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:6
class RubyLLM::Providers::Azure < ::RubyLLM::Provider
  # Files belong to the Azure resource, whichever key or Entra ID token
  # signs the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:38
  def account_identity; end

  # A base ending in /models or /openai/v1/responses is the resource or
  # its openai/v1 base, since RubyLLM adds those paths itself.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:30
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:124
  def azure_base_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:90
  def azure_cohere_url(operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:111
  def azure_media_url(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:102
  def azure_openai_v1_base; end

  # Azure AI Speech takes a resource key in its own header. An Entra ID
  # token is already sent as a bearer token.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:86
  def azure_speech_headers; end

  # Azure AI Speech answers on the resource's own host, whichever of its
  # endpoints the API base names.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:77
  def azure_speech_transcription_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:73
  def batch_cost_multiplier(**); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:190
  def ensure_configured!; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:63
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:24
  def original_image_detail?; end

  # Deployments named after gpt-5.4+ and gpt-6+ models need the Responses
  # API for tool use, so they route there automatically. Deployment names often
  # differ from model ids, so the routing stays conservative; an explicit
  # protocol: or the azure_protocol configuration option overrides it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:52
  def protocol_for(model, operation: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:42
  def resolve_protocol(name, model, operation: T.unsafe(nil), **options); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:204
  def azure_host_root(base_without_query); end

  class << self
    # Azure works with deployment names, instead of model names
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:185
    def assume_models_exist?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:158
    def capabilities; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:162
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:176
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:180
    def configured?(config); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:166
    def deployed_model_id(deployment, config = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:154
    def models_dev_provider_ids; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure.rb:150
    def open_telemetry_name; end
  end
end

