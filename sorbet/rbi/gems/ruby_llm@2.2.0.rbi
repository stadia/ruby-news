  # Returns the handler for +exception+, searched from this class up
  # through +within+, or through every ancestor without it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:31
  def rescue_handler_for(exception, within: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:25
  def rescue_handlers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:41
  def rescue_handlers?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:56
  def rescue_handler_class(class_name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/rescuable.rb:47
  def rescue_handler_key(exception_class); end
end

