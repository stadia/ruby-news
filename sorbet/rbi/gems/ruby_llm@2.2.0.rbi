RubyLLM::Tool::TOOL_CALL_KEYWORD = T.let(T.unsafe(nil), Symbol)

# A ToolCall is a request to run a tool with specific arguments. Instances
# appear in Message#tool_calls. Local calls are yielded to tool callbacks
# such as Chat#before_tool_call. Remote calls awaiting approval return
# +true+ from #remote?, and their approvals appear among
# Chat#pending_questions.
#
#   chat.before_tool_call do |tool_call|
#     puts "Calling tool: #{tool_call.name}"
#     puts "Arguments: #{tool_call.arguments}"
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:15
class RubyLLM::ToolCall
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:70
  def initialize(name:, id: T.unsafe(nil), provider_call_id: T.unsafe(nil), arguments: T.unsafe(nil), thought_signature: T.unsafe(nil), remote: T.unsafe(nil), namespace: T.unsafe(nil), malformed_arguments: T.unsafe(nil)); end

  # The arguments the model supplied for the invocation, as a Hash. Keys
  # are ordered the way PostgreSQL +jsonb+ and MySQL +json+ store them,
  # shorter keys first, so a call reloaded from the database renders the
  # same request bytes and keeps the provider's prompt cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:47
  def arguments; end

  # The RubyLLM identifier for this invocation. The tool result message
  # answering this call carries the same id, including after a reload.
  # This is independent of the ID in the provider's response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:30
  def id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:104
  def inspect_attributes; end

  # The provider's argument text when it was not a JSON object, or +nil+.
  # A call with such text has empty #arguments and never runs.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:84
  def malformed_arguments; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:86
  def malformed_arguments?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:88
  def malformed_arguments_problem; end

  # The name of the tool the model wants to invoke.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:33
  def name; end

  # The namespace of the tool the model wants to invoke, or +nil+ for a
  # tool without one. See Tool.namespace.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:37
  def namespace; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:95
  def provider_call_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:39
  def qualified_name; end

  # Returns +true+ if the provider executes this call after approval.
  # Local tools executed by the application return +false+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:51
  def remote?; end

  # The Gemini thought signature attached to this call, or +nil+.
  # RubyLLM replays it to the provider on later requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:55
  def thought_signature; end

  # The Gemini thought signature attached to this call, or +nil+.
  # RubyLLM replays it to the provider on later requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:55
  def thought_signature=(_arg0); end

  # Returns the call as a Hash, omitting +nil+ values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:110
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:97
  def with_id(id); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:125
  def canonical_arguments(value); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:18
    def index(calls, by: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool_call.rb:57
    def parse_arguments(text, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end
  end
end

# The tool calls of a Message: an Enumerable of ToolCall objects in the
# order the provider returned them, also readable by call ID. Empty on
# a message without calls.
#
#   response.tool_calls.first
#   response.tool_calls.map(&:name) # => ["search_issues"]
#   response.tool_calls["call_1"]
#
# pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:13
class RubyLLM::ToolCall::Collection
  include ::Enumerable
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:17
  def initialize(calls = T.unsafe(nil)); end

  # Returns +true+ when +other+ is a Collection or Hash of the same calls
  # under the same IDs.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:104
  def ==(other); end

  # Returns the ToolCall with the ID +id+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:43
  def [](id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:47
  def []=(id, call); end

  # Returns the JSON-ready form of #to_h, where Active Support provides
  # one, or #to_h.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:115
  def as_json(*); end

  # Yields each ToolCall, in provider order.
  #
  #   response.tool_calls.each { |call| puts call.name }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:25
  def each(&); end

  # Yields each key, in provider order: the call ID on a complete message,
  # and on a streamed Chunk the stream index when the provider sends one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:35
  def each_key(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:31
  def each_value(&); end

  # Returns +true+ when there are no tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:64
  def empty?; end

  # Returns a Collection without the calls with the given IDs.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:90
  def except(*ids); end

  # Returns the ToolCall with the ID +id+. Without a default or a block,
  # raises KeyError when there is none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:53
  def fetch(id, *, **, &); end

  # Returns +true+ when there is a tool call with the ID +id+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:79
  def key?(id); end

  # Returns the keys as an Array, as #each_key yields them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:74
  def keys; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:61
  def length; end

  # Returns the number of tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:58
  def size; end

  # Returns the tool calls as a new Hash of ToolCall objects keyed by call
  # ID. With a block, returns the Hash of the pairs it makes from each ID
  # and ToolCall.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:97
  def to_h(&block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:100
  def to_hash(&block); end

  # Returns the JSON of #to_h.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:109
  def to_json(*); end

  # Returns a Hash of what the block returns for each ToolCall, keyed by
  # call ID.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:85
  def transform_values(&); end

  # Returns the tool calls as an Array.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:69
  def values; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:127
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool_call/collection.rb:121
  def key_for(id); end
end

# The parent of ToolCallTruncatedError, the error RubyLLM raises for
# tool-call arguments it cannot read. Other arguments that are not a JSON
# object do not raise: the chat answers the call with an error result
# and the model calls the tool again.
