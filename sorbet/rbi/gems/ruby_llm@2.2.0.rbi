  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:17
  def download(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:11
  def rejected_options(operation); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:28
  def default_purpose(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:39
  def extracted_text(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:35
  def parse_file_response(data, mime_type: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/moonshot/files.rb:24
  def render_upload_fields(attachment, purpose: T.unsafe(nil), **); end
end

