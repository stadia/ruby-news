  def resolve(entries, aliases:, owner:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:105
  def same_tool?(existing, entry); end

  class << self
    # Normalizes what an Agent's provider_tools block returns: a Hash of
    # aliases and their options, like the macro's keywords, or a list.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:73
    def entries(value); end

    # Adds normalized entries to those a chat already holds. An alias
    # keeps one entry, in its place, with the latest options. A raw tool
    # and an MCP server, which may be enabled several times, are entered
    # once per identical definition.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:98
    def merge(entries, additions); end

    # Normalizes with_provider_tools arguments into entry hashes:
    # {name:, options:} for aliases and {raw:} for verbatim tool specs.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:66
    def normalize(tools, tools_with_options); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:77
    def normalize_positional(tool); end

    # Entries that already went through normalize (an Agent's declared
    # provider_tools, for example) pass through unchanged.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:90
    def normalized_entry?(hash); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:124
    def raise_unknown_alias(name, aliases, owner); end

    # Resolves normalized entries against a protocol's alias table.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:112
    def resolve(entries, aliases:, owner:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tools/provider_tools.rb:105
    def same_tool?(existing, entry); end
  end
end

