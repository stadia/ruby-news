  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:822
  def method_missing(name, *arguments, **keywords, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:968
  def mirrored_headers(params); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:1118
