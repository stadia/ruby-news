  def render_embedding_payload(text, model:, dimensions:, provider_options: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:77
  def reported_cost(_usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:54
  def valid_embedding_positions?(rows); end

  class << self
