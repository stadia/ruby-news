  def list(prefix = T.unsafe(nil)); end

  # Returns the content of the file at +path+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:30
  def read(path); end

  # Writes +content+ to +path+ and returns its StoredFile.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:39
  def write(path, content, content_type: T.unsafe(nil)); end
end

# The tools Chat#with_file_store gives the model, by the names its
# +tools:+ option takes: +:read+ for +list_files+, +read_file+, and
# +search_files+, +:write+ for +write_file+, +:edit+ for +edit_file+,
# and +:delete+ for +delete_file+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/tools.rb:9
module RubyLLM::FileStore::Tools
  class << self
    # Returns the tool classes for +names+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/tools.rb:33
    def classes(names); end

    # Returns +tools+, a name or an Array of them, as Symbols in the
    # order of GROUPS. Raises ArgumentError for a name it does not know,
    # and without +:read+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/tools.rb:17
    def names(tools); end
  end
end

