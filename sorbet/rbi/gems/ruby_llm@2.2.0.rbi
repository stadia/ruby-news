  def generate(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:687
  def headers(*args, **kwargs, &block); end

  # Persists every queued message as a user message record, without
  # calling the model, and returns the records, oldest first. Each joins
