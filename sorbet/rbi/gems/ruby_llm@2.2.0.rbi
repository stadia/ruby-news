# A Chunk is one streamed fragment of an assistant response. Chunks are
# yielded to the block passed to Chat#ask or Chat#complete when streaming.
# A Chunk is a Message, so it responds to the same readers, but it holds
# only the data received in that part of the stream, such as a piece of
# content, partial tool calls, or the finish reason.
#
#   chat.ask "Write a haiku about Ruby" do |chunk|
#     print chunk.content
#   end
#
# Streamed chunks always have the +:assistant+ role, and most carry the
# model ID. #finish_reason, with predicates such as #max_tokens?,
# #content_filtered?, #tool_call_stop?, and #stopped?, arrives near the end
# of the stream, not necessarily on the last chunk. #tokens is often empty
# until then: +output+ counts the billable output tokens up to that chunk,
# including thinking tokens the provider bills as output, and providers
# differ in when they report it. Read the final reason and usage from the
# Message that Chat#ask returns.
#
# Pass +index:+ to build one with its position, such as in a test:
#
#   RubyLLM::Chunk.new(role: :assistant, content: "Hel", index: 0)
#
# pkg:gem/ruby_llm#lib/ruby_llm/chunk.rb:27
class RubyLLM::Chunk < ::RubyLLM::Message
  # pkg:gem/ruby_llm#lib/ruby_llm/chunk.rb:28
  def initialize(options = T.unsafe(nil)); end

  # Returns the position of this chunk within the response it belongs
  # to, starting at 0. Each response in a Chat#complete loop, such as
  # the one after a tool call, starts again at 0. Counts every chunk,
  # including those without content.
  #
  #   chat.ask("Count to three") { |chunk| puts "#{chunk.index}: #{chunk.content}" }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chunk.rb:40
  def index; end

  # Returns the position of this chunk within the response it belongs
  # to, starting at 0. Each response in a Chat#complete loop, such as
  # the one after a tool call, starts again at 0. Counts every chunk,
  # including those without content.
  #
  #   chat.ask("Count to three") { |chunk| puts "#{chunk.index}: #{chunk.content}" }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chunk.rb:40
  def index=(_arg0); end
end

# A Citation links a span of generated text to the source material that
# supports it. Providers return citations in different shapes. RubyLLM
# normalizes all of them into Citation objects on Message#citations.
# Fields a provider does not report are +nil+.
#
#   chat = RubyLLM.chat(model: 'claude-sonnet-5').with_citations
#   response = chat.ask "Who created Ruby?", with: "facts.txt"
#
#   response.citations.each do |citation|
#     citation.title      # => "facts.txt"
#     citation.cited_text # => the quoted passage from facts.txt
#     citation.text       # => the span of the answer it supports
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:18
class RubyLLM::Citation
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:58
  def initialize(options = T.unsafe(nil)); end

  # Returns +true+ if +other+ is a Citation with the same attributes,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:97
  def ==(other); end

  # The quoted snippet from the source material, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:28
  def cited_text; end

  # The character offset where the cited span ends in the response
  # content, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:42
  def end_index; end

  # The last page of a PDF citation (1-indexed, inclusive), or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:56
  def end_page; end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:100
  def eql?(other); end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:102
  def hash; end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:75
  def inspect_attributes; end

  # The provider's identifier for the cited source, or +nil+. For a cited
  # SearchResults result, this is its +:source_id+ when it has one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:46
  def source_id; end

  # The 0-indexed position of the source document or search result,
  # or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:50
  def source_index; end

  # The character offset where the cited span starts in the response
  # content, or +nil+.
  #
  #   response.content[citation.start_index...citation.end_index] == citation.text # => true
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:38
  def start_index; end

  # The first page of a PDF citation (1-indexed, inclusive), or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:53
  def start_page; end

  # The span of the response content this citation supports, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:31
  def text; end

  # The title or filename of the cited source, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:25
  def title; end

  # Returns the citation as a Hash with symbol keys, omitting +nil+ fields.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:80
  def to_h; end

  # The URL of the cited source, when citing the web, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:22
  def url; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:71
    def from_h(data); end
  end
end

# CodeExecution is the +run_code+ tool Chat#with_code_execution gives the
# model. Each call runs Ruby, Python, JavaScript, or a shell script in a Sandbox, in a
# fresh run directory with read-only copies of the conversation's files,
# and returns the exit code, the output, and every file the code wrote
# there as an attachment on the tool result. In a chat with a file store
# (see Chat#with_file_store), runs work with the chat's files instead.
# With FileStore::Directory, code runs in the store's folder and changes
# the files in place. With any other store, each run has read-only
# copies of the conversation's files as usual, copies in the files the
# model names in +files+, and what the code writes is saved back to the
# store.
#
# Calls run in the chat's default sandbox. With +escalate_to:+, the model
# may name a wider sandbox for one call and say why; that call waits for
# Chat#approve, and the next call is back in the default.
#
#   chat = RubyLLM.chat.with_code_execution(escalate_to: [WorkspaceSandbox])
#   chat.tools[:run_code].escalations # => ["workspace"]
#
# pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:25
class RubyLLM::CodeExecution < ::RubyLLM::Tool
  # Creates the tool with the options Chat#with_code_execution takes.
  # +sandbox+ is the default sandbox, or a Proc returning it, and
  # +escalate_to+ the sandboxes the model may ask for, an Array or a Hash
  # of names to sandboxes. +attachments+ returns the conversation's files
  # when called, and +skills+ a Hash of paths under +skills/+ to the
  # skill folders mounted there. +file_store+ returns the chat's
  # FileStore, or +nil+: with one, runs work with its files instead of
  # the attachments, in its folder when it has one, and each file a run
  # writes or changes is passed to +written+. +attached_files+ returns
  # the StoredFiles of the conversation's files, kept in that store, which
  # a run without a folder has read-only. +mounts+ is a Hash of paths inside the
  # run directory to directories mounted there read-only, or a Proc called
  # before each run that returns one. +approval+ is called with the
  # ToolCall of each escalated run right before it runs, and the run goes
  # ahead only when it returns +true+. +chat+ and +config+ describe where
  # the instrumentation events go. Without +sandbox+, runs use
  # Configuration#sandbox from +config+. A Proc may return a new sandbox
  # instance each call: it stands for one sandbox, checked once.
  # Raises ConfigurationError without a sandbox.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:250
  def initialize(sandbox:, escalate_to: T.unsafe(nil), attachments: T.unsafe(nil), file_store: T.unsafe(nil), attached_files: T.unsafe(nil), written: T.unsafe(nil), skills: T.unsafe(nil), mounts: T.unsafe(nil), approval: T.unsafe(nil), chat: T.unsafe(nil), config: T.unsafe(nil), package_cache_dir: T.unsafe(nil), languages: T.unsafe(nil), **packages); end

  # Returns the description the model sees, naming only the languages
  # the sandbox can run and the sandboxes it may ask for.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:339
  def description; end

  # Returns the names of the sandboxes the model may ask for, leaving out
  # those that cannot run on this machine.
  #
  #   chat.tools[:run_code].escalations # => ["workspace", "online"]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:282
  def escalations; end

  # Runs +code+ written in +language+ and returns its report, followed by
  # the files it wrote as Attachments. +files+ names the chat's files to
  # copy into the run directory, for a store without a folder. With
  # +sandbox+, runs in that sandbox only when the chat recorded an
  # approval for +tool_call+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:371
  def execute(language:, code:, sandbox: T.unsafe(nil), reason: T.unsafe(nil), files: T.unsafe(nil), tool_call: T.unsafe(nil)); end

  # Returns the languages the model may use: those requested that the
  # sandbox can run. Raises ConfigurationError when it can run none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:320
  def languages; end

  # Returns the directories mounted read-only in each run directory, keyed
  # by their path there. Raises ArgumentError for a path outside the run
  # directory or a directory that does not exist.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:300
  def mounts; end

  # Returns the JSON Schema of the arguments: +language+ and +code+,
  # +files+ when runs copy in the chat's files, and +sandbox+ and
  # +reason+ when the model may ask for another sandbox.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/code_execution.rb:354
  def parameters_schema; end

  # Returns whether +tool_call+ asks for a sandbox wider than the default:
  # such a call waits for Chat#approve, every time.
  #
