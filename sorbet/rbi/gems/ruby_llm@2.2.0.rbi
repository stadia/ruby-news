RubyLLM::Protocols::Cohere::Transcription::DEFAULT_LANGUAGE = T.let(T.unsafe(nil), String)

# The AWS Bedrock Converse API. Requests are SigV4-signed by the provider.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:6
class RubyLLM::Protocols::Converse < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Converse::Chat
  include ::RubyLLM::Protocols::Converse::Media
  include ::RubyLLM::Protocols::Converse::RequestShapes
  include ::RubyLLM::Protocols::Bedrock::EventStream
  include ::RubyLLM::Protocols::Converse::Streaming

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:28
  def render(*, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:24
  def server_tool_aliases; end

  private

  # Provider options replace an array, and Bedrock refuses the binding
  # without its beta.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:36
  def keep_binding_beta(payload); end

  # Converse carries tools under toolConfig.tools rather than a
  # top-level tools array.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:46
  def merge_server_tool_entries(payload, entries); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:57
  def post_count_tokens(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:61
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:52
  def sync_response(payload, additional_headers = T.unsafe(nil)); end
end

