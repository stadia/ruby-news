  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_questions.rb:131
  def unmarked_approval(question); end
end

# Keeps a persisted chat's queued messages in +ruby_llm_queued_messages+,
# so any process can queue one and the process running the chat takes
# it. Taking or withdrawing deletes the row, and only the process whose
# delete removes it goes on, so each message joins once or not at all.
# Joining runs Chat#around_join inside the transaction that deletes the
# row, so a callback that raises puts the row back. The message record
# gets the row's sender when its model has a +sender+ association.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_queue.rb:14
class RubyLLM::ActiveRecord::ChatQueue
  include ::RubyLLM::ActiveRecord::AttachmentHelpers

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_queue.rb:17
