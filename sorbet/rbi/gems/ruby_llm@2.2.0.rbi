  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:61
  def to_blob; end

  # The URI that identifies the resource on its server.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:20
  def uri; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:82
  def inspect_attributes; end
end

# A family of resources on an MCP server, named by a URI template.
#
#   template = files.resource_templates.first
#   template.uri                        # => "file:///{path}"
#   template.suggest(path: "app/mo")    # => ["app/models/"]
#   files.resource(template.uri, path: "Gemfile")
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:12
class RubyLLM::MCP::ResourceTemplate
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource_template.rb:74
