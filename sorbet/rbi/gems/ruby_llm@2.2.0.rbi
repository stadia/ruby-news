  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:86
  def spill(tool, tool_call, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:30
  def store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:100
  def store_attachment(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:30
  def tools; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:78
  def view(list); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:195
  def as_text(file, config); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/file_references.rb:143
