    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:53
    def openai_prompt_caching?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:22
    def parse_chunk_citations(delta, data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:65
    def prompt_cache_options(caching); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:57
    def prompt_cache_params(caching); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:27
    def reference_citations(content, offsets: T.unsafe(nil)); end

    # Mistral carries reasoning in content blocks, not in the top-level
    # reasoning fields the rest of the Chat Completions family uses.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:106
    def render_message_content(msg, **); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:42
