# An UploadedFile is the metadata record for a file stored with a provider
# through its Files API. Upload a file once with ::upload, then reuse its
# provider id or URI, for example as a chat attachment or in a batch.
#
#   file = RubyLLM.upload("batch.jsonl", purpose: "batch")
#   file.id         # => "file_..."
#   file.filename   # => "batch.jsonl"
#   file.byte_size  # => 1234
#
# File ids are provider-owned. Persist #provider alongside #id and pass it
# back when finding or downloading the file later.
#
# pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:15
class RubyLLM::UploadedFile
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:63
  def initialize(id:, **attributes); end

  # The file size in bytes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:32
  def byte_size; end

  # The Time the provider stored the file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:35
  def created_at; end

  # Whether the provider allows downloading the file's content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:58
  def downloadable; end

  # Returns +true+ once the provider's retention window for this file has
  # passed or is about to; a file expiring within the next minute cannot
  # safely serve a request. Files without a reported expiry never expire.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:83
  def expired?; end

  # The Time the provider will delete the file, or +nil+ if it does not
  # expire.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:39
  def expires_at; end

  # The filename reported by the provider.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:29
  def filename; end

  # The provider-assigned file identifier, such as <tt>"file_..."</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:23
  def id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:18
  def inspect_attributes; end

  # The raw provider response data for the file, as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:61
  def metadata; end

  # The MIME type of the stored file. OpenAI, Azure, DeepSeek, Meta, and
  # xAI do not report one: ::upload returns the content type it sent, and
  # ::find returns +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:47
  def mime_type; end

  # The slug of the provider that stores the file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:26
  def provider; end

  # The purpose the file was uploaded for, such as <tt>"batch"</tt>, when
  # the provider tracks one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:51
  def purpose; end

  # The provider-reported processing status of the file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:42
  def status; end

  # The provider URI for the file, such as a Gemini Files API URI or a
  # <tt>gs://</tt> or <tt>s3://</tt> location for storage-backed providers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:55
  def uri; end

  class << self
    # Downloads the provider file +id+ and returns a DownloadedFile.
    # Also available as RubyLLM.download.
    #
    #   RubyLLM.download(file.id, provider: :openai).save("report.pdf")
    #
    # Not every provider allows downloads; see #downloadable. Cohere
    # downloads original uploaded bytes when preserved; generated datasets
    # return JSONL and require the optional +avro+ gem.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:138
    def download(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # Fetches metadata for an existing provider file by +id+ and returns an
    # UploadedFile. When +provider:+ is omitted, the provider of the
    # configured default model is used.
    #
    #   file = RubyLLM::UploadedFile.find("file_123")
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:126
    def find(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # Uploads +file+ to the provider's Files API and returns an UploadedFile.
    # +file+ may be a path, an IO object, or an Attachment. When +provider:+
    # is omitted, the provider of the configured default model is used.
    # Also available as RubyLLM.upload.
    #
    #   RubyLLM::UploadedFile.upload("document.pdf", provider: :anthropic)
    #   RubyLLM::UploadedFile.upload(io, provider: :openai, purpose: "batch",
    #                                filename: "batch.jsonl")
    #
    # OpenAI, Meta, and Azure require +purpose:+. Cohere uses +purpose:+ for its
    # dataset type, such as <tt>"embed-input"</tt>.
    # Pass +expires_in:+ as a number of
    # seconds to have the provider delete the file automatically; OpenAI,
    # Meta, Anthropic, xAI, and Mistral support it, and Mistral rounds up to
    # whole hours.
    # Storage-backed providers (Vertex AI and Bedrock) store the file at
    # +uri:+ when given, otherwise at a generated object name under the
    # configured bucket. Providers that cannot carry +purpose:+,
    # +expires_in:+, or +uri:+ raise ArgumentError. +content_type:+
    # overrides the MIME type RubyLLM detects. +provider_options:+
    # carries the rest in the provider's own vocabulary: multipart form
    # fields on most providers, such as +visibility:+ on Mistral, File
    # resource fields on Gemini, such as +display_name:+, PutObject keywords
    # on Bedrock, and +create_file+ keywords on Vertex AI. RubyLLM sends them
    # as given, so the provider rejects what it does not recognize. They
    # cannot replace the file itself.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:113
    def upload(file, provider: T.unsafe(nil), context: T.unsafe(nil), filename: T.unsafe(nil), purpose: T.unsafe(nil), expires_in: T.unsafe(nil), uri: T.unsafe(nil), content_type: T.unsafe(nil), provider_options: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:142
    def provider_for(provider, context); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/uploaded_file.rb:78
RubyLLM::UploadedFile::EXPIRY_MARGIN = T.let(T.unsafe(nil), Integer)

# The version of the ruby_llm gem, as a string.
#
# pkg:gem/ruby_llm#lib/ruby_llm/version.rb:5
RubyLLM::VERSION = T.let(T.unsafe(nil), String)

# A Video is a generated clip. Save it with #save or read the raw bytes
# with #to_blob. Both handle hosted URLs and inline data.
#
#   video = RubyLLM.animate("a paper boat sailing down a rainy gutter")
#   video.save("boat.mp4")
#
# pkg:gem/ruby_llm#lib/ruby_llm/video.rb:10
class RubyLLM::Video
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Files::Saving
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:101
  def initialize(url: T.unsafe(nil), data: T.unsafe(nil), mime_type: T.unsafe(nil), model: T.unsafe(nil), duration: T.unsafe(nil), raw: T.unsafe(nil)); end

  # Set by the protocol that generated the video, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:97
  def config; end

  # Set by the protocol that generated the video, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:95
  def config=(_arg0); end

  # Returns the Cost of the job that rendered the video: the amount the
  # provider reported, or its reported tokens at registry prices. Its total
  # is +nil+ when the provider reports neither a price nor priced tokens.
  #
  #   video = RubyLLM.animate("a paper boat")
  #   video.cost.total # => 0.05
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:125
  def cost; end

  # The raw video bytes, returned inline or downloaded with the
  # provider's credentials, or +nil+ when the video is hosted at #url.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:20
  def data; end

  # The clip length in seconds, when the provider reports one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:29
  def duration; end

  # The MIME type of the video, such as <tt>"video/mp4"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:23
  def mime_type; end

  # The id of the model that generated the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:26
  def model; end

  # The provider's raw job response, for provider-specific fields such
  # as reported cost.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:33
  def raw; end

  # Returns the raw binary video bytes, downloading from #url when the
  # provider returned a hosted video.
  #
  #   video_bytes = video.to_blob
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:146
  def to_blob; end

  # Returns the usage the provider reported for the job that rendered
  # the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:112
  def tokens; end

  # The URL of the hosted video, for providers that return one, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:16
  def url; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:152
  def inspect_attributes; end

  class << self
    # Generates a video from +prompt+, blocks until the provider finishes
    # rendering it, and returns a Video. Most code calls this through
    # RubyLLM.animate. Video generation is asynchronous on every provider,
    # so this submits a job with VideoJob.animate_later and polls until it
    # is done, honoring <tt>config.video_generation_timeout</tt> and
    # <tt>config.video_generation_poll_interval</tt>.
    #
    # +model:+ selects the video model and defaults to the configured
    # +default_video_model+. +provider:+ forces a specific provider, and
    # +assume_model_exists:+ skips the registry lookup. +with:+ passes a
    # reference image or a video to edit on models that support it. Models
    # driven by image and audio input can omit the prompt and pass both
    # attachments through +with:+.
    # +extend:+ continues a source video instead. It accepts a Video,
    # file path, URL, or Attachment and cannot be combined with +with:+.
    # +provider_options:+ takes options in the provider's request
    # vocabulary, such as durations and resolutions, and merges them into
    # the request as-is. +context:+ supplies a Context whose configuration
    # replaces the global one. +metadata:+ is included in the
    # instrumentation payload. +owner:+ attributes the usage to a record,
    # such as a user, and wins over RubyLLM.with_owner.
    #
    #   video = RubyLLM.animate("a hummingbird in slow motion", model: "gemini-omni-1.2-flash")
    #
    #   RubyLLM.animate(
    #     "Make the waterfall crash down",
    #     model: "grok-imagine-video-1.5",
    #     with: "waterfall.png",
    #     provider_options: { duration: 5 }
    #   )
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:66
    def animate(prompt = T.unsafe(nil), model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil), extend: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end
  end
end

# A VideoJob is an in-flight video generation. RubyLLM.animate_later
# returns one immediately; poll it with #refresh and read the finished
# clip with #video. RubyLLM.animate runs the same job through #wait.
#
#   job = RubyLLM.animate_later("a paper boat sailing down a gutter")
#   job.wait
#   job.video.save("boat.mp4")
#
# pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:12
class RubyLLM::VideoJob
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Support::DeprecatedJobPredicates

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:84
  def initialize(id:, protocol:, model: T.unsafe(nil), status: T.unsafe(nil), raw: T.unsafe(nil), error: T.unsafe(nil), reported_cost: T.unsafe(nil), tokens: T.unsafe(nil), duration: T.unsafe(nil), resolution: T.unsafe(nil)); end

  # Returns +true+ once the job finished, successfully or not.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:107
  def complete?; end

  # Returns the Cost of the job: the amount the provider reported, or its
  # reported tokens at registry prices. Its total is +nil+ while the job is
  # pending, or when the provider reports neither a price nor priced tokens.
  #
  #   job.wait
  #   job.cost.total # => 0.05
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:144
  def cost; end

  # The clip length in seconds the request asked for, or +nil+ when it
  # left the length to the provider's default or the job came from ::find.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:33
  def duration; end

  # The provider's failure message when #failed?, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:26
  def error; end

  # Returns +true+ when the job finished without a video. #error carries
  # the provider's failure message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:118
  def failed?; end

  # The provider's id for the job.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:17
  def id; end

  # The id of the model rendering the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:23
  def model; end

  # Returns +true+ while the provider is still rendering the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:102
  def pending?; end

  # The provider's raw response from the last submit or poll.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:29
  def raw; end

  # Re-fetches the job from the provider, updating #status, #error, and
  # #raw. Does nothing once the job is #complete?. Returns self.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:124
  def refresh; end

  # The resolution the request asked for, as the provider spells it,
  # such as <tt>"720p"</tt> or <tt>"1280x720"</tt>, or +nil+ when it left
  # the resolution to the provider's default or the job came from ::find.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:38
  def resolution; end

  # The job state: +:pending+, +:completed+, or +:failed+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:20
  def status; end

  # Returns +true+ when the job finished with a video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:112
  def succeeded?; end

  # Returns the finished Video, downloading it from the provider when
  # its API requires that. Returns +nil+ while #pending? and raises
  # Error when #failed?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:172
  def video; end

  # Polls the job until it finishes, then returns self. Raises Error
  # when the job fails or +timeout+ elapses first. +timeout+ and
  # +interval+ are seconds and default to the configured
  # +video_generation_timeout+ and +video_generation_poll_interval+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:152
  def wait(timeout: T.unsafe(nil), interval: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:202
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:198
  def monotonic_time; end

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:184
  def record_usage; end

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:194
  def usage_tokens; end

  class << self
    # Submits a video generation job and returns a VideoJob without
    # waiting for the result. Most code calls this through
    # RubyLLM.animate_later. Takes the same arguments as Video.animate.
    # The job records its usage, attributed to +owner:+ or the owner of
    # RubyLLM.with_owner, once it finishes.
    #
    #   job = RubyLLM.animate_later("a hummingbird in slow motion")
    #   job.id        # => "0eb6910f-a353-4699-9d1e-6a4f7a5b39e2"
    #   job.complete? # => false
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:50
    def animate_later(prompt = T.unsafe(nil), model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil), extend: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end

    # Returns a VideoJob reflecting the provider's current state for +id+.
    # Use it to pick a job back up from any process. Pass the #model that
    # rendered it: it selects the provider and protocol, and names the
    # usage entry. A job already finished reports its usage here, once per
    # VideoJob object, attributed to the owner of RubyLLM.with_owner.
    #
    #   job = RubyLLM::VideoJob.find(clip.video_job_id, model: clip.video_model, provider: :xai)
    #   job.video&.save("clip.mp4")
    #
    # Pass +context:+ to use a Context in place of the global configuration.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:78
    def find(id, model:, provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil)); end
  end
end

# A WebSource is a page a hosted web search returned. They appear on
# Message#web_sources, normalized across providers. A Citation is different:
# it links a span of the answer to what supports it, so a search usually
# has more sources than citations.
#
#   response = chat.with_provider_tools(:web_search).ask "What changed in Ruby 4.0?"
#   response.web_sources.map(&:url) # => ["https://www.ruby-lang.org/en/news/", ...]
#
# An address here comes from the outside world. See Message#web_sources
# before treating one as safe to open.
#
# pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:15
class RubyLLM::WebSource
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:24
  def initialize(url:, title: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:34
  def inspect_attributes; end

  # The title the provider reports for the page, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:22
  def title; end

  # Returns the source as a Hash with symbol keys, omitting a +nil+ title.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:30
  def to_h; end

  # The address the provider reports for the page.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/web_source.rb:19
  def url; end
end

# Adds workflow and step context to RubyLLM instrumentation and usage
# records while leaving orchestration in ordinary Ruby code.
#
# Create workflows through RubyLLM.workflow rather than constructing this
# class directly:
#
#   RubyLLM.workflow("Write article", id: "article-42") do |workflow|
#     notes = workflow.step("Research") { ResearchAgent.new.ask(topic).content }
#     workflow.step("Draft") { WriterAgent.new.ask(notes).content }
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:15
class RubyLLM::Workflow
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:22
  def initialize(name, id: T.unsafe(nil), metadata: T.unsafe(nil), config: T.unsafe(nil)); end

  # Returns the workflow identifier shared by its instrumentation events.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:17
  def id; end

  # Returns the workflow name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:20
  def name; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:29
  def run; end

  # Runs a named section of Ruby code and adds its identity to every RubyLLM
  # event emitted by the block. An ID is generated when one is not supplied.
  # Steps can contain regular Ruby control flow and may be nested.
  # Returns the block's result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:42
  def step(name, id: T.unsafe(nil), &block); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:79
  def current_step_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:67
  def link_parent; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:84
  def normalize(value, attribute); end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:59
  def workflow_context; end
end
