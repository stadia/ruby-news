# The Deepgram API: speech to text on v1/listen, text to speech on
# v1/speak, and the model catalog behind them. Deepgram has no embedding
# or image endpoints, so those seams are left unimplemented. Chat is a
# Chat Completions dialect, declared by the provider.
#
# Deepgram carries its request options in the query string rather than
# the body, so +provider_options:+ joins the query on both audio
# operations.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram.rb:13
class RubyLLM::Protocols::Deepgram < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Deepgram::Models
  include ::RubyLLM::Protocols::Deepgram::Speech
  include ::RubyLLM::Protocols::Deepgram::Transcription
  include ::RubyLLM::Protocols::Deepgram::StreamingTranscription
end

# Model catalog for Deepgram. GET v1/models splits the catalog into
# stt and tts groups, and names each entry twice: +name+ is the short
# name, such as the voice 'zeus', while +canonical_name+ is the id the
# listen and speak endpoints accept.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:10
module RubyLLM::Protocols::Deepgram::Models
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:61
  def build_metadata(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:40
  def build_model(data, slug, group); end

  # Deepgram lists a model once per language it was trained on, so
  # nova-3-general arrives 146 times with a different language and
  # version each time. One model answers to that id, so the rows
  # collapse into it, carrying every language between them. Fields
  # the rows disagree on describe a single language rather than the
  # model, and are left out.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:32
  def merge_language_rows(rows); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:13
  def models_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:17
  def parse_list_models_response(response, slug); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:61
    def build_metadata(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:40
    def build_model(data, slug, group); end

    # Deepgram lists a model once per language it was trained on, so
    # nova-3-general arrives 146 times with a different language and
    # version each time. One model answers to that id, so the rows
    # collapse into it, carrying every language between them. Fields
    # the rows disagree on describe a single language rather than the
    # model, and are left out.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:32
    def merge_language_rows(rows); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:13
    def models_url; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:17
    def parse_list_models_response(response, slug); end
  end
end

# Speech dialect for the Deepgram text-to-speech API. Deepgram names
# the voice inside the model id, so aura-2-thalia-en is the Thalia
# voice of Aura 2: asking for a +voice:+ swaps that segment of the
# model id. The container is an encoding query value, the body carries
# only the text, and the response is raw audio bytes.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:13
module RubyLLM::Protocols::Deepgram::Speech
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:86
  def format_for(format); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:58
  def parse_speech_response(response, model:, voice:, format:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:54
  def render_speech_payload(input, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:30
  def speak(input, model:, voice:, format:, provider_options: T.unsafe(nil), &block); end

  # Puts +voice+ into the voice segment of +model+, so Aura 2 with
  # voice 'zeus' is aura-2-zeus-en. A voice that already names a whole
  # model is used as it stands.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:70
  def speech_model_for(model, voice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:49
  def speech_params(model:, format: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:45
  def speech_url(model:, format: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # The voice segment of a Deepgram model id, so aura-2-thalia-en
  # speaks as 'thalia'.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:81
  def voice_for(model); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:14
RubyLLM::Protocols::Deepgram::Speech::DEFAULT_FORMAT = T.let(T.unsafe(nil), String)

# RubyLLM format names in Deepgram's encoding vocabulary. Deepgram
# wraps linear16 in a WAV header unless the container is turned off,
# and the compressed encodings carry their own.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:19
RubyLLM::Protocols::Deepgram::Speech::OUTPUT_FORMATS = T.let(T.unsafe(nil), Hash)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:6
module RubyLLM::Protocols::Deepgram::StreamingTranscription
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:78
  def build_live_transcription(segments, metadata, model:, language:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:56
  def process_transcription_result(event, segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:47
  def send_transcription_audio(socket, audio); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:7
  def stream_live_transcription(audio_file, model:, language:, speaker_names:, provider_options:, prompt:, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/streaming_transcription.rb:38
  def streaming_transcription_url(model:, language:, speaker_names:, provider_options:, prompt:); end
end

# Transcription dialect for the Deepgram speech-to-text API. Every
# option is a query parameter on v1/listen, and the body is either the
# audio bytes or a JSON pointer to a remote url. Requesting speaker
# labels turns on diarization, which labels each word and utterance
# with a numeric speaker index.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:13
module RubyLLM::Protocols::Deepgram::Transcription
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:70
  def parse_transcription_response(response, model:, language: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:20
  def rejected_options(operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:14
  def render_transcription_options(timestamps:, **); end

  # Deepgram fetches remote audio itself, so a url attachment is sent
  # as a JSON pointer and everything else is uploaded as raw bytes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:64
  def render_transcription_payload(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:36
  def transcribe(audio_file, model:, language:, format: T.unsafe(nil), speaker_names: T.unsafe(nil), speaker_references: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil), temperature: T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:57
  def transcription_params(model:, language: T.unsafe(nil), speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:52
  def transcription_url(model:, language: T.unsafe(nil), speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:97
  def post_transcription(url, payload, attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:90
  def transcription_hint_params(speaker_names:, prompt:); end
end

# Turned on by default so the transcript reads like the transcripts
# every other provider returns. Smart formatting punctuates and
# formats numbers, dates, and currency; utterances split the
# transcript into timed segments.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:28
RubyLLM::Protocols::Deepgram::Transcription::DEFAULT_PARAMS = T.let(T.unsafe(nil), Hash)

# The batch diarizer to run. 'latest' tracks Deepgram's current
# generally available diarizer, which the boolean diarize parameter
# it deprecates does not.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:33
RubyLLM::Protocols::Deepgram::Transcription::DIARIZE_MODEL = T.let(T.unsafe(nil), String)

