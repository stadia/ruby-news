  def ask_later(*args, **kwargs, &block); end

  # When +true+, skips the model registry lookup so unregistered model ids
  # are accepted. Not persisted; set it again after reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:83
  def assume_model_exists; end

  # When +true+, skips the model registry lookup so unregistered model ids
  # are accepted. Not persisted; set it again after reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:83
  def assume_model_exists=(_arg0); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:655
  def before_fallback(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:655
  def before_message(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:655
