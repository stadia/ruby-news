  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:490
  def collect_tool_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:482
  def current_message; end

  # Gemini checks signatures only in the current turn, which starts at
  # the last user message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:538
  def current_turn?; end

  # functionResponse parts carry no call id, so Gemini pairs them with
  # the functionCall parts by position. Results that arrived out of
  # call order have to be put back in it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:509
  def in_call_order(tool_messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:520
  def remember_tool_calls; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:542
  def render_tool_result(message, tool_name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:486
  def tool_message?(message); end
end

