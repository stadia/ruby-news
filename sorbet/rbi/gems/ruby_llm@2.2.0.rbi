RubyLLM::FileStore::DIGEST_CHUNK = T.let(T.unsafe(nil), Integer)

# Keeps files in a folder on disk, created when missing. Files someone
# puts in the folder are the chat's files too. Hidden files and
# folders, whose names start with a dot, are left out, and symbolic
# links are never followed. Code execution runs in the folder itself
# and can change anything in it, so give each store a folder of its
# own.
#
#   chat.with_file_store("tmp/chats/42")
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:17
class RubyLLM::FileStore::Directory < ::RubyLLM::FileStore
  # Creates a store for the folder +root+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:27
  def initialize(root); end

  # Returns the StoredFile at +path+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:49
  def [](path); end

  # Deletes the file at +path+ and returns its StoredFile, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:74
  def delete(path); end

  # Deletes the folder +path+ with everything in it, hidden files
  # included, and returns the deleted StoredFile objects. Links are
  # removed, never followed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:88
  def delete_folder(path); end

  # Returns the files inside the folder +prefix+, or every file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:39
  def list(prefix = T.unsafe(nil)); end

  # Returns #root: code execution runs in this folder.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:34
  def local_root; end

  # Returns the content of the file at +path+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:58
  def read(path); end

  # The folder holding the files, as an absolute path.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:24
  def root; end

  # Runs the block with the store locked, against other threads and,
  # through a lock on #root, other processes, and returns its value.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:101
  def with_lock; end

  # Writes +content+ to +path+ and returns its StoredFile. Raises
  # ArgumentError when +path+ is a folder.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:67
  def write(path, content, content_type: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:174
  def file_content_type(full, path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:168
  def folder?(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:132
  def full_path(path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:159
  def make_room(full); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:183
  def stored_file(full, stat); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:147
  def walk(start); end

  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:117
  def write_file(path, content); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/file_store/directory.rb:18
RubyLLM::FileStore::Directory::OPEN_FLAGS = T.let(T.unsafe(nil), Integer)

