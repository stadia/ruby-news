  # Returns the criterion name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:10
  def name; end

  # Returns true when this criterion passed its acceptance policy.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:38
  def passed?; end

  # Returns the evaluator's explanation, when available.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:14
  def reason; end

  # Returns :passed, :failed, :measured, :unassessed, or :error.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:55
  def status; end

  # Returns the measurement, policy, and outcome as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:64
  def to_h; end

  # Returns a boolean, Probability, Score, or Choice without discarding its distribution.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/result.rb:12
  def value; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/evaluation/reviewer.rb:5
class RubyLLM::Evaluation::Reviewer < ::RubyLLM::Agent; end

# pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:5
class RubyLLM::Evaluation::Runner
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:8
  def initialize(instance, test_case, repetition, groups, run_id:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:40
  def instrument(name, payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:19
  def run; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:69
  def evaluate; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:59
  def perform; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:51
  def run_steps; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:78
  def teardown; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation/runner.rb:84
  def with_usage(phase); end
