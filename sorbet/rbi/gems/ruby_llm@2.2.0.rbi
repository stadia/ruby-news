# pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:8
class RubyLLM::Transport::ErrorMiddleware < ::Faraday::Middleware
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:14
  def initialize(app, options = T.unsafe(nil)); end

  # Sits directly above the adapter, inside the retry middleware, so this
  # runs once per attempt: streaming state stored on the env by a previous
  # attempt must not leak into the next one, and a body the previous
  # attempt read to its end is sent again from its start.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:23
  def call(env); end

  private

  # A rate limit reported inside a stream raises with no failed HTTP
  # status, and without an env on Faraday 1, so its hint is only on the
  # error's own response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:53
  def apply_raised_retry_delay(env, provider, error); end

  # The retry middleware only reads the standard Retry-After header, so
  # other retry hints are normalized into seconds here. A failed stream
  # usually raises while it is read, before on_complete, and keeps its
  # body in the stored streaming error rather than on the response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:73
  def apply_retry_delay(response, provider, status: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:35
  def attempt(env, context, provider); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:91
  def millisecond_retry_delay(headers); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:87
  def provider_retry_delay(provider, response, status); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:61
  def rate_limit_report?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:83
  def response_status(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:96
  def streaming_error_response(response); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:151
    def parse_error(provider:, response:); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:224
    def authentication_failed?(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:191
    def bad_request_class(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:208
    def context_length_exceeded?(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:176
    def error_class(message, status); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:162
    def failure_status(provider, response); end

    # Providers hand back whatever their error body holds, which is not
    # always a String: bedrock-mantle nests code, message, and type in a
    # Hash. Match on the rendered text so any shape classifies.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:231
    def matches?(message, patterns); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:212
    def overloaded?(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:216
    def payment_required?(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:168
    def provider_details(provider, response); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:201
    def rate_limit_class(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:220
    def rate_limited?(message); end
  end
end

