  # pkg:gem/ruby_llm#lib/ruby_llm/tokenization.rb:14
  def model; end

  # The provider's unmodified response, including token strings when available.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokenization.rb:17
  def raw; end

  class << self
    # Tokenizes +text+ and returns a Tokenization. Most code calls
    # RubyLLM.tokenize. +model:+ defaults to the configured chat model;
    # +provider:+ selects its provider. +assume_model_exists:+ skips
    # registry lookup, and +context:+ supplies an isolated configuration.
    #
    #   result = RubyLLM.tokenize("Hello Ruby", model: "grok-4.3", provider: :xai)
    #   result.ids
    #   result.count
    #
    # Raises ArgumentError for non-string input and RubyLLM::Error when
    # the provider does not expose a tokenizer.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tokenization.rb:30
    def tokenize(text, model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil)); end
  end
end

# A Tokens holds normalized token counts for a provider attempt, a
# response, or an aggregate. Read them from Chat#tokens, Message#tokens,
# Chunk#tokens, and individual operation results such as Embedding.
# Counts the provider did not report are +nil+.
#
#   response = chat.ask "What is the capital of France?"
#   response.tokens.input       # standard input tokens
#   response.tokens.output      # billable output tokens
#   response.tokens.cache_read  # prompt cache reads
#   response.tokens.cache_write # prompt cache writes
#
# Operations a provider bills in other units count those units here too,
# so Cost prices them the same way:
#
#   RubyLLM.speak("Hello").tokens.characters             # => 5
#   RubyLLM.transcribe("call.mp3").tokens.audio_seconds  # => 42.3
#   RubyLLM.rerank(query, documents).tokens.search_units # => 1
#
# pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:22
class RubyLLM::Tokens
  include ::RubyLLM::Support::Inspectable

  # Creates token counts from the supplied values. Omitted counts remain
  # +nil+; zero means a reported count of zero. Returns a Tokens object
  # even when every count is +nil+.
  #
  #   tokens = RubyLLM::Tokens.new(input: 100, output: 20)
  #   RubyLLM.models.find("gpt-6.1-sol").cost_for(tokens).total
  #
  # +characters:+, +audio_seconds:+, and +search_units:+ count usage
  # billed in those units;
  # +cache_write_by_ttl:+ splits the cache writes by lifetime, keyed as
  # #cache_write_by_ttl describes;
  # +server_tool_use:+ counts the provider-executed tools that ran, keyed
  # as #server_tool_use describes;
  # +reported_cost:+ holds the provider's total price in US dollars.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:110
  def initialize(input: T.unsafe(nil), output: T.unsafe(nil), cache_read: T.unsafe(nil), cache_write: T.unsafe(nil), thinking: T.unsafe(nil), characters: T.unsafe(nil), audio_seconds: T.unsafe(nil), search_units: T.unsafe(nil), cache_write_by_ttl: T.unsafe(nil), server_tool_use: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # The seconds of audio the provider bills, such as the length of a
  # transcribed recording, or +nil+ if the operation is not billed by
  # duration. May be fractional.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:73
  def audio_seconds; end

  # The number of tokens served from the provider's prompt cache, or
  # +nil+ if the provider did not report it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:45
  def cache_read; end

  # The number of tokens written to the provider's prompt cache, or
  # +nil+ if the provider did not report it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:49
  def cache_write; end

  # The tokens in #cache_write split by cache lifetime, as a Hash of the
  # TTL Strings that <tt>with_caching(ttl:)</tt> accepts and Integer
  # counts, or +nil+ if the provider did not report a split. Lifetimes
  # with no writes are left out. Providers that price a longer lifetime
  # higher, such as Anthropic's one-hour cache, use it to price #cache_write.
  #
  #   response.tokens.cache_write_by_ttl # => {"5m" => 1024, "1h" => 2048}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:59
  def cache_write_by_ttl; end

  # The number of input characters the provider bills, such as the text
  # sent to a text-to-speech model, or +nil+ if the operation is not
  # billed by character.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:68
  def characters; end

  # The number of standard (non-cached) input tokens, or +nil+ if the
  # provider did not report it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:36
  def input; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:185
  def inspect_attributes; end

  # Returns Tokens with each count +other+ reported replacing this one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:141
  def merge(other); end

  # The number of billable output tokens, or +nil+ if the provider did
  # not report it. Includes thinking tokens when the provider bills
  # them as output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:41
  def output; end

  # The exact cost of the call in US dollars as reported by the
  # provider, or +nil+ if the provider does not report one. When present,
  # Cost#total returns it instead of a registry-price estimate.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:94
  def reported_cost; end

  # The number of search units the provider bills, such as Cohere's
  # rerank searches, or +nil+ if the operation is not billed by search.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:77
  def search_units; end

  # How many times each provider-executed tool ran, as a Hash of String
  # keys and Integer counts, or +nil+ if the provider reported none.
  # Web searches are <tt>"web_search_requests"</tt> on every provider
  # that reports them. Other tools follow the same form, such as
  # <tt>"web_fetch_requests"</tt> and <tt>"code_execution_requests"</tt>.
  # Tools that did not run are left out. Providers bill these per use,
  # not in tokens.
  #
  #   response.tokens.server_tool_use # => {"web_search_requests" => 2}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:89
  def server_tool_use; end

  # The number of thinking (reasoning) tokens, or +nil+ if the provider
  # does not report them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:63
  def thinking; end

  # Returns the counts as a hash with keys +:input_tokens+,
  # +:output_tokens+, +:cache_read_tokens+, +:cache_write_tokens+, and
  # +:thinking_tokens+, omitting +nil+ counts. Includes +:characters+,
  # +:audio_seconds+, +:search_units+, +:cache_write_tokens_by_ttl+, and
  # +:server_tool_use+ when reported.
  # The provider's reported cost is available separately
  # through #reported_cost.
  #
  #   response.tokens.to_h
  #   # => {input_tokens: 14, output_tokens: 5}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:170
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:148
  def without_reported_cost; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:202
  def positive_counts(counts); end

  class << self
    # Sums token counts across provider attempts. A bucket remains +nil+ when
    # no attempt reported it.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:128
    def aggregate(tokens); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:152
    def aggregate_counts(tokens, reader); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:25
RubyLLM::Tokens::READERS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/tokens.rb:30
RubyLLM::Tokens::SUMMED = T.let(T.unsafe(nil), Array)

# A Tool is an action an AI model can call during a chat. Subclasses
# describe themselves with ::description, declare their arguments, and
# implement #execute:
#
#   class Weather < RubyLLM::Tool
#     description "Gets current weather for a location"
#
#     def execute(latitude:, longitude:)
#       response = Faraday.get "https://api.open-meteo.com/v1/forecast",
#                              latitude: latitude, longitude: longitude,
#                              current: "temperature_2m,wind_speed_10m"
#       JSON.parse(response.body)
#     end
#   end
#
#   chat.with_tools(Weather).ask "What's the weather in Berlin?"
#
# When no parameters are declared, the argument schema is inferred from
# #execute's keyword arguments: required keywords become required string
# parameters and optional keywords become optional ones. Use ::parameter
# or ::parameters when arguments need explicit types, descriptions, or
# structure.
#
# pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:40
class RubyLLM::Tool
  include ::RubyLLM::Support::Rescuable
  extend ::RubyLLM::Support::Rescuable::ClassMethods

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:432
  def approval_resolver; end

  # Asks the person who runs the chat +message+ while #execute runs, and
  # returns their answer. The call pauses until they answer (see
  # Chat#pending_questions), then #execute runs again from the top, and
  # this time +ask+ returns the answer:
  #
  #   def execute(destination:)
  #     seat = ask("Window or aisle?", choices: %w[window aisle]) or return "No seat chosen."
  #     Flights.book!(destination, seat:)
  #   end
  #
  # Code before +ask+ runs again too, so make it safe to repeat: ask
  # first, then act. A call may ask several questions, one after
  # another, and each run asks them in the same order.
  #
  # Without options, +ask+ takes free text and returns the String. With
  # +choices:+ it returns the one the person picked. With a block, it
  # asks for the fields the block declares, in the DSL of
  # Tool.parameters, and returns their values by name. With +url:+, it
  # asks the person to visit a page, such as to connect an account, and
  # returns +true+ once they say they did.
  #
  #   passenger = ask("Who is flying?") do
  #     string :name, description: "As on the passport"
  #     integer :age, required: false
  #   end
  #   passenger # => {name: "Ada Lovelace", age: 36}
  #
  #   ask("Connect your calendar", url: authorization_url)
  #
  # Returns +nil+ when the person declines. Outside a chat, nothing can
  # pause the call, so +ask+ raises InputRequiredError. Raises
  # ArgumentError when given more than one of +choices:+, +url:+, and a
  # block.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:563
  def ask(message, choices: T.unsafe(nil), url: T.unsafe(nil), &fields); end

  # Runs the tool with keyword arguments, validating them against the
  # #execute signature before invoking it. RubyLLM supplies +tool_call:+
  # when the call comes from a chat; pass it yourself only when you need
  # the ToolCall in a direct invocation.
  #
  #   Weather.new.call(latitude: 52.52, longitude: 13.405)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:518
  def call(tool_call: T.unsafe(nil), **arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:452
  def declared_parameters; end

  # Keeps this tool, and no other of its class, out of the model's
  # context until tool search loads it, as ::defer does for the class.
  # Returns +self+. Chat#with_tools and Chat#with_mcp take +defer:+ to
  # decide for every tool they register instead.
  #
  #   chat.with_tools(CurrentTime.new, *connector_tools.map(&:defer))
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:468
  def defer; end

  # Returns whether this tool waits to be found by tool search: whether
  # it was deferred with #defer, or its class with ::defer.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:475
  def deferred?; end

  # Returns the tool description declared on the class with ::description.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:421
  def description; end

  # Returns whether this tool runs by itself in a concurrent round of
  # tool calls: whether its class was declared with ::exclusive.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:438
  def exclusive?; end

  # Runs the tool with the arguments chosen by the model. Subclasses must
  # implement this method; the base implementation raises
  # NotImplementedError. The return value is sent back to the model.
  # Return a Hash like <tt>{ error: "..." }</tt> to report a recoverable
  # failure.
  #
  # Declare an optional +tool_call:+ keyword to receive the ToolCall being
  # executed. The keyword is reserved: it never appears in the tool's
  # argument schema and is filled in by RubyLLM, not by the model.
  #
  #   def execute(query:, tool_call: nil)
  #     AuditLog.create!(tool_call_id: tool_call&.id)
  #     Search.run(query)
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:595
  def execute(*, **, &); end

  # Ends the turn with +result+ as this call's result: the model is not
  # asked to respond once the round's other calls finish. It stops
  # #execute where it is called, so call it, or return it, when the tool
  # has said the last word, such as filing a ticket a triage turn exists
  # for. The result reaches the conversation as any other, and the next
  # Chat#ask starts a new turn. See Chat#complete?.
  #
  #   def execute(category:)
  #     ticket.update!(category:)
  #     halt "Filed as #{category}"
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:644
  def halt(result = T.unsafe(nil)); end

  # Returns the limit declared on the class with ::inline_limit: a number
  # of characters, +false+, or +nil+ to use the chat's.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:444
  def inline_limit; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:448
  def max_run_time; end

  # Returns the name the model calls this tool by, delegating to
  # ::tool_name. Override either one to choose a different name.
  #
  #   WeatherLookup.new.name  # => "weather_lookup"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:402
  def name; end

  # Returns the tool's namespace, or +nil+ when it has none. See
  # ::namespace.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:408
  def namespace; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:412
  def namespace_description; end

  # Returns the JSON Schema for the tool's arguments, whether declared
  # explicitly or inferred from the +execute+ signature.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:496
  def parameters_schema; end

  # Reports what the tool is doing while #execute runs, so an application
  # can show it before the result arrives. Chat#after_tool_progress
  # callbacks receive it as a Progress. Pass +value:+ and +total:+ when
  # you can count the work. Outside a chat, the report goes nowhere.
  #
  #   def execute(url:)
  #     progress "Downloading #{File.basename(url)}"
  #     pages = Scanner.pages(url)
  #     pages.each_with_index.map do |page, index|
  #       progress "Reading page #{index + 1} of #{pages.size}", value: index + 1, total: pages.size
  #       page.text
  #     end.join("\n")
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:662
  def progress(message = T.unsafe(nil), value: T.unsafe(nil), total: T.unsafe(nil)); end

  # Returns the provider-specific tool metadata declared on the class.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:457
  def provider_options; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:416
  def qualified_name; end

  # Returns whether +tool_call+ must be approved before it runs: whether
  # this tool was declared with ::requires_approval. A subclass may
  # override it to decide from the call's arguments.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:428
  def requires_approval?(tool_call = T.unsafe(nil)); end

  # Carries on a call that paused on +task+, the Task #execute returned,
  # with the call's +arguments+. Each Chat#complete calls it once for
  # every paused call of the round. Return the call's result to finish
  # it, or a Task, +task+ itself or a new one, to keep it paused. Tools
  # that return a Task must implement this method; the base
  # implementation raises NotImplementedError.
  #
  #   def resume(task, **)
  #     envelope = Signatures.find(task.data["envelope_id"])
  #     envelope.signed? ? "Signed on #{envelope.signed_on}" : task
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:611
  def resume(task, **arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:626
  def resume_call(state, arguments, tool_call:); end

  # Returns the Task that +tool_call+ paused on, from +state+, the Hash
  # Task#to_h returned. Override it to return a Task subclass.
  #
  #   def task(state, tool_call: nil)
  #     SignatureTask.load(state, tool_call:)
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:622
  def task(state, tool_call: T.unsafe(nil)); end

  protected

  # Runs a call again that paused on its questions (#ask), now answered or
  # declined, with +input+, the state Chat saved for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:706
  def answered(input, arguments, tool_call:); end

  # The call a chat makes of a tool takes the questions Tool.asking
  # opened for it, which its handler then shares.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:694
  def asking; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:713
  def execute_accepts_tool_call?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:719
  def execute_keyword_signature; end

  # A call's questions are counted from its start; one resumed keeps the
  # answers it was given (#answered), and a call it makes of another tool
  # neither sees them nor moves its count.
  # A fresh Hash each time: fibers inherit their parent's storage, and
  # parallel calls mustn't share a count.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:688
  def halting(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:728
  def inferred_parameters; end

  # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:669
  def validate_keyword_arguments(arguments); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:112
    def approval_resolver; end

    # Opens the questions of the call a chat makes of +tool+, with
    # +input+, the answers Chat saved for it, so the call and its
    # ::rescue_from handler ask in turn and each reads its answers when
    # the call runs again.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:118
    def asking(tool, input); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:209
    def declared_parameters; end

    # Keeps this tool's definition out of the model's context until the
    # provider's tool search loads it. Pass +defer: false+ to
    # Chat#with_tools to offer it up front in one chat. See
    # Chat#deferred_tools.
    #
    #   class DeepResearch < RubyLLM::Tool
    #     description "Runs a multi-step web investigation"
    #     defer
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:331
    def defer; end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:335
    def deferred?; end

    # :call-seq:
    #   description(text) -> text
    #   description -> string or nil
    #
    # Sets the description the model sees for this tool, or returns the
    # current description when called without an argument.
    #
    #   class Weather < RubyLLM::Tool
    #     description "Gets current weather for a location"
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:165
    def description(text = T.unsafe(nil)); end

    # Declares that this tool runs by itself. When a chat runs a round of
    # tool calls concurrently (see Chat#with_tool_options), an exclusive
    # call waits for the calls before it to finish, and the calls after
    # it wait for it, while the other tools still run in parallel. Use it
    # for tools that share state, such as a browser page. When an
    # exclusive call waits for an approval or a Task, the calls after it
    # stay pending until it finishes.
    #
    #   class BrowserClick < RubyLLM::Tool
    #     exclusive
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:286
    def exclusive; end

    # Returns whether this tool was declared with ::exclusive.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:291
    def exclusive?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:126
    def inherited(subclass); end

    # :call-seq:
    #   inline_limit(characters) -> characters
    #   inline_limit(false) -> false
    #   inline_limit -> characters, false, or nil
    #
    # Sets how many characters this tool's results may have and still go
    # to the model whole. In a chat with a file store, a longer result is
    # saved as a file, and the model gets its start and the file's path.
    # It overrides the chat's own limit (see Chat#with_file_store).
    # +false+ always sends results whole, for tools that already return
    # what they find in pages. Without an argument,
    # returns the declared value, or +nil+.
    #
    #   class ExportOrders < RubyLLM::Tool
    #     inline_limit 50_000
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:356
    def inline_limit(characters = T.unsafe(nil)); end

    # Seconds a run of this tool may take before a persisted chat treats
    # it as crashed, overriding Configuration#max_run_time.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:297
    def max_run_time(seconds = T.unsafe(nil)); end

    # Puts the tool in a namespace, or returns its namespace. Tools in
    # different namespaces can share a name. +description:+ tells the
    # model what the namespace's tools are for, on APIs that describe
    # namespaces. Pass +nil+ to remove an inherited namespace.
    #
    #   class CustomerLookup < RubyLLM::Tool
    #     namespace "crm", description: "Customer records and orders"
    #   end
    #
    # A native client toolset, such as Anthropic's computer toolset, calls
    # the tools in its own namespace:
    #
    #   class Screenshot < RubyLLM::Tool
    #     namespace "computer"
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:186
    def namespace(value = T.unsafe(nil), description: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:112
    def namespace_description; end

    # Declares a parameter for the tool. +options+ accepts +type:+
    # (defaults to <tt>'string'</tt>), +description:+, and +required:+
    # (defaults to +true+).
    #
    #   class Distance < RubyLLM::Tool
    #     description "Calculates distance between two cities"
    #     parameter :origin, description: "Origin city name"
    #     parameter :destination, description: "Destination city name"
    #     parameter :units, type: :string, description: "metric or imperial", required: false
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:205
    def parameter(name, **); end

    # Sets the JSON Schema for the tool's arguments. Accepts a schema hash,
    # a Schematist::Schema class or instance, or a block written in the
    # schematist DSL. Returns +self+.
    #
    #   class Scheduler < RubyLLM::Tool
    #     description "Books a meeting"
    #
    #     parameters do
    #       object :window, description: "Time window to reserve" do
    #         string :start, description: "ISO8601 start time"
    #         string :finish, description: "ISO8601 end time"
    #       end
    #       array :participants, of: :string
    #     end
    #   end
    #
    # Raises ArgumentError when called without a schema or a block.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:230
    def parameters(schema = T.unsafe(nil), &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:112
    def parameters_schema_definition; end

    # :call-seq:
    #   provider_options(options) -> self
    #   provider_options -> hash
    #
    # Sets provider-specific metadata, such as Anthropic's +cache_control+
    # hints, merged verbatim into the tool payload sent to the provider.
    # Without an argument, returns the current options.
    #
    #   provider_options cache_control: { type: "ephemeral" }
    #
    # Raises ArgumentError if +options+ is +nil+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:313
    def provider_options(options = T.unsafe(nil)); end

    # Declares that this tool must be approved before it executes. The
    # conversation loop pauses the tool call until a decision is recorded with
    # Chat#approve or Chat#decline, so Chat#complete returns cleanly and
    # can be called again once the decision exists. In Rails the decision
    # persists on the tool call record and survives process restarts.
    #
    #   class IssueRefund < RubyLLM::Tool
    #     requires_approval
    #
    #     def execute(order_id:)
    #       Refunds.issue!(order_id)
    #     end
    #   end
    #
    # Pass a block to resolve the decision yourself instead of using the
    # recorded one. The block receives the ToolCall and returns +true+ to
    # execute, +false+ to deny, or +nil+ while the decision is pending.
    #
    # The block never runs at class definition. The loop consults it
    # whenever it needs the decision, which can be several times while
    # the call is pending, including after a crashed job resumes, so
    # write it as an idempotent read. If it also creates the approval
    # request, make that a find-or-create.
    #
    #   requires_approval { |tool_call| Approvals.status(tool_call.id) }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:265
    def requires_approval(&resolver); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:270
    def requires_approval?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:365
    def split_result(result); end

    # Returns the name the model calls this tool by, derived from the class
    # name: underscored, reduced to ASCII, with a trailing "_tool" removed.
    # Override this method to choose a different name.
    #
    #   WeatherLookup.tool_name  # => "weather_lookup"
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:144
    def tool_name; end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:388
    def result_content(result); end

    # pkg:gem/ruby_llm#lib/ruby_llm/tool.rb:376
    def split_array_result(result); end
  end
end

