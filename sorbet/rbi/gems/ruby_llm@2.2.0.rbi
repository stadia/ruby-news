  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:34
  def disconnect(chat); end

  # Yields each server.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:55
  def each(&); end

  # Returns whether no servers are connected.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:60
  def empty?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:64
  def inspect; end

  # The tools of the servers that can be reached.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:39
  def reachable_tools; end

  # The names of the servers that can't be reached.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:44
  def unreachable; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:70
  def check_name(server, connected); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:20
  def initialize_copy(source); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:82
  def method_missing(name, *arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:78
  def release(server, chat); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:88
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

