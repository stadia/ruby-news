# Removes the citation markers OpenAI's models write into their text:
# U+E200, then "cite" and the sources and line locators it cites, each
# after a U+E202, then U+E201. Only OpenAI's own tools turn them into annotations, so
# a model that writes them without those tools leaves them in the
# answer. Model output is untrusted: each character is read once, and
# an unclosed marker holds back at most MAX_LENGTH characters. A space
# before a removed marker goes too when punctuation, a space, or the end
# of the text follows. Only a marker holds a space past the end of a
# stream chunk, so text keeps its order across content parts. #shift
# maps an index into the text as sent onto the text without markers.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:16
class RubyLLM::Protocols::Responses::CitationMarkers
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:32
  def initialize; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:40
  def feed(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:49
  def finish; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:61
  def shift(index); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:138
  def alphanumeric?(char); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:123
  def citation_prefix?(held); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:118
  def close_marker(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:127
  def complete_marker?(held); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:148
  def drop(held); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:106
  def hold(char, output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:131
  def marker?(held); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:101
  def open_marker; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:69
  def read(char, output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:154
  def release(held, output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:91
  def settle_space(output, boundary:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:142
  def take_held; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:82
  def write(char, output); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/citation_markers.rb:27
    def strip(text); end
  end
end

