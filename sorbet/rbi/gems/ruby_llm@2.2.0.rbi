    # Deletes the uploads recorded for +blob+ as Active Storage destroys it.
    # Reads the stored key: Blob#key generates one when it is missing, and
    # a destroyed blob is frozen.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:38
    def forget_blob(blob); end

    # Returns a store for the blob whose key the block returns, or +nil+
    # while the table has not been migrated.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:31
    def store(&); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:27
    def __class_attr___callbacks; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:27
    def __class_attr___callbacks=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:24
    def __class_attr__validators; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:24
    def __class_attr__validators=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:24
    def __class_attr_defined_enums; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/provider_file.rb:24
    def __class_attr_defined_enums=(new_value); end
  end
end

