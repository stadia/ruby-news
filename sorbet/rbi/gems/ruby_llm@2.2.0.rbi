# pkg:gem/ruby_llm#lib/ruby_llm/providers/anthropic.rb:12
module RubyLLM::Protocols; end

# The Anthropic Messages API.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:6
class RubyLLM::Protocols::Anthropic < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Anthropic::Chat
  include ::RubyLLM::Protocols::Anthropic::Embeddings
  include ::RubyLLM::Protocols::Anthropic::Media
  include ::RubyLLM::Protocols::Anthropic::Models
  include ::RubyLLM::Protocols::Anthropic::RequestShapes
  include ::RubyLLM::Protocols::Anthropic::Streaming
  include ::RubyLLM::Protocols::Anthropic::Tools

  # Server tools can pause a long turn with stop_reason pause_turn; the
  # API expects the conversation back verbatim to continue it. Segments
  # are merged into the single Message the caller sees.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:78
  def complete(messages, *, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:63
  def server_tool_aliases; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:71
  def skipped_tool_call_error(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:67
  def tool_search?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:107
  def beta_headers(additional_headers, payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:147
  def merge_citations(segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:163
  def merge_raw_content(segments); end

  # A signature covers one segment's thinking, so joined text carries
  # none; replay sends each segment's own blocks from raw_content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:139
  def merge_thinking(segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:169
  def merge_tool_calls(segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:111
  def merge_tool_headers(tool_headers, headers); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:118
  def merge_turn_segments(segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:156
  def offset_citation(citation, offset); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:103
  def post_count_tokens(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:99
  def stream_response(payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:95
  def sync_response(payload, additional_headers = T.unsafe(nil)); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:49
    def mcp_tool_filter(options); end

    # Returns the pages the message's web searches returned, as WebSource objects.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:45
    def parse_web_sources(message); end
  end
end

# The Message Batches API: Messages requests processed together,
# asynchronously, at half price.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:8
module RubyLLM::Protocols::Anthropic::Batches
  include ::RubyLLM::Batch::Helpers

  # Results come back as JSONL in no particular order; each line carries
  # the custom_id (our submission index) to match results to requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:30
  def batch_results(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:24
  def cancel_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:11
  def create_batch(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:20
  def find_batch(id); end

  private

  # One request carries the whole batch, so it takes every beta any
  # of its entries needs.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:39
  def batch_betas(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:58
  def batch_url(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:54
  def batches_url; end

  # Anthropic ends every batch as "ended"; only the request counts say
  # whether it was cancelled or ran out of time. A batch with any
  # success ended, and its cancelled or expired slots fail on their own.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:78
  def ended_batch_status(request_counts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:62
  def parse_batch_response(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:95
  def parse_batch_result(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:84
  def parse_batch_status(raw_status, completed:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/batches.rb:49
  def with_request_betas(headers, request); end
end

# These Claude models bind a signed thinking block to the instructions,
# tools, and messages it was written under, and refuse it once they
# change. Dropping the block lets the model think that turn again.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/block_binding.rb:9
module RubyLLM::Protocols::Anthropic::BlockBinding
  private

  # Returns +thinking+ with the binding added, or +nil+ when thinking
  # is set to anything but adaptive, which the binding would replace.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/block_binding.rb:22
  def apply(thinking); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/block_binding.rb:16
  def binds?(model_id); end

  class << self
    # Returns +thinking+ with the binding added, or +nil+ when thinking
    # is set to anything but adaptive, which the binding would replace.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/block_binding.rb:22
    def apply(thinking); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/block_binding.rb:16
    def binds?(model_id); end
  end
end

