# Chat methods for Mistral API
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:7
module RubyLLM::Providers::Mistral::Chat
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:133
  def append_formatted_content(content_blocks, formatted_content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:120
  def build_thinking_blocks(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:86
  def build_tool_choice(tool_choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:73
  def cache_option_names; end

  # A tool that supplies numbered sources gets reference chunks back,
  # whose reference_ids are the keys of that tool's own result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:17
  def extract_citations(message_data, data, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:13
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:75
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:92
  def normalize_required_tool_choice(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:53
  def openai_prompt_caching?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:22
  def parse_chunk_citations(delta, data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:65
  def prompt_cache_options(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:57
  def prompt_cache_params(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:27
  def reference_citations(content, offsets: T.unsafe(nil)); end

  # Mistral carries reasoning in content blocks, not in the top-level
  # reasoning fields the rest of the Chat Completions family uses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:106
  def render_message_content(msg, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:42
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/chat.rb:38
  def render_role(role); end

