  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:23
    def join(first, second); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/think_tags.rb:16
    def split(text); end
  end
end

