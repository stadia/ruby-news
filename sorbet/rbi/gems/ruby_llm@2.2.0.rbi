  include ::RubyLLM::Providers::Moonshot::Chat
  include ::RubyLLM::Providers::Moonshot::Documents
end

# Kimi models cannot read a document attached to a message. Kimi
# documents one way to ask about a file: extract its text through the
# Files API and send that text in the conversation.
# https://platform.kimi.ai/docs/guide/ask-questions-about-pdf-content
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:12
module RubyLLM::Providers::Moonshot::Documents
  # Kimi extracts a whole document without a model, so +model:+ only
  # labels the result. The upload exists only to read it back.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:25
  def ocr(file, model:, pages: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:15
  def preprocess_message(message, unsupported_attachment: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:71
  def delete_upload(upload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:67
  def download_upload(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:51
  def extracted_attachment(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:45
  def extracted_document?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:56
  def extracted_text(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:41
  def provider_file_upload_options(_attachment); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/documents.rb:13
RubyLLM::Providers::Moonshot::Documents::EXTRACT_PURPOSE = T.let(T.unsafe(nil), String)

# Moonshot's dialect of the OpenAI Responses API, the route to Kimi's
# server-side web search. It holds no state: store is always false.
# https://platform.kimi.ai/docs/api/responses
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:9
class RubyLLM::Providers::Moonshot::Responses < ::RubyLLM::Protocols::Responses
  include ::RubyLLM::Providers::Moonshot::Documents

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:24
  def apply_end_user(payload, identifier); end

  # Kimi reads images only from data URIs, so remote images travel inline.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:29
  def render_image(image, image_url: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:16
  def server_tool_aliases; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:20
  def web_search_sources?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:48
  def parse_server_tool_use(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:35
  def provider_file_references?; end

  # Kimi silently drops the web_search tool for a message whose content
  # is a bare string, so text always travels as input_text parts.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:41
  def render_item(msg, caching: T.unsafe(nil)); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/moonshot/responses.rb:12
RubyLLM::Providers::Moonshot::Responses::SERVER_TOOL_ALIASES = T.let(T.unsafe(nil), Hash)

