  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/solid_queue_shutdown.rb:21
  def forked?(worker); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/solid_queue_shutdown.rb:16
  def install(solid_queue); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/solid_queue_shutdown.rb:26
    def exiting(solid_queue); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/solid_queue_shutdown.rb:21
    def forked?(worker); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/solid_queue_shutdown.rb:16
    def install(solid_queue); end
  end
end

