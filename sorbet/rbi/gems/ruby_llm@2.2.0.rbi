# Gemini can pause a long response with a continuation token. Each
# hop resends the same request with the newest token, and the hops
# join into one assistant message.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/long_decode.rb:9
module RubyLLM::Protocols::Gemini::LongDecode
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/long_decode.rb:10
