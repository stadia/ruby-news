  # The MIME type of the audio, such as <tt>"audio/mpeg"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/speech_chunk.rb:16
  def mime_type; end

  # Returns the raw audio bytes. Alias for #data.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/speech_chunk.rb:25
  def to_blob; end
