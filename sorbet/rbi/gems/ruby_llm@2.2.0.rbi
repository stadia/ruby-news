# A provider-side batch of persisted chats, in RubyLLM's
# +ruby_llm_batches+ table. RubyLLM.batch writes a row when it submits
# persisted chats of one class, and RubyLLM::Batch.find reads it back
# in any process.
#
#   RubyLLM::ActiveRecord::Batch.where(completed: false).pluck(:provider_batch_id)
#
# Its columns:
#
# [+provider_batch_id+] The provider's id for the batch.
# [+provider+] The provider's slug.
# [+status+] <tt>"pending"</tt>, <tt>"succeeded"</tt>, <tt>"failed"</tt>, or <tt>"cancelled"</tt>.
# [+raw_status+] The status as the provider last reported it.
# [+completed+] Whether the provider has finished the batch.
# [+request_counts+] The provider's request counts, as a Hash.
# [+reported_cost+] The cost the provider reported, as a Hash.
# [+chat_type+, +chat_ids+] The class and ids of the submitted chats.
#
# RubyLLM writes these rows. Read and query them, and add scopes and
# columns of your own, but do not create or update them.
# Use RubyLLM::Batch to refresh a batch and deliver its results.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:26
class RubyLLM::ActiveRecord::Batch < ::RubyLLM::ActiveRecord::Record
  include ::RubyLLM::ActiveRecord::Batch::GeneratedAttributeMethods
  include ::RubyLLM::ActiveRecord::Batch::GeneratedAssociationMethods

  # Returns the submitted chat records in submission order, with +nil+
  # for a chat that no longer exists.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:83
  def chats; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:109
  def sync_from(batch); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:90
  def to_llm(context: T.unsafe(nil), store: T.unsafe(nil)); end

  private

  # The chat was awaiting the model when the batch was submitted, so an
  # assistant message newer than the batch answers that turn, whatever
  # the chat went on to stage after it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:145
  def answered?(chat); end

  # A failed slot adds no message, so its usage row is what marks it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:135
  def billed_failure?(chat); end

  # Two pollers can load a batch before either delivers, so the check
  # is repeated once this one holds the chat.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:125
  def deliver_once(chat, failed: T.unsafe(nil)); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:54
    def fetch(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:35
    def persist(batch, chats); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:58
    def sync(batch); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:31
    def __class_attr___callbacks; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:31
    def __class_attr___callbacks=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:26
    def __class_attr__validators; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:26
    def __class_attr__validators=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:26
    def __class_attr_defined_enums; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:26
    def __class_attr_defined_enums=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:64
    def find_record(id, provider: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:72
    def persistable_chats?(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:76
    def persisted_chat?(chat); end
  end
end

