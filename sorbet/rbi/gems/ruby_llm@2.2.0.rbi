#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/text.rb:12
module RubyLLM::FileStore::Converters::Text
  private

  # Returns the content of +attachment+ as UTF-8 text.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/text.rb:16
  def call(attachment); end

  # Returns true: it reads files here, for free.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/text.rb:21
  def local?; end

  class << self
    # Returns the content of +attachment+ as UTF-8 text.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/text.rb:16
    def call(attachment); end

    # Returns true: it reads files here, for free.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/file_store/converters/text.rb:21
    def local?; end
  end
end

