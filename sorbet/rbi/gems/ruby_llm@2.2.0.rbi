RubyLLM::MCP::Client::METHOD_NOT_FOUND = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:31
RubyLLM::MCP::Client::MODERN_ERRORS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:34
RubyLLM::MCP::Client::PAGE_LIMIT = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:30
RubyLLM::MCP::Client::UNSUPPORTED_VERSION = T.let(T.unsafe(nil), Integer)

# :stopdoc:
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/client.rb:28
RubyLLM::MCP::Client::VERSION = T.let(T.unsafe(nil), String)

# The MCP servers connected to a chat, readable by name.
#
#   chat.with_mcp(Linear.new(user: current_user))
#   chat.mcp.linear     # => #<Linear ...>
#   chat.mcp[:linear]   # => #<Linear ...>
#   chat.mcp.map(&:name) # => ["linear"]
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:12
class RubyLLM::MCP::Collection
  include ::Enumerable

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:15
  def initialize; end

  # Returns the server named +name+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/collection.rb:50
