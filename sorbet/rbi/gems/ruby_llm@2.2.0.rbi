# Chat methods of the GPUStack API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:7
module RubyLLM::Providers::GPUStack::Chat
  private

  # vLLM truncates the rendered prompt to its last tokens. It summarizes
  # nothing, and the cut can reach the system prompt. Truncating to the
  # model's own limit without an output limit leaves no room to answer,
  # and vLLM rejects the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:22
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:31
  def log_ignored_compaction_options(compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:10
  def render_content(content, attachments = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:14
  def render_role(role); end

  class << self
    # vLLM truncates the rendered prompt to its last tokens. It summarizes
    # nothing, and the cut can reach the system prompt. Truncating to the
    # model's own limit without an output limit leaves no room to answer,
    # and vLLM rejects the request.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:22
    def apply_compaction(payload, compaction); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:31
    def log_ignored_compaction_options(compaction); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:10
    def render_content(content, attachments = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/gpustack/chat.rb:14
    def render_role(role); end
  end
end

