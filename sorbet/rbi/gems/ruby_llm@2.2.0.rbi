  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:25
    def [](*_arg0); end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:25
    def inspect; end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:25
    def keyword_init?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/code_execution/workspace.rb:25
