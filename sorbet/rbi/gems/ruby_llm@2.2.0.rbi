# Raised by a transport when the session of a server that predates
# 2026-07-28 has ended, so the client starts a new one: the server
# answered 404, or its stdio process exited. +session+ is the session
# that ended, as the transport's +session+ reader returned it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/session_expired.rb:9
class RubyLLM::MCP::SessionExpired < ::RubyLLM::MCP::Error
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/session_expired.rb:12
  def initialize(message = T.unsafe(nil), session: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/session_expired.rb:10
  def session; end
end

# stdio. The server is a child process that reads one JSON-RPC message
# per line on stdin and writes one per line on stdout. Reads never block
# past the deadline, even on a partial line. It starts on the
# first request, restarts after it exits, and handles one request at a
# time. Its stderr is the parent's. A server that predates 2026-07-28
# keeps its session for the life of its process, so after a restart its
# requests raise SessionExpired until the client initializes it again.
# The process inherits only INHERITED_ENV from the application, and +env+
# adds to and overrides those: a Hash, or a callable that returns one,
# called each time the process starts. Where the platform has process
# groups the server leads its own, so stopping it reaches the processes
# it started.
#
# Subscriptions share the channel, so whichever thread reads a message
# that belongs to one hands it to the subscription's listener: a
# request waiting for its answer, or the listener itself while no
# request reads. A listener stops when CancelledError is raised in its
# thread, so it reads and writes with that deferred.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:26
class RubyLLM::MCP::Stdio
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:61
  def initialize(command, env: T.unsafe(nil), directory: T.unsafe(nil), timeout: T.unsafe(nil), config: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:84
  def cancel(notification, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:106
  def close; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:88
  def listen(message, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:79
  def notify(message, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:70
  def request(message, version: T.unsafe(nil), timeout: T.unsafe(nil), **, &); end

  # The session of a server that predates 2026-07-28: the process it was initialized in, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:59
  def session; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:236
  def answer(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:174
  def await(id, timeout); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:112
  def check_session(version); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:144
  def drain; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:248
  def environment; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:231
  def exited; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:270
  def exited?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:285
  def groups?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:158
  def handled?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:293
  def monotonic_now; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:289
  def name; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:212
  def next_line(deadline); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:202
  def parse(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:195
  def read(deadline); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:126
  def receive(subscription); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:166
  def route(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:281
  def signal(signal); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:240
  def start; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:253
  def stop; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:118
  def subscribe(subscription, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:263
  def terminate; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:170
  def uninterrupted(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:184
  def write(message); end
end

