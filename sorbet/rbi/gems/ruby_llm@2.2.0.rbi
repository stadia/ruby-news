  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
    def [](*_arg0); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
    def inspect; end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
    def keyword_init?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/prompt.rb:17
