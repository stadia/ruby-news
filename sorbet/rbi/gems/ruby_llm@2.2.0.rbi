# pkg:gem/ruby_llm#lib/ruby_llm/providers/xai/responses.rb:8
class RubyLLM::Providers::XAI::Responses < ::RubyLLM::Protocols::Responses
  include ::RubyLLM::Providers::XAI::ReportedCost
