  include ::RubyLLM::Providers::XAI::Models
  include ::RubyLLM::Providers::XAI::Speech
  include ::RubyLLM::Providers::XAI::Transcription
  include ::RubyLLM::Providers::XAI::Videos
  include ::RubyLLM::Protocols::XAI::Tokenization
