#   chat.with_file_store(:memory)
#
# pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:10
class RubyLLM::FileStore::Memory < ::RubyLLM::FileStore
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:11
  def initialize; end

  # Returns the StoredFile at +path+, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:25
  def [](path); end

  # Deletes the file at +path+ and returns its StoredFile, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/file_store/memory.rb:50
  def delete(path); end

  # Deletes everything inside the folder +path+ and returns the deleted
  # StoredFile objects.
