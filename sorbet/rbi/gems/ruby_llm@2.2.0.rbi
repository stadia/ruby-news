# Perplexity's Batch API, the OpenAI batch shape for Agent API requests.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/batches.rb:7
module RubyLLM::Protocols::Perplexity::Batches
  include ::RubyLLM::Batch::Helpers
  include ::RubyLLM::Protocols::OpenAI::Batches
  include ::RubyLLM::Protocols::Responses::Batches

  # The Idempotency-Key lets the connection retry the create after a 429,
  # which arrives whenever the upload just used the 1 request per second
  # that the batch and file endpoints allow at the lowest usage tier.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/batches.rb:13
  def create_batch(requests); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/batches.rb:27
  def batch_create_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/batches.rb:31
  def batch_url(id); end
end

# Perplexity's two kinds of stored file: batch input and output under
# /v1/files, and files an Agent response generated, which belong to it
# and are named response_id/files/file_id.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:9
class RubyLLM::Protocols::Perplexity::Files < ::RubyLLM::Protocols::OpenAI::Files
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:14
  def find(resource_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:25
  def parse_response_file(response_id, data); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:42
  def download_file_url(resource_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:38
  def files_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:46
  def split_resource_id(resource_id); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:11
RubyLLM::Protocols::Perplexity::Files::RESPONSE_FILE_ID = T.let(T.unsafe(nil), Regexp)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/files.rb:10
RubyLLM::Protocols::Perplexity::Files::STORED_FILE_ID = T.let(T.unsafe(nil), Regexp)

# Perplexity Router's Chat Completions dialect.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/router.rb:7
class RubyLLM::Protocols::Perplexity::Router < ::RubyLLM::Protocols::ChatCompletions
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/router.rb:8
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/router.rb:12
  def render_payload(messages, schema: T.unsafe(nil), **); end
end

# The OpenAI Responses API. Overrides the chat surface of Chat Completions;
# embeddings, images, moderation, and transcription are inherited. Runs
# stateless (store: false) and replays encrypted reasoning so multi-turn
# tool calls work without server-side state.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:9
class RubyLLM::Protocols::Responses < ::RubyLLM::Protocols::ChatCompletions
  include ::RubyLLM::Protocols::Responses::Approvals
  include ::RubyLLM::Protocols::Responses::Chat
  include ::RubyLLM::Protocols::Responses::Media
  include ::RubyLLM::Protocols::Responses::RequestShapes
  include ::RubyLLM::Protocols::Responses::Streaming
  include ::RubyLLM::Protocols::Responses::Tools

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:44
  def server_tool_aliases; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:48
  def tool_search?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:52
  def web_search_sources?; end

  class << self
    # Returns the text of +message+ that holds its answer when its turn
    # marks other items as intermediate, or +nil+ when all of its content
    # is the answer. Reads only what the message keeps, so a restored
    # message answers the same.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:35
    def parse_answer_text(message); end

    # Returns the pages the message's web searches returned, as WebSource objects.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:40
    def parse_web_sources(message); end
  end
end

# Approval requests and decisions for provider-managed tools.
