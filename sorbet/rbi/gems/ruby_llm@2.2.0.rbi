  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:698
    def apply_configuration(chat, input_values: T.unsafe(nil), **options); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:594
    def build_chat(inputs:, options:, resolved_context: T.unsafe(nil)); end

    # Enables prompt caching for chats this agent builds, applied via
    # Chat#with_caching. With no options, the provider's default behavior
    # applies. Pass +false+ to stop RubyLLM from sending cache controls. A
    # provider may still cache prompts implicitly. A block defers evaluation
    # until the chat is built. Accepts keywords or an options Hash.
    #
    #   caching
    #   caching false
    #   caching cache
    #   caching ttl: "1h"
    #   caching { { ttl: workspace.cache_ttl } }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:446
    def caching(enabled = T.unsafe(nil), **options, &block); end

    # Builds a Chat configured with this agent's declarations and returns
    # it. Keywords matching declared ::inputs become runtime inputs; the
    # rest are forwarded to RubyLLM.chat.
    #
    #   chat = WorkAssistant.chat
    #   chat.ask "Hello"
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:606
    def chat(**kwargs); end

    # Sets the ActiveRecord chat class this agent creates and finds,
    # activating Rails mode (::create, ::create!, ::find, and
    # ::sync_instructions). Accepts the class or its name as a string.
    # Called with no argument, returns the configured value.
    #
    #   chat_class Chat
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:556
    def chat_class(value = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:581
    def chat_kwargs; end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:563
    def chat_model(value = T.unsafe(nil)); end

    # Enables citations for chats this agent builds, applied via
    # Chat#with_citations. Pass +false+ to disable them.
    #
    #   citations
    #   citations false
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:428
    def citations(value = T.unsafe(nil)); end

    # Lets chats this agent builds run code in the configured sandbox,
    # applied via Chat#with_code_execution. Accepts the same options as
    # keywords or a Hash. Pass +false+ to disable it. Passing +nil+ or a
    # block raises ArgumentError.
    #
    #   code_execution
    #   code_execution false
    #   code_execution languages: [:ruby, :python], gems: %w[prawn]
    #   code_execution sandbox: ReadOnlySandbox, escalate_to: [WorkspaceSandbox]
    #   code_execution mounts: -> { { "templates" => chat.templates_dir } }
    #
    # A +mounts+ lambda runs before each run, with +chat+ and the
    # agent's inputs in scope, like the agent's other lambdas.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:343
    def code_execution(enabled = T.unsafe(nil), **options); end

    # Enables context compaction for chats this agent builds, applied via
    # Chat#with_compaction. With no options, the provider's own defaults
    # apply. Pass +false+ to disable it.
    #
    #   compaction
    #   compaction false
    #   compaction at: 50_000
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:306
    def compaction(options = T.unsafe(nil)); end

    # Sets a Context whose configuration chats this agent builds should
    # use, applied via Chat#with_context. A block taking a configuration
    # argument creates an isolated Context when the agent class is defined.
    # A zero-argument block or Proc value defers evaluation until a chat is
    # built or configured, with declared ::inputs available as methods. In
    # plain Ruby, +chat+ is nil; in Rails mode, +chat+ is the record being
    # configured. Called with no argument or block, returns the configured
    # context or deferred Proc.
    #
    #   context SharedContext
    #   context { |config| config.request_timeout = 180 }
    #   context -> { RubyLLM.context { |config| config.openai_api_key = api_key } }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:535
    def context(value = T.unsafe(nil), &block); end

    # Keeps tool results within shares of the model's context window in
    # chats this agent builds, applied via Chat#with_context_budget, in
    # place of Configuration#context_budget. Pass +nil+ for no budget.
    #
    #   context_budget per_result: 0.25, per_request: 0.7
    #   context_budget window: 128_000, per_request: 0.7
    #   context_budget nil
    #
    # A block is evaluated for each chat, with the agent's inputs and
    # +chat+ in scope, and returns the options, or +nil+ for no budget.
    #
    #   context_budget { { window: model_window, per_request: 0.7 } if model_window }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:328
    def context_budget(budget = T.unsafe(nil), **, &); end

    # Creates a ::chat_class record, applies this agent's configuration to
    # it, and returns it. Keywords matching declared ::inputs become
    # runtime inputs; the rest are forwarded to the model's +create+.
    #
    #   chat = WorkAssistant.create(user: current_user)
    #
    # Raises ArgumentError if ::chat_class is not configured.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:621
    def create(**); end

    # Like ::create, but calls the model's <tt>create!</tt>, raising if
    # the record is invalid.
    #
    #   chat = WorkAssistant.create!(user: current_user)
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:630
    def create!(**); end

    # Sets the safety identifier for chats this agent builds, applied via
    # Chat#with_end_user. A block defers evaluation until the
    # chat is built, so the id can come from the agent's inputs. Called
    # with no arguments, returns the configured value.
    #
    #   end_user "tenant-42"
    #   end_user { workspace.public_id }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:406
    def end_user(value = T.unsafe(nil), &block); end

    # Sets fallback models for chats this agent builds, applied via
    # Chat#with_fallbacks. Called with no arguments, returns the
    # configured models. Keep the default +on:+: providers signal
    # overload as HTTP 529 or 503, and the default covers both.
    #
    #   fallbacks "gpt-4.1-mini", "claude-haiku-4-5"
    #   fallbacks "gpt-4.1-mini", on: [*RubyLLM::Fallback::DEFAULT_ERRORS, RubyLLM::ContextLengthExceededError]
    #   fallbacks drop_unsupported: true
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:509
    def fallbacks(*models, on: T.unsafe(nil), drop_unsupported: T.unsafe(nil)); end

    # Attaches a file store to chats this agent builds, with the tools to
    # work with it, applied via Chat#with_file_store, which takes the
    # same arguments. A +store+ lambda runs once for each chat, with
    # +chat+ and the agent's inputs in scope, like the agent's other
    # lambdas. Pass +nil+ to remove the store a parent agent declared. A
    # block raises ArgumentError: pass the lambda as the store instead.
    #
    #   file_store
    #   file_store inline_limit: 20_000, tools: :read
    #   file_store :memory
    #   file_store -> { "tmp/chats/#{chat.id}" }
    #   file_store nil
    #
    # Each chat gets a store of its own: without +store+, a new
    # FileStore::Memory, or for a persisted chat, its files in Active
    # Storage, kept for the chat's owner (see ::owner). A folder path on
    # its own is shared by every chat, so use a lambda to give each chat
    # its own folder.
    #
    # :call-seq: file_store(store = default, inline_limit: 10_000, tools: %i[read write edit])
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:369
    def file_store(store = T.unsafe(nil), inline_limit: T.unsafe(nil), tools: T.unsafe(nil)); end

    # Finds the ::chat_class record with +id+ and applies this agent's
    # configuration at runtime, without persisting instructions. Returns
    # the record.
    #
    #   chat = WorkAssistant.find(params[:id])
    #
    # Raises ArgumentError if ::chat_class is not configured.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:641
    def find(id, **kwargs); end

    # Sets custom HTTP headers for chats this agent builds, applied via
    # Chat#with_headers. A block defers evaluation until the chat is
    # built. Called with no arguments, returns the configured value.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:476
    def headers(**headers, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:110
    def inherited(subclass); end

    # Declares named runtime inputs. Matching keyword arguments passed to
    # ::chat, ::create, ::create!, ::find, or ::new become methods inside
    # lazy configuration blocks. Called with no arguments, returns the
    # declared names.
    #
    #   inputs :workspace
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:575
    def inputs(*names); end

    # Adds system instructions for chats this agent builds. Accepts a string,
    # a block evaluated when the chat is built, or keyword locals for the
    # agent's conventional prompt template (for a WorkAssistant agent,
    # <tt>app/prompts/work_assistant/instructions.txt.erb</tt>). Multiple
    # declarations are applied in order.
    #
    #   instructions "You are a helpful assistant."
    #   instructions { "You are helping #{workspace.name}" }
    #   instructions display_name: -> { chat.user.display_name_or_email }
    #   instructions append: true, persist: false do
    #     "Today is #{Date.current}"
    #   end
    #
    # The class's own declarations take precedence over its conventional
    # template. Inherited declarations are used only when neither exists.
    # In Rails mode, declarations persist when the record is created unless
    # <tt>persist: false</tt>;
    # ::find always reapplies them without rewriting history. Called with no
    # arguments, returns the declarations.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:243
    def instructions(text = T.unsafe(nil), append: T.unsafe(nil), persist: T.unsafe(nil), cache_until_here: T.unsafe(nil), **prompt_locals, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:273
    def max_output_tokens(value = T.unsafe(nil)); end

    # Connects MCP servers to chats this agent builds, applied via
    # Chat#with_mcp. A block defers construction until the chat is built,
    # with the declared ::inputs available. Called with no arguments,
    # returns the declared servers.
    #
    #   mcp Files
    #   mcp { [Linear.new(user: user), Files] }
    #
    # Pass +defer:+ as Chat#with_mcp takes it, or a lambda that decides
    # when the chat is built:
    #
    #   mcp GitHub, defer: true
    #
    # With +defer:+ alone it applies to the servers a parent agent declared.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:185
    def mcp(*servers, defer: T.unsafe(nil), &block); end

    # Sets the model used by chats this agent builds. Extra +options+ are
    # forwarded to RubyLLM.chat, including +provider:+ to disambiguate the
    # model and +protocol:+ to override its wire protocol. A block picks
    # the model when the chat is built, with the declared ::inputs
    # available as methods. Called with no arguments, returns the
    # configured chat keywords.
    #
    #   model "gpt-6-luna"
    #   model "gpt-6.1-sol", provider: :openai, protocol: :responses
    #   model { quality == :high ? "gpt-6.1-sol" : "gpt-6-luna" }
    #
    # A +model:+ passed to ::chat, ::new, ::create, or ::create! replaces
    # the declared model and its options, so the caller's model resolves
    # on its own provider unless the caller also passes +provider:+. Options
    # declared without a model stay. Later, ::find, ::new with +chat:+, and
    # ::sync_instructions apply the options only to a record on the declared
    # model, and always when a block declares it, since the block's choice
    # is unknown until it runs.
    #
    # The block runs before the chat exists, so it can read inputs but not
    # +chat+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:136
    def model(model_id = T.unsafe(nil), **options, &block); end

    # Sets whoever the usage of chats this agent builds or finds is
    # attributed to, applied via Chat#with_owner. A block defers
    # evaluation until the chat is built, so the owner can come from the
    # agent's inputs or, for a persisted chat, from +chat+. A persisted
    # chat keeps the files of its Active Storage store for the owner
    # too, and the owner wins over the association its
    # <tt>acts_as_chat owner:</tt> names. Subclasses inherit it. Called
    # with no arguments, returns the configured value.
    #
    #   owner { account }
    #   owner { chat.user }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:420
    def owner(value = T.unsafe(nil), &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:682
    def partition_inputs(kwargs); end

    # Sets options in the provider's request vocabulary for chats this
    # agent builds, applied via Chat#with_provider_options. A block
    # defers evaluation until the chat is built. Called with no
    # arguments, returns the configured value.
    #
    #   provider_options service_tier: "flex"
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:467
    def provider_options(**provider_options, &block); end

    # Enables provider-executed tools for chats this agent builds, applied
    # via Chat#with_provider_tools. Accepts the same aliases, options, and
    # raw Hashes; a block defers evaluation until the chat is built and
    # returns a list, or a Hash of aliases and options like the keywords.
    # Called with no arguments, returns the declared entries.
    #
    #   provider_tools :web_search
    #   provider_tools web_search: { allowed_domains: ["ruby-lang.org"] }
    #   provider_tools { { web_search: { max_uses: max_searches } } }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:218
    def provider_tools(*tools, **tools_with_options, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:677
    def render_prompt(name, chat:, inputs:, locals:); end

    # Resolves a deferred context before plain-Ruby chat construction;
    # +chat+ is nil in the evaluation runtime.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:587
    def resolved_context(inputs:); end

    # Sets the structured output schema for chats this agent builds,
    # applied via Chat#with_schema. Accepts a schema class, a JSON schema
    # hash, or a block. A plain block is built with the Schematist::Schema
    # DSL; a lambda is evaluated when the chat is built. Called with no
    # arguments, returns the configured value.
    #
    #   schema PersonSchema
    #   schema do
    #     string :verdict, enum: ["pass", "revise"]
    #     string :feedback
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:494
    def schema(value = T.unsafe(nil), &block); end

    # Gives chats this agent builds the skills named, applied via
    # Chat#with_skills when the chat is built. Symbols name folders under
    # Skill.roots, Strings and Pathnames are paths to skill folders,
    # +true+ is every skill under the roots, and +false+ removes the
    # skills a parent agent declared. An agent without a +skills+
    # declaration has no skills. Called with no arguments, returns the
    # declaration: the names, +true+, +false+, or +nil+. A block raises
    # ArgumentError.
    #
    #   skills :invoices, :refunds
    #   skills true
    #   skills false
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:391
    def skills(*skills); end

    # Re-renders this agent's instructions and persists them on the given
    # ::chat_class record (or the record found by that id). Keywords
    # matching declared ::inputs become runtime inputs. Returns the
    # record.
    #
    #   WorkAssistant.sync_instructions(chat)
    #
    # Raises ArgumentError if ::chat_class is not configured.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:659
    def sync_instructions(chat_or_id, **kwargs); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:273
    def temperature(value = T.unsafe(nil)); end

    # Enables thinking for chats this agent builds, applied via
    # Chat#with_thinking. With no options, RubyLLM chooses from the model's
    # registered controls. Accepts keywords or an options Hash. Pass +false+
    # to disable it. Passing +nil+ raises ArgumentError.
    #
    #   thinking
    #   thinking false
    #   thinking effort: :low
    #   thinking budget: 10_000
    #   thinking display: :summarized
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:291
    def thinking(enabled = T.unsafe(nil), **options); end

    # Sets how chats this agent builds use their tools, applied via
    # Chat#with_tool_options. Accepts +choice:+, +calls:+, +concurrency:+,
    # and +rounds:+. A block defers evaluation until the chat is built.
    # Called with no arguments, returns the configured options.
    #
    #   tool_options choice: :required, calls: :one
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:202
    def tool_options(**options, &block); end

    # Declares the tools for chats this agent builds. A block defers
    # construction until the chat is built. Configure how the model uses
    # them with ::tool_options. Called with no arguments, returns the
    # declared tools.
    #
    #   tools SearchDocs, LookupAccount
    #   tools { [TodoTool.new(chat: chat)] }
    #
    # Pass +defer:+ as Chat#with_tools takes it, or a lambda that decides
    # when the chat is built:
    #
    #   tools SearchDocs, LookupAccount, defer: true
    #   tools(defer: -> { many_tools? }) { connected_tools }
    #
    # With +defer:+ alone it applies to the tools a parent agent declared.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:160
    def tools(*tools, defer: T.unsafe(nil), &block); end

