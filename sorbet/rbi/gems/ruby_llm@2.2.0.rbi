# Provider-managed file storage APIs.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:8
class RubyLLM::Protocols::Files < ::RubyLLM::Protocol
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:30
  def download(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:25
  def find(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:38
  def list_uris(_uri); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:9
  def rejected_options(operation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:14
  def upload(file, filename: T.unsafe(nil), purpose: T.unsafe(nil), expires_in: T.unsafe(nil), uri: T.unsafe(nil), content_type: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:52
  def download_file_url(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:81
  def file_attachment(file, filename: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:93
  def file_content_type(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:79
  def file_headers(_request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:48
  def file_info_url(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:88
  def file_part(attachment, content_type: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:97
  def file_part_source(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:129
  def file_size(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:44
  def files_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:73
  def parse_upload_response(data, _attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:65
  def render_upload_fields(_attachment, **); end

  # The file part goes last: OpenAI can misread a field sent after a large
  # file part, rejecting a valid purpose as "user_data\r", and xAI requires
  # its fields to arrive before the file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:59
  def render_upload_payload(attachment, purpose: T.unsafe(nil), expires_in: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:107
  def timestamp(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:69
  def upload_file_field; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:77
  def upload_headers(_request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:115
  def uploaded_file(data, **attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/files.rb:119
  def with_file_body(attachment, &); end
end

