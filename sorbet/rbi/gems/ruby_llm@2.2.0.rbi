# How a protocol carries Tool.namespace. A namespace the API has no
# native form for is folded into the function name,
# <tt>namespace_name</tt>, and the calls that come back under that name
# are mapped back onto the namespace and the tool's own name.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:9
module RubyLLM::Protocol::ToolNamespaces
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:38
  def complete(messages, tools:, **options, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:46
  def count_tokens(messages, tools:, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:27
  def native_tool_namespace?(_namespace); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:42
  def render(messages, tools:, **); end

  # Returns whether +call+ came back under a namespace the API's own tool
  # search put a deferred function in, rather than one +tools+ declare.
  # Protocols whose tool search does that override this.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:34
  def searched_tool_namespace?(_call, _tools); end

  # Returns the error a call answers with when an earlier call of its
  # namespace in the same response failed, or +nil+ when the API runs
  # each call on its own. Protocols whose client toolsets run a
  # response's calls in order and stop at the first failure override
  # this.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:23
  def skipped_tool_call_error(_tool_call); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:77
  def flatten_message(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:83
  def flatten_tool_call(call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:52
  def flatten_tools(tools); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:73
  def flattened?(tool_or_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:93
  def rebuild_tool_call(call, name:, namespace:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:89
  def restore_tool_call(call, tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:62
  def restore_tool_namespace(call, tools); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:56
  def restore_tool_namespaces(message, tools); end

  class << self
    # Raises for a forced tool choice that names a namespaced tool, for
    # protocols whose tool choice cannot name one.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/tool_namespaces.rb:12
    def validate_tool_choice(tools, choice); end
  end
end

