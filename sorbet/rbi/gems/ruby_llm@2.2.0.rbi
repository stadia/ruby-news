# Streaming methods of the OpenAI Responses API. Events are semantic:
# each SSE data frame carries a `type` describing what changed.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:8
module RubyLLM::Protocols::Responses::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:64
  def build_annotation_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:21
  def build_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:106
  def build_content_part_added_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:146
  def build_final_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:126
  def build_function_call_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:96
  def build_item_added_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:118
  def build_item_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:88
  def build_reasoning_summary_part_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:50
  def build_text_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:54
  def build_text_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:186
  def chunk(content: T.unsafe(nil), **attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:84
  def citation_content_position(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:74
  def citation_markers(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:137
  def completed_function_call_arguments(arguments); end

  # OpenAI reports a stream error as a flat event carrying a code. Azure
  # nests the code and type under an error object, as a failed response
  # and Chat Completions do.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:171
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:163
  def raise_failed_response(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:179
  def stream_error(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:79
  def stream_remainder; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:13
  def stream_response(*, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:58
  def text_content_chunk(data, content); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:64
    def build_annotation_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:21
    def build_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:106
    def build_content_part_added_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:146
