  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:22
  def embedding_url(model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:26
  def ensure_no_embedding_media!(with); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:68
  def parse_embedding(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:46
  def parse_single_embedding_responses(responses, model:, text:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:54
  def record_embedding_attempt(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:16
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:40
  def single_embedding_attachment(attachments, label); end
end

