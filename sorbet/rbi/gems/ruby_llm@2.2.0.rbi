# Tools methods for the Gemini API implementation
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:10
module RubyLLM::Protocols::Gemini::Tools
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:68
  def parse_tool_calls(data); end

  # Gemini signs only the first of parallel calls, so each call goes back
  # with its own signature or none, never one another part carried.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:27
  def render_tool_call(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:47
  def render_tool_result(msg, function_name = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:17
  def render_tools(tools); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:150
  def build_tool_config(tool_choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:161
  def forced_tool_choice?(tool_choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:134
  def function_declaration_for(tool); end

  # Neither the model listing nor the registry distinguishes a Gemini
  # generation, so the id is the only signal available. The -latest
  # aliases always track the newest release.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:125
  def multimodal_function_responses_supported?(model); end

  # functionResponse.parts only accepts inline bytes, and pre-Gemini 3 models reject it
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:113
  def partition_tool_result_attachments(attachments); end

  # Gemini 3 refuses a step of the current turn whose first function
  # call carries no signature.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:99
  def sign_step(parts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:165
  def specific_tool_choice?(tool_choice); end

  # Vertex refuses text parts beside a functionResponse, so text files
  # travel inside its response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/tools.rb:108
  def split_text_attachments(attachments); end
end

