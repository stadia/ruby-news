# Model catalog for ElevenLabs. GET v1/models returns a bare array of
# the speech synthesis models and leaves out the Scribe transcription
# models, so those are appended from the published catalog.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/elevenlabs/models.rb:9
module RubyLLM::Protocols::ElevenLabs::Models
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/elevenlabs/models.rb:32
  def build_model(model_id, slug, name: T.unsafe(nil), description: T.unsafe(nil), data: T.unsafe(nil), transcription: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/elevenlabs/models.rb:54
