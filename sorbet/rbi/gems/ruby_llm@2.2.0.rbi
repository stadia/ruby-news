  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:36
  def declarations(definition); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:29
  def for(definition, arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:52
  def property_declarations(properties, path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:44
  def schema_declarations(schema, path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:60
  def unreachable_schemas(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:19
  def valid?(definition); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:40
  def valid_declaration?(path, header, schema); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:73
    def argument_at(arguments, path); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:36
    def declarations(definition); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:29
    def for(definition, arguments); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:52
    def property_declarations(properties, path); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:44
    def schema_declarations(schema, path); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:60
    def unreachable_schemas(schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:19
    def valid?(definition); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/param_headers.rb:40
    def valid_declaration?(path, header, schema); end
  end
end

