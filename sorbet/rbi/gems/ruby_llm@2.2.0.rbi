# Meta's dialect of the OpenAI Responses API, the format Meta
# recommends because it replays encrypted reasoning across turns.
# https://dev.meta.ai/docs/protocols/responses
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:9
class RubyLLM::Providers::Meta::Responses < ::RubyLLM::Protocols::Responses
  include ::RubyLLM::Protocols::Responses::TokenCounting
  include ::RubyLLM::Protocols::Meta::Transcription

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:32
  def apply_end_user(payload, identifier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:50
  def cache_option_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:24
  def document_urls?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:52
  def inject_cache_breakpoint(item); end

  # Meta takes a cache key and a retention hint, in_memory or 24h,
  # and no cache breakpoints.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:38
  def prompt_cache_params(caching); end

  # Meta's fetcher is refused by many hosts, so remote media travels inline.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:64
  def render_attachment(attachment); end

  # Meta refuses to fetch many remote images, so images travel inline.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:75
  def render_image(image, image_url: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:20
  def server_tool_aliases; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:56
  def supported_attachment?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:28
  def web_search_sources?; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/meta/responses.rb:18
RubyLLM::Providers::Meta::Responses::AUDIO_FORMATS = T.let(T.unsafe(nil), Array)

