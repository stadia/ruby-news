    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:50
    def models_dev_alias(*, **, &); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:58
    def models_dev_provider_ids; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:54
    def open_telemetry_name; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:46
    def resolve_registry_id(model_id, models, config = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:36
