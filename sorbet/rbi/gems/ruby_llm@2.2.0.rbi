RubyLLM::Protocols::Converse::Chat::FINISH_REASONS = T.let(T.unsafe(nil), Hash)

# Bedrock accepts at most four cache points in one request, and
# Converse takes them only for Claude and Nova models; Nova takes none
# in toolConfig.tools. See "Supported models, Regions, and explicit
# caching limits" in
# https://docs.aws.amazon.com/bedrock/latest/userguide/prompt-caching.html
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:23
RubyLLM::Protocols::Converse::Chat::MAX_CACHE_POINTS = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:32
RubyLLM::Protocols::Converse::Chat::OFFICE_DOCUMENT_FORMATS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:17
RubyLLM::Protocols::Converse::Chat::PROMPT_CACHE_OPTIONS = T.let(T.unsafe(nil), Array)

# Bedrock forwards an S3 source to other models untranslated, and
# Claude rejects it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:31
RubyLLM::Protocols::Converse::Chat::S3_SOURCE_MODELS = T.let(T.unsafe(nil), Array)

# Converse refuses searchResult blocks from every model but Claude, so an
# application inference profile, which doesn't name its model, gets text.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:28
RubyLLM::Protocols::Converse::Chat::SEARCH_RESULT_MODELS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:25
RubyLLM::Protocols::Converse::Chat::TOOL_CACHE_POINT_MODELS = T.let(T.unsafe(nil), Array)

