  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:68
  def shape_instructions(text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:158
  def shape_length(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:178
  def shape_list(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:106
  def shape_media(kind, source:, size: T.unsafe(nil), unit: T.unsafe(nil), mime_type: T.unsafe(nil), signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:127
  def shape_media_kind(mime_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:154
  def shape_name(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:102
  def shape_other(name, signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:45
  def shape_request(turns, payload:, instructions: T.unsafe(nil), tool_names: T.unsafe(nil), thinking_settings: T.unsafe(nil), pairing: T.unsafe(nil), rules: T.unsafe(nil)); end

  # Thinking settings are short words and numbers, such as an effort or
  # a budget, so anything else is left out rather than risk content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:143
  def shape_settings(settings, *names); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:150
  def shape_signature?(signature); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:76
  def shape_summary(summary, signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:72
  def shape_text(text, kind: T.unsafe(nil), signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:82
  def shape_tool_call(name, arguments, id: T.unsafe(nil), signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:136
  def shape_tool_name(tool); end

  # A result made of content blocks counts the characters of its text,
  # and its other blocks, such as images, follow it as parts of their
  # own. The block reads one content block in the protocol's format.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:90
  def shape_tool_result(content, name: T.unsafe(nil), id: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:58
  def shape_turn(index, role, speaker, parts); end

  # A URL field can hold a data URI instead of a link.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes.rb:120
  def shape_url(url, kind: T.unsafe(nil), mime_type: T.unsafe(nil)); end
end

# Finds what a provider would refuse in the turns a protocol read: parts
# with no data, empty turns, tool rounds whose calls and results do not
# pair up, and results that answer no call, plus the rules a protocol
# opts into. +pairing+ is how the provider matches results to calls:
# +:id+, or +:position+, which compares tool names in order. The rules
# are +:signed_steps+, where the first call of each step in the current
# turn needs a signature; +:signed_thinking+, where every thinking part
# does; and +:alternating_roles+, where user and model turns alternate,
# starting with the user.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:15
class RubyLLM::Protocol::RequestShapes::Analysis
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:21
  def initialize(turns, pairing:, rules:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:28
  def kept_turns; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:48
  def problems; end

  # The request is the model call after every round of the current
  # turn, which starts after the last user turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:36
  def step; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:40
  def tool_rounds; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:184
  def counted(count, noun); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:111
  def empty_turns; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:98
  def ids?(part); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:60
  def last_user_turn; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:56
  def located_parts(turns = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:64
  def name_results; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:89
  def paired?(round); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:102
  def parts_without_data; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:180
  def problem(kind, message, turn:, part: T.unsafe(nil), call_id: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:166
  def roles_out_of_order; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:80
  def round(run, answers); end

  # Consecutive model turns make one round, answered by the results in
  # the turns that follow them up to the next model turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:76
  def rounds; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:85
  def runs(turns); end

  # The one place a shape shows an id: a result naming a call the
  # request never made can only be traced by the id it names.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:130
  def unmatched_results; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:115
  def unpaired_rounds; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:143
  def unsigned_calls; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/request_shapes/analysis.rb:156
  def unsigned_thinking; end
end

