RubyLLM::Protocols::Cohere::Tools::EMPTY_PARAMETERS_SCHEMA = T.let(T.unsafe(nil), Hash)

# Audio transcription methods for the Cohere v2 API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:7
module RubyLLM::Protocols::Cohere::Transcription
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:10
  def rejected_options(operation); end

  private

  # Cohere Transcribe returns the transcript alone: no timestamps,
  # segments, or speaker labels.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:33
  def parse_transcription_response(response, model:); end

  # Cohere parses the multipart body as it streams, so every form field
  # has to be written before the file part or the request is rejected as
  # missing them. The file goes in last, after provider options.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:23
  def render_transcription_payload(file_part, model:, language:, provider_options: T.unsafe(nil), temperature: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:16
  def transcription_url; end

  class << self
    # Cohere Transcribe returns the transcript alone: no timestamps,
    # segments, or speaker labels.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/transcription.rb:33
    def parse_transcription_response(response, model:); end

    # Cohere parses the multipart body as it streams, so every form field
