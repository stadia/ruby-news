# What a page did while it rendered, filed against the tags that did it.
#
# `Herb::Engine::InstrumentationVisitor` says which tag is rendering at any moment. It does not
# say what is worth noticing while one is, because that is not the engine's business: an
# application knows what it cares about, and Rails already announces most of it through
# `ActiveSupport::Notifications`.
#
# These are the three worth having in every application, so they are here rather than in each one:
# the queries a tag ran, what a render cost, and what a translation rendered. Each is a subscriber
# that observes, plus a measurement that says how to read what was observed. Either half can be
# turned off on its own.
#
#     ReActionView.configure do |config|
#       config.instrumentation = true
#       config.instrumentation.sql_queries = false
#     end
#
# pkg:gem/reactionview#lib/reactionview/instrumentation.rb:21
module ReActionView::Instrumentation
  class << self
    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:30
    def available?; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:38
    def install!(config = T.unsafe(nil)); end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:91
    def install_render_times; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:75
    def install_sql_queries; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:110
    def install_translations; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:54
    def installed?; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:121
    def render_description(renders); end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:58
    def reset!; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:139
    def session; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:65
    def subscriptions; end

    # pkg:gem/reactionview#lib/reactionview/instrumentation.rb:69
    def visitor(config = T.unsafe(nil)); end
  end
end

