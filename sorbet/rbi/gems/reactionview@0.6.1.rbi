  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:49
  def candidates(name, from: T.unsafe(nil)); end

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:59
  def identifier_for(path); end

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:38
  def resolve(name, from: T.unsafe(nil), format: T.unsafe(nil)); end

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:54
  def similar(name, from: T.unsafe(nil), limit: T.unsafe(nil)); end

  private

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:85
  def project_path; end

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:66
  def resolvers; end

  # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:78
  def roots(dependencies); end

  class << self
    # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:22
    def current; end

    # pkg:gem/reactionview#lib/reactionview/template/partial_resolver.rb:27
    def reset!; end
  end
end

