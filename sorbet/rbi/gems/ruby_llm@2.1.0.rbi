  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:31
  def mime_type; end

  # The resource's name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:22
  def name; end

  # Writes the content to +path+, expanding it first. Returns +path+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:65
  def save(path); end

  # A human-readable title, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:25
  def title; end

  # Returns the resource as an Attachment, which is how chats take it
  # through +with:+.
