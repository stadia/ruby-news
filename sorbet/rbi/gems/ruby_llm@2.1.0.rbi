# A Video is a generated clip. Save it with #save or read the raw bytes
# with #to_blob. Both handle hosted URLs and inline data.
#
#   video = RubyLLM.animate("a paper boat sailing down a rainy gutter")
#   video.save("boat.mp4")
#
# pkg:gem/ruby_llm#lib/ruby_llm/video.rb:10
class RubyLLM::Video
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:98
  def initialize(url: T.unsafe(nil), data: T.unsafe(nil), mime_type: T.unsafe(nil), model: T.unsafe(nil), duration: T.unsafe(nil), raw: T.unsafe(nil)); end

  # Set by the protocol that generated the video, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:94
  def config; end

  # Set by the protocol that generated the video, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:92
  def config=(_arg0); end

  # The raw video bytes, returned inline or downloaded with the
  # provider's credentials, or +nil+ when the video is hosted at #url.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:18
  def data; end

  # The clip length in seconds, when the provider reports one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:27
  def duration; end

  # The MIME type of the video, such as <tt>"video/mp4"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:21
  def mime_type; end

  # The id of the model that generated the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:24
  def model; end

  # The provider's raw job response, for provider-specific fields such
  # as reported cost.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:31
  def raw; end

  # Writes the binary video to +path+, expanding it first. Returns
  # +path+ as given.
  #
  #   video.save("clip.mp4")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:121
  def save(path); end

  # Returns the raw binary video bytes, downloading from #url when the
  # provider returned a hosted video.
  #
  #   video_bytes = video.to_blob
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:112
  def to_blob; end

  # The URL of the hosted video, for providers that return one, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:14
  def url; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:128
  def inspect_attributes; end

  class << self
    # Generates a video from +prompt+, blocks until the provider finishes
    # rendering it, and returns a Video. Most code calls this through
    # RubyLLM.animate. Video generation is asynchronous on every provider,
    # so this submits a job with VideoJob.animate_later and polls until it
    # is done, honoring <tt>config.video_generation_timeout</tt> and
    # <tt>config.video_generation_poll_interval</tt>.
    #
    # +model:+ selects the video model and defaults to the configured
    # +default_video_model+. +provider:+ forces a specific provider, and
    # +assume_model_exists:+ skips the registry lookup. +with:+ passes a
    # reference image or a video to edit on models that support it. Models
    # driven by image and audio input can omit the prompt and pass both
    # attachments through +with:+.
    # +extend:+ continues a source video instead. It accepts a Video,
    # file path, URL, or Attachment and cannot be combined with +with:+.
    # +provider_options:+ takes options in the provider's request
    # vocabulary, such as durations and resolutions, and merges them into
    # the request as-is. +context:+ supplies a Context whose configuration
    # replaces the global one. +metadata:+ is included in the
    # instrumentation payload. +owner:+ attributes the usage to a record,
    # such as a user, and wins over RubyLLM.with_usage_owner.
    #
    #   video = RubyLLM.animate("a hummingbird in slow motion", model: "veo-3.1-fast-generate-preview")
    #
    #   RubyLLM.animate(
    #     "Make the waterfall crash down",
    #     model: "grok-imagine-video-1.5",
    #     with: "waterfall.png",
    #     provider_options: { duration: 5 }
    #   )
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/video.rb:64
    def animate(prompt = T.unsafe(nil), model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil), extend: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end
  end
end

# A VideoJob is an in-flight video generation. RubyLLM.animate_later
# returns one immediately; poll it with #refresh and read the finished
# clip with #video. RubyLLM.animate runs the same job through #wait.
#
#   job = RubyLLM.animate_later("a paper boat sailing down a gutter")
#   job.wait
#   job.video.save("boat.mp4")
#
# pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:12
class RubyLLM::VideoJob
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:82
  def initialize(id:, protocol:, model: T.unsafe(nil), status: T.unsafe(nil), raw: T.unsafe(nil), error: T.unsafe(nil), reported_cost: T.unsafe(nil), duration: T.unsafe(nil), resolution: T.unsafe(nil)); end

  # Returns +true+ when the job finished with a video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:108
  def completed?; end

  # Returns the Cost the provider reported for the job. Its total is
  # +nil+ while the job is pending or when the provider reports no
  # price.
  #
  #   job.wait
  #   job.cost.total # => 0.05
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:139
  def cost; end

  # Returns +true+ once the job finished, successfully or not.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:103
  def done?; end

  # The clip length in seconds the request asked for, or +nil+ when it
  # left the length to the provider's default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:32
  def duration; end

  # The provider's failure message when #failed?, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:25
  def error; end

  # Returns +true+ when the job finished without a video. #error carries
  # the provider's failure message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:114
  def failed?; end

  # The provider's id for the job.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:16
  def id; end

  # The id of the model rendering the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:22
  def model; end

  # Returns +true+ while the provider is still rendering the video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:98
  def pending?; end

  # The provider's raw response from the last submit or poll.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:28
  def raw; end

  # Re-fetches the job from the provider, updating #status, #error, and
  # #raw. Does nothing once the job is #done?. Returns self.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:120
  def refresh; end

  # The resolution the request asked for, as the provider spells it,
  # such as <tt>"720p"</tt> or <tt>"1280x720"</tt>, or +nil+ when it left
  # the resolution to the provider's default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:37
  def resolution; end

  # The job state: +:pending+, +:completed+, or +:failed+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:19
  def status; end

  # Returns the finished Video, downloading it from the provider when
  # its API requires that. Returns +nil+ while #pending? and raises
  # Error when #failed?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:167
  def video; end

  # Polls the job until it finishes, then returns self. Raises Error
  # when the job fails or +timeout+ elapses first. +timeout+ and
  # +interval+ are seconds and default to the configured
  # +video_generation_timeout+ and +video_generation_poll_interval+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:147
  def wait(timeout: T.unsafe(nil), interval: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:189
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:185
  def monotonic_time; end

  # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:176
  def record_usage; end

  class << self
    # Submits a video generation job and returns a VideoJob without
    # waiting for the result. Most code calls this through
    # RubyLLM.animate_later. Takes the same arguments as Video.animate.
    # The job records its usage, attributed to +owner:+ or the owner of
    # RubyLLM.with_usage_owner, once it finishes.
    #
    #   job = RubyLLM.animate_later("a hummingbird in slow motion")
    #   job.id      # => "0eb6910f-a353-4699-9d1e-6a4f7a5b39e2"
    #   job.done?   # => false
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/video_job.rb:49
    def animate_later(prompt = T.unsafe(nil), model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil), extend: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end
  end
end

# Adds workflow and step context to RubyLLM instrumentation while leaving
# orchestration in ordinary Ruby code.
#
# Create workflows through RubyLLM.workflow rather than constructing this
# class directly:
#
#   RubyLLM.workflow("Write article", id: "article-42") do |workflow|
#     notes = workflow.step("Research") { ResearchAgent.new.ask(topic).content }
#     workflow.step("Draft") { WriterAgent.new.ask(notes).content }
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:15
class RubyLLM::Workflow
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:22
  def initialize(name, id: T.unsafe(nil), metadata: T.unsafe(nil), config: T.unsafe(nil)); end

  # Returns the workflow identifier shared by its instrumentation events.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:17
  def id; end

  # Returns the workflow name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:20
  def name; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:29
  def run; end

  # Runs a named section of Ruby code and adds its identity to every RubyLLM
  # event emitted by the block. An ID is generated when one is not supplied.
  # Steps can contain regular Ruby control flow and may be nested.
  # Returns the block's result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:42
  def step(name, id: T.unsafe(nil), &block); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:79
  def current_step_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:67
  def link_parent; end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:84
  def normalize(value, attribute); end

  # pkg:gem/ruby_llm#lib/ruby_llm/workflow.rb:59
  def workflow_context; end
end
