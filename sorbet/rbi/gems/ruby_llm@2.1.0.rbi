  # does not offer.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:540
  def tools; end

  # Returns the version the server reports for itself, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:694
  def version; end

