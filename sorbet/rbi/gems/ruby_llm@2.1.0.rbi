  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:117
  def deep_stringify_keys(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:132
  def deep_symbolize_keys(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:15
  def hash_get(hash, key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:85
  def iso_date_prefix_to_utc_midnight_string(value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:67
