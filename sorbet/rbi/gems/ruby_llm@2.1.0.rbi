# formats a message
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:386
class RubyLLM::Protocols::Gemini::Chat::MessageFormatter
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:387
  def initialize(provider, messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:395
  def format; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:459
  def build_standard_message(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:449
  def build_tool_response(parts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:423
  def collect_tool_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:415
  def current_message; end

  # Gemini checks signatures only in the current turn, which starts at
  # the last user message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:471
  def current_turn?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:475
  def format_tool_result(message, tool_name); end

  # functionResponse parts carry no call id, so Gemini pairs them with
  # the functionCall parts by position. Results that arrived out of
  # call order have to be put back in it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:442
  def in_call_order(tool_messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:453
  def remember_tool_calls; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:419
  def tool_message?(message); end
end

