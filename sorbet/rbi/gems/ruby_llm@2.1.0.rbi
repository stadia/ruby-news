# Tracks the physical transport attempts belonging to one operation.
#
# pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:151
class RubyLLM::Accounting::Usage::Tracker
  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:166
  def initialize(operation:, provider:, model:, config:, on_finish: T.unsafe(nil), model_id: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:164
  def entries; end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:199
  def fail_attempt(entry, error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:206
  def fail_pending(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:185
  def observe(chunk); end

  # Keeps the usage a response reported for the current attempt, so an
  # attempt that fails after the provider answered, such as a blocked
  # one, still records what it billed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:192
  def observe_tokens(tokens); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:177
  def start; end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:210
  def succeed(result); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:232
  def succeed_attempts(tokens:); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:285
  def attach_to_result(result); end

  # A request that never reached the provider, or that the provider
  # refused before running it, cannot have been billed; possibly-billed
  # failures keep their usage unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:251
  def failure_tokens(entry, error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:268
  def finish(entry, status:, tokens:, **details); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:258
  def never_sent?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:262
  def refused?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/accounting/usage.rb:240
  def result_model(result); end
end

