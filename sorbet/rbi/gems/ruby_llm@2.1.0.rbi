end

# A Part describes one piece of a turn by its kind and size, never by
# its content.
#
#   part.kind    # => :tool_call
#   part.name    # => "find_tasks"
#   part.size    # => 42
#   part.unit    # => :chars
#   part.signed? # => true
#   part.to_s    # => "call find_tasks (args 42 chars), signed"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:15
class RubyLLM::RequestShape::Part
  include ::RubyLLM::Support::Inspectable

  # Creates a part. Every attribute but +kind+ is optional. A +size+
  # counts characters unless +unit+ says +:bytes+; pass +signed: true+
  # when the piece carries a thinking signature.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:54
  def initialize(kind:, size: T.unsafe(nil), unit: T.unsafe(nil), name: T.unsafe(nil), source: T.unsafe(nil), mime_type: T.unsafe(nil), signed: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:90
  def inspect_attributes; end

  # The kind of piece: +:text+, +:thinking+, +:image+, +:audio+,
  # +:video+, +:document+, +:tool_call+, +:tool_result+, or +:other+
  # for a piece RubyLLM does not classify, such as a provider tool step.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:24
  def kind; end

  # The MIME type of media, as the request gives it or as its format
  # implies, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:49
  def mime_type; end

  # The tool's name for a tool call, and for a tool result the name of
  # the call it answers, which is +nil+ when no call in the request
  # matches it. For an +:other+ piece, the provider's name for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:40
  def name; end

  # Returns whether the piece carries a thinking signature, the token a
  # provider issues to verify replayed thinking or tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:66
  def signed?; end

  # The size of the piece as the request sends it, in #unit: the
  # characters of text, thinking, tool call arguments, and a tool
  # result's text, or of its JSON when it is structured data, and the
  # bytes of inline media. Media inside a tool result follows it as
  # parts of its own. Returns +nil+ when there is nothing to measure,
  # such as media sent by URL or thinking the provider encrypted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:32
  def size; end

  # Where media comes from: +:inline+ for bytes in the request, +:url+
  # for a link the provider fetches, or +:file+ for a file stored with
  # the provider. Returns +nil+ for pieces that are not media.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:45
  def source; end

  # Returns the part as a Hash, with its size under its unit, omitting
  # attributes it does not have.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:84
  def to_h; end

  # Returns the part in words, with its size and unit:
  #
  #   text (13 chars)
  #   image/png (34512 bytes)
  #   document (url)
  #   result find_tasks (6859 chars)
  #   thinking (no text), signed
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:78
  def to_s; end

  # The unit of #size: +:chars+ or +:bytes+, or +nil+ without a size.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:35
  def unit; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:96
  def description; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:105
  def measured; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:110
  def missing; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/part.rb:18
RubyLLM::RequestShape::Part::TEXT_KINDS = T.let(T.unsafe(nil), Array)

# A Problem is something in a request that providers are known to
# reject, found by the protocol that rendered it: a part with no data, a
# tool round whose calls and results do not pair up, a step that lacks
# the signature the provider requires, or roles out of order.
#
#   problem.kind    # => :part_without_data
#   problem.turn    # => 3
#   problem.part    # => 0
#   problem.to_s    # => "problem at #3, part 0: thinking part carries no data"
#
# pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:15
class RubyLLM::RequestShape::Problem
  include ::RubyLLM::Support::Inspectable

