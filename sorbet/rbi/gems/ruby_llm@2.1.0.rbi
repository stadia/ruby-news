# OAuth for one MCP server and one owner, following the 2026-07-28
# authorization spec: protected resource metadata, authorization server
# discovery, client ID metadata documents or dynamic registration when no
# client is configured, PKCE, resource indicators, issuer checks, and
# token refresh. Credentials live in the configured
# +mcp_credential_store+, keyed by owner and server.
#
# Two grants need no user to authorize: the client credentials grant
# of the OAuth Client Credentials extension, and the JWT bearer grant
# (RFC 7523 section 2.1). The latter presents a token the workload's
# platform issued (Workload Identity Federation) or an identity
# assertion grant the user's identity provider issued for their ID
# token (Enterprise-Managed Authorization). As the extensions' flows
# describe, a token is requested once the server rejects a request
# without one, and again before it expires. Pre-registered clients
# authenticate with their secret or with a private_key_jwt assertion
# (RFC 7523 section 2.2) addressed to the authorization server's
# issuer.
#
# A server that requires DPoP-bound tokens (RFC 9449) gets them: new
# tokens are bound to a key kept with them in the credentials, and
# every token request and server request carries a fresh proof with
# the nonce the server last supplied.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:32
class RubyLLM::MCP::OAuth
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:100
  def initialize(server_url, owner:, scopes: T.unsafe(nil), client_id: T.unsafe(nil), client_secret: T.unsafe(nil), grant: T.unsafe(nil), private_key: T.unsafe(nil), assertion: T.unsafe(nil), identity_provider: T.unsafe(nil), config: T.unsafe(nil), resolve: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:120
  def access_token; end

  # Returns the headers that authorize a +verb+ request to the server:
  # none without a token, and a proof of possession with a bound one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:129
  def authorization_headers(verb = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:173
  def authorization_url(redirect_uri:, challenge: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:192
  def authorize(params); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:116
  def authorized?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:200
  def deauthorize; end

  # Answers the server's rejection of a request, given its challenge,
  # its DPoP nonce, and the ways the request +recovered+ before. Returns
  # how to send it again, +:nonce+ with the nonce in its proof or
  # +:token+ with a new token, or +nil+ when it is not worth sending
  # again.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:142
  def recover(challenge, nonce: T.unsafe(nil), recovered: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:157
  def refresh; end

  # Keeps the DPoP nonce the server supplied with a response for the
  # next proof (RFC 9449 section 9).
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:153
  def remember_nonce(nonce); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:389
  def authenticate(client, server, form, headers, key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:234
  def authorization_code?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:425
  def authorization_server; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:501
  def authorization_server_metadata(issuer); end

  # RFC 6749 section 2.3.1: the client ID and secret are form-encoded
  # before they become the user and password of Basic authentication.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:406
  def basic_credentials(client_id, client_secret); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:284
  def binding_key; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:577
  def challenged(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:330
  def check_callback(pending, params); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:339
  def check_issuer(pending, issuer); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:344
  def check_state(pending, state); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:467
  def checked_resource(resource); end

  # RFC 7523bis section 4: the issuer is the sole audience, so no other
  # authorization server can replay the assertion, and the explicit
  # type tells servers the client follows that rule.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:413
  def client_assertion(key, client_id, server); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:514
  def client_for(server, redirect_uri); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:625
  def connection(url); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:478
  def covers?(resource, server); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:207
  def credential; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:435
  def described_authorization_server(metadata); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:486
  def discover_authorization_server(issuer); end

  # RFC 9449 section 7.1 and RFC 9728 section 2: a server requires
  # DPoP-bound tokens when it challenges with the DPoP scheme and not
  # Bearer, or when its metadata says so.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:279
  def dpop_required?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:630
  def endpoint(url); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:230
  def expiring?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:585
  def first_json(urls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:384
  def forget_registration(client); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:594
  def get_json(url); end

  # Assertions are resolved for every token, since workload platforms
  # rotate the tokens they issue and ID tokens expire.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:300
  def grant_parameters(server, scope); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:267
  def granting_client(server); end

  # Exchanges the user's ID token at the identity provider for an
  # Identity Assertion JWT Authorization Grant addressed to the
  # server's authorization server (enterprise-managed authorization,
  # section 4). Only that grant is forwarded: any other token the
  # identity provider returns is the user's credential there.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:314
  def identity_assertion(server, scope); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:351
  def issuer_required?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:647
  def key; end

  # Servers from the 2025-03-26 revision publish no protected resource
  # metadata: their own origin is the authorization server, with default
  # endpoints when it publishes no metadata either.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:458
  def legacy_authorization_server; end

  # RFC 9449 section 9: a server that wants a nonce in proofs answers
  # with use_dpop_nonce and the nonce to use.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:290
  def nonce_requested?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:380
  def oauth_error(error); end

  # Requests a token with the configured grant, unless another worker
  # has replaced the one the server rejected. Failures raise
  # UnauthorizedError: Client falls back to the older handshake on an
  # MCP::Error, which would ask the authorization server again.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:250
  def obtain; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:573
  def offline_access?(server); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:619
  def parse(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:598
  def post(url, body, headers); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:525
  def preregistered_client(server); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:294
  def proofs; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:445
  def protected_resource_metadata; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:607
  def refusal(url, response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:537
  def register(server, redirect_uri); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:556
  def registered_for?(registered, requested); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:560
  def registration_key(issuer, redirect_uri); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:238
  def renew; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:242
  def renewed?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:581
  def resource; end

  # RFC 3986 section 6.2.3: an empty path and "/" name the same resource.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:510
  def same_issuer?(one, other); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:474
  def same_origin?(url, server); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:564
  def scopes_for(server); end

  # RFC 9449 section 8: an authorization server that wants a nonce in
  # the proof answers use_dpop_nonce once with the nonce to use. Every
  # attempt signs a new proof and a new client assertion.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:367
  def send_token_request(server, client, key, params, retried: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:421
  def signing_key; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:643
  def store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:220
  def store_tokens(tokens, client: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:216
  def synchronize(&block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:355
  def token_request(grant_type, client: T.unsafe(nil), key: T.unsafe(nil), **params); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:639
  def value(params, name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:211
  def write(data); end

  class << self
    # Reads the challenges of a WWW-Authenticate header (RFC 9110
    # section 11.6.1) into their parameters, keyed by lowercase scheme.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:85
    def challenge(header); end

    # Returns the authorization extensions that the options of MCP.oauth
    # use, as client capabilities declare them, so servers that require
    # an extension know the client follows it.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:68
    def extensions(settings); end

    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:61
    def memory_store; end

    # Runs the block while no other thread in this process refreshes the
    # credentials stored under +key+.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth.rb:79
    def refreshing(key, &); end
  end
end

