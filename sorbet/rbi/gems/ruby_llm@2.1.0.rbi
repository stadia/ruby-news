  def to_blob; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:29
  def inspect_attributes; end
end

# An Embedding is the result of turning text into numerical vectors.
# RubyLLM.embed returns one:
#
#   embedding = RubyLLM.embed("Ruby is a programmer's best friend")
#   embedding.vectors # => [0.018, -0.027, ...]
#
# Pass an array to embed several texts in one call on supported models:
#
#   RubyLLM.embed(["Ruby", "Rails"]).vectors # => [[...], [...]]
#
# Store the vectors for similarity search. #tokens and #cost report
# usage when the provider supplies it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:17
class RubyLLM::Embedding
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:35
  def initialize(vectors:, model:, sparse_vectors: T.unsafe(nil), input_tokens: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # Returns the embedding cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:51
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:162
  def inspect_attributes; end

  # The id of the model that produced the vectors, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:33
  def model; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:59
  def model_info; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:57
  def model_info=(_arg0); end

  # The sparse vectors, for models that return one beside the dense
  # vector, as a Hash mapping token id to weight. Shaped like #vectors:
  # one Hash for a single text, an array of them for an array of texts.
  # +nil+ on models that return only dense vectors.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:30
  def sparse_vectors; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:44
  def tokens; end

  # The embedding vectors. A flat array of floats when a single text
  # was embedded, an array of such arrays when an array of texts was
  # embedded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:24
  def vectors; end

  class << self
    # Generates embeddings for +text+ and returns an Embedding. +text+
    # may be a single string or, on supported models, an array of strings.
    # An array produces one vector per string in a single API call.
    #
    #   RubyLLM.embed "Ruby is a programmer's best friend"
    #   RubyLLM.embed ["Ruby", "Python", "JavaScript"]
    #   RubyLLM.embed "This is a test sentence",
    #                 model: "text-embedding-3-large",
    #                 dimensions: 512
    #   RubyLLM.embed "RubyLLM makes provider APIs feel native to Ruby.",
    #                 model: "gemini-embedding-001",
    #                 provider: :vertexai,
    #                 task_type: "RETRIEVAL_DOCUMENT",
    #                 title: "RubyLLM docs"
    #   RubyLLM.embed "The Ruby logo",
    #                 model: "gemini-embedding-2",
    #                 with: "logo.png"
    #
    # +model:+ selects the embedding model and defaults to the
    # configured +default_embedding_model+. +provider:+ forces a specific
    # provider, and <tt>assume_model_exists: true</tt> skips the model
    # registry check. +context:+ supplies a Context whose configuration
    # is used instead of the global one. +dimensions:+ requests a
    # specific vector size on models that support it. +task_type:+ names
    # the embedding task in the provider's own vocabulary: Vertex AI and
    # Gemini take values such as <tt>"RETRIEVAL_QUERY"</tt> or
    # <tt>"RETRIEVAL_DOCUMENT"</tt>, while Bedrock Cohere takes an input
    # type such as <tt>"search_document"</tt>. +title:+ labels the
    # document on Vertex AI and Gemini retrieval tasks. Providers that
    # have no task concept ignore both. +with:+ passes one or more media
    # attachments (images, audio, video, PDFs) to embed alongside the
    # text on multimodal embedding models such as Gemini's
    # gemini-embedding-2; providers without multimodal embeddings raise
    # UnsupportedAttachmentError. +provider_options:+ takes options
    # in the provider's request vocabulary and merges them into the
    # request as-is. +metadata:+ is not sent to the provider; it is
    # attached to the emitted +embedding.ruby_llm+ instrumentation event.
    # +owner:+ attributes the usage to a record, such as a user, and wins
    # over RubyLLM.with_usage_owner.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:104
    def embed(text, model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), dimensions: T.unsafe(nil), task_type: T.unsafe(nil), title: T.unsafe(nil), with: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), owner: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:158
    def embedding_count(vectors); end

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:153
    def vector_dimensions(vectors); end
  end
end

# An EmbeddingRequest is an embedding awaiting a provider-side batch.
# RubyLLM.embed_later stages one; submit an array of them with
# RubyLLM.batch, and once the batch completes, collecting the results
# fills in #result:
#
#   requests = texts.map { |text| RubyLLM.embed_later(text) }
#   batch = RubyLLM.batch(requests)
#   # later, once batch.refresh.complete?
#   batch.results
#   requests.first.result.vectors
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:15
class RubyLLM::EmbeddingRequest
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:35
  def initialize(text, model: T.unsafe(nil), provider: T.unsafe(nil), dimensions: T.unsafe(nil), context: T.unsafe(nil)); end

  # The requested vector size, or +nil+ for the model's default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:25
  def dimensions; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:49
  def inspect_attributes; end

  # The Model of the embedding model the request targets.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:22
  def model; end

  # The Provider the request will be submitted through.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:28
  def provider; end

  # Returns the request payload this embedding request would send to the
  # provider, in the provider's wire format.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:45
  def render; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result=(_arg0); end

  # The text staged for embedding.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:19
  def text; end
end

# Error is the base class for provider-operation errors raised by
# RubyLLM, including API, network, capability, and provider response-shape
# failures. When an HTTP response is available, it wraps that response and
# normalizes the message across providers. When the provider refuses a
# conversation, #request_shape describes what it was sent. Subclasses map
# common HTTP status codes: BadRequestError (400), UnauthorizedError (401),
# PaymentRequiredError (402), ForbiddenError (403), RateLimitError (429),
# ServerError (500), ServiceUnavailableError (502 to 504), and
# OverloadedError (529).
#
#   begin
#     RubyLLM.chat.ask "Translate 'hello' to French."
#   rescue RubyLLM::RateLimitError
#     puts "Rate limit hit. Please wait a moment."
#   rescue RubyLLM::Error => e
#     puts "API error: #{e.message}"
#     puts e.response&.status
#   end
#
# Local setup and programming errors, such as ConfigurationError and
# ModelNotFoundError, inherit from StandardError directly and are not
# caught by rescuing Error.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:26
class RubyLLM::Error < ::StandardError
  # Creates an error with +message+. Pass +response:+ to attach the HTTP
  # response; its body supplies the message when +message+ is +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:44
  def initialize(message = T.unsafe(nil), response: T.unsafe(nil)); end

  # The payload request_protocol rendered for the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:36
  def request_payload; end

  # The payload request_protocol rendered for the request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:36
  def request_payload=(_arg0); end

  # The Protocol that rendered the request the error answered, which
  # reads its payload back for #request_shape.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:33
  def request_protocol; end

  # The Protocol that rendered the request the error answered, which
  # reads its payload back for #request_shape.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:33
  def request_protocol=(_arg0); end

  # Returns a RequestShape describing the conversation request the error
  # answered: each turn's parts and their sizes, never their contents,
  # and the problems providers are known to refuse. Returns +nil+ for
  # errors raised before a request goes out, such as an unsupported
  # attachment, and for operations that send no conversation, such as
  # embeddings.
  #
  #   rescue RubyLLM::BadRequestError => e
  #     Rails.logger.error("#{e.message}\n#{e.request_shape}")
  #     Rails.error.report(e, context: { request_shape: e.request_shape&.to_h })
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:60
  def request_shape; end

  # The HTTP response that caused the error, or +nil+ when none is
  # available. Its +status+ and +body+ carry the provider's reply.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:29
  def response; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:38
    def default_message; end
  end
end

# Defines reusable evaluations with a dataset, semantic criteria, and Ruby assertions.
# Datasets default to app/evals/<class_name>.yml, .yaml, .json, or .jsonl.
# Without declared criteria, evaluates correctness against each case's expected_output.
#
#   class SupportEvaluation < RubyLLM::Evaluation
#     def perform(input)
#       SupportAgent.new.ask(input)
#     end
#   end
#
#   SupportEvaluation.run.save("tmp/support.json")
#
# pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:15
class RubyLLM::Evaluation
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:280
  def assertion_context; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:284
  def assertion_count; end

  # Runs Ruby assertions after perform. Override to use assert, refute, and the Minitest assertion family.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:204
  def assertions; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:275
  def execute; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:194
  def expected_output; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:194
  def input; end

  # Returns retained messages from a Chat, Agent, or Message result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:218
  def messages; end

  # Returns the current case's input, reference output, and metadata, respectively.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:194
  def metadata; end

  # :stopdoc:
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:255
  def method_missing(name, *, **, &); end

  # Returns the primary answer or value extracted from result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:213
  def output; end

  # Runs the application under evaluation. Override in your evaluation class.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:199
  def perform(_input); end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:269
  def prepare(test_case); end

  # Returns the original value returned by perform.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:196
  def result; end

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:265
  def run_case(test_case, repetition, groups, run_id:); end

  # Runs before perform on each fresh case instance. Override for application fixtures.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:207
  def setup; end

  # Runs after each case, even when setup, perform, or an assertion fails.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:210
  def teardown; end

  # Returns tool calls recorded in the returned conversation or message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:223
  def tool_calls; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:261
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end

  class << self
    # Converts a custom result into evaluation evidence. The original stays available as result.
    #
    #   adapt Invoice do |invoice|
    #     invoice.attributes.slice("total", "currency")
    #   end
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:74
    def adapt(type, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:128
    def adapters; end

    # Returns the dataset cases without running the application or its evaluators.
    # Supply only to select one or more case names, raising when any name is missing.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:82
    def cases(dataset: T.unsafe(nil), only: T.unsafe(nil)); end

    # Sets the dataset path, enumerable of cases, or block returning cases.
    # With no argument, returns the configured source. The default is discovered by class name.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:30
    def dataset(source = T.unsafe(nil), &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:124
    def definitions; end

    # Declares a semantic criterion. A minimum applies to a native probability or score;
    # without one, numeric decisions are measured but do not count as passes.
    # Omit instructions to set a minimum on a question already defined by a Judge.
    # Declared criteria replace implicit correctness. Use evaluation :correctness
    # without instructions to include the built-in reference comparison explicitly.
    # Supply evaluator to override the class evaluator for this criterion.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:58
    def evaluation(name, instructions = T.unsafe(nil), minimum: T.unsafe(nil), evaluator: T.unsafe(nil)); end

    # Sets the default evaluator: a model, Agent class, or Judge class.
    # Model keywords accept provider, protocol, and context as Chat does.
    # Without a declaration, uses the default chat model and built-in reviewer.
    # Pass false to disable model grading and run only Ruby assertions.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:42
    def evaluator(target = T.unsafe(nil), **options); end

    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:20
    def inherited(subclass); end

    # Executes fresh instances for every case and repetition and returns an Evaluation::Report.
    # A supplied dataset overrides discovery for this run. Configuration errors raise;
    # task, assertion, and evaluator failures are recorded per case.
    # Yields each completed Trial before starting the next. Exceptions from the block propagate.
    # Supply id to correlate reports and instrumentation with an application record or job.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/evaluation.rb:98
    def run(dataset: T.unsafe(nil), only: T.unsafe(nil), repetitions: T.unsafe(nil), id: T.unsafe(nil)); end

