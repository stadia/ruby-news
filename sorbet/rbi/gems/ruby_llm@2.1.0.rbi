  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:194
  def answers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:254
  def custom_headers(verb); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:218
