    # pkg:gem/ruby_llm#lib/ruby_llm/providers/ollama_cloud.rb:23
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/ollama_cloud.rb:27
    def configuration_requirements; end
  end
end

