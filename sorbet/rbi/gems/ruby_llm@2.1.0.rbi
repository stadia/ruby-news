  # Acronym-aware underscoring: 'HTTPProxyTool' -> 'http_proxy_tool'.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:27
  def underscore(name); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:100
    def deep_dup(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:90
    def deep_merge(original, overrides); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:117
    def deep_stringify_keys(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:132
    def deep_symbolize_keys(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:15
    def hash_get(hash, key); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:85
    def iso_date_prefix_to_utc_midnight_string(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:67
    def parse_iso_date_prefix(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:51
    def safe_constantize(name); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:20
    def strip_schema_metadata(schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:45
    def to_date(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:31
    def to_safe_array(item); end

    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:39
    def to_time(value); end

    # Acronym-aware underscoring: 'HTTPProxyTool' -> 'http_proxy_tool'.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:27
    def underscore(name); end
  end
end

# Keys a JSON Schema document carries for its own sake: $schema names the
# dialect and title names the document, neither of which describes the shape
# a provider is being asked to produce.
#
# pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:11
RubyLLM::Support::Utils::SCHEMA_METADATA_KEYS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/support/utils.rb:6
RubyLLM::Support::Utils::UNDERSCORE_BOUNDARY = T.let(T.unsafe(nil), Regexp)

# A Thinking holds the reasoning output a provider returned alongside a
# response. Instances appear on Message#thinking, and on Chunk#thinking
# while streaming, when the model exposes its thinking.
#
#   chat = RubyLLM.chat(model: 'claude-opus-5').with_thinking(display: :summarized)
#   response = chat.ask "What is 15 * 23?"
#   response.thinking&.text
#   response.thinking&.signature
#
# pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:13
class RubyLLM::Thinking
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:23
  def initialize(text: T.unsafe(nil), signature: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:37
  def inspect_attributes; end

  # The provider's opaque signature or encrypted reasoning payload for the
  # thinking block, or +nil+. Shown as redacted in pretty-print output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:21
  def signature; end

  # The reasoning text the provider returned, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:17
  def text; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:28
    def build(text: T.unsafe(nil), signature: T.unsafe(nil)); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:110
class RubyLLM::Thinking::Config
  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:121
  def initialize(effort: T.unsafe(nil), budget: T.unsafe(nil), display: T.unsafe(nil), enabled: T.unsafe(nil), intent: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:111
  def budget; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:133
  def disabled?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:111
  def display; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:111
  def effort; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:111
  def enabled; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:129
  def enabled?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:137
  def resolve(model); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:149
  def resolution_error(model); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:113
    def default; end

    # pkg:gem/ruby_llm#lib/ruby_llm/thinking.rb:117
    def disabled; end
  end
end

