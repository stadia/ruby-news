# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle/responses.rb:10
class RubyLLM::Providers::Bedrock::Mantle::Responses < ::RubyLLM::Protocols::Responses
  include ::RubyLLM::Providers::Bedrock::Mantle

