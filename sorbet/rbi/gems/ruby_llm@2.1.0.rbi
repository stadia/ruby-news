# The AWS InvokeModel API, where the envelope is shared but each model
# family owns its request and response body. Subclasses under
# Protocols::InvokeModel implement one family each. Requests are signed
# by the provider, which knows the credentials and the signing service.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:9
class RubyLLM::Protocols::InvokeModel < ::RubyLLM::Protocol
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:43
  def deep_merge_provider_options(payload, provider_options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:39
  def embedding_attempt_tokens(responses); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:18
  def embedding_url(model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:22
  def ensure_no_embedding_media!(with); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:49
  def extract_embedding(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:27
  def parse_single_embedding_responses(responses, model:, text:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:35
  def record_embedding_attempt(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:12
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end
end

