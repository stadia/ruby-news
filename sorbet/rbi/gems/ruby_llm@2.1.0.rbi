#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:9
module RubyLLM::Protocols::Anthropic::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:110
  def append_stream_text(block, key, text); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:35
  def build_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:146
  def extract_citations_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:140
  def extract_content_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:61
  def extract_server_tool_use(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:159
  def extract_signature_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:153
  def extract_thinking_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:115
  def finalize_stream_block(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:165
  def json_delta?(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:123
  def parse_stream_block_input(json, block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:169
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:79
  def reset_stream_blocks; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:129
  def stream_end_fields(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:25
