#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:7
module RubyLLM::Protocols::ChatCompletions::Transcription
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:88
  def build_streamed_transcription(chunks, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:76
  def build_transcription_chunk(data); end

  # Diarization models return plain text with no segments unless the
  # response format asks for them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:57
  def default_response_format(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:43
  def encode_speaker_references(references); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:118
  def parse_transcription_response(response, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:14
  def render_transcription_options(timestamps:, format:, streaming:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:28
