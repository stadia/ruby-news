    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:34
    def format_attachment(attachment, used_document_names:, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:85
    def format_audio_attachment(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:24
    def format_content(content, attachments = T.unsafe(nil), used_document_names: T.unsafe(nil), citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:119
    def format_document_attachment(attachment, used_document_names:, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:74
    def format_image_attachment(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:151
    def format_provider_file_attachment(attachment, used_document_names:, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:115
    def format_text_attachment(attachment); end

    # Text attachments become citable documents when citations are
    # enabled. Bedrock rejects text-format documents sent as bytes when
    # citations are on, so the text rides in the source's text member.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:139
    def format_text_document_attachment(attachment, used_document_names:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:96
    def format_video_attachment(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:107
    def media_format(attachment, aliases, supported); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:176
    def sanitize_document_name(filename); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:10
    def supported_attachment?(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:168
    def supported_document_format?(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:182
    def unique_document_name(base_name, used_names); end
  end
end

