  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:41
  def format_content(content, attachments = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:106
