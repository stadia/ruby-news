    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:28
    def render_transcription_payload(file_part, model:, language:, format: T.unsafe(nil), speaker_names: T.unsafe(nil), speaker_references: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil), temperature: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:51
    def reported_cost(_usage); end

    # OpenAI streams transcriptions as server-sent events carrying text
    # deltas, completed segments on diarization models, and a final
    # event with the whole transcript and its usage.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:64
    def stream_transcription(payload, model:, &block); end

    # Diarization models stream segments instead of deltas, so the
    # transcript is rebuilt from whichever the provider sent.
    #
