  def to_s; end

  # The index of the turn that made the calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:19
  def turn; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/tool_round.rb:59
  def counted(count, noun); end
end

# A Turn describes one entry of a request's conversation: a message, or
