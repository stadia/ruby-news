  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:88
  def format_thinking(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:113
  def inject_cache_control(content, caching: T.unsafe(nil), ttl: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:29
  def log_ignored_compaction_options(compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:149
