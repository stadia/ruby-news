  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:151
  def gap_line(turn, following); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:138
  def list_line(label, items); end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:156
  def problem_lines; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:142
  def settings_line; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:128
  def step_description; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:123
  def summary_line; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape.rb:146
