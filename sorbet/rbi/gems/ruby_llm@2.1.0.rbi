# pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:5
module RubyLLM::Chat::ToolConcurrency
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:98
  def capture_result(index, tool_call, caller_context, execute); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:79
  def collect_results(queue, count, on_result:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:123
  def execution_context; end

  # Rails gives a thread, and a fiber under fiber isolation, execution
  # state of its own: the block runs as its own unit of work, so its
  # connections return to the pool. A fiber sharing the caller's state
  # must not start one, whose completion resets the caller's Current
  # attributes. Unlike wrap, run! reports no errors: they reach the
  # caller, whose own executor reports what nothing rescues.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:111
  def isolated(caller_context); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:127
  def rails_executor; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:11
  def run(mode, tool_calls, on_result: T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:42
  def run_with_fibers(tool_calls, on_result:, &execute); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:20
  def run_with_threads(tool_calls, on_result:, &execute); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:11
    def run(mode, tool_calls, on_result: T.unsafe(nil), &); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:98
    def capture_result(index, tool_call, caller_context, execute); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:79
    def collect_results(queue, count, on_result:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:123
    def execution_context; end

    # Rails gives a thread, and a fiber under fiber isolation, execution
    # state of its own: the block runs as its own unit of work, so its
    # connections return to the pool. A fiber sharing the caller's state
    # must not start one, whose completion resets the caller's Current
    # attributes. Unlike wrap, run! reports no errors: they reach the
    # caller, whose own executor reports what nothing rescues.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:111
    def isolated(caller_context); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:127
    def rails_executor; end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:42
    def run_with_fibers(tool_calls, on_result:, &execute); end

    # pkg:gem/ruby_llm#lib/ruby_llm/chat/tool_concurrency.rb:20
    def run_with_threads(tool_calls, on_result:, &execute); end
  end
end

