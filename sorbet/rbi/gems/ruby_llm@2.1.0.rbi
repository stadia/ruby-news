# Reasoning request fields for Bedrock Converse, whose shape depends on
# the model family.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:10
module RubyLLM::Protocols::Converse::Reasoning
  private

  # Claude generations that take an effort but no budget only think
  # adaptively, and reject a reasoning_config that enables a budget.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:53
  def adaptive_thinking?(thinking, model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:36
  def between_tools_off?(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:30
  def disabled_reasoning_fields(model); end

  # Models that take a budget reject reasoning_effort, so effort has to become a budget.
  # Bedrock names the levels of an enumerated budget after the efforts they stand for;
  # otherwise the effort spans the range the schema allows.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:156
  def effort_budget_tokens(effort, schema, max_output_tokens); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:166
  def enumerated_budget(effort, schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:62
  def format_adaptive_reasoning_fields(thinking); end

  # Models that publish a reasoning_config enum, such as OpenAI's GPT
  # models, take the effort as its value and reject reasoning_effort.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:45
  def format_effort_fields(effort, model); end

  # Nova 2 takes reasoningConfig with an effort level instead of a token budget,
  # and rejects an enabled reasoningConfig that names no effort.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:88
  def format_nova_reasoning_fields(thinking, model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:17
  def format_reasoning_fields(thinking, model, max_output_tokens = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:82
  def nova_model?(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:141
  def published_schema(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:172
  def ranged_budget(effort, schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:104
  def reasoning_budget(thinking, effort, model, max_output_tokens); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:112
  def reasoning_budget_schema(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:116
  def reasoning_config_schema(model); end

  # Inference profile ARNs and unlisted regional ids carry no reasoning
  # options of their own, so use another entry for the same model.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:72
  def registered_model(model); end

  # Bedrock only publishes Converse metadata for some regional entries, so use the
  # schema from another entry for the same foundation model when needed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:125
  def request_fields_schema(model, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:185
  def unknown_effort_message(effort, schema); end

  class << self
    # Claude generations that take an effort but no budget only think
    # adaptively, and reject a reasoning_config that enables a budget.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:53
    def adaptive_thinking?(thinking, model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:36
    def between_tools_off?(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:30
    def disabled_reasoning_fields(model); end

    # Models that take a budget reject reasoning_effort, so effort has to become a budget.
    # Bedrock names the levels of an enumerated budget after the efforts they stand for;
    # otherwise the effort spans the range the schema allows.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:156
    def effort_budget_tokens(effort, schema, max_output_tokens); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:166
    def enumerated_budget(effort, schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:62
    def format_adaptive_reasoning_fields(thinking); end

    # Models that publish a reasoning_config enum, such as OpenAI's GPT
    # models, take the effort as its value and reject reasoning_effort.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:45
    def format_effort_fields(effort, model); end

    # Nova 2 takes reasoningConfig with an effort level instead of a token budget,
    # and rejects an enabled reasoningConfig that names no effort.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:88
    def format_nova_reasoning_fields(thinking, model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:17
    def format_reasoning_fields(thinking, model, max_output_tokens = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:82
    def nova_model?(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:141
    def published_schema(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:172
    def ranged_budget(effort, schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:104
    def reasoning_budget(thinking, effort, model, max_output_tokens); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:112
    def reasoning_budget_schema(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:116
    def reasoning_config_schema(model); end

    # Inference profile ARNs and unlisted regional ids carry no reasoning
    # options of their own, so use another entry for the same model.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:72
    def registered_model(model); end

    # Bedrock only publishes Converse metadata for some regional entries, so use the
    # schema from another entry for the same foundation model when needed.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:125
    def request_fields_schema(model, &); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:185
    def unknown_effort_message(effort, schema); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:12
RubyLLM::Protocols::Converse::Reasoning::MINIMUM_BUDGET_TOKENS = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:13
RubyLLM::Protocols::Converse::Reasoning::NOVA_DEFAULT_REASONING_EFFORT = T.let(T.unsafe(nil), String)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/reasoning.rb:11
RubyLLM::Protocols::Converse::Reasoning::RANGED_EFFORTS = T.let(T.unsafe(nil), Array)

# Describes Converse requests, and the token counting requests that
# wrap them, as RequestShape objects. A content block is a union keyed
# by its kind, and media names a format instead of a MIME type.
# Converse wants user and assistant messages to alternate, pairs tool
# results with uses by id, and takes reasoning back only with its
# signature.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:12
module RubyLLM::Protocols::Converse::RequestShapes
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:15
  def parse_request_shape(payload); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:40
  def shape_converse_block(block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:36
  def shape_converse_blocks(blocks); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:64
  def shape_converse_media(kind, media); end

  # A format can name a container that holds either sound or video,
  # such as mp4, so its MIME type counts only when it agrees.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:75
  def shape_converse_mime_type(kind, format); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:55
  def shape_converse_reasoning(reasoning); end

  # Each model family takes its reasoning settings in a field of its
  # own, and some name an effort with a bare reasoning_config.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:88
  def shape_converse_thinking(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:82
  def shape_converse_tool_name(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:31
  def shape_converse_turn(message, index); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/request_shapes.rb:13
RubyLLM::Protocols::Converse::RequestShapes::MEDIA_KINDS = T.let(T.unsafe(nil), Hash)

# Nova 2 models execute built-in tools server-side when the request
# names them as system tools.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:16
RubyLLM::Protocols::Converse::SERVER_TOOL_ALIASES = T.let(T.unsafe(nil), Hash)

# Streaming implementation for Bedrock ConverseStream (AWS Event Stream).
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:11
module RubyLLM::Protocols::Converse::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:184
  def build_chunk(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:152
  def decode_error_frame(headers); end

  # ConverseStream delivers modeled errors as a frame after the 200, with
  # the type in the frame headers and a bare message as the payload. Rewrap
  # it under the exception name so raise_stream_error classifies it instead
  # of the frame passing for an empty chunk.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:135
  def decode_event(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:171
  def decode_event_payload(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:111
  def decode_events(decoder, raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:411
  def event_block_index(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:166
  def event_header(headers, name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:51
  def event_stream_decoder; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:221
  def event_usage(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:237
  def extract_cache_read_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:241
  def extract_cache_write_tokens(metadata_usage, usage); end

  # The cited span itself streams as ordinary text deltas; the citation
  # delta carries the source. The final message resolves the span text
  # from the accumulated content when indices are known.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:283
  def extract_citations_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:276
  def extract_content_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:217
  def extract_finish_reason(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:228
  def extract_input_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:233
  def extract_output_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:245
  def extract_reasoning_tokens(metadata_usage, usage); end

  # Server-executed tool steps stream as typed toolUse and toolResult
  # block starts. Their input deltas are not function-call arguments,
  # so the block index is remembered and its deltas skipped.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:381
  def extract_server_tool_call_events(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:318
  def extract_signature_from_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:324
  def extract_signature_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:290
  def extract_thinking_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:301
  def extract_thinking_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:308
  def extract_thinking_signature(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:369
  def extract_tool_call_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:350
  def extract_tool_call_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:335
  def extract_tool_calls(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:71
  def failed_stream_buffer(env); end

  # The error body arrives in as many reads as the adapter hands out, so
  # it accumulates on the env, which ErrorMiddleware clears per attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:62
  def handle_failed_stream(chunk, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:88
  def handle_non_eventstream_error_chunk(raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:417
  def normalized_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:75
  def parse_stream_chunk(decoder, raw_chunk, accumulator, progress); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:253
  def raise_stream_error(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:102
  def raise_streaming_chunk_error(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:398
  def remember_server_tool_block(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:406
  def server_tool_block_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:249
  def stream_error_event?(event); end

  # Failures the API does not model arrive as an error frame instead,
  # with the code and message in the headers and nothing in the payload.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:148
  def stream_error_frame?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:159
  def stream_exception_type(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:20
  def stream_response(payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:16
  def stream_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:211
  def streamed_thinking_blocks(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:346
  def tool_call_delta_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:342
  def tool_call_start_event?(event); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
class RubyLLM::Protocols::Converse::Streaming::ErrorResponse < ::Struct
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
  def body; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
