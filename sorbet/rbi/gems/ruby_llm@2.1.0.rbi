# Google credentials shared by every Vertex AI provider in the process.
# googleauth keeps the access token on the credentials object and
# refreshes it a minute before it expires, so sharing the object shares
# the token.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:13
class RubyLLM::Providers::VertexAI::Credentials
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:34
  def initialize(service_account_key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:16
  def authorizer; end

  # One caller fetches an expiring token while the others wait for it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:40
  def headers; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:46
  def build(service_account_key); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:23
    def cache; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:18
    def for(config); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/credentials.rb:27
    def source(key); end
  end
end

