# The OpenAI file-backed Batch API: upload JSONL, create /batches,
# then read output/error files back in custom_id order.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:10
module RubyLLM::Protocols::OpenAI::Batches
  include ::RubyLLM::Batch::Helpers

  # Results are JSONL and may arrive out of order. Each line carries the
  # custom_id we assigned from the submission index.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:39
  def batch_results(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:33
  def cancel_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:16
  def create_batch(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:29
  def find_batch(id); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:82
  def batch_create_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:78
  def batch_endpoint; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:63
  def batch_jsonl(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:67
  def batch_request_line(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:86
  def batch_url(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:59
  def download_batch_file(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:90
  def parse_batch_response(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:113
  def parse_batch_result(line); end

