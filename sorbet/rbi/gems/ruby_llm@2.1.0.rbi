  # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/ocr.rb:16
  def render_ocr_payload(file, model:, pages: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/ocr.rb:24
    def ocr_document_part(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/ocr.rb:12
    def ocr_url; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/ocr.rb:34
    def parse_ocr_response(response, model:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/mistral/ocr.rb:16
