  # The id of the model that generated the audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/speech.rb:28
  def model; end

  # pkg:gem/ruby_llm#lib/ruby_llm/speech.rb:147
  def model_info; end

  # pkg:gem/ruby_llm#lib/ruby_llm/speech.rb:145
  def model_info=(_arg0); end

  # Writes the audio to +path+ in binary mode and returns +path+.
  #
  #   speech.save "welcome.mp3"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/speech.rb:157
  def save(path); end

  # Returns the raw audio bytes. Alias for #data, mirroring Image#to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/speech.rb:126
  def to_blob; end

