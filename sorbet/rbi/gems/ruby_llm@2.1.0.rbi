  def status=(_); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
    def [](*_arg0); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
    def inspect; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
    def keyword_init?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
    def members; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
    def new(*_arg0); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/thinking_stream.rb:8
class RubyLLM::Protocols::Converse::ThinkingStream
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/thinking_stream.rb:9
