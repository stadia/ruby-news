  # pkg:gem/ruby_llm#lib/ruby_llm/providers/ollama_cloud.rb:18
  def headers; end

  class << self
    # Returns +true+: Ollama retires cloud models faster than the
    # registry tracks them, so model ids are accepted as given. Call
