# Interprets a text/event-stream as the HTML standard describes, fed in
# whatever pieces the network delivers. Each dispatched event is yielded
# as its type, data, and last event ID. The last event ID and the
# reconnection time the server asked for stay readable between events.
#
# pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:9
class RubyLLM::Transport::EventStreamParser
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:19
  def initialize; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:32
  def feed(chunk, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:17
  def last_event_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:17
  def reconnection_time; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:48
  def compact; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:115
  def decode(bytes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:103
  def dispatch; end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:75
  def line_end(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:94
  def process_field(field, value); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:83
  def process_line(line, &); end

  # A carriage return that ended the previous piece may be the first
  # half of a CRLF pair.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:68
  def skip_line_feed_after_carriage_return; end

  # The stream decodes as UTF-8, which drops one byte order mark at its
  # very start, so the first bytes wait until they can be told apart.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/event_stream_parser.rb:58
  def start; end
end

