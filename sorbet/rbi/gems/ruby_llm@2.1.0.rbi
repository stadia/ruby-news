# Raised by a transport when the session of a server that predates
# 2026-07-28 has ended, so the client starts a new one: the server
# answered 404, or its stdio process exited.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/session_expired.rb:8
class RubyLLM::MCP::SessionExpired < ::RubyLLM::MCP::Error; end

# stdio. The server is a child process that reads one JSON-RPC message
# per line on stdin and writes one per line on stdout. Reads never block
# past the deadline, even on a partial line. It starts on the
# first request, restarts after it exits, and handles one request at a
# time. Its stderr is the parent's. A server that predates 2026-07-28
# keeps its session for the life of its process, so after a restart its
# requests raise SessionExpired until the client initializes it again.
#
# Subscriptions share the channel, so whichever thread reads a message
# that belongs to one hands it to the subscription's listener: a
# request waiting for its answer, or the listener itself while no
# request reads. A listener stops when CancelledError is raised in its
# thread, so it reads and writes with that deferred.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:21
class RubyLLM::MCP::Stdio
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:42
  def initialize(command, env: T.unsafe(nil), directory: T.unsafe(nil), timeout: T.unsafe(nil), config: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:65
  def cancel(notification, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:89
  def close; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:69
  def listen(message, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:60
  def notify(message, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:51
  def request(message, version: T.unsafe(nil), timeout: T.unsafe(nil), **, &); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:215
  def answer(request); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:155
  def await(id, timeout); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:95
  def check_session(version); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:125
  def drain; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:210
  def exited; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:139
  def handled?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:245
  def monotonic_now; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:241
  def name; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:191
  def next_line(deadline); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:181
  def parse(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:174
  def read(deadline); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:109
  def receive(subscription); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:147
  def route(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:219
  def start; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:225
  def stop; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:101
  def subscribe(subscription, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:234
  def terminate; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:151
  def uninterrupted(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/stdio.rb:165
  def write(message); end
end

