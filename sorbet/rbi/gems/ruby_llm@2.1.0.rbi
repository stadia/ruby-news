# ChatMethods provides the RubyLLM::Chat API on ActiveRecord models
# declared with <tt>acts_as_chat</tt>, persisting every message to the
# database. Configuration methods return +self+ so calls can be chained.
#
#   class Chat < ApplicationRecord
#     acts_as_chat
#   end
#
#   chat = Chat.create!(model: 'gpt-5.6-luna')
#   chat.ask "What is the capital of France?"
#   chat.messages.count # => 2
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:20
module RubyLLM::ActiveRecord::ChatMethods
  include ::ActiveSupport::ToJsonWithActiveSupportEncoder
  include ::Enumerable
  include ::RubyLLM::ActiveRecord::AttachmentHelpers
  extend ::ActiveSupport::Concern

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def add_completion(*args, **kwargs, &block); end

  # Persists +message_or_attributes+ as a message record, including any
  # attachments and tool calls. Accepts a RubyLLM::Message, an attributes
  # Hash, or a record responding to +to_llm+.
  # Returns the message record.
  #
  #   chat.add_message(role: :user, content: long_context)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:587
  def add_message(message_or_attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def after_fallback(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def after_message(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def after_tool_progress(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def after_tool_result(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def answer(*args, **kwargs, &block); end

  # Records approval for +tool_call+ (a ToolCall, a tool call record, or
  # an id) on the persisted tool call, so the next #complete executes it
  # from any process. Returns +self+.
  #
  #   chat.approve(params[:tool_call_id])
  #   CompleteJob.perform_later(chat.id)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:75
  def approve(tool_call); end

  # Persists +message+ as a user message, then runs the conversation loop
  # and returns the latest assistant RubyLLM::Message. The loop pauses
  # when #awaiting_approval? is true. Yields streaming chunks to a block.
  #
  #   chat.ask "What is the capital of France?"
  #   chat.ask "What's in this file?", with: "diagram.png"
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:653
  def ask(message = T.unsafe(nil), with: T.unsafe(nil), &); end

  # Persists +message+ as a user message without calling the model, so
  # #complete can run later. Returns +self+.
  #
  #   chat.ask_later "Summarize this document."
  #   chat.complete
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:666
  def ask_later(message = T.unsafe(nil), with: T.unsafe(nil)); end

  # When +true+, skips the model registry lookup so unregistered model ids
  # are accepted. Not persisted; set it again after reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:36
  def assume_model_exists; end

  # When +true+, skips the model registry lookup so unregistered model ids
  # are accepted. Not persisted; set it again after reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:36
  def assume_model_exists=(_arg0); end

  # Returns whether the conversation is waiting on tool calls that
  # require approval and have no recorded decision. See
  # RubyLLM::Chat#awaiting_approval?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:90
  def awaiting_approval?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def awaiting_input?(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def awaiting_tasks?(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def before_fallback(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def before_message(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def before_request(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def before_tool_call(*args, **kwargs, &block); end

  # Marks the latest persisted message as a prompt cache boundary, or the
  # latest in-memory message when none is persisted yet. Pass +ttl:+ to
  # give the boundary its own cache lifetime. Returns +self+.
  #
  #   chat.with_instructions('Reusable analysis prompt').cache_until_here
  #   chat.with_instructions('Reusable analysis prompt').cache_until_here(ttl: "1h")
  #
  # Raises ArgumentError if the chat has no messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:614
  def cache_until_here(ttl: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def caching(*args, **kwargs, &block); end

  # Requests cancellation of the current in-flight chat operation. The
  # request is persisted so a background job can observe it from another
  # process.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:51
  def cancel; end

  # Returns whether this record or its memoized in-memory chat has a
  # pending cancellation request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:64
  def cancelled?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def citations(*args, **kwargs, &block); end

  # Compacts the model context and persists its assistant Message without
  # deleting earlier messages. See RubyLLM::Chat#compact.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:688
  def compact; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def compaction(*args, **kwargs, &block); end

  # Runs the completion loop on the underlying chat, persisting each
  # message, and returns the latest RubyLLM::Message. Pauses when a tool
  # requires approval. When the API call fails, destroys the empty assistant
  # message and any orphaned tool results, then re-raises the error.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:726
  def complete(*, **, &); end

  # Returns whether the conversation has no pending work, neither a
  # response to generate nor tool calls to run. See
  # RubyLLM::Chat#complete?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:718
  def complete?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def concurrency(*args, **kwargs, &block); end

  # An optional RubyLLM::Context supplying per-chat configuration, used
  # when building the underlying chat. Not persisted; set it again after
  # reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:46
  def context; end

  # An optional RubyLLM::Context supplying per-chat configuration, used
  # when building the underlying chat. Not persisted; set it again after
  # reloading the record.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:46
  def context=(_arg0); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def convert_unsupported_attachments(*args, **kwargs, &block); end

  # Returns a RubyLLM::Cost aggregating every persisted usage entry,
  # including retries and attempts that did not produce a message.
  #
  #   chat.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:641
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def count_tokens(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:518
  def decline(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def deferred_tools(*args, **kwargs, &block); end

  # Records denial for +tool_call+ (a ToolCall, a tool call record, or
  # an id) on the persisted tool call. The next #complete appends a
  # structured denial result instead of executing the tool. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:83
  def deny(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def each(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def end_user(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def fallbacks(*args, **kwargs, &block); end

  # Makes a single generation attempt, persists the response, and returns it as a
  # RubyLLM::Message. Tool calls in the response are not executed. See
  # RubyLLM::Chat#generate.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:679
  def generate(*, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def headers(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def max_output_tokens(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:554
  def mcp(*args, **kwargs, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:110
  def messages_association; end

  # Sets the chat's model from an id, a RubyLLM::Model value, or the
  # associated internal model record.
  #
  #   chat.model = 'gpt-5.6-luna'
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/chat_methods.rb:119
  def model=(value); end

  # Returns the model id of the associated model record, or +nil+.
  #
  #   chat.model_id # => "gpt-5.6-luna"
  #
