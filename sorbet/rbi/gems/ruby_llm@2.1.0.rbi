RubyLLM::Protocols::Cohere::Transcription::DEFAULT_LANGUAGE = T.let(T.unsafe(nil), String)

# The AWS Bedrock Converse API. Requests are SigV4-signed by the provider.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:6
class RubyLLM::Protocols::Converse < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Converse::Chat
  include ::RubyLLM::Protocols::Converse::Media
  include ::RubyLLM::Protocols::Converse::RequestShapes
  include ::RubyLLM::Protocols::Converse::Streaming

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:22
  def server_tool_aliases; end

  private

  # Converse carries tools under toolConfig.tools rather than a
  # top-level tools array.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:30
  def merge_server_tool_entries(payload, entries); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:41
  def post_count_tokens(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:45
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse.rb:36
  def sync_response(payload, additional_headers = T.unsafe(nil)); end
end

# Bedrock Model Invocation Jobs for Converse payloads.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:7
module RubyLLM::Protocols::Converse::Batches
  include ::RubyLLM::Batch::Helpers
  include ::RubyLLM::Protocols::Bedrock::Batches

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:16
  def bedrock_batch_jsonl(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:12
  def bedrock_invocation_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:37
  def parse_bedrock_output(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:33
  def parse_bedrock_outputs(outputs, **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:41
  def parse_bedrock_record(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/batches.rb:22
  def validate_bedrock_batch_requests!(requests); end
end

