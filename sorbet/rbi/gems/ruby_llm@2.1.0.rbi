  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle/responses.rb:17
  def supports_provider_file_references?; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/mantle.rb:12
RubyLLM::Providers::Bedrock::Mantle::SIGNING_SERVICE = T.let(T.unsafe(nil), String)

