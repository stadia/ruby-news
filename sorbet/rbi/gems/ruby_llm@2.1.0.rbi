# Chat methods of the OpenAI Responses API
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:7
module RubyLLM::Protocols::Responses::Chat
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:8
  def completion_url; end

  private

  # OpenAI names the threshold compact_threshold and takes the entries
  # as a flat array, where Anthropic nests a trigger object under
  # context_management.edits. It writes the summary itself, so there is
  # nothing to steer with instructions and no pausing to opt into.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:89
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:227
  def build_prompt_cache_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:354
  def cache_breakpoint_parts(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:486
  def default_large_file_upload_threshold; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:416
  def empty_content?(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:437
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:381
  def format_assistant_items(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:255
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:312
  def format_conversation(messages, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:401
  def format_function_call_items(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:301
  def format_input(messages, caching: T.unsafe(nil)); end

  # The +instructions+ parameter is a plain string and cannot carry a
  # breakpoint marker or a file. When any system message needs one, every
  # system message rides along as an input item, so their order holds.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:294
  def format_instructions(messages, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:331
  def format_item(msg, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:412
  def format_output_content(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:393
  def format_reasoning_item(thinking); end

  # Function call outputs are text-only on the wire, so tool attachments
  # ride a user item spliced in right after the result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:363
  def format_tool_items(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:346
  def inject_cache_breakpoint(item); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:112
  def keep_raw_output?(output, server_tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:116
  def namespaced_call?(item); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:211
  def normalize_annotation(annotation); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:198
  def offset_citations(citations, offset, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:173
  def parse_annotations(annotations, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:154
  def parse_citations(data, output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:52
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:184
  def parse_file_citation(annotation, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:439
  def parse_finish_reason(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:462
  def parse_function_call_arguments(arguments, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:444
  def parse_function_calls(output, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:159
  def parse_output_citations(output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:422
  def parse_output_text(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:478
  def parse_reasoning_signature(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:470
  def parse_reasoning_summary(output); end

  # Output items beyond text, reasoning, and function calls record
  # provider-executed tool steps (web_search_call, code_interpreter_call,
  # and whatever OpenAI ships next). They are kept raw and replayed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:132
  def parse_server_tool_items(output); end

  # Searches are billed by tool_usage, not by the web_search_call items
  # in the output, which can each run several.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:276
  def parse_server_tool_use(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:259
  def parse_usage(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:120
  def portable_raw_content(message); end

