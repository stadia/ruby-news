  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:242
  def headers(message, version, session); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:152
  def listen_to_session(version:, &on_notification); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/http.rb:114
  def post(message, version:, timeout: T.unsafe(nil), params: T.unsafe(nil), connection: T.unsafe(nil), recovered: T.unsafe(nil), &on_notification); end

