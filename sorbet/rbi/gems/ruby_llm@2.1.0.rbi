  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:51
  def reported_cost(_usage); end

  # OpenAI streams transcriptions as server-sent events carrying text
  # deltas, completed segments on diarization models, and a final
  # event with the whole transcript and its usage.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:64
  def stream_transcription(payload, model:, &block); end

  # Diarization models stream segments instead of deltas, so the
  # transcript is rebuilt from whichever the provider sent.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:106
  def streamed_transcript_text(chunks); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:113
  def streamed_transcription_segments(chunks, data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:144
  def transcription_duration(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:137
  def transcription_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:10
  def transcription_url; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:88
    def build_streamed_transcription(chunks, model:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/transcription.rb:76
    def build_transcription_chunk(data); end

    # Diarization models return plain text with no segments unless the
