  def to_blob; end

  # The URI that identifies the resource on its server.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:19
  def uri; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/resource.rb:79
  def inspect_attributes; end
end

