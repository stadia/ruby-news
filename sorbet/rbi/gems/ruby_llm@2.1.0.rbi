# Perplexity's Agent API, a dialect of the Responses API. A request names
# either a preset, which bundles a model, search settings, and
# instructions, or a model in provider/model form. The retired Sonar
# model ids run the presets Perplexity recommends in their place.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:10
class RubyLLM::Protocols::Perplexity::Agent < ::RubyLLM::Protocols::Responses
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:20
  def completion_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:34
  def format_document(document); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:24
  def render_payload(messages, model:, max_output_tokens: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:38
  def supported_attachment?(attachment); end

  private

  # Perplexity sends each function call whole, without argument deltas,
  # and announces its own web searches as function calls whose items
  # finish as search_results. Only a finished function_call item is a
  # call for the application to run.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:86
  def build_item_added_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:90
  def build_item_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:44
  def default_max_output_tokens(model); end

  # Perplexity rejects its own search_results and fetch_url_results
  # items as input, so a replayed turn keeps only messages, reasoning,
  # and function calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:103
  def format_assistant_items(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:61
  def parse_citations(data, output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:76
  def parse_server_tool_use(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:69
  def parse_usage(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:48
  def preset_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/perplexity/agent.rb:110
  def supports_provider_file_references?; end
end

