# AWS Bedrock integration.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:6
class RubyLLM::Providers::Bedrock < ::RubyLLM::Provider
  include ::RubyLLM::Providers::Bedrock::Auth
  include ::RubyLLM::Providers::Bedrock::Models

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:53
  def initialize(config); end

  # Uploads are objects in the configured bucket, readable with any
  # credentials the bucket admits.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:93
  def account_identity; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:102
  def agent_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:106
  def agent_connection; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:87
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:132
  def batch_cost_multiplier(**); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:98
  def control_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:134
  def embedding_batch_protocol(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:203
  def ensure_configured!; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:120
  def guardrail_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:116
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:156
  def list_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:79
  def mantle_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:83
  def mantle_connection; end

  # Un-versioned ids such as anthropic.claude-sonnet-5 and
  # openai.gpt-oss-20b are served by the bedrock-mantle endpoint rather
  # than by Converse.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:75
  def mantle_model?(model_id); end

  # bedrock-mantle nests code, message, and type under "error" rather
  # than answering with a bare string.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:151
  def nested_error_message(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:141
  def parse_error(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:58
  def protocol_for(model, operation: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:110
  def rerank_model_arn(model_id); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:229
  def batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:244
  def bedrock_credentials_requirement; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:297
  def bedrock_model_id_pattern(prefix); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:240
  def bedrock_region; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:268
  def embedding_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:284
  def image_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:252
  def list_converse_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:256
  def list_mantle_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:261
  def mantle_protocol_for(model_id); end

  # Signs each attempt as it is sent, so a retry never replays a
  # signature that expired while the previous attempt waited.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:217
  def signed_connection(base_url, service: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:291
  def video_protocol_for(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:225
  def voxtral_transcription?(operation, model_id); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:31
    def between_tools_off?(model_id); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:39
    def cache_write_input_multiplier(model_id, ttl); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:27
    def capabilities; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:161
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:178
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:186
    def configured?(config); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:190
    def credentials_configured?(config); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:182
    def model_required?(operation:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:49
    def models_dev_alias(*, **, &); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:45
    def resolve_registry_id(model_id, models, config = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:35
    def thinking_off_control(model_id); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock.rb:198
    def credential_provider?(config); end
  end
end

