  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:34
  def azure_base_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:38
  def chat_endpoint(parts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:51
  def embeddings_endpoint(parts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:62
  def models_endpoint(parts); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/azure/chat_completions.rb:71
  def with_api_version(path, version); end
end

