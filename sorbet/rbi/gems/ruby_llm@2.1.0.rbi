end

# The Gemini Interactions API for conversations and hosted tools.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/interactions.rb:6
class RubyLLM::Protocols::Interactions < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Interactions::Chat
  include ::RubyLLM::Protocols::Interactions::Content
  include ::RubyLLM::Protocols::Interactions::RequestShapes
  include ::RubyLLM::Protocols::Interactions::Tools
  include ::RubyLLM::Protocols::Interactions::Streaming
  include ::RubyLLM::Protocols::Gemini::FileTranscription
  include ::RubyLLM::Protocols::Interactions::Transcription

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/interactions.rb:25
  def server_tool_aliases; end
end

