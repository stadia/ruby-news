# Keeps OAuth credentials in memory for the life of the process. Rails
# applications keep them in the database instead.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth/memory_store.rb:8
class RubyLLM::MCP::OAuth::MemoryStore
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth/memory_store.rb:9
  def initialize; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth/memory_store.rb:22
  def delete(key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth/memory_store.rb:14
  def read(key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/oauth/memory_store.rb:18
  def write(key, data, **); end
end

