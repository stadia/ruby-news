  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/attachment_helpers.rb:199
  def preloaded_records(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/attachment_helpers.rb:37
  def prepare_for_active_storage(attachments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/attachment_helpers.rb:232
  def stored_attachment(attachment, attachable); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/attachment_helpers.rb:250
  def uploaded_file?(attachable); end
end

