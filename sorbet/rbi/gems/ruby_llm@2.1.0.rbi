  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:104
  def raise_failed_response(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:120
  def stream_error(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:18
  def stream_response(*, **, &); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:54
    def build_annotation_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:23
