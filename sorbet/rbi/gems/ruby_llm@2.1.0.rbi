    def validate_thinking_options(enabled, options); end

    # pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:698
    def with_rails_chat_record(method_name, **kwargs); end
  end
end

# Chat methods that return the wrapped chat so calls can be chained there.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:73
RubyLLM::Agent::CHAINABLE_CHAT_DELEGATES = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:92
RubyLLM::Agent::COPIED_INHERITED_CONFIG = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:46
RubyLLM::Agent::DUPED_INHERITED_CONFIG = T.let(T.unsafe(nil), Hash)

# The chat operations an agent instance runs through its ::rescue_from
# handlers. Remaining delegated methods pass through untouched.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:70
RubyLLM::Agent::GUARDED_OPERATIONS = T.let(T.unsafe(nil), Array)

# Chat values and operations whose return values pass through unchanged.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:85
RubyLLM::Agent::PASSTHROUGH_CHAT_DELEGATES = T.let(T.unsafe(nil), Array)

# Simple value options: a class-level getter/setter macro whose value the
# agent forwards to the matching Chat#with_* when it builds its chat.
#
# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:63
RubyLLM::Agent::PASSTHROUGH_OPTIONS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:64
RubyLLM::Agent::THINKING_OPTIONS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/agent.rb:65
RubyLLM::Agent::UNRESOLVED_CONTEXT = T.let(T.unsafe(nil), Object)

# An Attachment is a file sent to the model alongside a message. The source
# can be a local path, an http(s) URL, an IO-like object, an ActiveStorage
# object, or a provider-managed UploadedFile. Chat#ask builds attachments
# for you from its +with:+ option:
#
#   chat.ask "What's in this image?", with: "ruby_conf.jpg"
#
# Build one explicitly to return a file from a Tool:
#
#   RubyLLM::Attachment.new(doc.download_path)
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:19
class RubyLLM::Attachment
  include ::RubyLLM::Support::Inspectable

  # Creates an attachment from +source+: a file path, URL, IO-like object,
  # ActiveStorage object, or UploadedFile. Derives the filename from the
  # source when +filename:+ is not given, then detects the MIME type.
  #
  #   RubyLLM::Attachment.new("diagram.png")
  #   RubyLLM::Attachment.new(StringIO.new(data), filename: "report.pdf")
  #
  # +resolution:+ asks the provider to spend more or fewer tokens on an
  # image, video, or PDF. +:original+ requests original image detail where
  # supported, or the highest available resolution. Providers without
  # the setting ignore it.
  #
  #   RubyLLM::Attachment.new("page-3.png", resolution: :ultra_high)
  #
  # +config:+ is the Configuration a URL source is downloaded with, and
  # defaults to the global one.
  #
  # Paths and URLs must be trusted and authorized by the application.
  # They can be read or fetched during construction to detect the MIME type.
  # Validate upload parameters before passing them here: an unchecked String
  # can access local files or internal network endpoints.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:99
  def initialize(source, filename: T.unsafe(nil), resolution: T.unsafe(nil), config: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:155
  def active_storage?; end

  # Returns whether the attachment is audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:215
  def audio?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:257
  def byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:113
  def config; end

  # Returns the raw bytes of the attachment, fetching or reading the source
  # on the first call. Text content is returned as UTF-8.
  #
  # Raises RubyLLM::Error if the attachment is a provider-managed file,
  # which has no local content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:164
  def content; end

  # Returns whether the attachment is a non-PDF, non-text document format
  # such as Word or Excel, judged by MIME type or file extension.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:237
  def document?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:174
  def encoded; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:243
  def extension; end

  # The filename given at construction or derived from the source.
  # May be +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:28
  def filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:178
  def for_llm; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:219
  def format; end

  # Returns whether the attachment is an image.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:205
  def image?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:151
  def io_like?; end

  # The detected MIME type string, such as <tt>"image/png"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:31
  def mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:147
  def path?; end

  # Returns whether the attachment is a PDF.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:231
  def pdf?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:121
  def provider_file?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:139
  def provider_file_id; end

  # Where uploads of this attachment outlive the process: an object that
  # responds to <tt>fetch(provider:, account:)</tt>,
  # <tt>store(upload, provider:, account:)</tt>, and
  # <tt>forget(id, provider:, account:)</tt>. The Rails integration sets
  # one for files kept in Active Storage.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:137
  def provider_file_store; end

  # Where uploads of this attachment outlive the process: an object that
  # responds to <tt>fetch(provider:, account:)</tt>,
  # <tt>store(upload, provider:, account:)</tt>, and
  # <tt>forget(id, provider:, account:)</tt>. The Rails integration sets
  # one for files kept in Active Storage.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:137
  def provider_file_store=(_arg0); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:143
  def provider_file_uri; end

  # Files this attachment has been auto-uploaded to, keyed by provider and
  # credentials. Kept on the attachment so request-time preprocessing
  # uploads once per account while history keeps the original source.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:128
  def provider_uploads; end

  # The requested media resolution: +:low+, +:medium+, +:high+,
  # +:ultra_high+, +:original+, or +nil+ for the provider default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:35
  def resolution; end

  # The underlying source: a URI, Pathname, IO-like object, ActiveStorage
  # object, or UploadedFile.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:24
  def source; end

  # Returns whether the attachment is textual, like source code or CSV.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:249
  def text?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:253
  def to_h; end

  # Returns the attachment category as a Symbol: +:image+, +:video+,
  # +:audio+, +:pdf+, +:text+, +:document+, or +:unknown+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:193
  def type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:117
  def url?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:187
  def url_or_data_uri; end

  # Returns whether the attachment is a video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:210
  def video?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:395
  def active_storage_blob; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:274
  def active_storage_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:387
  def active_storage_content_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:291
  def content_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:263
  def data_uri; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:320
  def determine_mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:383
  def extract_filename_from_active_storage; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:373
  def extract_filename_from_io; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:331
  def fetch_content; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:267
  def file_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:408
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:279
  def io_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:297
  def load_content; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:345
  def load_content_from_active_storage; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:340
  def load_content_from_io; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:336
  def load_content_from_path; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:287
  def loaded_byte_size; end

  # Text content is loaded as binary; retag it so payloads serialize as UTF-8.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:313
  def normalize_text_encoding; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:391
  def provider_file_mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:359
  def source_filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:403
  def source_is_a?(class_name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:349
  def source_type_cast; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:73
    def from_h(data, config: T.unsafe(nil)); end

    # :startdoc:
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:55
    def wrap(sources, config: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:63
    def coerce(source, config:); end
  end
end

# :stopdoc:
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:47
RubyLLM::Attachment::ACTIVE_STORAGE_CLASS_NAMES = T.let(T.unsafe(nil), Array)

# File extensions recognized as document attachments when the MIME type
# alone is inconclusive.
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:42
RubyLLM::Attachment::DOCUMENT_EXTENSIONS = T.let(T.unsafe(nil), Array)

# Media resolutions accepted by +resolution:+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:38
RubyLLM::Attachment::RESOLUTIONS = T.let(T.unsafe(nil), Array)

# Raised for HTTP 400 responses when the request is invalid.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:130
class RubyLLM::BadRequestError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:131
    def default_message; end
  end
end

# A Batch is a provider-side batch of requests: chats awaiting a
# response (or texts awaiting embeddings) go in together, answers come
# back at batch prices, typically within hours. Persist the id, pick the
# batch back up from any process, and collect the results once
# processing ends.
#
#   chats = documents.map do |doc|
#     RubyLLM.chat(model: "claude-haiku-4-5").ask_later(doc.text)
#   end
#   batch = RubyLLM.batch(chats)
#   batch.id                # => "msgbatch_01EhcDuvb5XfWqcdJArbsfNX"
#   batch.refresh.complete? # => false, check back later
#   batch.messages          # the responses, in submission order
#
# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:18
class RubyLLM::Batch
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:170
  def initialize(provider:, chats: T.unsafe(nil), requests: T.unsafe(nil), batch_protocol: T.unsafe(nil), store: T.unsafe(nil), **attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:186
  def batch_protocol; end

  # Asks the provider to cancel the batch and applies the new state.
  # Requests already processed still return results. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:223
  def cancel; end

  # Returns whether the provider cancelled the batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:209
  def cancelled?; end

  # The submitted Chat objects in order, or +nil+ when the batch was
  # loaded by id via ::find or holds embedding requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:41
  def chats; end

  # Returns whether the batch has finished processing, as of the last
  # state fetched from the provider. Never contacts the provider; poll
  # with #refresh.
  #
  #   sleep 60 until batch.refresh.complete?
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:194
  def complete?; end

  # Returns a Cost for the batch. Uses the provider's reported total when
  # available, otherwise aggregates collected response costs at batch rates.
  # The total is +nil+ until the batch ends or when pricing is unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:259
  def cost; end

  # Returns whether the provider failed or expired the batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:204
  def failed?; end

  # The provider's batch id. Persist it to load the batch again later
  # from any process with ::find.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:25
  def id; end

  # Returns the answers in submission order, +nil+ where a request
  # failed. In a chat batch the answers are Messages, each also appended
  # to its chat; in an embeddings batch they are Embeddings, each also
  # hydrated into its request's EmbeddingRequest#result. Fetches results
  # from the provider; cached once #complete? is true, so collecting
  # early keeps reading fresh.
  #
  #   batch.messages.each do |message|
  #     puts message.content
  #   end
  #
  # Raises Error when the provider returns malformed result indices.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:241
  def messages; end

  # The slug of the provider running the batch, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:182
  def provider; end

  # The provider-reported status string, such as "in_progress".
  # Refreshed by #refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:33
  def raw_status; end

  # Re-fetches the batch from the provider, updating #status, #raw_status,
  # #request_counts, and #complete?. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:215
  def refresh; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:186
  def reported_cost; end

  # The provider-reported request tallies by state, or +nil+ when the
  # provider does not report them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:37
  def request_counts; end

  # The submitted EmbeddingRequest objects in order, or +nil+ when the
  # batch was loaded by id via ::find or holds chats.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:45
  def requests; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:249
  def results; end

  # The provider-neutral lifecycle status: +:pending+, +:succeeded+,
  # +:failed+, or +:cancelled+. Refreshed by #refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:29
  def status; end

  # The normalized outcome of each collected request, in submission order.
  # Values are +:succeeded+, +:failed+, or +:cancelled+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:49
  def statuses; end

  # Returns whether the provider completed the batch successfully.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:199
  def succeeded?; end

  # Returns token usage aggregated across the batch's collected responses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:252
  def tokens; end

  private

  # A plain answer is the chat's last message once it arrives. A tool-call
  # answer is not: running its tools adds messages after it, so we match on its
  # tool-call ids instead.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:399
  def already_in_chat?(chat, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:272
  def apply(attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:372
  def attach_batch_usage(result, operation:, model:, category:, instrument:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:289
  def collect_results; end

  # Collecting early keeps reading fresh, so a result already delivered
  # comes back on every later poll: hand each one over once.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:329
  def deliver(index, result, failure_status); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:340
  def deliver_embedding(index, embedding); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:356
  def deliver_message(index, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:322
  def fill_missing_statuses(size); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:451
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:314
  def known_request_count; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:268
  def persist_state; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:283
  def protocol_name(protocol); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:318
  def result_slot_count(results); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:304
  def validate_result_indices(results); end

  class << self
    # Returns a Batch reflecting the provider's current state for +id+.
    # Use it to pick a batch back up from any process.
    #
    #   batch = RubyLLM::Batch.find("msgbatch_01EhcDuvb5XfWqcdJArbsfNX",
    #                               provider: :anthropic)
    #   batch.complete? # => true
    #
    # Pass +context:+ to use a Context in place of the global
    # configuration. Raises ArgumentError if +provider+ is not given.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:83
    def find(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # Submits chats or embedding requests to their shared provider as a
    # batch and returns a new Batch. Accepts a single Chat or an array.
    # Every chat must be awaiting the model (see Chat#ask_later), and all
    # requests must use the same provider.
    #
    #   chats = tickets.map do |ticket|
    #     RubyLLM.chat(model: "claude-haiku-4-5").ask_later(ticket.body)
    #   end
    #   batch = RubyLLM::Batch.submit(chats)
    #   batch.status     # => :pending
    #   batch.raw_status # => "in_progress"
    #
    # Raises ArgumentError if the batch is empty, mixes providers, mixes
    # chats with embedding requests, or includes a chat that is not
    # awaiting the model.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:67
    def submit(chats); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:155
    def awaiting_model?(chat); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:143
    def normalize_chats(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:159
    def shared_provider(chats); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:100
    def submit_chats(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:117
    def submit_embeddings(requests); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:134
    def wrap_records(records); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:21
RubyLLM::Batch::AWAITING_ROLES = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:407
module RubyLLM::Batch::Helpers
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:419
  def batch_error_message(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:431
  def batch_error_value(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:414
  def batch_failure(custom_id, detail, status: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:445
  def batch_payload(request, except: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:410
  def batch_result_index(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:438
  def single_batch_model!(requests, provider_name); end
end

# A CachedContent is a provider-side prompt cache resource. Create one
# with ::create from a long, stable prompt prefix, then attach it to a
# chat so later requests read the cached tokens instead of resending
# them. This lifecycle requires a provider with managed cache resources;
# automatic prompt caching is configured with Chat#with_caching.
#
#   cache = RubyLLM.cache(big_document, model: 'gemini-3.7-flash', ttl: 3600)
#   chat = RubyLLM.chat(model: 'gemini-3.7-flash').with_caching(id: cache)
#   chat.ask "What does the document conclude?"
#   cache.delete
#
# Cache names are provider-owned. Persist #provider alongside #name and
# pass it back when finding the cache later.
#
# pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:17
class RubyLLM::CachedContent
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:46
  def initialize(name:, **attributes); end

  # The Time the provider stored the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:35
  def created_at; end

  # Deletes the cache resource from the provider. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:58
  def delete; end

  # The Time the provider will delete the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:38
  def expires_at; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:20
  def inspect_attributes; end

  # The raw provider response data for the cache, as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:44
  def metadata; end

  # The model the cache was created for.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:29
  def model; end

  # The provider-assigned resource name, such as
  # <tt>"cachedContents/abc123"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:26
  def name; end

  # The slug of the provider that stores the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:32
  def provider; end

  # Extends the cache's lifetime to +ttl:+ seconds from now, given as an
  # Integer or a provider duration string such as <tt>"600s"</tt>.
  # Updates #expires_at and returns +self+.
  #
  #   cache.renew(ttl: 3600)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:69
  def renew(ttl:); end

  # The number of tokens stored in the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:41
  def tokens; end

  class << self
    # Creates a provider-side prompt cache from +content+ and returns a
    # CachedContent. Also available as RubyLLM.cache.
    #
    #   RubyLLM::CachedContent.create(big_document, model: 'gemini-3.7-flash')
    #
    # +content+ is the text to cache; pass file attachments with +with:+
    # the way Chat#ask accepts them. +instructions:+ caches a system
    # prompt alongside the content, and +ttl:+ sets the cache lifetime in
    # seconds (Integer) or as a provider duration string such as
    # <tt>"300s"</tt>. When +provider:+ is omitted, the model's default
    # provider is used. The content must exceed the model's minimum
    # cacheable token count.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:88
    def create(content, model:, ttl: T.unsafe(nil), instructions: T.unsafe(nil), provider: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil)); end

    # Fetches an existing cache resource by +name+ and returns a
    # CachedContent. When +provider:+ is omitted, the provider of the
    # configured default model is used.
    #
    #   cache = RubyLLM::CachedContent.find("cachedContents/abc123", provider: :gemini)
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:101
    def find(name, provider: T.unsafe(nil), context: T.unsafe(nil)); end
  end
end

# Raised when an in-flight chat operation is cancelled with Chat#cancel.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:105
class RubyLLM::CancelledError < ::StandardError
  # Creates an error for a cancelled chat operation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:107
  def initialize(message = T.unsafe(nil)); end
end

# A Chat is a conversation with an AI model. It holds the messages
# exchanged so far, the tools the model may call, and the settings applied
# to each request. RubyLLM.chat is the usual way to create one.
#
#   chat = RubyLLM.chat
#   chat.ask "What's the best way to learn Ruby?"
#
# Configuration methods return +self+, so calls chain:
#
#   chat = RubyLLM.chat(model: 'claude-sonnet-5')
#   chat.with_instructions("Be terse.").with_tools(Weather)
#
# #ask runs the conversation loop, executing tools until the model answers
# or a call needs approval. #ask_later, #generate, #run_tools, and #step
# expose individual operations. Resume an approval pause with #approve
# or #deny followed by #complete.
#
# A Chat is Enumerable over its messages.
#
# pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:24
class RubyLLM::Chat
  include ::Enumerable
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Chat::ToolSearch
  include ::RubyLLM::Skills::SourceDetection

  # Creates a chat with +model:+, or with the configured default model
  # when +model:+ is +nil+. Most code calls RubyLLM.chat instead.
  #
  # A model is identified by its name, an optional +provider:+, and an
  # optional +protocol:+. Pass +provider:+ to disambiguate models
  # available from several providers, and +protocol:+ to override the wire
  # protocol the provider would otherwise pick for the model. With
  # <tt>assume_model_exists: true</tt> the registry lookup is skipped,
  # which requires +provider:+. Pass a Context as +context:+ to use its
  # configuration instead of the global one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:113
  def initialize(model: T.unsafe(nil), provider: T.unsafe(nil), protocol: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil)); end

  # Receives a completion produced out-of-band (e.g. by a batch), running the
  # same callbacks as a synchronous completion so persistence works unchanged.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1058
  def add_completion(response, record_usage: T.unsafe(nil)); end

  # Appends a message to the conversation and returns it as a Message.
  # Accepts a Message, an attribute Hash, or a record responding to
  # +to_llm+.
  #
  #   chat.add_message(role: :user, content: "What's the capital of France?")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1034
  def add_message(message_or_attributes); end

  # Registers a callback that receives the Fallback attempt once it has
  # succeeded or failed. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:903
  def after_fallback(&); end

  # Registers a callback that receives each assistant response and each
  # tool result message once it has been appended. Returns +self+.
  #
  #   chat.after_message { |message| puts message.content }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:858
  def after_message(&); end

  # Registers a callback that receives the ToolCall and a Progress each
  # time a running local tool reports what it is doing, with
  # Tool#progress or, for MCP tools, through the server's progress
  # notifications. Returns +self+.
  #
  #   chat.after_tool_progress do |tool_call, progress|
  #     puts "#{tool_call.name}: #{progress.message}"
  #   end
  #
  # The callback runs in the thread or fiber that reports, before the
  # tool's result. On Ruby 3.2 and later, that includes threads and
  # fibers the tool starts. With concurrent tool execution, callbacks for
  # different tool calls can run at the same time.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:890
  def after_tool_progress(&); end

  # Registers a callback that receives each local tool's result after
  # execution. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:873
  def after_tool_result(&); end

  # Answers +request+, an MCP::InputRequest from #pending_inputs, with
  # +values+ for a form, or none to accept a URL request. The next
  # #complete resumes the call once its requests are settled. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:404
  def answer(request, **values); end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1026
  def approval_checker=(_arg0); end

  # Records approval for +tool_call+, a ToolCall or its id, so the next
  # #complete or #run_tools executes a local tool or records permission for
  # the provider to execute a remote tool on the next request. Returns +self+.
  #
  #   chat.approve(tool_call)
  #   chat.complete
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:286
  def approve(tool_call); end

  # Adds +message+ as a user message and runs the conversation loop,
  # executing tools until the model answers or a call needs approval.
  # Returns the latest assistant Message; check #waiting? before
  # treating it as a final answer. Attach files with +with:+. An
  # MCP::Prompt adds its messages instead.
  # A given block receives streamed Chunk objects as they arrive.
  #
  # String attachments read local paths or fetch URLs. Only pass trusted,
  # authorized sources; validate user uploads before calling this method.
  # See Attachment.new.
  #
  #   chat.ask "What's the best way to learn Ruby?"
  #   chat.ask "What's in this image?", with: "ruby_conf.jpg"
  #   chat.ask "Analyze these files", with: ["diagram.png", "report.pdf"]
  #   chat.ask("Tell me a story") { |chunk| print chunk.content }
  #   chat.ask github.prompt(:code_review, code: diff)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:170
  def ask(message = T.unsafe(nil), with: T.unsafe(nil), &); end

  # Stages +message+ as a user message without requesting a completion,
  # leaving the chat ready for #complete, a single #step, or a
  # provider-side batch via RubyLLM.batch. Accepts attachments with
  # +with:+ like #ask. Returns +self+.
  #
  #   chats = tickets.map { |t| RubyLLM.chat.ask_later(t.body) }
  #   RubyLLM.batch(chats)
  #
  # Raises PendingToolCallsError while the last response has unanswered
  # tool calls: finish the round first, recording #approve or #deny
  # decisions for calls that require approval.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:188
  def ask_later(message = T.unsafe(nil), with: T.unsafe(nil)); end

  # Returns whether the conversation can make no progress without an
  # approval decision: every remaining pending tool call requires
  # approval and has none recorded, or waits on input. While +true+,
  # #complete returns
  # without executing them; record decisions with #approve or #deny,
  # then call #complete again. Tool calls that need no approval still
  # execute before the loop pauses.
  #
  # Consults each pending tool's approval resolver when one is declared,
  # so resolvers must be idempotent reads.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:326
  def awaiting_approval?; end

  # Returns whether the conversation can make no progress until the user
  # answers an MCP server: every remaining pending tool call waits on
  # input or an approval decision, and at least one waits on input.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:347
  def awaiting_input?; end

  # Returns whether the conversation can make no progress until MCP
  # servers finish tasks: every remaining pending tool call waits on a
  # task, input, or an approval decision, and at least one waits on a
  # task. #complete checks on the tasks again.
  #
  #   chat.ask "Render the quarterly report"
  #   chat.awaiting_tasks?  # => true
  #   sleep chat.pending_tasks.first.poll_interval
  #   chat.complete
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:379
  def awaiting_tasks?; end

  # Registers a callback that receives the Fallback attempt after the
  # current model fails and before the fallback model is tried. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:897
  def before_fallback(&); end

  # Registers a callback that runs before each assistant response or tool
  # result is appended to the conversation. Callbacks are additive: every
  # registered block runs. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:849
  def before_message(&); end

  # Registers a callback that receives the fully rendered request payload
  # before it is sent and may mutate it in place. Runs after all RubyLLM
  # formatting and #with_provider_options merging. Returns +self+.
  #
  #   chat.before_request { |payload| logger.debug payload }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:913
  def before_request(&); end

  # Registers a callback that receives each local ToolCall before the tool
  # executes. Returns +self+.
  #
  #   chat.before_tool_call { |tool_call| puts tool_call.name }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:867
  def before_tool_call(&); end

  # Marks the latest message as an explicit prompt cache boundary, asking
  # the provider to cache everything up to this point. Pass +ttl:+ to give
  # this boundary its own cache lifetime, as Message#cache_until_here
  # describes. Returns +self+.
  #
  #   chat.with_instructions(policy).cache_until_here(ttl: "1h")
  #
  # Raises ArgumentError if the chat has no messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1048
  def cache_until_here(ttl: T.unsafe(nil)); end

  # The prompt caching options set with #with_caching, +false+ when
  # explicitly disabled, or +nil+ when not configured.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:75
  def caching; end

  # Cancels the current in-flight chat operation. The next cancellation
  # checkpoint raises CancelledError and clears the flag so the chat can be
  # reused. The MCP tasks that pending tool calls wait on are cancelled
  # then too; see #pending_tasks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:418
  def cancel; end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1026
  def cancellation_checker=(_arg0); end

  # Returns whether this in-memory chat has been marked for cancellation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:424
  def cancelled?; end

  # Whether #with_citations asked the provider for citations.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:89
  def citations; end

  # Compacts the conversation's model context and returns an assistant
  # Message. The message can have empty text and carries the provider's
  # compacted context internally. Every earlier message remains in
  # #messages, including on persisted Rails chats.
  #
  #   chat.ask "Remember these project requirements..."
  #   chat.compact
  #   chat.ask "Which requirement should we implement first?"
  #
  # Uses the current instructions, headers, and request hooks. Records
  # reported usage and runs the normal message callbacks. Raises Error
  # when the provider has no manual compaction endpoint, and
  # PendingToolCallsError until pending tool calls have been answered.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:998
  def compact; end

  # The context compaction options set with #with_compaction, +false+ when
  # explicitly disabled, or +nil+ when not configured.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:79
  def compaction; end

  # Runs the conversation loop until #complete? or #waiting? is +true+.
  # Returns the last conversation Message, or +nil+ for an empty chat.
  # Used after #ask_later; #ask calls #complete for you.
  #
  # When a pending tool call requires approval and no decision has been
  # recorded, or waits on input for an MCP server, the loop pauses.
  # Record #approve, #deny, #answer, or #decline decisions, then call
  # #complete again to continue. A tool call that waits on an MCP::Task
  # pauses the loop too, and each #complete checks on the task once,
  # without waiting, and continues once it is done.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:260
  def complete(&); end

  # Returns whether the chat has no pending response or tool execution:
  # nothing is staged, or the model answered without requesting tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:268
  def complete?; end

  # The tool concurrency mode, or +nil+ when tools run sequentially.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:71
  def concurrency; end

  # The Context this chat sends requests through, or +nil+ for the global
  # configuration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:93
  def context; end

  # Converts attachments the current protocol cannot render with the
  # given block. Returns +self+. The block receives an Attachment and
  # returns a replacement Attachment, or +nil+ to keep the existing error.
  # Blocks run in registration order until one returns a replacement.
  # The transcript keeps the original file, even when the model changes.
  # The chat converts each attachment once and reuses the replacement,
  # and its upload, on later requests.
  #
  #   chat.convert_unsupported_attachments do |attachment|
  #     text = TextExtraction.call(attachment)
  #     Attachment.new(StringIO.new(text), filename: 'extracted.txt') if text
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:929
  def convert_unsupported_attachments(&); end

  # Returns a Cost aggregating every provider attempt this chat has made,
  # including retries and attempts that produced no message.
  #
  #   chat.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:954
  def cost; end

  # Counts input tokens for the conversation, including instructions,
  # function tools, structured output, thinking, and attachments.
  # Pass +message+ to include it as a staged user message without
  # mutating the chat. Returns an Integer.
  #
  #   chat.with_instructions("Be terse.").with_tools(Weather)
  #   chat.count_tokens("What's the weather in Berlin?")
  #
  # Provider tools, provider_options, compaction, and before_request hooks
  # are not included. Raises Error when the provider has no token counting
  # endpoint.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:969
  def count_tokens(message = T.unsafe(nil)); end

  # Declines +request+, an MCP::InputRequest from #pending_inputs.
  # Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:410
  def decline(request); end

  # Returns the tools whose definitions stay out of the model's context
  # until the provider's tool search loads them, as a Hash like #tools.
  # Providers without tool search receive them as ordinary tools.
  #
  #   chat.with_tools(Weather).with_mcp(GitHub, defer: true)
  #   chat.deferred_tools.keys # => [:search_issues, :create_issue, ...]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:506
  def deferred_tools; end

  # Records denial for +tool_call+, a ToolCall or its id. The next
  # #complete or #run_tools appends a structured denial result instead
  # of executing a local tool, or sends a refusal for a remote tool on the
  # next request. The model continues from there. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:295
  def deny(tool_call); end

  # Yields each Message in the conversation. Returns an Enumerator when
  # no block is given. Chat includes Enumerable, so the usual collection
  # methods are available.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:936
  def each(&); end

  # The opaque per-user identifier set with #with_end_user, or
  # +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:83
  def end_user; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:95
  def fallback_errors; end

  # The Fallback models tried in order when generation fails.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:86
  def fallbacks; end

  # Requests one completion from the model, appends the response to the
  # conversation, and returns it as a Message. Honors the fallbacks
  # configured with #with_fallbacks. A given block receives streamed
  # Chunk objects. Tool calls in the response are not executed; that is
  # #run_tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:203
  def generate(&); end

  # Extra HTTP headers set with #with_headers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:58
  def headers; end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1026
  def input_checker=(_arg0); end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1026
  def input_recorder=(_arg0); end

  # The output cap set with #with_max_output_tokens, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:65
  def max_output_tokens; end

  # The MCP servers connected with #with_mcp, readable by name:
  # <tt>chat.mcp.linear</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:47
  def mcp; end

  # The Message objects exchanged so far, including system instructions.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:43
  def messages; end

  # Replaces the conversation with +new_messages+, coercing each element
  # into a Message. Accepts Message objects, attribute Hashes, and
  # records responding to +to_llm+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1015
  def messages=(new_messages); end

  # The Model the chat sends requests to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:37
  def model; end

  # Returns the tool calls from the latest response that require approval
  # and have no recorded decision, as an array of ToolCall objects. Pairs
  # with #approve and #deny. ToolCall#remote? identifies provider-executed calls.
  #
  #   chat.pending_approvals.each { |tool_call| puts tool_call.name }
  #   chat.approve(chat.pending_approvals.first)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:337
  def pending_approvals; end

  # Returns the unanswered requests for input that paused MCP tool calls,
  # as MCP::InputRequest objects. Settle each with #answer or #decline,
  # then call #complete to resume the calls.
  #
  #   chat.pending_inputs.each { |request| puts request.message }
  #   chat.answer(chat.pending_inputs.first, environment: "staging")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:358
  def pending_inputs; end

  # Returns the MCP::Task objects that MCP tool calls wait on, as they
  # were when the chat last checked. MCP::Task#refresh checks on one
  # without resuming the chat; #complete checks on all of them and
  # resumes their calls once they are done.
  #
  #   chat.pending_tasks.each { |task| puts "#{task.tool_call.name}: #{task.status_message}" }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:390
  def pending_tasks; end

  # The Provider instance handling requests for the current model.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:40
  def provider; end

  # Extra request options set with #with_provider_options, expressed in
  # the provider's request vocabulary.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:55
  def provider_options; end

  # The provider tools enabled with #with_provider_tools, as an array of
  # normalized entry Hashes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:51
  def provider_tools; end

  # Refuses to stage a user message onto an unfinished tool round, which
  # providers reject. Called by #ask_later here and in the Rails
  # integration before it persists anything.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1097
  def raise_if_pending_tool_calls!; end

  # Returns the request payload this chat would send to the provider for
  # its next completion, with #before_request hooks applied. Useful for
  # inspecting and testing request output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1073
  def render; end

  # Executes the tool calls pending in the latest response and appends
  # their result messages, without asking the model to respond. Tool
  # calls that already have results are skipped, so a chat reloaded
  # mid-round resumes with only the remaining tools. Calls whose tool
  # was declared with Tool.requires_approval only execute once #approve
  # records a decision; denied calls receive a structured denial result,
  # and undecided calls stay pending. Does nothing when no tool calls
  # are pending. Calls paused on an MCP::Task check on it once. The chat
  # is then ready for the next #generate, or the next batch round.
  # Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:221
  def run_tools; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:175
  def say(message = T.unsafe(nil), with: T.unsafe(nil), &); end

  # The normalized structured output schema set with #with_schema, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:68
  def schema; end

  # Advances the conversation by one move: runs the pending tool calls
  # if any are unanswered, otherwise generates the next response.
  # Returns the Message that move produced, and +nil+ once there is
  # nothing left to do or the chat is #waiting?.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:236
  def step(&); end

  # The sampling temperature set with #with_temperature, or +nil+ to let
  # the model use its default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:62
  def temperature; end

  # Returns the thinking options resolved for the current model, or +nil+
  # when thinking was not configured or needs no provider control.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:691
  def thinking; end

  # Returns token usage aggregated across every provider attempt this chat
  # has made, including retries and attempts that produced no message.
  #
  #   chat.tokens.input
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:945
  def tokens; end

  # Returns the +choice+, +calls+, and +concurrency+ set with
  # #with_tool_options, with +nil+ for anything left at the default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:99
  def tool_options; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:95
  def tool_prefs; end

  # Returns the tools the model can call, as a Hash of tool name Symbols
  # to Tool instances: those registered with #with_tools and those of the
  # MCP servers connected with #with_mcp. MCP tools that only the UI of
  # an MCP App may call are left out; see MCP::Tool#visibility.
  #
  # Raises ArgumentError when two tools share a name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:487
  def tools; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:95
  def usage_entries; end

  # Replaces the usage ledger. Used by the Rails integration when
  # rebuilding a persisted chat.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1021
  def usage_entries=(entries); end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1026
  def usage_recorder=(_arg0); end

  # Returns whether the conversation can't continue until something
  # outside it happens: every remaining pending tool call waits on an
  # approval decision, an answer to an MCP input request, or an MCP task.
  # #complete stops here, and #awaiting_approval?, #awaiting_input?, and
  # #awaiting_tasks? tell what it waits on. Stop a loop you drive with
  # #step here too:
  #
  #   chat.step until chat.complete? || chat.waiting?
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:308
  def waiting?; end

  # Enables provider prompt caching. With no arguments the provider's
  # default behavior applies; options such as +ttl:+ apply where
  # supported. Pass +id:+ with a CachedContent (or its name) from
  # RubyLLM.cache to attach an explicit
  # content cache. Pass +false+ to stop RubyLLM from sending cache
  # controls or rendering explicit cache boundaries. A provider may still
  # cache prompts implicitly. Passing +nil+ raises ArgumentError.
  # Returns +self+.
  #
  #   chat.with_caching
  #   chat.with_caching(ttl: "1h")
  #   chat.with_caching(id: cache)
  #   chat.with_caching(false)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:732
  def with_caching(options = T.unsafe(nil)); end

  # Enables document citations, so the model backs its claims with quotes
  # from attached files. Pass +false+ to disable. Passing +nil+ raises
  # ArgumentError. Returns +self+.
  #
  #   chat.with_citations
  #   response = chat.ask "Who created Ruby?", with: "facts.txt"
  #   response.citations.each { |citation| puts citation.cited_text }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:711
  def with_citations(enabled = T.unsafe(nil)); end

  # Enables provider-side context compaction, so a long conversation keeps
  # going instead of overflowing the context window. The provider condenses
  # the earlier turns itself and returns a block that RubyLLM replays on
  # later requests. With no arguments the provider's own defaults apply.
  # The options are provider-neutral:
  #
  # +at+:: the input-token count that triggers compaction.
  # +instructions+:: a custom prompt for the summary the provider writes.
  # +pause_after+:: end the turn once compaction runs, instead of
  #                 continuing straight into the answer.
  #
  # Each provider applies the options it supports. Unsupported options
  # are ignored with a debug log. Pass +false+ to disable; passing +nil+
  # raises ArgumentError. Returns +self+.
  #
  #   chat.with_compaction
  #   chat.with_compaction(at: 50_000)
  #   chat.with_compaction(at: 100_000, instructions: "Keep every decision.")
  #   chat.with_compaction(false)
  #
  # What a provider does when the threshold is crossed differs. Anthropic
  # and OpenAI summarize the compacted span into an opaque block that
  # replaces it; OpenRouter drops messages from the middle of the
  # conversation instead, and has no threshold of its own.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:766
  def with_compaction(options = T.unsafe(nil)); end

  # Rebinds the chat to +context+, a Context built with RubyLLM.context,
  # so subsequent requests use its configuration. Pass +nil+ to return to
  # the global RubyLLM.config. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:793
  def with_context(context); end

  # Identifies the end user behind the conversation for the provider's
  # abuse monitoring. Providers without an equivalent field omit it.
  # Pass +nil+ to remove it.
  # Returns +self+.
  #
  #   chat.with_end_user("user-123").ask "Hello"
  #
  # The value is sent as given, so use an opaque id such as a hash of
  # your user id, never personal data.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:785
  def with_end_user(end_user); end

  # Sets fallback models to try, in order, when generation fails. +on:+
  # selects the error classes that trigger a fallback; the default covers
  # transient provider and network errors. Pass +nil+ to remove all
  # fallbacks and restore the default error classes. Returns +self+.
  #
  #   chat.with_fallbacks("gpt-4.1-mini", "claude-haiku-4-5")
  #   chat.with_fallbacks(nil)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:625
  def with_fallbacks(*models, on: T.unsafe(nil)); end

  # Sets extra HTTP headers sent with completion requests, replacing any
  # previously set headers; +nil+ clears them. Returns +self+.
  #
  #   chat.with_headers('anthropic-beta' => 'fine-grained-tool-streaming-2025-05-14')
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:816
  def with_headers(headers); end

  # Sets the system instructions for the conversation, replacing any
  # existing system messages. With <tt>append: true</tt> the instructions
  # are added alongside the existing ones. With <tt>cache_until_here:
  # true</tt> the instruction becomes an explicit prompt cache boundary;
  # pass <tt>cache_until_here: { ttl: "1h" }</tt> to give that boundary its
  # own lifetime, as Message#cache_until_here describes. Pass +nil+ to
  # remove all system instructions. Returns +self+.
  #
  #   chat.with_instructions "You are a helpful Ruby tutor."
  #   chat.with_instructions "Use exactly one short paragraph.", append: true
  #   chat.with_instructions policy, cache_until_here: { ttl: "1h" }
  #   chat.with_instructions nil
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:441
  def with_instructions(instructions, append: T.unsafe(nil), cache_until_here: T.unsafe(nil)); end

  # Caps the number of tokens the model may generate.
  # Pass +nil+ to remove the limit.
  # Returns +self+.
  #
  #   chat.with_max_output_tokens(1000)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:648
  def with_max_output_tokens(max_output_tokens); end

  # Connects MCP servers, each an MCP instance or class, and gives the
  # model their tools. The servers are contacted when the chat first
  # needs their tools. Pass +nil+ to disconnect them all. Returns +self+.
  #
  #   chat.with_mcp(Linear.new(user: current_user), Files)
  #   chat.mcp.linear
  #
  # Pass <tt>defer: true</tt> to keep every tool of these servers out of
  # the model's context until the provider's tool search loads it, or
  # <tt>defer: false</tt> to offer them up front despite MCP.defer. See
  # #deferred_tools.
  #
  #   chat.with_mcp(GitHub, defer: true)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:524
  def with_mcp(*servers, defer: T.unsafe(nil)); end

  # Switches the chat to +model_id+ and its provider. Pass +provider:+ to
  # disambiguate, and <tt>assume_model_exists: true</tt> to skip registry
  # validation for custom or private models. Pass +nil+ to return to the
  # configured default model. Returns +self+.
  #
  # +protocol:+ overrides the wire protocol the provider would pick for the
  # model, such as +:responses+ or +:chat_completions+ for OpenAI. It stays
  # +nil+ by default, meaning the provider chooses the protocol for each
  # request. A bare #with_model resets the override to +nil+, just as it
  # re-resolves the provider from the model.
  #
  # Raises ModelNotFoundError if +model_id+ is not in the registry and
  # +assume_model_exists:+ is false.
  #
  #   chat.with_model('claude-sonnet-5')
  #   chat.with_model('gpt-5.6', protocol: :chat_completions)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:609
  def with_model(model_id, provider: T.unsafe(nil), protocol: T.unsafe(nil), assume_model_exists: T.unsafe(nil)); end

  # Sets options in the provider's request vocabulary, merged into the
  # request payload as-is and overriding RubyLLM's defaults. Replaces any
  # previously set provider options; +nil+ clears them. Returns +self+.
  #
  #   chat.with_provider_options(service_tier: "flex")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:806
  def with_provider_options(provider_options); end

  # Enables tools that run on the provider's servers, such as web search
  # or code execution. Accepts portable alias Symbols, alias-with-options
  # keywords whose options use the provider's own vocabulary, and raw
  # Hashes passed to the provider verbatim, so provider tools RubyLLM has
  # no alias for yet work without a gem update. Entries add to any tools
  # enabled earlier; pass +nil+ to clear them all. Returns +self+.
  #
  #   chat.with_provider_tools(:web_search)
  #   chat.with_provider_tools(:web_search, :code_execution)
  #   chat.with_provider_tools(web_search: { allowed_domains: ["ruby-lang.org"] })
  #   chat.with_provider_tools({ type: "web_search_20260318", name: "web_search" })
  #
  # The tool steps the model ran come back on
  # Message#server_tool_calls, citations from search tools on
  # Message#citations, and per-use billing counters on
  # <tt>message.tokens.server_tool_use</tt>.
  #
  # Raises UnsupportedServerToolError at request time when the provider
  # has no provider-tool support or does not define a requested alias.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:557
  def with_provider_tools(*tools, **tools_with_options); end

  # Sets the schema for structured output. Accepts a JSON Schema Hash, a
  # Schematist::Schema class or instance, or any object responding to
  # +to_json_schema+. Returns +self+.
  #
  #   class PersonSchema < Schematist::Schema
  #     string :name
  #     integer :age
  #   end
  #
  #   chat.with_schema(PersonSchema)
  #   response = chat.ask("Generate a person named Alice who is 30 years old")
  #   response.parsed # => {"name" => "Alice", "age" => 30}
  #
  # Pass +nil+ to remove the schema, returning the chat to plain text
  # responses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:836
  def with_schema(schema); end

  # Sets the sampling temperature for subsequent requests. Pass +nil+ to
  # return to the model's default sampling behavior. Returns +self+.
  #
  #   chat.with_temperature(0.2)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:637
  def with_temperature(temperature); end

  # Configures extended thinking for models that support it. With no
  # arguments, RubyLLM uses the current model's registered default. Pass
  # +false+ to disable thinking, or tune it with
  # +effort:+ (+:low+, +:medium+, +:high+, +:none+, or a
  # provider-specific tier such as +:minimal+, +:xhigh+, or +:max+,
  # passed through as-is), +budget:+ (a token count), and +display:+
  # (+:summarized+ or +:omitted+, controlling whether providers that
  # support it return readable thinking text). Accepts keywords or an options
  # Hash. Passing +nil+ raises ArgumentError. Returns +self+.
  #
  #   chat.with_thinking
  #   chat.with_thinking(false)
  #   chat.with_thinking(effort: :high)
  #   chat.with_thinking(budget: 10_000)
  #   chat.with_thinking(display: :summarized)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:669
  def with_thinking(enabled = T.unsafe(nil), **options); end

  # Configures how the model uses the registered tools. +choice:+
  # constrains tool use to +:auto+, +:none+, +:required+, a tool name, or
  # a Tool class. +calls:+ limits how many tool calls one response may
  # contain (+:many+ or +:one+). +concurrency:+ runs tool calls
  # concurrently: +true+ or +:threads+ for threads, +:fibers+ for fibers.
  # An omitted option is left unchanged; passing +nil+ explicitly resets
  # that option (+concurrency: nil+ returns to the configured default).
  # Returns +self+.
  #
  #   chat.with_tools(Weather, Search).with_tool_options(choice: :required)
  #   chat.with_tool_options(calls: :one, concurrency: :threads)
  #   chat.with_tool_options(choice: nil)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:580
  def with_tool_options(**options); end

  # Registers +tools+, each a Tool class or instance, for the model to
  # call. Configure how the model uses them with #with_tool_options.
  # Pass +nil+ to remove all registered tools. Returns +self+.
  #
  #   chat.with_tools(Weather, Search)
  #   chat.with_tools(Weather).with_tool_options(choice: :required)
  #
  # Pass <tt>defer: true</tt> to keep the tools' definitions out of the
  # model's context until the provider's tool search loads the ones it
  # needs, or <tt>defer: false</tt> to offer a tool declared with
  # Tool.defer up front. See #deferred_tools.
  #
  #   chat.with_tools(*Catalog.tools, defer: true)
  #
  # To replace the registered tools, clear them first:
  #
  #   chat.with_tools(nil).with_tools(NewTool)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:467
  def with_tools(*tools, defer: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1188
  def add_callback(name, &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1634
  def add_tool_result_message(tool_call, result); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1757
  def apply_tool_choice(choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1580
  def approval_pending?(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1856
  def awaiting_approval_names; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1835
  def blank_response?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1174
  def build_schema_payload(schema, schema_def, strict); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1729
  def cancel_task(task); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1716
  def cancel_tasks; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1138
  def coerce_message(message_or_attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1566
  def deny_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1473
  def discard_missing_uploads(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1520
  def execute_pending_tool_calls(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1642
  def execute_tool(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1623
  def execute_tool_with_callbacks(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1617
  def execute_tools_concurrently(tool_calls, &on_result); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1559
  def execution_decision(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1162
  def extract_schema_definition(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1167
  def extract_schema_strict(schema, schema_def); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1358
  def fallback_error?(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1331
  def fallback_to_next_model!(fallback_queue, error:, attempt:, streaming:, chunks_yielded:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1351
  def finish_fallback(fallback, response: T.unsafe(nil), fallback_error: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1810
  def forced_tool_choice?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1125
  def format_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1201
  def generate_once(stream_tracker: T.unsafe(nil), usage_start: T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1269
  def generate_with_fallbacks(&block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1607
  def handle_concurrent_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1596
  def handle_sequential_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1818
  def hidden_from_model?(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1703
  def input_pending?(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1846
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1229
  def instrumentation_payload(streaming:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1682
  def invoke_tool(tool, tool_call, arguments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1814
  def last_non_system_message; end

  # A blank response answers nothing, so it never hides the round before
  # it, as the placeholder of a process that died after a tool finished.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1829
  def latest_response(list); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1483
  def link_completion_usage(response, usage_start); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1129
  def message_list(new_messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1784
  def normalize_calls(calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1114
  def normalize_compaction(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1152
  def normalize_schema_payload(raw_schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1795
  def normalize_tool_choice(choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1772
  def normalize_tool_concurrency(concurrency); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1549
  def partition_pending_tool_calls(pending); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1693
  def pause_tool_call(tool_call, state); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1698
  def paused?(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1841
  def pending_tool_calls(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1822
  def pending_tool_response; end

  # Preprocessing builds a per-request view of the conversation: the
  # provider can change through fallbacks or with_model, so history keeps
  # the original attachments while each provider's upload is memoized on
  # them. An attachment's store keeps its uploads for later processes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1366
  def preprocessed_messages(list = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1676
  def progress_listener(tool_call); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1452
  def provider_compaction; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1416
  def provider_completion(usage_recorder:, stream_tracker: T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1193
  def raise_if_cancelled!; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1256
  def record_completion_event(event, result); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1221
  def record_generated_message(result, usage_start, streaming: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1487
  def record_out_of_band_usage(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1574
  def record_tool_call_decision(tool_call, decision); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1739
  def record_tool_call_input(tool_call, input); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1477
  def record_usage_entry(entry); end

  # A provider-executed call is closed with the refusal its provider
  # expects. Another provider takes it as an ordinary tool call.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1410
  def remote_refusal(tool_call); end

  # A provider can delete a file RubyLLM uploaded for an attachment. A
  # request that fails over such a file before streaming anything uploads
  # the file again and runs once more; one that streamed is not repeated.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1465
  def replacing_missing_uploads(request_messages, streamed = T.unsafe(nil)); end

  # A process that dies mid-round leaves a blank assistant placeholder,
  # or tool calls without results, and providers refuse both. A request
  # leaves blank messages out and answers the calls of a round the
  # conversation moved past as unfinished. The latest round stays as it
  # is: the loop runs its calls or waits on them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1388
  def request_history(list); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1110
  def resolved_thinking; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1536
  def respond_to_tool_approvals(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:1503
  def run_callbacks(name, *args); end

