  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:74
  def warn_unsupported_citations(model); end

  # Google's terms forbid storing search suggestions, and Gemini takes
  # a replayed search result without them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:253
  def without_search_suggestions(parts); end

