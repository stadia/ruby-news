  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:38
  def initialize(kind:, message:, turn: T.unsafe(nil), part: T.unsafe(nil), call_id: T.unsafe(nil)); end

  # The id of the call an unmatched tool result names, the only id a
  # shape shows, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:32
  def call_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:58
  def inspect_attributes; end

  # What is wrong: +:part_without_data+, +:empty_turn+,
  # +:unpaired_round+, +:unmatched_result+, +:unsigned_call+,
  # +:unsigned_thinking+, or +:role_order+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:21
  def kind; end

  # The problem in words.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:35
  def message; end

  # The position of the part in the turn's parts, or +nil+ when the
  # problem concerns the whole turn.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:28
  def part; end

  # Returns the problem as a Hash, omitting attributes it does not have.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:54
  def to_h; end

  # Returns the problem as one line, with where it is.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:47
  def to_s; end

  # The index of the turn the problem is in, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/request_shape/problem.rb:24
  def turn; end
end

# A ToolRound describes a model turn that called tools and the results
