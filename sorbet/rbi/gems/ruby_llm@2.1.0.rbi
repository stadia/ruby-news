    # and tool_calls_executed count every tool at once.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:147
    def server_tool_use(usage); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:37
    def strict_schema?(node); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:401
    def supports_provider_file_references?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:368
    def thinking_only_assistant_message?(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:197
    def thinking_tokens(usage); end

    # Chat Completions tool messages are text-only on the wire, so tool
    # attachments ride a user message spliced in after the results.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:334
    def tool_attachment_message(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/chat.rb:100
    def warn_unsupported_citations(model); end
  end
end

