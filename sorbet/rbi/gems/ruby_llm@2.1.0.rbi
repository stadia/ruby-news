# Describes generateContent requests, and the countTokens requests that
# wrap them, as RequestShape objects. RubyLLM writes media parts in
# snake case, and a model's own parts replay in camel case. Gemini pairs
# function responses with calls by position and name, wants data in
# every part, and from Gemini 3 needs a signature on the first call of
# each step in the current turn.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:12
module RubyLLM::Protocols::Gemini::RequestShapes
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:22
  def parse_request_shape(payload); end

  private

  # A thought or a signature alone is a part with no data, which
  # Gemini refuses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:75
  def shape_gemini_data(part, signed); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:92
  def shape_gemini_field(part, *keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:47
  def shape_gemini_part(part); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:43
  def shape_gemini_parts(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:104
  def shape_gemini_thinking(request); end

  # RubyLLM wraps a result's text in content parts, and Gemini 3 sends
  # a result's media in parts beside it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:65
  def shape_gemini_tool_result(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:96
  def shape_gemini_tools(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:38
  def shape_gemini_turn(content, index); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:15
RubyLLM::Protocols::Gemini::RequestShapes::DATA_FIELDS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:18
RubyLLM::Protocols::Gemini::RequestShapes::FUNCTION_DECLARATIONS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/request_shapes.rb:13
RubyLLM::Protocols::Gemini::RequestShapes::PART_MODIFIERS = T.let(T.unsafe(nil), Array)

