  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/request_shapes.rb:24
  def shape_message(message, index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/request_shapes.rb:45
  def shape_message_thinking(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/request_shapes.rb:54
