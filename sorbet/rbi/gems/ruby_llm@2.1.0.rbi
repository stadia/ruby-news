# Raised when a server needs input from the user and no
# MCP.before_input_request callback answered. Its message includes what
# the server asked for, and #requests has the MCP::InputRequest objects.
# In a chat, the tool call pauses instead, and Chat#pending_inputs
# returns the requests.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/input_required_error.rb:10
class RubyLLM::MCP::InputRequiredError < ::RubyLLM::MCP::Error
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/input_required_error.rb:11
  def initialize(server, input); end

  # The unanswered MCP::InputRequest objects.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/input_required_error.rb:18
  def requests; end

  # Returns everything needed to answer the requests later and resume
  # the call, as a Hash that serializes to JSON.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/input_required_error.rb:24
  def to_h; end
end

# pkg:gem/ruby_llm#lib/ruby_llm/mcp.rb:38
RubyLLM::MCP::LOG_LEVELS = T.let(T.unsafe(nil), Hash)

# Keeps a subscription to a server's changes open in a thread of its
# own, so the notifications reach the MCP while chats and requests go
# on. #start returns once the server acknowledges the subscription.
# When a stream ends, the listener subscribes again after a delay that
# starts at a second and doubles up to a minute, and gives up when the
# server agrees to send nothing or does not know the method. Changes
# made in between are lost, so once the server acknowledges again, the
# +resumed+ callable receives what the listener listens to.
#
# Stopping raises CancelledError in the listener's thread. Callbacks run
# with that deferred, so a stop never cuts one short, and inside the
# Rails executor when Rails is loaded. The thread reports no progress
# to a chat that started it. A forked child does not inherit the
# thread, so it listens again only when started again.
#
# pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:19
class RubyLLM::MCP::Listener
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:24
  def initialize(client, name:, timeout:, resumed: T.unsafe(nil), &on_notification); end

  # Listens for +changes+, a subscriptions/listen filter, instead of
  # whatever the listener heard before. Returns the changes the server
  # agreed to send, or +nil+ when there is nothing to listen for.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:38
  def start(changes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:47
  def stop; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:67
  def acknowledgment; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:138
  def again?(ending); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:131
  def dispatch(callback, argument); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:154
  def halt; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:57
  def launch(changes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:163
  def monotonic_now; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:105
  def pause(seconds, ending); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:120
  def receive(notification); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:90
  def run; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:53
  def running?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:147
  def settle(state); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:77
  def settle_within(timeout); end

  # pkg:gem/ruby_llm#lib/ruby_llm/mcp/listener.rb:111
  def subscribe; end
end

