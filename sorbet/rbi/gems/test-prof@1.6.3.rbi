# Ruby applications tests profiling tools.
#
# Contains tools to analyze factories usage, integrate with Ruby profilers,
# profile your examples using ActiveSupport notifications (if any) and
# statically analyze your code with custom RuboCop cops.
#
# Example usage:
#
#   require 'test_prof'
#
#   # Activate a tool by providing environment variable, e.g.
#   TEST_RUBY_PROF=1 rspec ...
#
#   # or manually in your code
#   TestProf::RubyProf.run
#
# See other modules for more examples.
#
# pkg:gem/test-prof#lib/test_prof/version.rb:3
module TestProf
  extend ::TestProf::Logging

  class << self
    # Run block only if provided env var is present and
    # equal to the provided value (if any).
    # Contains workaround for applications using Spring.
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:100
    def activate(env_var, val = T.unsafe(nil)); end

    # Return a path to store artifact
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:120
    def artifact_path(filename); end

    # Return absolute path to asset
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:115
    def asset_path(filename); end

    # pkg:gem/test-prof#lib/test_prof/core.rb:53
    def config; end

    # pkg:gem/test-prof#lib/test_prof/core.rb:57
    def configure; end

    # pkg:gem/test-prof#lib/test_prof/core.rb:133
    def create_artifact_dir; end

    # pkg:gem/test-prof#lib/test_prof/core.rb:78
    def dry_run?; end

    # Returns true if we're inside Minitest
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:67
    def minitest?; end

    # Returns the current process time
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:83
    def now; end

    # Require gem and shows a custom
    # message if it fails to load
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:89
    def require(gem_name, msg = T.unsafe(nil)); end

    # Returns true if we're inside RSpec
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:62
    def rspec?; end

    # Returns true if Spring is used and not disabled
    #
    # pkg:gem/test-prof#lib/test_prof/core.rb:72
    def spring?; end

    private

    # pkg:gem/test-prof#lib/test_prof/core.rb:139
    def activate!(env_var, val); end

    # pkg:gem/test-prof#lib/test_prof/core.rb:161
    def notify_spring_activate(env_var); end

    # pkg:gem/test-prof#lib/test_prof/core.rb:155
    def notify_spring_detected; end

    # pkg:gem/test-prof#lib/test_prof/core.rb:149
    def with_report_suffix(path); end

    # pkg:gem/test-prof#lib/test_prof/core.rb:143
    def with_timestamps(path); end
  end
end

