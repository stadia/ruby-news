    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:122
    def print(started_at); end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:137
    def result; end

    # Inits FactoryProf and setups at exit hook,
    # then runs
    #
    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:110
    def run; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:128
    def start; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:133
    def stop; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:141
    def track(factory, variation:); end

    private

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:201
    def flush_stack; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:180
    def hash_template(name); end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:169
    def reset!; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:207
    def running?; end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:190
    def track_count(factory); end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:195
    def track_time(factory, t1, t2); end

    # pkg:gem/test-prof#lib/test_prof/factory_prof.rb:161
