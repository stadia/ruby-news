# pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:22
class RailsSemanticLogger::ActiveJob::LogSubscriber < ::ActiveSupport::LogSubscriber
  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:121
  def discard(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:23
  def enqueue(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:217
  def enqueue_all(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:44
  def enqueue_at(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:92
  def enqueue_retry(event); end

  # ActiveJob Continuations (Rails 8.1+)
  #
  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:134
  def interrupt(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:71
  def perform(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:65
  def perform_start(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:146
  def resume(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:108
  def retry_stopped(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:186
  def step(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:157
  def step_skipped(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:168
  def step_started(event); end

  private

  # Upstream records an enqueue failure either via the event's exception_object or via
  # ActiveJob's job.enqueue_error. Prefer the former, fall back to the latter.
  #
  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:251
  def enqueue_error(event); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:256
  def enqueued_jobs_message(adapter_name, enqueued_jobs); end

  # Builds the structured log entry for an event. The block is given an EventFormatter and
  # returns a hash with :message, an optional :exception, and an optional :payload of extra
  # fields. Those extra fields are merged on top of the formatter's standard payload, so
  # handlers can add event-specific keys (executions, wait, step_name, ...) without each
  # having to rebuild the common job payload.
  #
  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:352
  def log_with_formatter(level: T.unsafe(nil), **kw_args); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:362
  def logger; end
end

# pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:263
class RailsSemanticLogger::ActiveJob::LogSubscriber::EventFormatter
  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:264
  def initialize(event:, log_duration: T.unsafe(nil)); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:299
  def executions; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:269
