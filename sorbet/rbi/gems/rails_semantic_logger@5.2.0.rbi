  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:291
  def queue_name; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:295
  def scheduled_at; end

  private

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:311
  def adapter_name; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:305
  def event; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:323
  def format(arg); end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:315
  def formatted_args; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:307
  def job; end

  # pkg:gem/rails_semantic_logger#lib/rails_semantic_logger/active_job/log_subscriber.rb:342
  def log_duration?; end
end

