  # pkg:gem/deepl-rb#lib/deepl/requests/multilingual_glossary/helpers.rb:20
  def glossary_path(id, suffix = T.unsafe(nil)); end

  # pkg:gem/deepl-rb#lib/deepl/requests/multilingual_glossary/helpers.rb:57
  def uri; end
end

