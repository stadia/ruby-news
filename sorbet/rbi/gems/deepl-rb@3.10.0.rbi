# Raised by DeepL::Client and DeepL::AdminClient for a network failure without a complete
# HTTP response from the API (DNS, connection, TLS, proxy, timeout or a body cut off
# mid-read), after the retries are used up. Transient failures (DNS, connection, timeout,
# cut-off body) are retried and have +should_retry?+ true; TLS failures, proxy failures and
# malformed responses are raised at once and have +should_retry?+ false. The original
# exception is available as +cause+. The module-level API raises the original exception.
#
# pkg:gem/deepl-rb#lib/deepl/exceptions/connection_error.rb:15
class DeepL::Exceptions::ConnectionError < ::DeepL::Exceptions::Error
  # pkg:gem/deepl-rb#lib/deepl/exceptions/connection_error.rb:27
  def initialize(message = T.unsafe(nil), should_retry: T.unsafe(nil)); end

  # pkg:gem/deepl-rb#lib/deepl/exceptions/connection_error.rb:32
  def should_retry?; end

  class << self
    # Raised from a +rescue+ block, so the original exception becomes +cause+.
    # +should_retry: false+ marks a request that is unsafe to repeat once sent.
    #
    # pkg:gem/deepl-rb#lib/deepl/exceptions/connection_error.rb:18
    def from_network_error(error, should_retry: T.unsafe(nil)); end

    # pkg:gem/deepl-rb#lib/deepl/exceptions/connection_error.rb:23
    def transient?(error); end
  end
end

