# Common behaviour of the requests to a pre-signed storage URL handed out by the API, such
# as a translation memory upload or download URL. Those URLs point outside of the DeepL
# API, so they are requested over their own connection and send only the User-Agent: neither
# the DeepL `Authorization` header nor other caller headers. That connection uses the same
# proxy, SSL and timeout options as the API connection. A non-2xx response raises the API
# error class for its status (e.g. DeepL::Exceptions::AuthorizationFailed for 401/403) in the
# module-level API and a plain DeepL::Exceptions::Error in DeepL::Client.
#
# pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:18
class DeepL::Requests::TranslationMemory::StorageBase < ::DeepL::Requests::Base
  include ::DeepL::Requests::Base::ResponseFormatGuard

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:21
  def initialize(api, storage_url, options = T.unsafe(nil), additional_headers = T.unsafe(nil)); end

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:19
  def storage_url; end

  private

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:44
  def default_http_client; end

  # Only the User-Agent: the caller's from the configured +headers+, else the library's.
  #
  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:70
  def headers; end

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:32
  def http_client; end

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:40
  def http_client_options_of(_client); end

  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:50
  def uri; end

  # Storage responses are not DeepL API responses, so their statuses carry none of the API's
  # meanings: an expired URL replies 403, which is no authorization failure. DeepL::Client
  # raises a plain error; until the next major version, the module-level API raises the API
  # error classes it has released.
  #
  # pkg:gem/deepl-rb#lib/deepl/requests/translation_memory/storage_base.rb:58
  def validate_response!(response, request = T.unsafe(nil)); end
end

