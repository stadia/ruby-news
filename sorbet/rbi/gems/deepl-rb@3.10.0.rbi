  # @return [DeepL::Resources::TranslationMemorySegments] The requested page of segments.
  #
  # @deprecated Use DeepL::Client#list_translation_memory_segments instead.
  #
  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:63
  def segments(translation_memory, options = T.unsafe(nil)); end

  # Uploads a TMX file to the upload URL of an import job, which starts the processing. The
  # upload URL is a pre-signed storage URL outside of the DeepL API, so no authorization header
  # is sent with this request.
  #
  # @raise [DeepL::Exceptions::RequestError] If the storage URL replies with a non-2xx status:
  #                                          the API error class for that status, e.g.
  #                                          `AuthorizationFailed` for 401 and 403.
  #
  # @param [String, DeepL::Resources::TranslationMemoryImport] translation_memory_import Import
  #        returned by `create_import`, or its upload URL.
  # @param [String] file_content Content of the TMX file.
  # @param [String] content_type MIME type of the file. Must match the `content_type` declared
  #                              when the import job was created.
  # @return [nil]
  #
  # @deprecated Use DeepL::Client#upload_translation_memory_file instead.
  #
  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:129
  def upload_file(translation_memory_import, file_content, content_type: T.unsafe(nil)); end

  # Polls a translation memory import or export job until it is finished, `sleep`ing between
  # the status queries, and returns the final status.
  #
  # Note that an import job keeps reporting `awaiting_input` for a while after its file has
  # been uploaded, because the API detects the upload asynchronously. That status is therefore
  # polled through like any other non-terminal one. A job whose file is never uploaded does not
  # finish on its own, so pass `timeout_s` when that is a possibility.
  #
  # @raise [DeepL::Exceptions::Error] If the job failed or expired, or if `timeout_s` elapsed
  #                                   before the job finished.
  #
  # @param [String, DeepL::Resources::TranslationMemoryJob] job Job ID or object.
  # @param [Hash] options Additional options for the status queries.
  # @param [Numeric, nil] timeout_s Maximum time in seconds to wait for the job to finish. The
  #                                 status is queried every five seconds; the last wait is cut
  #                                 so that the call never waits past `timeout_s`.
  # @return [DeepL::Resources::TranslationMemoryJob] The finished job.
  #
  # @deprecated Use DeepL::Client#wait_until_translation_memory_job_done instead.
  #
  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:188
  def wait_until_job_done(job, options = T.unsafe(nil), timeout_s: T.unsafe(nil)); end

  private

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:325
  def blank?(value); end

  # Until the next major version, the module-level API raises the error classes of v3.9.0 for
  # local file failures; DeepL::Client raises ArgumentError and wrapped errors.
  #
  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:331
  def check_input_file(input_file_path); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:348
  def check_output_directory(output_path); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:313
  def extract_download_url(job); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:298
  def extract_job_id(job); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:287
  def extract_translation_memory_id(translation_memory); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:305
  def extract_upload_url(translation_memory_import); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:358
  def log_job_polling(interval); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:363
  def monotonic_time; end

  # The polling interval, cut to the time left until +deadline+ so that a wait never runs
  # past +timeout_s+.
  #
  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:369
  def polling_interval_until(deadline, timeout_s); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:383
  def raise_job_error(job_status); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:378
  def raise_timeout_error(timeout_s); end

  # pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:340
  def read_input_file(input_file_path); end
end

# Time to wait between two status queries of an import or export job.
#
# pkg:gem/deepl-rb#lib/deepl/translation_memory_api.rb:10
DeepL::TranslationMemoryApi::JOB_POLLING_INTERVAL_SECONDS = T.let(T.unsafe(nil), Integer)

# pkg:gem/deepl-rb#lib/deepl/utils/exception_builder.rb:7
module DeepL::Utils; end

# pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:8
class DeepL::Utils::BackoffTimer
  # pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:20
  def initialize(min_connection_timeout = T.unsafe(nil)); end

  # pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:27
  def current_request_timeout; end

  # pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:18
  def num_retries; end

  # pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:35
  def sleep_until_deadline; end

  # pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:31
  def time_until_deadline; end
end

# Implements exponential-backoff strategy.
# This strategy is based on the GRPC Connection Backoff Protocol:
# https://github.com/grpc/grpc/blob/master/doc/connection-backoff.md
#
# pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:13
DeepL::Utils::BackoffTimer::BACKOFF_INITIAL = T.let(T.unsafe(nil), Float)

# pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:15
DeepL::Utils::BackoffTimer::BACKOFF_JITTER = T.let(T.unsafe(nil), Float)

# pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:14
DeepL::Utils::BackoffTimer::BACKOFF_MAX = T.let(T.unsafe(nil), Float)

# pkg:gem/deepl-rb#lib/deepl/utils/backoff_timer.rb:16
DeepL::Utils::BackoffTimer::BACKOFF_MULTIPLIER = T.let(T.unsafe(nil), Float)

# Builds the API connection of a DeepL::Client or DeepL::AdminClient from its constructor
# options. Nothing is read from the environment or from module state.
# @api private
#
# pkg:gem/deepl-rb#lib/deepl/utils/client_builder.rb:11
module DeepL::Utils::ClientBuilder
  extend ::DeepL::Utils::ClientBuilder

  # pkg:gem/deepl-rb#lib/deepl/utils/client_builder.rb:14
  def build_api(key, key_name:, server_url:, default_server_url:, headers:, max_retries:, timeout:, proxy:, send_platform_info:, app_info:, http_client_options:, logger:); end

  private

  # pkg:gem/deepl-rb#lib/deepl/utils/client_builder.rb:37
  def merge_proxy(options, proxy); end

  # pkg:gem/deepl-rb#lib/deepl/utils/client_builder.rb:33
  def user_agent_header?(name); end
end

# @api private
# Polls the status of a document translation every 5 seconds.
#
# pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:10
module DeepL::Utils::DocumentPoller
  extend ::DeepL::Utils::DocumentPoller

  # Polls until the translation is done and returns that status. Raises
  # DeepL::Exceptions::Error with the API's message when the translation fails, and when
  # +timeout_s+ is set and expires. An unknown status keeps polling.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:18
  def wait_until_done(api, handle, timeout_s: T.unsafe(nil)); end

  # Polls until the translation is done or failed and returns that status, or the last status
  # after +max_queries+ + 1 queries if +max_queries+ is set.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:32
  def wait_until_finished(api, handle, max_queries: T.unsafe(nil)); end

  private

  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:50
  def get_status(api, handle); end

  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:54
  def interval_until(deadline, timeout_s); end

  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:65
  def monotonic_now; end

  # pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:44
  def raise_if_failed(status); end
end

# pkg:gem/deepl-rb#lib/deepl/utils/document_poller.rb:11
DeepL::Utils::DocumentPoller::INTERVAL_S = T.let(T.unsafe(nil), Integer)

# pkg:gem/deepl-rb#lib/deepl/utils/exception_builder.rb:8
class DeepL::Utils::ExceptionBuilder
  # pkg:gem/deepl-rb#lib/deepl/utils/exception_builder.rb:24
