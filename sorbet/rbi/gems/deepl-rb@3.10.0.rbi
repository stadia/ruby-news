end

# pkg:gem/deepl-rb#lib/deepl/exceptions/document_translation_error.rb:8
class DeepL::Exceptions::DocumentTranslationError < ::DeepL::Exceptions::Error
  # +error+ is the failure being wrapped; the HTTP status and retryability of a DeepL error
  # are copied from it.
  #
  # pkg:gem/deepl-rb#lib/deepl/exceptions/document_translation_error.rb:15
  def initialize(message, handle, error = T.unsafe(nil)); end

  # @return [DeepL::Resources::DocumentHandle, nil] Handle of the uploaded document, +nil+ if
  #   the upload failed. Use it to query the status or download the document later.
  #
  # pkg:gem/deepl-rb#lib/deepl/exceptions/document_translation_error.rb:11
  def document_handle; end

  # @return [Boolean] +should_retry?+ of the wrapped DeepL error, +false+ without one.
  #
  # pkg:gem/deepl-rb#lib/deepl/exceptions/document_translation_error.rb:26
  def should_retry?; end
end

