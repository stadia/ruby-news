  end
end

# pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:8
module DeepL::Utils::HTTPClientBuilder
  extend ::DeepL::Utils::HTTPClientBuilder

  # Builds an unstarted Net::HTTP client for +host+ configured with +options+. Net::HTTP does
  # not retry on its own (+max_retries+ 0): only the library's retries apply.
  #
  # @param [String] host Base URL of the API.
  # @param [DeepL::HTTPClientOptions] options Proxy, SSL and timeout options.
  # @return [Net::HTTP]
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:18
  def build(host, options); end

  # Net::HTTP would re-send idempotent requests once on its own, outside max_retries, and would
  # return a body shorter than its Content-Length as complete (+ignore_eof+, net-http 0.3+).
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:35
  def disable_lenient_defaults(http); end

  private

  # pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:74
  def decode(value); end

  # Error messages show the URL without its user info; the URI error, which repeats the URL,
  # is not kept as cause.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:62
  def parse_proxy_url(proxy); end

  # The proxy is either a URL string, e.g. +http://user:pass@proxy.example:8080+, or a hash
  # with +proxy_addr+ and +proxy_port+. Returns the proxy arguments of +Net::HTTP.new+.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/http_client_builder.rb:45
  def proxy_arguments(proxy); end
end

# Reads numbers from API responses without failing on unexpected values.
#
# pkg:gem/deepl-rb#lib/deepl/utils/number_parser.rb:10
module DeepL::Utils::NumberParser
  extend ::DeepL::Utils::NumberParser

  # @return [Integer] The value if it is an Integer, otherwise 0.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/number_parser.rb:14
  def count(value); end

  # @return [Float] The value as a Float if it is numeric, otherwise 0.0.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/number_parser.rb:19
  def minutes(value); end

  # @return [Integer, nil] The value if it is an Integer, otherwise nil.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/number_parser.rb:29
  def optional_count(value); end

  # @return [Float, nil] The value as a Float if it is numeric, otherwise nil.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/number_parser.rb:24
  def optional_minutes(value); end
end

# pkg:gem/deepl-rb#lib/deepl/utils/term_validator.rb:8
module DeepL::Utils::TermValidator
  extend ::DeepL::Utils::TermValidator

  # Strips surrounding whitespace from a single glossary or spoken term, then checks it
  # before it is serialized into a request.
  #
  # @param [String] term The term to check.
  # @return [String] The stripped term, which is what the request sends.
  # @raise [DeepL::Exceptions::ValidationError] If the stripped term is empty or contains a
  #   control character.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/term_validator.rb:22
  def validate!(term); end
end

# C0 and C1 control characters plus the Unicode line and paragraph separators.
#
# pkg:gem/deepl-rb#lib/deepl/utils/term_validator.rb:12
DeepL::Utils::TermValidator::INVALID_CHARACTERS = T.let(T.unsafe(nil), Regexp)

# pkg:gem/deepl-rb#lib/deepl/utils/time_parser.rb:10
module DeepL::Utils::TimeParser
  extend ::DeepL::Utils::TimeParser

  # Parses an optional timestamp returned by the API.
  #
  # @param [String, nil] time_string Timestamp in ISO 8601 format, or nil.
  # @return [Time, nil] The parsed time, or nil if no timestamp was given.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/time_parser.rb:19
  def parse_optional_time(time_string); end

  # Like +parse_optional_time+, but treats timestamps without a zone offset as UTC.
  #
  # @param [Object] time_string Timestamp in ISO 8601 format, or nil.
  # @return [Time, nil] The parsed time, or nil if no valid timestamp was given.
  #
  # pkg:gem/deepl-rb#lib/deepl/utils/time_parser.rb:30
  def parse_optional_utc_time(time_string); end
end

