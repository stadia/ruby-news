#         "commit": "…",
#         "plugins": {
#           "compound-writing": {
#             "version": "2.4.1", "version_kind": "manifest", "commit": "…",
#             "tree_sha256": "…", "source": { "kind": "relative", "path": "" },
#             "skills": ["cw-draft", "…"]
#           }
#         }
#       }
#     }
#   }
#
