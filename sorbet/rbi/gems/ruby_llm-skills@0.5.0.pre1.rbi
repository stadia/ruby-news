class RubyLLM::Skills::ParseError < ::RubyLLM::Skills::Error; end

# Parses SKILL.md files with YAML frontmatter.
#
# A valid SKILL.md has the format:
#   ---
#   name: skill-name
#   description: What the skill does
#   ---
#   # Skill content here
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/parser.rb:16
class RubyLLM::Skills::Parser
  class << self
    # Extract the body content (everything after frontmatter).
    #
    # @param content [String] full SKILL.md content
    # @return [String] body content without frontmatter
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/parser.rb:55
    def extract_body(content); end

    # Parse a SKILL.md file and extract frontmatter metadata.
    #
    # @param path [String, Pathname] path to SKILL.md file
    # @return [Hash] parsed frontmatter as hash
    # @raise [ParseError] if frontmatter is missing or invalid
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/parser.rb:26
    def parse_file(path); end

    # Parse SKILL.md content string and extract frontmatter.
    #
    # @param content [String] full SKILL.md content
    # @return [Hash] parsed frontmatter as hash
    # @raise [ParseError] if frontmatter is missing or invalid
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/parser.rb:40
    def parse_string(content); end

    private

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/parser.rb:64
    def parse_yaml(yaml_content); end
  end
end

