  # @return [String] skill name from frontmatter
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:38
  def name; end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:22
  def path; end

  # List reference files in the references/ directory.
  # Loaded lazily on first access.
  #
  # @return [Array<String>] paths to reference files
