# Where a marketplace's bytes come from: one adapter per source kind.
# +head+ answers "did the upstream move?" cheaply (a commit sha or a
# tree hash), +catalog_files+ fetches only the marketplace file(s),
# +source_tree+ fetches one plugin's content (the marketplace's own tree
# for relative sources, memoized so ten relative plugins cost one
# download; another repository's archive for github / gitlab sources;
# a .tar.gz for archive sources). Nothing here runs git.
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:16
module RubyLLM::Skills::Marketplace::Fetcher
  class << self
    # @param source [Locator::Source]
    # @return [Base]
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:27
    def for(source); end
  end
end

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:37
class RubyLLM::Skills::Marketplace::Fetcher::Base
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:40
  def initialize(source); end

  # `{ path => bytes }` for the marketplace files that exist at +head+.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:51
  def catalog_files(head); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:46
  def head(previous_sha: T.unsafe(nil), previous_etag: T.unsafe(nil)); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:38
  def source; end

  # The commit a source resolves to right now, without downloading it
  # (nil for an archive, whose identity is its digest).
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:72
  def source_sha(plugin_source, head:); end

  # The plugin content for one marketplace entry.
  #
  # @param plugin_source [Manifest::PluginSource]
  # @param head [Head]
  # @return [Fetched]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:60
  def source_tree(plugin_source, head:); end

  private

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:100
  def archive_tree(plugin_source); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:82
  def relative_tree(plugin_source, head); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:86
  def repo_sha(repo, plugin_source); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:90
  def repo_tree(repo, plugin_source); end

  # An archive may carry the plugin at its top or one folder down: a
  # single root directory that itself holds a plugin marker (a
  # `skills/` directory, a manifest, a root `SKILL.md`) is a wrapper
  # and is stripped; a root that is the plugin's own `skills/` is not.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:117
  def strip_single_root(files); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:130
  def subtree(files, subdir, where); end

  # One download per repository commit however many plugins live in it.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/fetcher.rb:96
  def tarball(repo, sha); end
end

