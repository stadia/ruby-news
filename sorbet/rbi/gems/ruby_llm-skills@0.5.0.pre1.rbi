  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:125
  def valid?; end

  # Check if skill is a virtual/database skill (no filesystem resources).
  #
  # @return [Boolean] true if skill has no filesystem resources
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:109
  def virtual?; end

  private

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:176
  def list_resources(subdir); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:153
  def load_content; end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:172
  def single_file?; end
end

# A RubyLLM Tool that enables progressive skill loading.
#
# This tool is the key integration point for LLM skill discovery.
# It embeds skill metadata (name + description) in its description,
# allowing the LLM to discover available skills. When invoked,
# it returns the full skill content.
#
# Progressive Disclosure Pattern:
# 1. Skill metadata is always visible in the tool description (~100 tokens/skill)
# 2. Full skill content is loaded on-demand when the tool is called (~5k tokens)
# 3. Resources (scripts, references) can be loaded separately as needed
#
# @example Basic usage
#   loader = RubyLLM::Skills.from_directory("app/skills")
#   skill_tool = RubyLLM::Skills::SkillTool.new(loader)
#
#   chat.with_tools(skill_tool)
#   chat.ask("Help me generate a PDF report")
#   # LLM sees available skills, calls skill_tool with name="pdf-report"
#   # Tool returns full SKILL.md content for LLM to follow
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:28
class RubyLLM::Skills::SkillTool < ::RubyLLM::Tool
  # Initialize with a skill loader.
  #
  # @param loader [Loader] any loader (FilesystemLoader, ZipLoader, etc.)
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:49
  def initialize(loader); end

  # Dynamic description including available skills.
  #
  # @return [String] tool description with embedded skill metadata
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:56
  def description; end

  # Execute the tool to load a skill's content or a specific resource.
  #
  # @param command [String] name of skill to load
  # @param arguments [String, nil] optional arguments passed with the command
  # @param resource [String, nil] optional resource path within the skill
  # @return [String] skill content, resource content, or error message
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:79
  def execute(command:, arguments: T.unsafe(nil), resource: T.unsafe(nil)); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:37
  def loader; end

  # Convert to RubyLLM Tool-compatible format.
  #
  # @return [Hash] tool definition for RubyLLM
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:97
  def to_tool_definition; end

  private

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:125
  def build_skill_response(skill, arguments: T.unsafe(nil)); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:107
  def build_skills_xml; end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:166
  def escape_xml(text); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:200
  def list_available_resources(skill); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:177
  def load_resource(skill, resource_path); end

  class << self
    # Tool name for RubyLLM.
    #
    # @return [String] "skill"
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill_tool.rb:42
    def tool_name; end
  end
end

# Shared duck-typing predicates for classifying skill sources.
# Used by both AgentExtensions and ChatExtensions.
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/source_detection.rb:7
module RubyLLM::Skills::SourceDetection
  private

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/source_detection.rb:19
  def database_collection_source?(source); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/source_detection.rb:10
  def loader_source?(source); end

  # A Marketplace::Registry: its installed plugins load through #loader.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/source_detection.rb:15
  def marketplace_source?(source); end
end

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/version.rb:5
RubyLLM::Skills::VERSION = T.let(T.unsafe(nil), String)

# Validates skill structure according to the Agent Skills specification.
#
# Validation rules based on agentskills.io specification:
# - name: required, max 64 chars, lowercase + hyphens only, no leading/trailing hyphens
# - description: required, max 1024 chars
# - license: optional, max 128 chars
# - compatibility: optional, max 500 chars
#
# @example
#   errors = Validator.validate(skill)
#   puts errors # => [] if valid, or list of error messages
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:17
class RubyLLM::Skills::Validator
  class << self
    # Check if a skill is valid.
    #
    # @param skill [Skill] skill to validate
    # @return [Boolean] true if skill passes validation
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:43
    def valid?(skill); end

    # Validate a skill and return all errors.
    #
    # @param skill [Skill] skill to validate
    # @return [Array<String>] list of error messages (empty if valid)
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:29
    def validate(skill); end

    private

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:88
    def validate_compatibility(skill, errors); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:66
    def validate_description(skill, errors); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:79
    def validate_license(skill, errors); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:49
    def validate_name(skill, errors); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:97
    def validate_path_name_match(skill, errors); end
  end
end

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:21
RubyLLM::Skills::Validator::COMPATIBILITY_MAX_LENGTH = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:19
RubyLLM::Skills::Validator::DESCRIPTION_MAX_LENGTH = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:20
RubyLLM::Skills::Validator::LICENSE_MAX_LENGTH = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:18
RubyLLM::Skills::Validator::NAME_MAX_LENGTH = T.let(T.unsafe(nil), Integer)

# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/validator.rb:22
RubyLLM::Skills::Validator::NAME_PATTERN = T.let(T.unsafe(nil), Regexp)
