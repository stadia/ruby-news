RubyLLM::Skills::Marketplace::Registry::SCRATCH_PREFIX = T.let(T.unsafe(nil), String)

# The one tar.gz reader for upstream content: every entry path is
# cleaned and refused when it escapes (`..`, absolute); anything but a
# regular file or directory (symlinks, hardlinks, devices, FIFOs) is
# dropped, never followed or written; the archive, each file and the
# file count are capped. GitHub and GitLab archives wrap the repository
# in one root directory, which +strip_root+ removes.
#
# Trees are plain hashes of `"relative/path" => bytes`.
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:22
module RubyLLM::Skills::Marketplace::Tarball
  class << self
    # `..`, absolute paths, empty names and NUL bytes are refused before
    # any path is joined to a directory.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:82
    def clean_path(name); end

    # The directory as `{ "path" => bytes }` (regular files only).
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:110
    def from_directory(dir, max_bytes: T.unsafe(nil), max_file_bytes: T.unsafe(nil), max_files: T.unsafe(nil)); end

    # @param archive [String] tar.gz bytes
    # @param strip_root [Boolean] drop the single wrapping directory
    # @param subdir [String, nil] keep only this directory, re-rooted
    # @return [Hash{String => String}] the files
    # @raise [InvalidPluginError]
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:33
    def read(archive, strip_root: T.unsafe(nil), subdir: T.unsafe(nil), max_bytes: T.unsafe(nil), max_file_bytes: T.unsafe(nil), max_files: T.unsafe(nil)); end

    # sha256 over the sorted paths and content hashes: the tree's identity.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:139
    def tree_sha256(files); end

    # `{ "path" => bytes }` to tar.gz bytes, entries sorted and the
    # mtime zeroed so the same tree always yields the same archive.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:94
    def write(files, root: T.unsafe(nil)); end

    # Writes the tree under +dir+, creating parents; replaces nothing else.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:129
    def write_directory(files, dir); end

    private

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:153
    def clean_prefix(subdir); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/tarball.rb:149
    def config; end
  end
end

