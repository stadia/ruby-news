  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:87
  def references; end

  # Clear cached content and resources (useful for testing).
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:137
  def reload!; end

  # List script files in the scripts/ directory.
  # Loaded lazily on first access.
  #
  # @return [Array<String>] paths to script files
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:79
  def scripts; end

  # Path to the SKILL.md file.
  #
  # @return [String, nil] path to SKILL.md or nil for virtual skills
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/skill.rb:116
  def skill_md_path; end

  # Validate the skill structure.
  #
  # @return [Boolean] true if skill is valid
