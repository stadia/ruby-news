    # The marketplace file among +files+ (`{ path => bytes }`), in discovery order.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:83
    def discover(files); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:116
    def entry(raw, index, plugin_root: T.unsafe(nil)); end

    # `https://github.com/o/r[.git]`, `git@github.com:o/r.git`, `owner/repo`
    # and their gitlab.com twins; any other host is unsupported.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:157
    def git_url(url, ref: T.unsafe(nil), sha: T.unsafe(nil), subdir: T.unsafe(nil), raw: T.unsafe(nil)); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:147
    def github(repo, ref: T.unsafe(nil), sha: T.unsafe(nil), subdir: T.unsafe(nil), raw: T.unsafe(nil)); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:151
    def gitlab(project, ref: T.unsafe(nil), sha: T.unsafe(nil), subdir: T.unsafe(nil), raw: T.unsafe(nil)); end

    # A relative path inside the marketplace repo: "./x", "x", "./" and "."
    # are accepted; anything escaping the root is nil.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:179
    def normalize_relative(path, allow_blank:); end

    # `owner/repo`, with a leading slash, trailing slash or `.git` removed.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:187
    def normalize_repo(value); end

