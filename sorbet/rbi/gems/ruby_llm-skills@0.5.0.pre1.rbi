    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:191
    def presence(value); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:137
    def relative(path, plugin_root: T.unsafe(nil)); end

    # `{ "old" => "new" }`, keeping only well-formed names; a nil value marks a removal.
    #
    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:197
    def renames(raw); end

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:129
    def source(raw, plugin_root: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/manifest.rb:248
    def archive_problem(url, sha256); end

    # nil when the path is absolute, escapes the root or carries unsafe bytes.
