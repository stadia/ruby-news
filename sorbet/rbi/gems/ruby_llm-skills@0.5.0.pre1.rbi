# The public surface: marketplaces recorded in a lockfile, their plugins
# installed under a root directory, and a loader over what is installed.
#
# @example
#   marketplaces = RubyLLM::Skills.marketplaces           # vendor/skills + skills.lock.json
#   marketplaces.add("EveryInc/compound-writing")          # follows the default branch
#   marketplaces.add("typesafe-ai/skills", ref: "v0.5.7")  # pinned to a tag
#   marketplaces.plugins("compound-writing").map(&:name)
#   marketplaces.install("compound-writing")               # every supported plugin
#   marketplaces.install("typesafe-ai", only: ["typesafe"])
#   marketplaces.install                                   # reproduce the lockfile
#   marketplaces.update                                    # move every unpinned ref forward
#   marketplaces.remove("typesafe-ai")
#   chat.with_skills(marketplaces)
#
# pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:24
class RubyLLM::Skills::Marketplace::Registry
  # @param root [String] where plugins are written (default: Marketplace.root)
  # @param lockfile [String] the lockfile path (default: Marketplace.lockfile)
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:66
  def initialize(root: T.unsafe(nil), lockfile: T.unsafe(nil)); end

  # Records a marketplace and caches its marketplace file; installs nothing.
  #
  # @param locator [String] `owner/repo`, `owner/repo@ref`, a repository URL, a hosted `.json` URL, or a directory
  # @param ref [String, nil] a branch, tag or commit sha to pin the marketplace to
  # @param as [String, nil] the name to record it under (default: the marketplace file's `name`)
  # @return [Record]
  # @raise [FetchError, InvalidManifestError, ArgumentError]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:78
  def add(locator, ref: T.unsafe(nil), as: T.unsafe(nil)); end

  # @return [Record]
  # @raise [NotFoundError]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:111
  def fetch(name); end

  # @return [Record, nil]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:105
  def find(name); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:198
  def inspect; end

  # Installs plugins. With a marketplace name, every supported plugin of
  # that marketplace (or +only+ the named ones) at the marketplace's
  # recorded commit. With no name, every plugin in the lockfile at its
  # recorded commit, so a fresh checkout reproduces the same trees.
  #
  # @return [Result]
  # @raise [NotFoundError] for an unknown marketplace or plugin name
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:129
  def install(name = T.unsafe(nil), only: T.unsafe(nil)); end

  # @return [Array<InstalledPlugin>] in lockfile order
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:180
  def installed; end

  # @return [Array<Record>] every recorded marketplace
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:100
  def list; end

  # A loader over every installed plugin's skills.
  #
  # @return [Loader]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:187
  def loader; end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:62
  def lockfile_path; end

  # The plugins a marketplace lists, from the cached marketplace file.
  #
  # @return [Array<Manifest::Entry>]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:118
  def plugins(name); end

  # Forget the cached lockfile so the next call re-reads it.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:193
  def reload!; end

  # Deletes a marketplace's directory and lockfile entry.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:159
  def remove(name); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:62
  def root; end

  # Deletes one plugin's directory and lockfile entry.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:169
  def uninstall(name, plugin); end

  # Moves marketplaces forward: re-resolves each ref, re-reads the
  # marketplace file when the head moved, refetches installed plugins
  # whose source moved, and rewrites the lockfile. A marketplace pinned
  # to a commit never moves.
  #
  # @return [Result]
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:147
  def update(name = T.unsafe(nil), only: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:245
  def cache_catalog!(name, files); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:251
  def catalog(record); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:281
  def catalog_cached?(record); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:208
  def finish(result); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:318
  def install_plugin(record, fetcher, head, entry, installed, result, reproduce:); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:295
  def install_plugins(record, names, result, reproduce:); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:223
  def installed_plugin(marketplace, plugin_name, data); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:204
  def lockfile; end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:229
  def marketplace_dir(name); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:352
  def on_disk?(installed); end

  # The lockfile's commit, so a reproduce fetches what was recorded rather than the ref's current head.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:346
  def pin_source(plugin_source, installed); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:357
  def plugin_data(entry, fetched, bundle); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:233
  def plugin_dir(marketplace, plugin); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:214
  def record(name); end

  # A Head standing at the recorded commit, so relative sources read the
  # marketplace tree exactly as it was recorded. A directory marketplace
  # has no history: its head is what the folder holds now.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:288
  def recorded_head(record); end

  # Re-resolves the ref; on a move, re-reads and caches the marketplace file.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:271
  def refresh_head!(record); end

  # Names come from marketplace files and the lockfile; only a kebab-case
  # name may become a directory under the root.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:239
  def safe_name(name); end

  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:266
  def supported_plugin_names(record); end

  # Written to a scratch directory beside the target and moved into
  # place with one rename, so a failure leaves no partial tree.
  #
  # pkg:gem/ruby_llm-skills#lib/ruby_llm/skills/marketplace/registry.rb:369
  def write_tree!(target, bundle); end
end

