  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:17
  def length(*_arg0, **_arg1, &_arg2); end

  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:17
  def size(*_arg0, **_arg1, &_arg2); end

  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:23
  def to_h; end

  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:17
  def to_s(*_arg0, **_arg1, &_arg2); end

  private

  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:32
  def queues_by_id; end

  # pkg:gem/mission_control-jobs#lib/active_job/queues.rb:16
  def values(*_arg0, **_arg1, &_arg2); end
end

