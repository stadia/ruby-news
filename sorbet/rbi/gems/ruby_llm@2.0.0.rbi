    # Text attachments become citable documents when citations are
    # enabled. Bedrock rejects text-format documents sent as bytes when
    # citations are on, so the text rides in the source's text member.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:125
    def format_text_document_attachment(attachment, used_document_names:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:82
    def format_video_attachment(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:93
    def media_format(attachment, aliases, supported); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:162
    def sanitize_document_name(filename); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:154
