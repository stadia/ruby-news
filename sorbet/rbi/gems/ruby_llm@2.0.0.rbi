# RubyLLM's private persistence for provider-side batches.
#
# pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:6
class RubyLLM::ActiveRecord::Batch < ::ActiveRecord::Base
  include ::RubyLLM::ActiveRecord::Batch::GeneratedAttributeMethods
  include ::RubyLLM::ActiveRecord::Batch::GeneratedAssociationMethods

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:61
  def chats; end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:84
  def sync_from(batch); end

  # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:68
  def to_llm(context: T.unsafe(nil), store: T.unsafe(nil)); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:34
    def fetch(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:15
    def persist(batch, chats); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:38
    def sync(batch); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:11
    def __class_attr___callbacks; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:11
    def __class_attr___callbacks=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:6
    def __class_attr__validators; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:6
    def __class_attr__validators=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:6
    def __class_attr_defined_enums; end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:6
    def __class_attr_defined_enums=(new_value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:44
    def find_record(id, provider: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:52
    def persistable_chats?(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/active_record/batch.rb:56
