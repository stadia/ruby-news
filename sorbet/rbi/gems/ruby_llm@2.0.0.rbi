# OpenAI API integration.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:6
class RubyLLM::Providers::OpenAI < ::RubyLLM::Provider
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:16
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:55
  def batch_cost_multiplier(**); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:51
  def batch_results(id, batch_protocol: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:44
  def find_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:27
  def headers; end

  # Audio, realtime, and dedicated search models only exist on Chat Completions.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:21
  def protocol_for(model, **); end

  # OpenAI reports when each rate limit resets in its own headers,
  # as durations like "6m0s", "7.66s" or "76ms".
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:37
  def retry_delay(response); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:92
  def batch_protocol; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:96
  def batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:123
  def batch_protocol_for_endpoint(endpoint); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:118
  def batch_protocol_for_stored_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:103
  def batch_protocol_name_for(payload); end

  # Responses payloads carry the conversation as an array of message hashes
  # under :input; embedding payloads put the text itself there.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:114
  def embeddings_input?(input); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:83
  def parse_reset_duration(value); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:58
    def capabilities; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:66
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:76
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/openai.rb:62
    def models_dev_alias(*, **, &); end
  end
end

