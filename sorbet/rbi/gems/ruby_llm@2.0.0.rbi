  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:42
  def embedding_attempt_tokens(responses); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:21
  def embedding_url(model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:25
  def ensure_no_embedding_media!(with); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:52
  def extract_embedding(body); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:30
  def parse_single_embedding_responses(responses, model:, text:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:38
  def record_embedding_attempt(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/invoke_model.rb:12
  def signed_post(url, payload, additional_headers = T.unsafe(nil)); end
end

