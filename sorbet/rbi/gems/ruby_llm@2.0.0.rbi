  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:452
  def provider_file_upload_limit; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:460
  def provider_file_upload_options(_attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:19
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:216
  def retention_ttl(retention); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:254
  def schema_format(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:129
  def server_tool_result(item); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:444
  def supports_provider_file_references?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:289
  def system_input_item?(msg, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:98
  def warn_ignored_compaction_options(compaction); end

