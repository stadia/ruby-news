  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:406
  def parse_function_calls(output, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:139
