# A Chunk is one streamed fragment of an assistant response. Chunks are
# yielded to the block passed to Chat#ask or Chat#complete when streaming.
# A Chunk is a Message, so it responds to the same readers, but it holds
# only the data received in that part of the stream, such as a piece of
# content, partial tool calls, or the finish reason on the final chunk.
#
#   chat.ask "Write a haiku about Ruby" do |chunk|
#     print chunk.content
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/chunk.rb:14
class RubyLLM::Chunk < ::RubyLLM::Message; end

# A Citation links a span of generated text to the source material that
# supports it. Providers return citations in different shapes. RubyLLM
# normalizes all of them into Citation objects on Message#citations.
# Fields a provider does not report are +nil+.
#
#   chat = RubyLLM.chat(model: 'claude-sonnet-5').with_citations
#   response = chat.ask "Who created Ruby?", with: "facts.txt"
#
#   response.citations.each do |citation|
#     citation.title      # => "facts.txt"
#     citation.cited_text # => the quoted passage from facts.txt
#     citation.text       # => the span of the answer it supports
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:18
class RubyLLM::Citation
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:57
  def initialize(options = T.unsafe(nil)); end

  # Returns +true+ if +other+ is a Citation with the same attributes,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:96
  def ==(other); end

  # The quoted snippet from the source material, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:28
  def cited_text; end

  # The character offset where the cited span ends in the response
  # content, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:42
  def end_index; end

  # The last page of a PDF citation (1-indexed, inclusive), or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:55
  def end_page; end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:99
  def eql?(other); end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:101
  def hash; end

  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:74
  def inspect_attributes; end

  # The provider's identifier for the cited source, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:45
  def source_id; end

  # The 0-indexed position of the source document or search result,
  # or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:49
  def source_index; end

  # The character offset where the cited span starts in the response
  # content, or +nil+.
  #
  #   response.content[citation.start_index...citation.end_index] == citation.text # => true
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:38
  def start_index; end

  # The first page of a PDF citation (1-indexed, inclusive), or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:52
  def start_page; end

  # The span of the response content this citation supports, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:31
  def text; end

  # The title or filename of the cited source, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:25
  def title; end

  # Returns the citation as a Hash with symbol keys, omitting +nil+ fields.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:79
  def to_h; end

  # The URL of the cited source, when citing the web, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:22
  def url; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/citation.rb:70
    def from_h(data); end
  end
end

# A Configuration holds every RubyLLM setting: provider credentials,
# default models, timeouts, retries, logging, and the model registry.
# The global instance is yielded by RubyLLM.configure and available as
# RubyLLM.config.
#
#   RubyLLM.configure do |config|
#     config.openai_api_key = ENV['OPENAI_API_KEY']
#     config.anthropic_api_key = ENV['ANTHROPIC_API_KEY']
#   end
#
# RubyLLM.context yields an isolated copy for per-request or per-tenant
# overrides.
#
# Provider credentials such as +openai_api_key+ are declared by each
# provider. See https://rubyllm.com/next/configuration-providers/ for
# provider credentials and endpoint settings.
#
# Assigning an empty or whitespace-only string to any option stores
# +nil+, so unset environment variables behave as if the option was
# never set.
#
# pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:26
class RubyLLM::Configuration
  # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:295
  def initialize; end

  # pkg:gem/ruby_llm#lib/ruby_llm.rb:474
  def anthropic_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm.rb:474
  def anthropic_api_base=(value); end

