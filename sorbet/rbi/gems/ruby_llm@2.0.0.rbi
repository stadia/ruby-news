    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:169
    def format_non_tool_message(msg, caching: T.unsafe(nil), automatic_cache_target: T.unsafe(nil), citations: T.unsafe(nil)); end

    # Nova 2 takes reasoningConfig with an effort level instead of a token budget,
    # and rejects an enabled reasoningConfig that names no effort.
