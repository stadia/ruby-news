    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:469
    def effort_budget_tokens(effort, schema, model, max_output_tokens); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:489
    def enumerated_budget(effort, schema); end

    # Application inference profile ARNs contain '/', but Bedrock expects the model id
    # to remain one path segment.
