# The Cohere v2 API, a native wire format shared by Cohere's own host and
# the platforms that serve Command, Embed, Rerank, and Transcribe models.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere.rb:7
class RubyLLM::Protocols::Cohere < ::RubyLLM::Protocol
  include ::RubyLLM::Batch::Helpers
  include ::RubyLLM::Protocols::Cohere::BatchRequests
  include ::RubyLLM::Protocols::Cohere::Batches
  include ::RubyLLM::Protocols::Cohere::Chat
  include ::RubyLLM::Protocols::Cohere::Embeddings
  include ::RubyLLM::Protocols::Cohere::Media
  include ::RubyLLM::Protocols::Cohere::Models
  include ::RubyLLM::Protocols::Cohere::OCR
  include ::RubyLLM::Protocols::Cohere::Tokenization
  include ::RubyLLM::Protocols::Cohere::Rerank
  include ::RubyLLM::Protocols::Cohere::Streaming
  include ::RubyLLM::Protocols::Cohere::Tools
  include ::RubyLLM::Protocols::Cohere::Transcription
end

