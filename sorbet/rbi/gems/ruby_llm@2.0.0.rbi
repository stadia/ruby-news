# Models methods for the Vertex AI integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:7
module RubyLLM::Providers::VertexAI::Models
  # The configured location has to answer: without it we would report a
  # catalog the caller cannot reach. A supplementary location is a bonus,
  # so a failure there is a warning and the rest of the union stands.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:43
  def list_models; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:161
  def build_known_models(fetched_ids); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:181
  def build_model_from_api_data(model_data, model_id); end

  # MaaS models are called as publisher/name through the OpenAI-compatible
  # endpoint; directly served models by their bare catalog name.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:112
  def build_publisher_model(publisher, model_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:142
  def catalog(publisher, connection); end

  # The location lives in the host, so locations sharing one api base,
  # as they do behind a custom vertexai_api_base, are one catalog.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:71
  def catalog_connections; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:65
  def configured_location; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:77
  def connection_for(location); end

  # Deploy-it-yourself Model Garden cards expose deploy actions; managed
  # services Vertex AI serves on our behalf never do.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:125
  def deployable?(model_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:203
  def determine_model_family(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:226
  def extract_capabilities(name); end

  # A publisher with nothing to offer in a region answers 200 with an
  # empty list, so any error here is infrastructure, not an empty
  # catalog. Reporting a partial catalog as a success would drop the
  # missing publishers from the registry.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:92
  def location_models(connection); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:83
  def log_catalog(counts, models); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:106
  def publisher_models(publisher, connection); end

  # Among the managed models, which publishers we route by bare name, and
  # for Google (whose catalog is a grab-bag of vision, media, and AutoML
  # products) which of those names are chat or embedding models.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:133
  def served_directly?(publisher, name); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:8
    def models_dev_alias(model_id, models_dev_by_key, _provider_model = T.unsafe(nil)); end
  end
end

# Vertex AI serves a different slice of the catalog in each location and
# neither of these is a superset of the other, so a listing unions them.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:38
RubyLLM::Providers::VertexAI::Models::CATALOG_LOCATIONS = T.let(T.unsafe(nil), Array)

# Google models the publisher catalog omits in some regions while still
# serving them there. Every id must be callable in at least one region;
# ids that answer nowhere do not belong here.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:16
RubyLLM::Providers::VertexAI::Models::KNOWN_GOOGLE_MODELS = T.let(T.unsafe(nil), Array)

# Every publisher with models Vertex AI serves as a service. The rest
# of the Model Garden is deploy-it-yourself and not callable directly.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai/models.rb:34
RubyLLM::Providers::VertexAI::Models::PUBLISHERS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:21
RubyLLM::Providers::VertexAI::SCOPES = T.let(T.unsafe(nil), Array)

