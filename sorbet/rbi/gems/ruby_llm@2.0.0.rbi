    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:659
    def server_tool_use?(tool_use); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:96
    def supports_provider_file_references?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:243
    def text_tool_result_block(text); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:508
    def unknown_effort_message(effort, schema); end
  end
end

