# pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:8
class RubyLLM::Transport::ErrorMiddleware < ::Faraday::Middleware
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:9
  def initialize(app, options = T.unsafe(nil)); end

  # Sits directly above the adapter, inside the retry middleware, so this
  # runs once per attempt: streaming state stored on the env by a previous
  # attempt must not leak into the next one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:17
  def call(env); end

  private

  # The retry middleware only reads the standard Retry-After header, so
  # provider-specific rate-limit headers are normalized into it here,
  # where the provider is known.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:31
  def apply_retry_delay(response); end

  # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:41
  def streaming_error_response(response); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:76
    def parse_error(provider:, response:); end

    private

    # Providers hand back whatever their error body holds, which is not
    # always a String: bedrock-mantle nests code, message, and type in a
    # Hash. Match on the rendered text so any shape classifies.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:113
    def context_length_exceeded?(message); end

    # pkg:gem/ruby_llm#lib/ruby_llm/transport/error_middleware.rb:120
    def rate_limited?(message); end
  end
end

# Sits inside Faraday retry middleware so every transport attempt produces
