  def transcription_params(model:, language: T.unsafe(nil), speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:52
  def transcription_url(model:, language: T.unsafe(nil), speaker_names: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:88
  def post_transcription(url, payload, attachment); end
end

# Turned on by default so the transcript reads like the transcripts
