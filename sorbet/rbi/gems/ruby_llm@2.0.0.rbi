  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:598
  def upload_large_attachment?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:639
  def validate_animate_inputs!(with:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:633
  def validate_paint_inputs!(with:, mask:); end

  class << self
    # Declares seam methods that raise NotImplementedError until a subclass
    # overrides them: render_* serializes a request to wire form, *_url names an
    # endpoint, and parse_* reads a wire response back into RubyLLM objects.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol.rb:60
    def abstract(*names); end
  end
end

