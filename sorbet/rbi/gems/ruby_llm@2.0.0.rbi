    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:406
    def format_nova_reasoning_fields(thinking, model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:387
    def format_reasoning_fields(thinking, model, max_output_tokens = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:249
    def format_role(role); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:198
    def format_structured_message_content(msg, citations: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:256
    def format_system(messages, caching: T.unsafe(nil), automatic_cache_target: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:515
    def format_thinking_block(thinking); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:208
    def format_thinking_blocks(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:337
