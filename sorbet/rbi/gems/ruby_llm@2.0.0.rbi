  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:147
  def apply_end_user(payload, identifier); end

  # The Files API is still a beta, so a request that references an
  # uploaded file has to carry its beta header too.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:173
  def apply_files_beta(headers, payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/chat.rb:97
  def build_base_payload(chat_messages, model, stream, thinking, citations: T.unsafe(nil), caching: T.unsafe(nil), max_output_tokens: T.unsafe(nil)); end

