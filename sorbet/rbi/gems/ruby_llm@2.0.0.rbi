  def render_tool_approval_response(tool_call, approved:); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/approvals.rb:24
    def parse_pending_tool_calls(output, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/approvals.rb:14
    def parse_tool_approvals(output, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/approvals.rb:10
