  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:70
  def merge_turn_segments(segments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:66
  def stream_response(payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:62
  def sync_response(payload, additional_headers = T.unsafe(nil)); end
end

