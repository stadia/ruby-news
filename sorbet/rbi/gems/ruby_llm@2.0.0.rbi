  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:64
  def inspect_attributes; end

  # Whether this is a tentative transcript, replacing the previous partial.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:56
  def partial?; end

  # The parsed provider event, for fields RubyLLM does not normalize.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:42
  def raw; end

  # The segment this event completed as a Hash, or +nil+. Diarization
  # models label each segment with a speaker.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:39
  def segment; end

  # Whether this event completed a segment.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:59
  def segment?; end

  # The transcript for a partial event or the complete final transcript.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:35
  def text; end

  # The normalized event type, such as
  # <tt>"transcript.text.delta"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/transcription_chunk.rb:29
  def type; end
end

# Text deltas, arriving as the model transcribes.
