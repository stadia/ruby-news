    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:43
    def register_provider_options(options); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:56
    def defaults; end

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:28
    def option(key, default = T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/configuration.rb:55
    def option_keys; end
  end
end

# Raised when required configuration, such as a provider API key, is
# missing.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:53
class RubyLLM::ConfigurationError < ::StandardError; end

# A Context is an isolated configuration scope. It offers the same entry
# points as the top-level RubyLLM module but reads from its own
# Configuration copy instead of the global one, which suits multi-tenant
# applications and per-request overrides.
#
# Contexts are created with RubyLLM.context:
#
#   ctx = RubyLLM.context do |config|
#     config.openai_api_key = ENV.fetch('TENANT_OPENAI_API_KEY')
#     config.request_timeout = 180
#   end
#
#   ctx.chat.ask "Explain Ruby blocks."
#   ctx.paint("A paper boat in the rain").save("boat.png")
#   ctx.transcribe("meeting.wav").text
#
# The global configuration is left untouched.
#
# Batch submission uses each chat's own configuration (a chat carries
# the config it was built with), so there is no context entry point for
# it. To look up an existing batch, where no chats carry the config,
# pass a context to Batch.find:
#
#   RubyLLM::Batch.find(id, provider: :anthropic, context: ctx)
#
# pkg:gem/ruby_llm#lib/ruby_llm/context.rb:29
class RubyLLM::Context
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:32
  def initialize(config); end

  # Generates a video using this context's configuration, blocking
  # until it is ready. Accepts the same arguments as RubyLLM.animate.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:80
  def animate(*args, **kwargs, &); end

  # Submits a video generation job using this context's configuration.
  # Accepts the same arguments as RubyLLM.animate_later.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:86
  def animate_later(*args, **kwargs, &); end

  # Creates a provider-side prompt cache using this context's
  # configuration. Accepts the same arguments as RubyLLM.cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:147
  def cache(*args, **kwargs, &); end

  # Creates a new Chat that uses this context's configuration.
  # Accepts the same arguments as RubyLLM.chat.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:38
  def chat(*args, **kwargs, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:30
  def config; end

  # Counts tokens using this context's configuration.
  # Accepts the same arguments as RubyLLM.count_tokens.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:44
  def count_tokens(text, model: T.unsafe(nil), provider: T.unsafe(nil)); end

  # Downloads a provider-hosted file using this context's configuration.
  # Accepts the same arguments as RubyLLM.download.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:141
  def download(*args, **kwargs, &); end

  # Generates embeddings using this context's configuration.
  # Accepts the same arguments as RubyLLM.embed.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:62
  def embed(*args, **kwargs, &); end

  # Stages an embedding request using this context's configuration.
  # Accepts the same arguments as RubyLLM.embed_later.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:68
  def embed_later(text, model: T.unsafe(nil), provider: T.unsafe(nil), dimensions: T.unsafe(nil)); end

  # Runs content moderation using this context's configuration.
  # Accepts the same arguments as RubyLLM.moderate.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:92
  def moderate(*args, **kwargs, &); end

  # Extracts document text using this context's configuration.
  # Accepts the same arguments as RubyLLM.ocr.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:123
  def ocr(*args, **kwargs, &); end

  # Generates an image using this context's configuration.
  # Accepts the same arguments as RubyLLM.paint.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:74
  def paint(*args, **kwargs, &); end

  # Ranks documents using this context's configuration.
  # Accepts the same arguments as RubyLLM.rerank.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:129
  def rerank(*args, **kwargs, &); end

  # Runs hosted research using this context's configuration.
  # Accepts the same arguments as RubyLLM.research.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:98
  def research(*args, **kwargs); end

  # Submits hosted research using this context's configuration.
  # Accepts the same arguments as RubyLLM.research_later.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:104
  def research_later(*args, **kwargs); end

  # Generates speech audio using this context's configuration. Given a
  # block, yields SpeechChunk objects and returns the complete Speech.
  # Accepts the same arguments as RubyLLM.speak.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:111
  def speak(*args, **kwargs, &); end

  # Tokenizes plain text using this context's configuration.
  # Accepts the same arguments as RubyLLM.tokenize.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:50
  def tokenize(*args, **kwargs); end

  # Transcribes audio using this context's configuration.
  # Accepts the same arguments as RubyLLM.transcribe.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:117
  def transcribe(*args, **kwargs, &); end

  # Uploads a file to a provider using this context's configuration.
  # Accepts the same arguments as RubyLLM.upload.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:135
  def upload(*args, **kwargs, &); end

  # Runs a named workflow using this context's instrumenter. Accepts the same
  # arguments as RubyLLM.workflow.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/context.rb:56
  def workflow(name, id: T.unsafe(nil), metadata: T.unsafe(nil), &); end
end

# Raised when the request exceeds the model's context window or token
# limits.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:120
class RubyLLM::ContextLengthExceededError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:121
    def default_message; end
  end
end

# A Cost prices token usage in US dollars using pricing from the model
# registry. Usage entries own accounting events; Message and Chat aggregate
# calls, and Model#cost_for prices any token usage against a specific model.
#
#   response = chat.ask "Summarize Ruby's object model."
#   response.cost.total
#
#   cost = model.cost_for(response.tokens)
#   cost.input
#   cost.output
#
# The components are RubyLLM's normalized token buckets: #input, #output,
# #cache_read, #cache_write, and #thinking. When the registry lacks
# pricing for tokens that were used, the affected component and #total
# return +nil+ instead of a false zero.
#
# When the provider reports the exact cost of a call, #total returns the
# reported amount instead of a registry-price estimate, even when
# registry pricing is missing.
#
# Costs are computed when the object is built. Readers do not recalculate
# them when registry prices change.
# ::aggregate and ::from_h return the same class, so a single call, a
# whole chat, and a stored breakdown all read the same way.
#
# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:28
class RubyLLM::Cost
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:99
  def initialize(tokens: T.unsafe(nil), model: T.unsafe(nil), category: T.unsafe(nil), input_details: T.unsafe(nil), tier: T.unsafe(nil), amounts: T.unsafe(nil), missing: T.unsafe(nil), reported: T.unsafe(nil), complete: T.unsafe(nil), total: T.unsafe(nil)); end

  # Returns the cost of cache-read input tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:128
  def cache_read; end

  # Returns the cost of cache-write input tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:134
  def cache_write; end

  # Returns the cost of input tokens in US dollars, or +nil+ when the
  # token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:116
  def input; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:179
  def missing?(component); end

  # Returns the cost of billable output tokens in US dollars, or +nil+
  # when the token count or its pricing is unavailable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:122
  def output; end

  # Returns the cost of thinking tokens in US dollars, or +nil+ when
  # the model does not price reasoning output separately from regular
  # output or the token count is unavailable. When not priced
  # separately, thinking tokens are part of #output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:142
  def thinking; end

  # Returns a hash of component costs in US dollars, plus +:total+,
  # omitting +nil+ values.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:164
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:175
  def tokens?; end

  # Returns the sum of all components in US dollars, or the exact amount
  # the provider reported when it reported one. Returns +nil+ when there
  # is no token usage, or when pricing is missing for tokens that were
  # used and the provider reported no cost.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:150
  def total; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:207
  def amount_for(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:274
  def applicable_text_tier; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:292
  def category_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:306
  def detailed_image_input?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:302
  def image_cost?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:310
  def image_input_amount; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:320
  def image_input_missing?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:326
  def image_input_parts; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:288
  def image_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:334
  def input_detail(key); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:249
  def input_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:357
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:200
  def missing_component?(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:347
  def normalize_model(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:255
  def output_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:239
  def price_for(component); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:185
  def price_tokens(tokens, model, category, input_details, tier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:280
  def prompt_tokens; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:196
  def reported_total; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:262
  def text_input_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:266
  def text_output_price; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:270
  def text_price(attribute, standard_price); end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:284
  def text_pricing; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:338
  def thinking_priced_separately?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:222
  def tokens_for(component); end

  class << self
    # Combines several costs into one Cost that sums each component.
    # Ignores +nil+ entries. A component returns +nil+ when pricing was
    # missing for one of the calls, or when no call has a cost for that
    # component. Pass <tt>complete: false</tt> when some requests are still
    # running or their costs are unknown; #total then remains +nil+.
    #
    #   cost = RubyLLM::Cost.aggregate(messages.map(&:cost))
    #   cost.total
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:44
    def aggregate(costs, complete: T.unsafe(nil)); end

    # Rebuilds a cost from a stored breakdown Hash, as produced by #to_h
    # and persisted alongside a usage entry. Keys may be Strings or
    # Symbols. The component readers return the recorded amounts and
    # #total equals the recorded +:total+.
    #
    #   RubyLLM::Cost.from_h({ input: 0.0001, total: 0.0003 }).total
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:66
    def from_h(hash, tokens: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:77
    def aggregate_total(costs); end

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:82
    def missing_recorded_components(amounts, tokens, total_recorded); end

    # pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:91
    def recorded_tokens?(amounts, tokens, total_recorded); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:31
RubyLLM::Cost::COMPONENTS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/cost.rb:32
RubyLLM::Cost::PER_MILLION = T.let(T.unsafe(nil), Float)

# Raised when a deprecated API is used and
# Configuration#deprecation_behavior is +:raise+. With the default
# +:warn+, deprecations are logged instead.
#
#   RubyLLM.configure do |config|
#     config.deprecation_behavior = :raise
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:49
class RubyLLM::DeprecationError < ::StandardError; end

# A DownloadedFile contains a provider file's bytes. Save it with #save
# or read the bytes with #to_blob. It is also a String, so parsers and
# existing string operations work directly on the result.
#
#   RubyLLM.download(file.id, provider: :openai).save("report.pdf")
#
# pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:10
class RubyLLM::DownloadedFile < ::String
  include ::RubyLLM::Support::Inspectable

  # Writes the file bytes to +path+, expanding it first. Returns +path+.
  #
  #   file.save("report.pdf")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:22
  def save(path); end

  # Returns the raw file bytes as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:14
  def to_blob; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/downloaded_file.rb:29
  def inspect_attributes; end
end

# An Embedding is the result of turning text into numerical vectors.
# RubyLLM.embed returns one:
#
#   embedding = RubyLLM.embed("Ruby is a programmer's best friend")
#   embedding.vectors # => [0.018, -0.027, ...]
#
# Pass an array to embed several texts in one call on supported models:
#
#   RubyLLM.embed(["Ruby", "Rails"]).vectors # => [[...], [...]]
#
# Store the vectors for similarity search. #tokens and #cost report
# usage when the provider supplies it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:17
class RubyLLM::Embedding
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:35
  def initialize(vectors:, model:, sparse_vectors: T.unsafe(nil), input_tokens: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # Returns the embedding cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:51
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:155
  def inspect_attributes; end

  # The id of the model that produced the vectors, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:33
  def model; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:57
  def model_info; end

  # The sparse vectors, for models that return one beside the dense
  # vector, as a Hash mapping token id to weight. Shaped like #vectors:
  # one Hash for a single text, an array of them for an array of texts.
  # +nil+ on models that return only dense vectors.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:30
  def sparse_vectors; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:44
  def tokens; end

  # The embedding vectors. A flat array of floats when a single text
  # was embedded, an array of such arrays when an array of texts was
  # embedded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:24
  def vectors; end

  class << self
    # Generates embeddings for +text+ and returns an Embedding. +text+
    # may be a single string or, on supported models, an array of strings.
    # An array produces one vector per string in a single API call.
    #
    #   RubyLLM.embed "Ruby is a programmer's best friend"
    #   RubyLLM.embed ["Ruby", "Python", "JavaScript"]
    #   RubyLLM.embed "This is a test sentence",
    #                 model: "text-embedding-3-large",
    #                 dimensions: 512
    #   RubyLLM.embed "RubyLLM makes provider APIs feel native to Ruby.",
    #                 model: "gemini-embedding-001",
    #                 provider: :vertexai,
    #                 task_type: "RETRIEVAL_DOCUMENT",
    #                 title: "RubyLLM docs"
    #   RubyLLM.embed "The Ruby logo",
    #                 model: "gemini-embedding-2",
    #                 with: "logo.png"
    #
    # +model:+ selects the embedding model and defaults to the
    # configured +default_embedding_model+. +provider:+ forces a specific
    # provider, and <tt>assume_model_exists: true</tt> skips the model
    # registry check. +context:+ supplies a Context whose configuration
    # is used instead of the global one. +dimensions:+ requests a
    # specific vector size on models that support it. +task_type:+ names
    # the embedding task in the provider's own vocabulary: Vertex AI and
    # Gemini take values such as <tt>"RETRIEVAL_QUERY"</tt> or
    # <tt>"RETRIEVAL_DOCUMENT"</tt>, while Bedrock Cohere takes an input
    # type such as <tt>"search_document"</tt>. +title:+ labels the
    # document on Vertex AI and Gemini retrieval tasks. Providers that
    # have no task concept ignore both. +with:+ passes one or more media
    # attachments (images, audio, video, PDFs) to embed alongside the
    # text on multimodal embedding models such as Gemini's
    # gemini-embedding-2; providers without multimodal embeddings raise
    # UnsupportedAttachmentError. +provider_options:+ takes options
    # in the provider's request vocabulary and merges them into the
    # request as-is. +metadata:+ is not sent to the provider; it is
    # attached to the emitted +embedding.ruby_llm+ instrumentation event.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:100
    def embed(text, model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), dimensions: T.unsafe(nil), task_type: T.unsafe(nil), title: T.unsafe(nil), with: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil)); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:151
    def embedding_count(vectors); end

    # pkg:gem/ruby_llm#lib/ruby_llm/embedding.rb:146
    def vector_dimensions(vectors); end
  end
end

# An EmbeddingRequest is an embedding awaiting a provider-side batch.
# RubyLLM.embed_later stages one; submit an array of them with
# RubyLLM.batch, and once the batch completes, collecting the results
# fills in #result:
#
#   requests = texts.map { |text| RubyLLM.embed_later(text) }
#   batch = RubyLLM.batch(requests)
#   # later, once batch.refresh.complete?
#   batch.results
#   requests.first.result.vectors
#
# pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:15
class RubyLLM::EmbeddingRequest
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:35
  def initialize(text, model: T.unsafe(nil), provider: T.unsafe(nil), dimensions: T.unsafe(nil), context: T.unsafe(nil)); end

  # The requested vector size, or +nil+ for the model's default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:25
  def dimensions; end

  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:49
  def inspect_attributes; end

  # The Model of the embedding model the request targets.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:22
  def model; end

  # The Provider the request will be submitted through.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:28
  def provider; end

  # Returns the request payload this embedding request would send to the
  # provider, in the provider's wire format.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:45
  def render; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result; end

  # The Embedding, once the batch has completed and its results have
  # been collected. +nil+ until then, and for requests that failed.
  # Batch result collection writes it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:33
  def result=(_arg0); end

  # The text staged for embedding.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/embedding_request.rb:19
  def text; end
end

# Error is the base class for provider-operation errors raised by
# RubyLLM, including API, network, capability, and provider response-shape
# failures. When an HTTP response is available, it wraps that response and
# normalizes the message across providers. Subclasses map common HTTP
# status codes: BadRequestError (400), UnauthorizedError (401),
# PaymentRequiredError (402), ForbiddenError (403), RateLimitError (429),
# ServerError (500), ServiceUnavailableError (502 to 504), and
# OverloadedError (529).
#
#   begin
#     RubyLLM.chat.ask "Translate 'hello' to French."
#   rescue RubyLLM::RateLimitError
#     puts "Rate limit hit. Please wait a moment."
#   rescue RubyLLM::Error => e
#     puts "API error: #{e.message}"
#     puts e.response&.status
#   end
#
# Local setup and programming errors, such as ConfigurationError and
# ModelNotFoundError, inherit from StandardError directly and are not
# caught by rescuing Error.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:25
class RubyLLM::Error < ::StandardError
  # Creates an error with +message+. Pass +response:+ to attach the HTTP
  # response; its body supplies the message when +message+ is +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:36
  def initialize(message = T.unsafe(nil), response: T.unsafe(nil)); end

  # The HTTP response that caused the error, or +nil+ when none is
  # available. Its +status+ and +body+ carry the provider's reply.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:28
  def response; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:30
    def default_message; end
  end
end

# A Fallback is a fallback model target configured with Chat#with_fallbacks.
# When the active model fails with a matching error, the chat retries the
# request with each fallback in order. Instances are yielded to
# Chat#before_fallback and Chat#after_fallback callbacks, enriched with the
# details of that attempt.
#
#   chat = RubyLLM.chat(model: "gpt-4.1")
#                 .with_fallbacks("gpt-4.1-mini", "claude-haiku-4-5")
#
#   chat.before_fallback do |fallback|
#     puts "Falling back from #{fallback.from.id} to #{fallback.to.id}"
#   end
#
#   chat.after_fallback do |fallback|
#     puts "Fallback #{fallback.succeeded? ? 'succeeded' : 'failed'}"
#   end
#
# pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:20
class RubyLLM::Fallback
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:85
  def initialize(id: T.unsafe(nil), provider: T.unsafe(nil), model: T.unsafe(nil), **attributes); end

  # The fallback attempt number, starting at 1.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:57
  def attempt; end

  # The Chat performing the fallback attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:45
  def chat; end

  # Returns whether the failed model already yielded stream chunks before
  # the fallback.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:117
  def chunks_yielded?; end

  # The error that triggered the fallback.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:48
  def error; end

  # Returns +true+ if the fallback attempt raised an error, +false+
  # otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:123
  def failed?; end

  # The error raised by the fallback attempt itself, or +nil+ if it
  # succeeded.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:64
  def fallback_error; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:104
  def finish(response: T.unsafe(nil), fallback_error: T.unsafe(nil)); end

  # The Model the chat is falling back from.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:51
  def from; end

  # The model id of the fallback target.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:35
  def id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:81
  def inspect_attributes; end

  # The Model object the fallback was configured with, or +nil+ when it was
  # configured with a model id.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:42
  def model; end

  # The provider slug of the fallback target as a String, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:38
  def provider; end

  # The response Message from a successful fallback attempt, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:60
  def response; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:66
  def streaming; end

  # Returns whether the fallback happened during a streaming request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:111
  def streaming?; end

  # Returns +true+ if the fallback attempt produced a response without
  # error, +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:129
  def succeeded?; end

  # The Model the chat is falling back to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:54
  def to; end

  # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:100
  def with_attempt(**attributes); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:68
    def build(value); end
  end
end

# The error classes that trigger a fallback when Chat#with_fallbacks is
# called without +on:+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/fallback.rb:25
RubyLLM::Fallback::DEFAULT_ERRORS = T.let(T.unsafe(nil), Array)

