# pkg:gem/ruby_llm#lib/ruby_llm/providers/anthropic.rb:7
module RubyLLM::Protocols; end

# The Anthropic Messages API.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:6
class RubyLLM::Protocols::Anthropic < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Anthropic::Chat
  include ::RubyLLM::Protocols::Anthropic::Embeddings
  include ::RubyLLM::Protocols::Anthropic::Media
  include ::RubyLLM::Protocols::Anthropic::Models
  include ::RubyLLM::Protocols::Anthropic::Streaming
  include ::RubyLLM::Protocols::Anthropic::Tools

  # Server tools can pause a long turn with stop_reason pause_turn; the
  # API expects the conversation back verbatim to continue it. Segments
  # are merged into the single Message the caller sees.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:45
  def complete(messages, *, **, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic.rb:38
