# The OpenAI Responses API. Overrides the chat surface of Chat Completions;
# embeddings, images, moderation, and transcription are inherited. Runs
# stateless (store: false) and replays encrypted reasoning so multi-turn
# tool calls work without server-side state.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:9
class RubyLLM::Protocols::Responses < ::RubyLLM::Protocols::ChatCompletions
  include ::RubyLLM::Protocols::Responses::Approvals
  include ::RubyLLM::Protocols::Responses::Chat
  include ::RubyLLM::Protocols::Responses::Media
  include ::RubyLLM::Protocols::Responses::Streaming
  include ::RubyLLM::Protocols::Responses::Tools

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses.rb:30
  def server_tool_aliases; end
end

