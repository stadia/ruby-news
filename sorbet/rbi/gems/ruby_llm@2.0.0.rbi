# Chat methods of the OpenRouter API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:7
module RubyLLM::Providers::OpenRouter::Chat
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:79
  def add_reasoning_toggle(reasoning, thinking); end

  # OpenRouter compacts through its context-compression plugin, which
  # drops messages from the middle of the conversation once the prompt
  # would overflow the model's context window. It summarizes nothing
  # and takes no threshold of its own, so the portable options have
  # nowhere to go.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:25
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:16
  def apply_end_user(payload, identifier); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:68
  def build_reasoning(thinking); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:165
  def default_large_file_upload_threshold; end

  # OpenRouter requires the reasoning_details array back untouched for
  # signed reasoning to survive multi-turn tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:211
  def extract_raw_reasoning(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:196
  def extract_thinking_signature(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:177
  def extract_thinking_text(message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:145
  def format_cache_option_keys(keys); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:38
  def format_content(content, attachments = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:109
  def format_message_content(msg, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:85
  def format_thinking(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:114
  def inject_cache_control(content, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:30
  def log_ignored_compaction_options(compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:149
  def openai_prompt_caching?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:126
  def prompt_cache_control(caching = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:134
  def prompt_cache_options(caching); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:173
  def provider_file_attachable?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:169
  def provider_file_upload_limit; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:42
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:153
  def reported_cost(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:58
  def strip_schema_strict(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:161
  def supports_provider_file_references?; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/openrouter/chat.rb:79
    def add_reasoning_toggle(reasoning, thinking); end

    # OpenRouter compacts through its context-compression plugin, which
    # drops messages from the middle of the conversation once the prompt
    # would overflow the model's context window. It summarizes nothing
    # and takes no threshold of its own, so the portable options have
    # nowhere to go.
    #
