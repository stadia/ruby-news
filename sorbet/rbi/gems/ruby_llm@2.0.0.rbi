    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:10
    def embedding_url(*, **, &); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:48
    def normalize_sparse_vector(weights); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:23
    def parse_embedding_response(response, model:, text:); end

    # Sparse-capable models return a token-to-weight map beside the dense
    # vector, under lexical_weights on BGE-M3 and sparse_embedding
    # elsewhere. It is an extension: dense-only servers send neither, and
