    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/media.rb:19
    def format_attachment(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/media.rb:10
    def format_content(content, attachments = T.unsafe(nil)); end

    # The Responses API extracts text from documents, presentations, and
    # spreadsheets as well as PDFs, so every document attachment rides
    # along as a native input_file.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/media.rb:44
    def format_document(document); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/media.rb:34
    def format_image(image); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/media.rb:52
    def format_provider_file(file); end
  end
end

