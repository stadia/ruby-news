  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:167
  def parse_citations(citations, offsets); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:109
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:27
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:204
  def source_document(source); end

  # Documents RubyLLM sends, and those Cohere numbers itself, are
  # identified as doc:N where N is the document's position.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:217
  def source_index(source); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:199
  def text_citation?(data); end

  # Cohere reports what the model processed under tokens and what it
  # charges for under billed_units; the two differ because Cohere does
  # not bill its own preamble.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:131
  def usage_tokens(usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:50
  def warn_unsupported_citations(model); end

  class << self
