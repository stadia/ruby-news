    #     print chunk.delta
    #   end
    #
    # Raises RubyLLM::ModelNotFoundError if +model:+ is not in the registry,
    # and RubyLLM::Error when a block is given to a provider that does not
    # stream transcriptions.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/transcription.rb:113
    def transcribe(audio_file, model: T.unsafe(nil), language: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), prompt: T.unsafe(nil), temperature: T.unsafe(nil), format: T.unsafe(nil), timestamps: T.unsafe(nil), speaker_names: T.unsafe(nil), speaker_references: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil), &block); end
  end
end

