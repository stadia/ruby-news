RubyLLM::Protocols::Anthropic::Models::ITERATION_TOKEN_KEYS = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:14
RubyLLM::Protocols::Anthropic::Models::REPORTED_CAPABILITIES = T.let(T.unsafe(nil), Hash)

