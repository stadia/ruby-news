module RubyLLM::Protocols::Cohere::Chat
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:43
  def add_optional_fields(payload, messages, temperature:, max_output_tokens:, citations:, schema:); end

  # Reasoning is on by default for models that support it, so an
  # explicit disable is as meaningful as an explicit enable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:77
