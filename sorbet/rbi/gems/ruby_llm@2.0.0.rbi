# Chat methods of the OpenAI Responses API
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:7
module RubyLLM::Protocols::Responses::Chat
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:8
  def completion_url; end

  private

  # OpenAI names the threshold compact_threshold and takes the entries
  # as a flat array, where Anthropic nests a trigger object under
  # context_management.edits. It writes the summary itself, so there is
  # nothing to steer with instructions and no pausing to opt into.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:89
  def apply_compaction(payload, compaction); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:207
  def build_prompt_cache_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:316
  def cache_breakpoint_parts(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:448
  def default_large_file_upload_threshold; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:378
  def empty_content?(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:399
  def finish_reasons; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:343
