# Google Vertex AI implementation
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:8
class RubyLLM::Providers::VertexAI < ::RubyLLM::Provider
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:71
  def initialize(config); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:110
  def api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:114
  def api_base_for(location); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:103
  def batch_cost_multiplier(model:, component:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:96
  def find_batch(id); end

  # The rescue can't name Google::Auth::AuthorizationError directly:
  # when googleauth is missing, evaluating the constant would replace
  # the helpful install error with a NameError.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:139
  def headers; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:63
  def location_path; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:67
  def model_path(model, publisher: T.unsafe(nil)); end

  # Vertex AI hosts models from several publishers, each speaking its
  # native protocol. Publisher-prefixed ids are MaaS models served
  # through the OpenAI-compatible endpoint.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:45
  def protocol_for(model, operation: T.unsafe(nil), **); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:124
  def ranking_config; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:129
  def ranking_connection; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:76
  def batch_protocol; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:80
  def batch_protocol_for(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:200
  def batch_protocol_for_model_path(model_path); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:191
  def batch_protocol_name_for(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:175
  def initialize_authorizer; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:168
  def transcription_protocol_for(id); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:27
    def capabilities; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:149
    def configuration_options; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:161
    def configuration_requirements; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:31
    def models_dev_alias(*, **, &); end

    # models.dev pins Vertex AI models to a version (claude-haiku-4-5@20251001);
    # Vertex AI serves them by bare name.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/vertexai.rb:37
    def models_dev_model_id(id); end
  end
end

