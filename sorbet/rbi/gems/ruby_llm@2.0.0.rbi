# Streaming methods of the Anthropic API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:9
module RubyLLM::Protocols::Anthropic::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:22
  def build_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:127
  def extract_citations_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:121
  def extract_content_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:47
  def extract_server_tool_use(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:140
  def extract_signature_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:134
  def extract_thinking_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:96
  def finalize_stream_block(index); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:146
  def json_delta?(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:104
  def parse_stream_block_input(json, block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:150
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:65
  def reset_stream_blocks; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:110
  def stream_end_fields(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:12
  def stream_response(payload, additional_headers = T.unsafe(nil), &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:18
  def stream_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:82
  def track_stream_block_delta(data, delta_type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:71
  def track_stream_block_start(data); end

  # Reconstructs the response's content blocks from stream events so
  # turns that used server tools can be replayed verbatim, exactly as
  # the non-streaming path does with the response body.
  # Resetting on message_start matters for pause_turn continuations,
  # which stream several messages through one protocol instance.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/streaming.rb:56
  def track_stream_blocks(data, delta_type); end
end

