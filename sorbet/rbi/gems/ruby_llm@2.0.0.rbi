  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:71
  def parse_transcription_response(response, model:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/transcription.rb:14
  def render_transcription_options(timestamps:, **); end

  # Deepgram fetches remote audio itself, so a url attachment is sent
  # as a JSON pointer and everything else is uploaded as raw bytes.
