# Streaming methods of the OpenAI Responses API. Events are semantic:
# each SSE data frame carries a `type` describing what changed.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:8
module RubyLLM::Protocols::Responses::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:53
  def build_annotation_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:22
  def build_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:88
  def build_final_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:72
  def build_item_added_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:81
  def build_item_done_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:66
  def build_reasoning_summary_part_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:47
  def build_text_chunk(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:111
  def chunk(content: T.unsafe(nil), **attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:62
  def citation_content_position(data); end

  # Responses reports a stream error as a flat event carrying a code,
  # where Chat Completions nests type and message under an error object.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:104
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:17
  def stream_response(*, **, &); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:53
    def build_annotation_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:22
    def build_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:88
    def build_final_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:72
    def build_item_added_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:81
    def build_item_done_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:66
    def build_reasoning_summary_part_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:47
    def build_text_chunk(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:111
    def chunk(content: T.unsafe(nil), **attributes); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:62
    def citation_content_position(data); end

    # Responses reports a stream error as a flat event carrying a code,
    # where Chat Completions nests type and message under an error object.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:104
    def parse_streaming_error(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/streaming.rb:17
    def stream_response(*, **, &); end
  end
end

