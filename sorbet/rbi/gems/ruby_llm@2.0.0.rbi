# An Attachment is a file sent to the model alongside a message. The source
# can be a local path, an http(s) URL, an IO-like object, an ActiveStorage
# object, or a provider-managed UploadedFile. Chat#ask builds attachments
# for you from its +with:+ option:
#
#   chat.ask "What's in this image?", with: "ruby_conf.jpg"
#
# Build one explicitly to return a file from a Tool:
#
#   RubyLLM::Attachment.new(doc.download_path)
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:19
class RubyLLM::Attachment
  include ::RubyLLM::Support::Inspectable

  # Creates an attachment from +source+: a file path, URL, IO-like object,
  # ActiveStorage object, or UploadedFile. Derives the filename from the
  # source when +filename:+ is not given, then detects the MIME type.
  #
  #   RubyLLM::Attachment.new("diagram.png")
  #   RubyLLM::Attachment.new(StringIO.new(data), filename: "report.pdf")
  #
  # +config:+ is the Configuration a URL source is downloaded with, and
  # defaults to the global one.
  #
  # Paths and URLs must be trusted and authorized by the application.
  # They can be read or fetched during construction to detect the MIME type.
  # Validate upload parameters before passing them here: an unchecked String
  # can access local files or internal network endpoints.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:75
  def initialize(source, filename: T.unsafe(nil), config: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:119
  def active_storage?; end

  # Returns whether the attachment is audio.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:175
  def audio?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:217
  def byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:84
  def config; end

  # Returns the raw bytes of the attachment, fetching or reading the source
  # on the first call. Text content is returned as UTF-8.
  #
  # Raises RubyLLM::Error if the attachment is a provider-managed file,
  # which has no local content.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:128
  def content; end

  # Returns whether the attachment is a non-PDF, non-text document format
  # such as Word or Excel, judged by MIME type or file extension.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:197
  def document?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:138
  def encoded; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:203
  def extension; end

  # The filename given at construction or derived from the source.
  # May be +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:28
  def filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:142
  def for_llm; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:179
  def format; end

  # Returns whether the attachment is an image.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:165
  def image?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:115
  def io_like?; end

  # The detected MIME type string, such as <tt>"image/png"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:31
  def mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:111
  def path?; end

  # Returns whether the attachment is a PDF.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:191
  def pdf?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:92
  def provider_file?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:103
  def provider_file_id; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:107
  def provider_file_uri; end

  # Files this attachment has been auto-uploaded to, keyed by provider and
  # credentials. Kept on the attachment so request-time preprocessing
  # uploads once per account while history keeps the original source.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:99
  def provider_uploads; end

  # The underlying source: a URI, Pathname, IO-like object, ActiveStorage
  # object, or UploadedFile.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:24
  def source; end

  # Returns whether the attachment is textual, like source code or CSV.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:209
  def text?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:213
  def to_h; end

  # Returns the attachment category as a Symbol: +:image+, +:video+,
  # +:audio+, +:pdf+, +:text+, +:document+, or +:unknown+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:153
  def type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:88
  def url?; end

  # Returns whether the attachment is a video.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:170
  def video?; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:351
  def active_storage_blob; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:230
  def active_storage_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:343
  def active_storage_content_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:247
  def content_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:276
  def determine_mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:339
  def extract_filename_from_active_storage; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:329
  def extract_filename_from_io; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:287
  def fetch_content; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:223
  def file_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:364
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:235
  def io_byte_size; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:253
  def load_content; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:301
  def load_content_from_active_storage; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:296
  def load_content_from_io; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:292
  def load_content_from_path; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:243
  def loaded_byte_size; end

  # Text content is loaded as binary; retag it so payloads serialize as UTF-8.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:269
  def normalize_text_encoding; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:347
  def provider_file_mime_type; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:315
  def source_filename; end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:359
  def source_is_a?(class_name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:305
  def source_type_cast; end

  class << self
    # :startdoc:
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:48
    def wrap(sources, config: T.unsafe(nil)); end
  end
end

# :stopdoc:
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:40
RubyLLM::Attachment::ACTIVE_STORAGE_CLASS_NAMES = T.let(T.unsafe(nil), Array)

# File extensions recognized as document attachments when the MIME type
# alone is inconclusive.
#
# pkg:gem/ruby_llm#lib/ruby_llm/attachment.rb:35
RubyLLM::Attachment::DOCUMENT_EXTENSIONS = T.let(T.unsafe(nil), Array)

# Raised for HTTP 400 responses when the request is invalid.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:104
class RubyLLM::BadRequestError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:105
    def default_message; end
  end
end

# A Batch is a provider-side batch of requests: chats awaiting a
# response (or texts awaiting embeddings) go in together, answers come
# back at batch prices, typically within hours. Persist the id, pick the
# batch back up from any process, and collect the results once
# processing ends.
#
#   chats = documents.map do |doc|
#     RubyLLM.chat(model: "claude-haiku-4-5").ask_later(doc.text)
#   end
#   batch = RubyLLM.batch(chats)
#   batch.id                # => "msgbatch_01EhcDuvb5XfWqcdJArbsfNX"
#   batch.refresh.complete? # => false, check back later
#   batch.messages          # the responses, in submission order
#
# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:18
class RubyLLM::Batch
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:170
  def initialize(provider:, chats: T.unsafe(nil), requests: T.unsafe(nil), batch_protocol: T.unsafe(nil), store: T.unsafe(nil), **attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:186
  def batch_protocol; end

  # Asks the provider to cancel the batch and applies the new state.
  # Requests already processed still return results. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:223
  def cancel; end

  # Returns whether the provider cancelled the batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:209
  def cancelled?; end

  # The submitted Chat objects in order, or +nil+ when the batch was
  # loaded by id via ::find or holds embedding requests.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:41
  def chats; end

  # Returns whether the batch has finished processing, as of the last
  # state fetched from the provider. Never contacts the provider; poll
  # with #refresh.
  #
  #   sleep 60 until batch.refresh.complete?
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:194
  def complete?; end

  # Returns a Cost for the batch. Uses the provider's reported total when
  # available, otherwise aggregates collected response costs at batch rates.
  # The total is +nil+ until the batch ends or when pricing is unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:258
  def cost; end

  # Returns whether the provider failed or expired the batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:204
  def failed?; end

  # The provider's batch id. Persist it to load the batch again later
  # from any process with ::find.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:25
  def id; end

  # Returns the answers in submission order, +nil+ where a request
  # failed. In a chat batch the answers are Messages, each also appended
  # to its chat; in an embeddings batch they are Embeddings, each also
  # hydrated into its request's EmbeddingRequest#result. Fetches results
  # from the provider; cached once #complete? is true, so collecting
  # early keeps reading fresh.
  #
  #   batch.messages.each do |message|
  #     puts message.content
  #   end
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:240
  def messages; end

  # The slug of the provider running the batch, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:182
  def provider; end

  # The provider-reported status string, such as "in_progress".
  # Refreshed by #refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:33
  def raw_status; end

  # Re-fetches the batch from the provider, updating #status, #raw_status,
  # #request_counts, and #complete?. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:215
  def refresh; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:186
  def reported_cost; end

  # The provider-reported request tallies by state, or +nil+ when the
  # provider does not report them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:37
  def request_counts; end

  # The submitted EmbeddingRequest objects in order, or +nil+ when the
  # batch was loaded by id via ::find or holds chats.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:45
  def requests; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:248
  def results; end

  # The provider-neutral lifecycle status: +:pending+, +:succeeded+,
  # +:failed+, or +:cancelled+. Refreshed by #refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:29
  def status; end

  # The normalized outcome of each collected request, in submission order.
  # Values are +:succeeded+, +:failed+, or +:cancelled+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:49
  def statuses; end

  # Returns whether the provider completed the batch successfully.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:199
  def succeeded?; end

  # Returns token usage aggregated across the batch's collected responses.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:251
  def tokens; end

  private

  # A plain answer is the chat's last message once it arrives. A tool-call
  # answer is not: running its tools adds messages after it, so we match on its
  # tool-call ids instead.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:376
  def already_in_chat?(chat, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:271
  def apply(attributes); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:356
  def attach_batch_usage(result, operation:, model:, category:, instrument:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:288
  def collect_results; end

  # Collecting early keeps reading fresh, so a result already delivered
  # comes back on every later poll: hand each one over once.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:313
  def deliver(index, result, failure_status); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:324
  def deliver_embedding(index, embedding); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:340
  def deliver_message(index, message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:306
  def fill_missing_statuses(size); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:428
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:267
  def persist_state; end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:282
  def protocol_name(protocol); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:302
  def result_slot_count(results); end

  class << self
    # Returns a Batch reflecting the provider's current state for +id+.
    # Use it to pick a batch back up from any process.
    #
    #   batch = RubyLLM::Batch.find("msgbatch_01EhcDuvb5XfWqcdJArbsfNX",
    #                               provider: :anthropic)
    #   batch.complete? # => true
    #
    # Pass +context:+ to use a Context in place of the global
    # configuration. Raises ArgumentError if +provider+ is not given.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:83
    def find(id, provider: T.unsafe(nil), context: T.unsafe(nil)); end

    # Submits chats or embedding requests to their shared provider as a
    # batch and returns a new Batch. Accepts a single Chat or an array.
    # Every chat must be awaiting the model (see Chat#ask_later), and all
    # requests must use the same provider.
    #
    #   chats = tickets.map do |ticket|
    #     RubyLLM.chat(model: "claude-haiku-4-5").ask_later(ticket.body)
    #   end
    #   batch = RubyLLM::Batch.submit(chats)
    #   batch.status     # => :pending
    #   batch.raw_status # => "in_progress"
    #
    # Raises ArgumentError if the batch is empty, mixes providers, mixes
    # chats with embedding requests, or includes a chat that is not
    # awaiting the model.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:67
    def submit(chats); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:155
    def awaiting_model?(chat); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:143
    def normalize_chats(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:159
    def shared_provider(chats); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:100
    def submit_chats(records); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:117
    def submit_embeddings(requests); end

    # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:134
    def wrap_records(records); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:21
RubyLLM::Batch::AWAITING_ROLES = T.let(T.unsafe(nil), Array)

# pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:384
module RubyLLM::Batch::Helpers
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:396
  def batch_error_message(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:408
  def batch_error_value(error); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:391
  def batch_failure(custom_id, detail, status: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:422
  def batch_payload(request, except: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:387
  def batch_result_index(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/batch.rb:415
  def single_batch_model!(requests, provider_name); end
end

# A CachedContent is a provider-side prompt cache resource. Create one
# with ::create from a long, stable prompt prefix, then attach it to a
# chat so later requests read the cached tokens instead of resending
# them. This lifecycle requires a provider with managed cache resources;
# automatic prompt caching is configured with Chat#with_caching.
#
#   cache = RubyLLM.cache(big_document, model: 'gemini-3.7-flash', ttl: 3600)
#   chat = RubyLLM.chat(model: 'gemini-3.7-flash').with_caching(id: cache)
#   chat.ask "What does the document conclude?"
#   cache.delete
#
# Cache names are provider-owned. Persist #provider alongside #name and
# pass it back when finding the cache later.
#
# pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:17
class RubyLLM::CachedContent
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:46
  def initialize(name:, **attributes); end

  # The Time the provider stored the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:35
  def created_at; end

  # Deletes the cache resource from the provider. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:58
  def delete; end

  # The Time the provider will delete the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:38
  def expires_at; end

  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:20
  def inspect_attributes; end

  # The raw provider response data for the cache, as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:44
  def metadata; end

  # The model the cache was created for.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:29
  def model; end

  # The provider-assigned resource name, such as
  # <tt>"cachedContents/abc123"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:26
  def name; end

  # The slug of the provider that stores the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:32
  def provider; end

  # Extends the cache's lifetime to +ttl:+ seconds from now, given as an
  # Integer or a provider duration string such as <tt>"600s"</tt>.
  # Updates #expires_at and returns +self+.
  #
  #   cache.renew(ttl: 3600)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:69
  def renew(ttl:); end

  # The number of tokens stored in the cache.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:41
  def tokens; end

  class << self
    # Creates a provider-side prompt cache from +content+ and returns a
    # CachedContent. Also available as RubyLLM.cache.
    #
    #   RubyLLM::CachedContent.create(big_document, model: 'gemini-3.7-flash')
    #
    # +content+ is the text to cache; pass file attachments with +with:+
    # the way Chat#ask accepts them. +instructions:+ caches a system
    # prompt alongside the content, and +ttl:+ sets the cache lifetime in
    # seconds (Integer) or as a provider duration string such as
    # <tt>"300s"</tt>. When +provider:+ is omitted, the model's default
    # provider is used. The content must exceed the model's minimum
    # cacheable token count.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:88
    def create(content, model:, ttl: T.unsafe(nil), instructions: T.unsafe(nil), provider: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil)); end

    # Fetches an existing cache resource by +name+ and returns a
    # CachedContent. When +provider:+ is omitted, the provider of the
    # configured default model is used.
    #
    #   cache = RubyLLM::CachedContent.find("cachedContents/abc123", provider: :gemini)
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/cached_content.rb:101
    def find(name, provider: T.unsafe(nil), context: T.unsafe(nil)); end
  end
end

# Raised when an in-flight chat operation is cancelled with Chat#cancel.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:79
class RubyLLM::CancelledError < ::StandardError
  # Creates an error for a cancelled chat operation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:81
  def initialize(message = T.unsafe(nil)); end
end

# A Chat is a conversation with an AI model. It holds the messages
# exchanged so far, the tools the model may call, and the settings applied
# to each request. RubyLLM.chat is the usual way to create one.
#
#   chat = RubyLLM.chat
#   chat.ask "What's the best way to learn Ruby?"
#
# Configuration methods return +self+, so calls chain:
#
#   chat = RubyLLM.chat(model: 'claude-sonnet-5')
#   chat.with_instructions("Be terse.").with_tools(Weather)
#
# #ask runs the conversation loop, executing tools until the model answers
# or a call needs approval. #ask_later, #generate, #run_tools, and #step
# expose individual operations. Resume an approval pause with #approve
# or #deny followed by #complete.
#
# A Chat is Enumerable over its messages.
#
# pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:24
class RubyLLM::Chat
  include ::Enumerable
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Skills::SourceDetection

  # Creates a chat with +model:+, or with the configured default model
  # when +model:+ is +nil+. Most code calls RubyLLM.chat instead.
  #
  # A model is identified by its name, an optional +provider:+, and an
  # optional +protocol:+. Pass +provider:+ to disambiguate models
  # available from several providers, and +protocol:+ to override the wire
  # protocol the provider would otherwise pick for the model. With
  # <tt>assume_model_exists: true</tt> the registry lookup is skipped,
  # which requires +provider:+. Pass a Context as +context:+ to use its
  # configuration instead of the global one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:109
  def initialize(model: T.unsafe(nil), provider: T.unsafe(nil), protocol: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil)); end

  # Receives a completion produced out-of-band (e.g. by a batch), running the
  # same callbacks as a synchronous completion so persistence works unchanged.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:833
  def add_completion(response, record_usage: T.unsafe(nil)); end

  # Appends a message to the conversation and returns it as a Message.
  # Accepts a Message, an attribute Hash, or a record responding to
  # +to_llm+.
  #
  #   chat.add_message(role: :user, content: "What's the capital of France?")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:813
  def add_message(message_or_attributes); end

  # Registers a callback that receives the Fallback attempt once it has
  # succeeded or failed. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:698
  def after_fallback(&); end

  # Registers a callback that receives each assistant response and each
  # tool result message once it has been appended. Returns +self+.
  #
  #   chat.after_message { |message| puts message.content }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:670
  def after_message(&); end

  # Registers a callback that receives each local tool's result after
  # execution. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:685
  def after_tool_result(&); end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:805
  def approval_checker=(_arg0); end

  # Records approval for +tool_call+, a ToolCall or its id, so the next
  # #complete or #run_tools executes a local tool or records permission for
  # the provider to execute a remote tool on the next request. Returns +self+.
  #
  #   chat.approve(tool_call)
  #   chat.complete
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:256
  def approve(tool_call); end

  # Adds +message+ as a user message and runs the conversation loop,
  # executing tools until the model answers or a call needs approval.
  # Returns the latest assistant Message; check #awaiting_approval? before
  # treating it as a final answer. Attach files with +with:+.
  # A given block receives streamed Chunk objects as they arrive.
  #
  # String attachments read local paths or fetch URLs. Only pass trusted,
  # authorized sources; validate user uploads before calling this method.
  # See Attachment.new.
  #
  #   chat.ask "What's the best way to learn Ruby?"
  #   chat.ask "What's in this image?", with: "ruby_conf.jpg"
  #   chat.ask "Analyze these files", with: ["diagram.png", "report.pdf"]
  #   chat.ask("Tell me a story") { |chunk| print chunk.content }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:157
  def ask(message = T.unsafe(nil), with: T.unsafe(nil), &); end

  # Stages +message+ as a user message without requesting a completion,
  # leaving the chat ready for #complete, a single #step, or a
  # provider-side batch via RubyLLM.batch. Accepts attachments with
  # +with:+ like #ask. Returns +self+.
  #
  #   chats = tickets.map { |t| RubyLLM.chat.ask_later(t.body) }
  #   RubyLLM.batch(chats)
  #
  # Raises PendingToolCallsError while the last response has unanswered
  # tool calls: finish the round first, recording #approve or #deny
  # decisions for calls that require approval.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:175
  def ask_later(message = T.unsafe(nil), with: T.unsafe(nil)); end

  # Returns whether the conversation can make no progress without an
  # approval decision: every remaining pending tool call requires
  # approval and has none recorded. While +true+, #complete returns
  # without executing them; record decisions with #approve or #deny,
  # then call #complete again. Tool calls that need no approval still
  # execute before the loop pauses.
  #
  # Consults each pending tool's approval resolver when one is declared,
  # so resolvers must be idempotent reads.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:278
  def awaiting_approval?; end

  # Registers a callback that receives the Fallback attempt after the
  # current model fails and before the fallback model is tried. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:692
  def before_fallback(&); end

  # Registers a callback that runs before each assistant response or tool
  # result is appended to the conversation. Callbacks are additive: every
  # registered block runs. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:661
  def before_message(&); end

  # Registers a callback that receives the fully rendered request payload
  # before it is sent and may mutate it in place. Runs after all RubyLLM
  # formatting and #with_provider_options merging. Returns +self+.
  #
  #   chat.before_request { |payload| logger.debug payload }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:708
  def before_request(&); end

  # Registers a callback that receives each local ToolCall before the tool
  # executes. Returns +self+.
  #
  #   chat.before_tool_call { |tool_call| puts tool_call.name }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:679
  def before_tool_call(&); end

  # Marks the latest message as an explicit prompt cache boundary, asking
  # the provider to cache everything up to this point. Returns +self+.
  #
  # Raises ArgumentError if the chat has no messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:823
  def cache_until_here; end

  # The prompt caching options set with #with_caching, +false+ when
  # explicitly disabled, or +nil+ when not configured.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:71
  def caching; end

  # Cancels the current in-flight chat operation. The next cancellation
  # checkpoint raises CancelledError and clears the flag so the chat can be
  # reused.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:303
  def cancel; end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:805
  def cancellation_checker=(_arg0); end

  # Returns whether this in-memory chat has been marked for cancellation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:309
  def cancelled?; end

  # Whether #with_citations asked the provider for citations.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:85
  def citations; end

  # Compacts the conversation's model context and returns an assistant
  # Message. The message can have empty text and carries the provider's
  # compacted context internally. Every earlier message remains in
  # #messages, including on persisted Rails chats.
  #
  #   chat.ask "Remember these project requirements..."
  #   chat.compact
  #   chat.ask "Which requirement should we implement first?"
  #
  # Uses the current instructions, headers, and request hooks. Records
  # reported usage and runs the normal message callbacks. Raises Error
  # when the provider has no manual compaction endpoint, and
  # PendingToolCallsError until pending tool calls have been answered.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:777
  def compact; end

  # The context compaction options set with #with_compaction, +false+ when
  # explicitly disabled, or +nil+ when not configured.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:75
  def compaction; end

  # Runs the conversation loop until #complete? or #awaiting_approval?
  # is +true+. Returns the last conversation Message, or +nil+ for an
  # empty chat. Used after #ask_later; #ask calls #complete for you.
  #
  # When a pending tool call requires approval and no decision has been
  # recorded, the loop pauses. Record #approve or #deny decisions, then
  # call #complete again to continue.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:233
  def complete(&); end

  # Returns whether the chat has no pending response or tool execution:
  # nothing is staged, or the model answered without requesting tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:240
  def complete?; end

  # The tool concurrency mode, or +nil+ when tools run sequentially.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:67
  def concurrency; end

  # The Context this chat sends requests through, or +nil+ for the global
  # configuration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:89
  def context; end

  # Returns a Cost aggregating every provider attempt this chat has made,
  # including retries and attempts that produced no message.
  #
  #   chat.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:733
  def cost; end

  # Counts input tokens for the conversation, including instructions,
  # function tools, structured output, thinking, and attachments.
  # Pass +message+ to include it as a staged user message without
  # mutating the chat. Returns an Integer.
  #
  #   chat.with_instructions("Be terse.").with_tools(Weather)
  #   chat.count_tokens("What's the weather in Berlin?")
  #
  # Provider tools, provider_options, compaction, and before_request hooks
  # are not included. Raises Error when the provider has no token counting
  # endpoint.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:748
  def count_tokens(message = T.unsafe(nil)); end

  # Records denial for +tool_call+, a ToolCall or its id. The next
  # #complete or #run_tools appends a structured denial result instead
  # of executing a local tool, or sends a refusal for a remote tool on the
  # next request. The model continues from there. Returns
  # +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:265
  def deny(tool_call); end

  # Yields each Message in the conversation. Returns an Enumerator when
  # no block is given. Chat includes Enumerable, so the usual collection
  # methods are available.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:715
  def each(&); end

  # The opaque per-user identifier set with #with_end_user, or
  # +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:79
  def end_user; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:91
  def fallback_errors; end

  # The Fallback models tried in order when generation fails.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:82
  def fallbacks; end

  # Requests one completion from the model, appends the response to the
  # conversation, and returns it as a Message. Honors the fallbacks
  # configured with #with_fallbacks. A given block receives streamed
  # Chunk objects. Tool calls in the response are not executed; that is
  # #run_tools.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:186
  def generate(&); end

  # Extra HTTP headers set with #with_headers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:54
  def headers; end

  # The output cap set with #with_max_output_tokens, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:61
  def max_output_tokens; end

  # The Message objects exchanged so far, including system instructions.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:40
  def messages; end

  # Replaces the conversation with +new_messages+, coercing each element
  # into a Message. Accepts Message objects, attribute Hashes, and
  # records responding to +to_llm+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:794
  def messages=(new_messages); end

  # The Model the chat sends requests to.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:34
  def model; end

  # Returns the tool calls from the latest response that require approval
  # and have no recorded decision, as an array of ToolCall objects. Pairs
  # with #approve and #deny. ToolCall#remote? identifies provider-executed calls.
  #
  #   chat.pending_approvals.each { |tool_call| puts tool_call.name }
  #   chat.approve(chat.pending_approvals.first)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:293
  def pending_approvals; end

  # The Provider instance handling requests for the current model.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:37
  def provider; end

  # Extra request options set with #with_provider_options, expressed in
  # the provider's request vocabulary.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:51
  def provider_options; end

  # The provider tools enabled with #with_provider_tools, as an array of
  # normalized entry Hashes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:47
  def provider_tools; end

  # Refuses to stage a user message onto an unfinished tool round, which
  # providers reject. Called by #ask_later here and in the Rails
  # integration before it persists anything.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:872
  def raise_if_pending_tool_calls!; end

  # Returns the request payload this chat would send to the provider for
  # its next completion, with #before_request hooks applied. Useful for
  # inspecting and testing request output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:848
  def render; end

  # Executes the tool calls pending in the latest response and appends
  # their result messages, without asking the model to respond. Tool
  # calls that already have results are skipped, so a chat reloaded
  # mid-round resumes with only the remaining tools. Calls whose tool
  # was declared with Tool.requires_approval only execute once #approve
  # records a decision; denied calls receive a structured denial result,
  # and undecided calls stay pending. Does nothing when no tool calls
  # are pending. The chat is then ready for the next #generate, or the
  # next batch round. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:203
  def run_tools; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:162
  def say(message = T.unsafe(nil), with: T.unsafe(nil), &); end

  # The normalized structured output schema set with #with_schema, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:64
  def schema; end

  # Advances the conversation by one move: runs the pending tool calls
  # if any are unanswered, otherwise generates the next response.
  # Returns the Message that move produced, and +nil+ once there is
  # nothing left to do or the loop is parked on an approval.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:215
  def step(&); end

  # The sampling temperature set with #with_temperature, or +nil+ to let
  # the model use its default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:58
  def temperature; end

  # Returns the thinking options resolved for the current model, or +nil+
  # when thinking was not configured or needs no provider control.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:503
  def thinking; end

  # Returns token usage aggregated across every provider attempt this chat
  # has made, including retries and attempts that produced no message.
  #
  #   chat.tokens.input
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:724
  def tokens; end

  # Returns the +choice+, +calls+, and +concurrency+ set with
  # #with_tool_options, with +nil+ for anything left at the default.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:95
  def tool_options; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:91
  def tool_prefs; end

  # The registered tools, as a Hash of tool name Symbols to Tool instances.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:43
  def tools; end

  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:91
  def usage_entries; end

  # Replaces the usage ledger. Used by the Rails integration when
  # rebuilding a persisted chat.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:800
  def usage_entries=(entries); end

  # Hooks installed by the Rails integration.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:805
  def usage_recorder=(_arg0); end

  # Enables provider prompt caching. With no arguments the provider's
  # default behavior applies; options such as +ttl:+ apply where
  # supported. Pass +id:+ with a CachedContent (or its name) from
  # RubyLLM.cache to attach an explicit
  # content cache. Pass +false+ to stop RubyLLM from sending cache
  # controls or rendering explicit cache boundaries. A provider may still
  # cache prompts implicitly. Passing +nil+ raises ArgumentError.
  # Returns +self+.
  #
  #   chat.with_caching
  #   chat.with_caching(ttl: "1h")
  #   chat.with_caching(id: cache)
  #   chat.with_caching(false)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:544
  def with_caching(options = T.unsafe(nil)); end

  # Enables document citations, so the model backs its claims with quotes
  # from attached files. Pass +false+ to disable. Passing +nil+ raises
  # ArgumentError. Returns +self+.
  #
  #   chat.with_citations
  #   response = chat.ask "Who created Ruby?", with: "facts.txt"
  #   response.citations.each { |citation| puts citation.cited_text }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:523
  def with_citations(enabled = T.unsafe(nil)); end

  # Enables provider-side context compaction, so a long conversation keeps
  # going instead of overflowing the context window. The provider condenses
  # the earlier turns itself and returns a block that RubyLLM replays on
  # later requests. With no arguments the provider's own defaults apply.
  # The options are provider-neutral:
  #
  # +at+:: the input-token count that triggers compaction.
  # +instructions+:: a custom prompt for the summary the provider writes.
  # +pause_after+:: end the turn once compaction runs, instead of
  #                 continuing straight into the answer.
  #
  # Each provider applies the options it supports. Unsupported options
  # are ignored with a debug log. Pass +false+ to disable; passing +nil+
  # raises ArgumentError. Returns +self+.
  #
  #   chat.with_compaction
  #   chat.with_compaction(at: 50_000)
  #   chat.with_compaction(at: 100_000, instructions: "Keep every decision.")
  #   chat.with_compaction(false)
  #
  # What a provider does when the threshold is crossed differs. Anthropic
  # and OpenAI summarize the compacted span into an opaque block that
  # replaces it; OpenRouter drops messages from the middle of the
  # conversation instead, and has no threshold of its own.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:578
  def with_compaction(options = T.unsafe(nil)); end

  # Rebinds the chat to +context+, a Context built with RubyLLM.context,
  # so subsequent requests use its configuration. Pass +nil+ to return to
  # the global RubyLLM.config. Returns +self+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:605
  def with_context(context); end

  # Identifies the end user behind the conversation for the provider's
  # abuse monitoring. Providers without an equivalent field omit it.
  # Pass +nil+ to remove it.
  # Returns +self+.
  #
  #   chat.with_end_user("user-123").ask "Hello"
  #
  # The value is sent as given, so use an opaque id such as a hash of
  # your user id, never personal data.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/chat.rb:597
  def with_end_user(end_user); end

  # Sets fallback models to try, in order, when generation fails. +on:+
  # selects the error classes that trigger a fallback; the default covers
  # transient provider and network errors. Pass +nil+ to remove all
  # fallbacks and restore the default error classes. Returns +self+.
  #
  #   chat.with_fallbacks("gpt-4.1-mini", "claude-haiku-4-5")
  #   chat.with_fallbacks(nil)
  #
