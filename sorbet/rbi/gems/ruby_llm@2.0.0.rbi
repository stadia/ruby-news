  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:384
  def parse_output_text(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:440
  def parse_reasoning_signature(output); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:432
  def parse_reasoning_summary(output); end

  # Output items beyond text, reasoning, and function calls record
  # provider-executed tool steps (web_search_call, code_interpreter_call,
  # and whatever OpenAI ships next). They are kept raw and replayed.
