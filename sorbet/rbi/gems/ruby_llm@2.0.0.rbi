# Models methods for AWS Bedrock.
#
# pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:7
module RubyLLM::Providers::Bedrock::Models
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:109
  def create_model_info(model_data, slug, _capabilities = T.unsafe(nil), profile_ids: T.unsafe(nil)); end

  # The region's actual cross-region inference profile ids. Some
  # geography prefixes cannot be synthesized from the region alone:
  # Tokyo serves both apac. and jp. profiles.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:90
  def inference_profile_ids; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:209
  def inference_profile_only?(inference_types); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:143
  def listed_profile_id(model_id, profile_ids); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:77
  def mantle_created_at(created); end

  # Which endpoint serves a model is a fact about the catalogs, not
  # about the id: mantle spells some Converse models differently and
  # lists models Converse has never heard of. The registry records it,
  # so ask the registry first and read the id only for models it does
  # not list.
  #
  # Claude is the exception. Converse only ever serves it under a dated
  # and versioned id, so a bare anthropic. id means mantle even on
  # accounts whose catalog listing hides Claude behind the AWS Sales
  # agreement.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:162
  def mantle_model?(model_id, models); end

  # The bedrock-mantle endpoint serves bare vendor.model ids under
  # exactly that id. Converse ids carry a date or :N version suffix, a
  # cross-region inference prefix, or both.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:178
  def mantle_model_id?(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:23
  def mantle_models_url; end

  # Models both catalogs list keep their Converse metadata and gain the
  # mantle tag, because mantle is where RubyLLM sends them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:61
  def merge_mantle_models(converse_models, mantle_models); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:136
  def model_id_with_region(model_id, model_data, profile_ids = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:15
  def models_api_base; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:27
  def models_dev_alias(model_id, models_dev_by_key, _provider_model = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:19
  def models_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:213
  def normalize_inference_profile_id(model_id, inference_types, region); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:255
  def normalize_modalities(modalities); end

  # A summary's converse block is metadata Bedrock fills in for some
  # models, not a statement that Converse serves them: Nova Lite,
  # Llama 3.3 and Mistral Large take tool calls without one. Whether
  # Converse accepts the model at all is the closest thing the listing
  # has to a tool-use flag.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:271
  def parse_capabilities(model_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:282
  def parse_context_window(model_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:81
  def parse_list_models_response(response, slug, profile_ids: T.unsafe(nil)); end

  # The mantle catalog reports ids and nothing else, so entries carry
  # only what the endpoint states. models.dev fills in limits and
  # pricing for the ids it knows during a registry refresh.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:45
  def parse_mantle_models_response(response, slug); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:223
  def prefixed_with(model_id, prefix); end

  # Inference profile ids use geography prefixes, not region name
  # segments: ap-* regions are apac., GovCloud is us-gov.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:233
  def region_prefix(region); end

  # Countries with their own residency-preserving profiles come before
  # the broad geography, so Tokyo prefers jp. over apac. Some models
  # ship with only a global. profile, so that is the last resort.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:245
  def region_prefix_candidates(region); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:251
  def region_prefixed?(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:171
  def registered_model(model_id, models); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:197
  def registered_profile_candidate(model_id, models, region); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:185
  def resolve_registry_id(model_id, models, config); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:72
  def tag_mantle_endpoint(model); end

  # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:219
  def with_region_prefix(model_id, region); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:109
    def create_model_info(model_data, slug, _capabilities = T.unsafe(nil), profile_ids: T.unsafe(nil)); end

    # The region's actual cross-region inference profile ids. Some
    # geography prefixes cannot be synthesized from the region alone:
    # Tokyo serves both apac. and jp. profiles.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:90
    def inference_profile_ids; end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:209
    def inference_profile_only?(inference_types); end

    # pkg:gem/ruby_llm#lib/ruby_llm/providers/bedrock/models.rb:143
