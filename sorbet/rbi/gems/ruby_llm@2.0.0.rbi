  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:90
  def extract_cache_read_tokens(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:94
  def extract_cache_write_tokens(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:77
  def extract_input_tokens(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:73
  def extract_model_id(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:81
  def extract_output_tokens(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:85
  def extract_thinking_tokens(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:105
  def message_usage(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:64
  def model_capabilities(model_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/anthropic/models.rb:43
