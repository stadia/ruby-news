  def in_call_order(tool_messages); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:433
  def remember_tool_calls; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:399
  def tool_message?(message); end
end

