# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:7
module RubyLLM::Protocols::Converse::Media
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:158
  def document_format(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:20
