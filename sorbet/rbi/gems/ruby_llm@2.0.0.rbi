# Streaming implementation for Bedrock ConverseStream (AWS Event Stream).
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:11
module RubyLLM::Protocols::Converse::Streaming
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:185
  def build_chunk(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:153
  def decode_error_frame(headers); end

  # ConverseStream delivers modeled errors as a frame after the 200, with
  # the type in the frame headers and a bare message as the payload. Rewrap
  # it under the exception name so raise_stream_error classifies it instead
  # of the frame passing for an empty chunk.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:136
  def decode_event(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:172
  def decode_event_payload(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:112
  def decode_events(decoder, raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:411
  def event_block_index(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:167
  def event_header(headers, name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:52
  def event_stream_decoder; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:221
  def event_usage(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:237
  def extract_cache_read_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:241
  def extract_cache_write_tokens(metadata_usage, usage); end

  # The cited span itself streams as ordinary text deltas; the citation
  # delta carries the source. The final message resolves the span text
  # from the accumulated content when indices are known.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:283
  def extract_citations_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:276
  def extract_content_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:217
  def extract_finish_reason(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:228
  def extract_input_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:233
  def extract_output_tokens(metadata_usage, usage); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:245
  def extract_reasoning_tokens(metadata_usage, usage); end

  # Server-executed tool steps stream as typed toolUse and toolResult
  # block starts. Their input deltas are not function-call arguments,
  # so the block index is remembered and its deltas skipped.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:381
  def extract_server_tool_call_events(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:318
  def extract_signature_from_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:324
  def extract_signature_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:290
  def extract_thinking_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:301
  def extract_thinking_from_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:308
  def extract_thinking_signature(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:369
  def extract_tool_call_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:350
  def extract_tool_call_start(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:335
  def extract_tool_calls(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:72
  def failed_stream_buffer(env); end

  # The error body arrives in as many reads as the adapter hands out, so
  # it accumulates on the env, which ErrorMiddleware clears per attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:63
  def handle_failed_stream(chunk, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:89
  def handle_non_eventstream_error_chunk(raw_chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:417
  def normalized_delta(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:76
  def parse_stream_chunk(decoder, raw_chunk, accumulator, progress); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:253
  def raise_stream_error(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:103
  def raise_streaming_chunk_error(payload); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:398
  def remember_server_tool_block(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:406
  def server_tool_block_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:249
  def stream_error_event?(event); end

  # Failures the API does not model arrive as an error frame instead,
  # with the code and message in the headers and nothing in the payload.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:149
  def stream_error_frame?(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:160
  def stream_exception_type(message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:20
  def stream_response(payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:16
  def stream_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:211
  def streamed_thinking_blocks(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:346
  def tool_call_delta_event?(event); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:342
  def tool_call_start_event?(event); end
end

# pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
class RubyLLM::Protocols::Converse::Streaming::ErrorResponse < ::Struct
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
  def body; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
  def body=(_); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
  def status; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
  def status=(_); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/streaming.rb:12
