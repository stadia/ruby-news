  def transcribe(audio_file, model:, language:, format: T.unsafe(nil), speaker_names: T.unsafe(nil), speaker_references: T.unsafe(nil), provider_options: T.unsafe(nil), prompt: T.unsafe(nil), temperature: T.unsafe(nil), &block); end

