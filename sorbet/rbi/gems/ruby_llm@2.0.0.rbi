  def render_embedding_payload(text, model:, dimensions:, task_type: T.unsafe(nil), title: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/chat_completions/embeddings.rb:54
  def reported_cost(_usage); end

