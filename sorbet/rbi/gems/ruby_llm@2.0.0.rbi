  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:162
  def sanitize_document_name(filename); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:154
  def supported_document_format?(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:168
  def unique_document_name(base_name, used_names); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:158
    def document_format(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:20
