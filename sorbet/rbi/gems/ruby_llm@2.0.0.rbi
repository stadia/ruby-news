    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:38
    def escape_model_id(model_id); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:669
    def extract_server_tool_calls(content_blocks); end

