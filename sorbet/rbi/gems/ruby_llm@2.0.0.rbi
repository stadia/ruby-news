# The Deepgram API: speech to text on v1/listen, text to speech on
# v1/speak, and the model catalog behind them. Deepgram has no chat,
# embedding, or image endpoints, so those seams are left unimplemented.
#
# Deepgram carries its request options in the query string rather than
# the body, so +provider_options:+ joins the query on both audio
# operations.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram.rb:12
class RubyLLM::Protocols::Deepgram < ::RubyLLM::Protocol
  include ::RubyLLM::Protocols::Deepgram::Models
  include ::RubyLLM::Protocols::Deepgram::Speech
  include ::RubyLLM::Protocols::Deepgram::Transcription
  include ::RubyLLM::Protocols::Deepgram::StreamingTranscription
end

# Model catalog for Deepgram. GET v1/models splits the catalog into
# stt and tts groups, and names each entry twice: +name+ is the short
# name, such as the voice 'zeus', while +canonical_name+ is the id the
# listen and speak endpoints accept.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:10
module RubyLLM::Protocols::Deepgram::Models
  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:61
  def build_metadata(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:40
  def build_model(data, slug, group); end

  # Deepgram lists a model once per language it was trained on, so
  # nova-3-general arrives 146 times with a different language and
  # version each time. One model answers to that id, so the rows
  # collapse into it, carrying every language between them. Fields
  # the rows disagree on describe a single language rather than the
  # model, and are left out.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:32
  def merge_language_rows(rows); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:13
  def models_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:17
  def parse_list_models_response(response, slug); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:61
    def build_metadata(data); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:40
    def build_model(data, slug, group); end

    # Deepgram lists a model once per language it was trained on, so
    # nova-3-general arrives 146 times with a different language and
    # version each time. One model answers to that id, so the rows
    # collapse into it, carrying every language between them. Fields
    # the rows disagree on describe a single language rather than the
    # model, and are left out.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:32
    def merge_language_rows(rows); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:13
    def models_url; end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/models.rb:17
    def parse_list_models_response(response, slug); end
  end
end

# Speech dialect for the Deepgram text-to-speech API. Deepgram names
# the voice inside the model id, so aura-2-thalia-en is the Thalia
# voice of Aura 2: asking for a +voice:+ swaps that segment of the
# model id. The container is an encoding query value, the body carries
# only the text, and the response is raw audio bytes.
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:13
module RubyLLM::Protocols::Deepgram::Speech
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:87
  def format_for(format); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:59
  def parse_speech_response(response, model:, voice:, format:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:55
  def render_speech_payload(input, model:, voice: T.unsafe(nil), format: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:30
  def speak(input, model:, voice:, format:, provider_options: T.unsafe(nil), &block); end

  # Puts +voice+ into the voice segment of +model+, so Aura 2 with
  # voice 'zeus' is aura-2-zeus-en. A voice that already names a whole
  # model is used as it stands.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:71
  def speech_model_for(model, voice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:49
  def speech_params(model:, format: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:45
  def speech_url(model:, format: T.unsafe(nil), provider_options: T.unsafe(nil)); end

  # The voice segment of a Deepgram model id, so aura-2-thalia-en
  # speaks as 'thalia'.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/deepgram/speech.rb:82
  def voice_for(model); end
end

