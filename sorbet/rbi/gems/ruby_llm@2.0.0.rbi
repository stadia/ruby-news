# Tools methods of the Cohere v2 API integration
#
# pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:9
module RubyLLM::Protocols::Cohere::Tools
  private

  # Cohere only forces tool use on or off; it cannot pin a named tool.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:47
  def build_tool_choice(choice); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:95
  def document_blocks(search_results); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:58
  def format_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:71
  def format_tool_result(msg); end

  # Search results become document content blocks, the shape Cohere
  # cites tool output against. A tool that attaches files sends its
  # text and each attachment as blocks, so the model reads what the
  # tool fetched rather than only the sentence describing it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:83
  def format_tool_result_content(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:18
  def function_for(tool); end

  # Cohere takes plain JSON Schema here and controls strictness with the
  # request's own strict_tools flag, so the OpenAI strict keyword goes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:35
  def parameters_schema_for(tool); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:122
  def parse_arguments(arguments, response, finish_reason); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:107
  def parse_tool_calls(tool_calls, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end

  class << self
    # Cohere only forces tool use on or off; it cannot pin a named tool.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:47
    def build_tool_choice(choice); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:95
    def document_blocks(search_results); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:58
    def format_tool_calls(tool_calls); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:71
    def format_tool_result(msg); end

    # Search results become document content blocks, the shape Cohere
    # cites tool output against. A tool that attaches files sends its
    # text and each attachment as blocks, so the model reads what the
    # tool fetched rather than only the sentence describing it.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:83
    def format_tool_result_content(msg); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:18
    def function_for(tool); end

    # Cohere takes plain JSON Schema here and controls strictness with the
    # request's own strict_tools flag, so the OpenAI strict keyword goes.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:35
    def parameters_schema_for(tool); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:122
    def parse_arguments(arguments, response, finish_reason); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/tools.rb:107
    def parse_tool_calls(tool_calls, response: T.unsafe(nil), finish_reason: T.unsafe(nil)); end
  end
end

