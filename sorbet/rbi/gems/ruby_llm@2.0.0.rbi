  # Cohere takes a bare JSON Schema under json_schema, with no name or
  # strict wrapper.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:67
  def build_response_format(schema); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:190
  def citation_span(data, offsets); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:210
  def citation_url(document); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:22
  def completion_url; end

  # Returns the joined text of the response along with the offset each
  # content block starts at, so citation spans resolve against the
  # content string RubyLLM exposes.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:145
  def extract_text(blocks); end

  # The tool plan is the model's reasoning for a tool-calling turn, and
  # is the only reasoning Cohere returns when thinking blocks are absent.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:161
  def extract_thinking(blocks, message_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:14
  def finish_reasons; end

  # Cohere returns tool_plan alongside tool calls, and RubyLLM surfaces
  # it as thinking, but the newer models reject it on the way back in.
  # It is optional in a request, so the plan stays out of the history.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:101
  def format_assistant_message(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:88
  def format_message(msg, citations: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:84
  def format_messages(messages, citations: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:16
  def normalize_finish_reason(reason); end

  # Only citations of the response text carry offsets into #content.
  # Citations of the thinking blocks or the tool plan point into text
  # RubyLLM exposes elsewhere, so they keep their snippet without a span.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/cohere/chat.rb:174
