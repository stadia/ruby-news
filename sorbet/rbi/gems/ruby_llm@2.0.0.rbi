  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:363
  def format_function_call_items(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:273
  def format_input(messages, caching: T.unsafe(nil)); end

  # System messages marked as cache boundaries, or carrying attachments,
  # ride along as input items, because the +instructions+ parameter is a
  # plain string and cannot carry a breakpoint marker or a file.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:266
  def format_instructions(messages, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:293
  def format_item(msg, caching: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:374
  def format_output_content(msg); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:355
  def format_reasoning_item(thinking); end

  # Function call outputs are text-only on the wire, so tool attachments
  # ride a user item spliced in right after the result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:325
