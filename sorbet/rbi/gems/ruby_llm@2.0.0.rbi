  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:153
  def parse_annotations(annotations, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:134
  def parse_citations(data, output, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:53
  def parse_completion_body(data, raw:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:164
  def parse_file_citation(annotation, content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/responses/chat.rb:401
