    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:75
    def render_count_tokens_payload(messages, tools:, model:, tool_prefs: T.unsafe(nil), thinking: T.unsafe(nil), schema: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:43
    def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), max_output_tokens: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), citations: T.unsafe(nil), caching: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:232
    def search_result_block(result); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:664
    def server_tool_result?(tool_result); end

    # Provider-executed tool steps come back with a distinguishing type,
