# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:112
class RubyLLM::ForbiddenError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:113
    def default_message; end
  end
end

# An Image is a generated or edited image. Save it to a file with #save
# or read its bytes with #to_blob. Both handle hosted URLs and inline data.
#
#   image = RubyLLM.paint("a sunset over mountains in watercolor style")
#   image.save("sunset.png")
#
# pkg:gem/ruby_llm#lib/ruby_llm/image.rb:12
class RubyLLM::Image
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:111
  def initialize(url: T.unsafe(nil), data: T.unsafe(nil), mime_type: T.unsafe(nil), revised_prompt: T.unsafe(nil), model: T.unsafe(nil), usage: T.unsafe(nil)); end

  # Returns +true+ if the image holds inline Base64 data, +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:122
  def base64?; end

  # Set by the protocol that generated the image, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:107
  def config; end

  # Set by the protocol that generated the image, so a Context's
  # connection settings reach #to_blob.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:105
  def config=(_arg0); end

  # Returns a Cost across every provider attempt, using reported prices
  # when available and registry pricing otherwise.
  #
  #   image.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:171
  def cost; end

  # The Base64-encoded image data, for providers that return the image
  # inline, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:21
  def data; end

  # The MIME type of the image data, such as <tt>"image/png"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:24
  def mime_type; end

  # The id of the model that generated the image.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:30
  def model; end

  # Returns the registry Model for #model, or +nil+ if the model id
  # is missing or not in the registry.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:179
  def model_info; end

  # The provider's rewritten version of the prompt, when reported.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:27
  def revised_prompt; end

  # Writes the binary image to +path+, expanding it first. Returns
  # +path+ as given.
  #
  #   image.save("steampunk_owl.png")
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:145
  def save(path); end

  # Returns the raw binary image bytes, decoding #data when present or
  # downloading from #url otherwise.
  #
  #   image_bytes = image.to_blob
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:131
  def to_blob; end

  # Returns a Tokens with usage across every provider attempt.
  # Its fields are +nil+ when none were reported.
  #
  #   image.tokens.input
  #   image.tokens.output
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:156
  def tokens; end

  # The URL of the hosted image, for providers that return one, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:17
  def url; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:191
  def input_tokens_details; end

  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:195
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:189
  def raw_usage; end

  class << self
    # Generates an image from +prompt+ and returns an Image. Most code
    # calls this through RubyLLM.paint.
    #
    # +model:+ selects the image model and defaults to the configured
    # +default_image_model+. +provider:+ forces a specific provider, and
    # +assume_model_exists:+ skips the registry lookup, which is useful
    # for custom endpoints. +size:+ requests dimensions on models that
    # support it. +count:+ asks for several images in one request, returning
    # an Array of Images instead of one. +with:+ passes one or more source
    # images for editing, and +mask:+ constrains which parts of the image
    # may change. +provider_options:+ takes options in the provider's
    # request vocabulary and merges them into the request as-is.
    # +context:+ supplies a Context whose configuration replaces the
    # global one. +metadata:+ is included in the instrumentation payload.
    #
    #   image = RubyLLM.paint("A small watercolor robot", model: "gpt-image-2")
    #
    #   images = RubyLLM.paint("A small watercolor robot", count: 4)
    #   images.each_with_index { |image, i| image.save("robot-#{i}.png") }
    #
    #   RubyLLM.paint(
    #     "Turn the logo green and keep the background transparent",
    #     model: "gpt-image-2",
    #     with: "logo.png"
    #   )
    #
    # Providers that cannot generate several images in one request ignore
    # +count:+ and return a single Image.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/image.rb:60
    def paint(prompt, model: T.unsafe(nil), provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), size: T.unsafe(nil), count: T.unsafe(nil), context: T.unsafe(nil), with: T.unsafe(nil), mask: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil)); end
  end
end

# Raised when a message role outside +:system+, +:user+, +:assistant+, or
# +:tool+ is used.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:60
class RubyLLM::InvalidRoleError < ::StandardError; end

# Raised when the +choice:+ option of Chat#with_tool_options is neither a
# known mode nor the name of a registered tool.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:64
class RubyLLM::InvalidToolChoiceError < ::StandardError; end

# A Message is a single entry in a chat conversation: a user prompt, an
# assistant reply, a system instruction, or a tool result. Chat#ask
# returns the model's reply as a Message, and Chat#messages holds the
# transcript as an array of them.
#
#   response = chat.ask "What is the capital of France?"
#   response.role          # => :assistant
#   response.content       # => "The capital of France is Paris."
#   response.finish_reason # => :stop
#
# A Message also carries everything else the provider returned: token
# usage (#tokens), reasoning output (#thinking), source citations
# (#citations), and requested tool calls (#tool_calls).
#
# pkg:gem/ruby_llm#lib/ruby_llm/message.rb:17
class RubyLLM::Message
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:84
  def initialize(options = T.unsafe(nil)); end

  # The files sent or returned with the message, as an array of
  # Attachment objects.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:33
  def attachments; end

  # Marks this message as an explicit prompt cache boundary. Providers
  # with boundary controls use the conversation up to and including this
  # message as the cacheable prefix. Returns +self+.
  #
  #   chat.add_message(role: :user, content: long_context).cache_until_here
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:216
  def cache_until_here; end

  # Returns +true+ if the message carries an explicit prompt cache
  # boundary, +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:223
  def cache_until_here?; end

  # The source citations as an array of Citation objects, normalized
  # across providers.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:58
  def citations; end

  # The message text as a String. Empty for assistant messages that only
  # request tool calls.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:29
  def content; end

  # Returns +true+ if a provider safety filter stopped the response,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:184
  def content_filtered?; end

  # The Chat this message belongs to, set when it is added to a
  # conversation. Backs #tool_results.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:82
  def conversation; end

  # The Chat this message belongs to, set when it is added to a
  # conversation. Backs #tool_results.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:82
  def conversation=(_arg0); end

  # Returns a Cost pricing this message's token usage in US dollars.
  # Uses recorded attempt costs, an explicitly supplied +cost:+, or pricing
  # from #model_info. An explicit +model:+ overrides those costs for repricing.
  #
  #   response.cost.total
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:203
  def cost(model: T.unsafe(nil)); end

  # Why the model stopped: +:stop+, +:max_tokens+, +:tool_calls+, or
  # +:content_filter+. Any other reason comes through as the provider
  # spelled it, such as Anthropic's +:pause_turn+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:63
  def finish_reason; end

  # Returns +true+ if the response was cut off by a token limit,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:172
  def max_tokens?; end

  # The ID of the model that produced the message, +nil+ on user messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:36
  def model; end

  # Returns the response's Model from its provider's registry, falling
  # back to the requested model when the response ID is unknown.
  # Restored messages use the last successful attempt's provider and model.
  # Messages without request context look up #model, or return +nil+ if unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:255
  def model_info; end

  # Returns the response's Model from its provider's registry, falling
  # back to the requested model when the response ID is unknown.
  # Restored messages use the last successful attempt's provider and model.
  # Messages without request context look up #model, or return +nil+ if unknown.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:38
  def model_info=(_arg0); end

  # Returns #content parsed as JSON, memoized after the first call.
  # Useful for reading structured output responses.
  #
  #   response = chat.with_schema(PersonSchema).ask "Generate a person"
  #   response.parsed # => {"name" => "Alice", "age" => 30}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:121
  def parsed; end

  # The raw provider response: a Faraday::Response, or the result body
  # Hash for messages retrieved from a Batch.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:50
  def raw; end

  # The provider-shaped content blocks of this assistant message, kept
  # verbatim when the response used server tools so later requests can
  # replay the turn exactly. +nil+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:73
  def raw_content; end

  # The provider-shaped reasoning payload of this assistant message, kept
  # verbatim so later requests can replay the model's reasoning exactly.
  # +nil+ when the provider returned none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:78
  def raw_reasoning; end

  # The role of the message: +:system+, +:user+, +:assistant+, or +:tool+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:25
  def role; end

  # The provider-executed tool steps in this response, as an array of
  # ServerToolCall objects. Empty unless the chat enabled tools with
  # Chat#with_provider_tools and the model used one.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:68
  def server_tool_calls; end

  # Returns +true+ if #finish_reason indicates the model finished
  # normally, +false+ otherwise. A turn that stopped to call tools is
  # reported by #tool_call_stop? instead, whatever the provider named it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:166
  def stopped?; end

  # The model's reasoning output as a Thinking object, or +nil+ when the
  # provider returned none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:54
  def thinking; end

  # Returns a Hash of the message's attributes, with token counts merged
  # in as +:input_tokens+, +:output_tokens+, and related keys. Omits
  # +nil+ values and empty attachment and citation lists. Includes +:cost+
  # only when supplied explicitly, preserving unknown costs on round-trip.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:231
  def to_h; end

  # Returns usage aggregated across every provider attempt that produced this
  # message. Messages constructed by hand report the token counts they were
  # built with.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:191
  def tokens; end

  # Returns +true+ if the assistant requested one or more tool calls,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:142
  def tool_call?; end

  # The ID of the tool call this message answers. Set only on tool result
  # messages.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:46
  def tool_call_id; end

  # Returns +true+ if the model stopped to request tool calls,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:178
  def tool_call_stop?; end

  # The tool calls the assistant requested, as a Hash of ToolCall objects
  # keyed by call ID, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:42
  def tool_calls; end

  # Returns +true+ if the message carries the result of a tool call,
  # +false+ otherwise.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:148
  def tool_result?; end

  # Returns the tool result messages answering this message's tool calls,
  # or an empty array when it made none. Mirrors the +tool_results+
  # association on acts_as_message records.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:155
  def tool_results; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:127
  def with_attachments(attachments); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:132
  def without_thinking; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:293
  def coerce_thinking(thinking, signature); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:274
  def coerce_tool_calls(tool_calls); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:301
  def coerce_value(value, klass); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:314
  def ensure_valid_role; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:318
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:270
  def list_to_h(list); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:305
  def normalize_content(content); end

  # pkg:gem/ruby_llm#lib/ruby_llm/message.rb:287
  def tool_calls_without_thought_signatures; end
end

# The valid message roles: +:system+, +:user+, +:assistant+, and +:tool+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/message.rb:22
RubyLLM::Message::ROLES = T.let(T.unsafe(nil), Array)

# A Model describes one entry in the model registry: the model's identity,
# capabilities, modalities, pricing, and provider metadata. Instances come
# from the registry through RubyLLM.models and from Chat#model.
#
#   model = RubyLLM.models.find('gpt-5.6')
#   model.name              # => "GPT-5.6"
#   model.provider          # => "openai"
#   model.context_window    # => 1050000
#   model.supports?(:vision) # => true
#
# pkg:gem/ruby_llm#lib/ruby_llm/model.rb:14
class RubyLLM::Model
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:76
  def initialize(data); end

  # The model's capability names as an array of Strings,
  # e.g. <tt>["function_calling", "streaming"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:50
  def capabilities; end

  # The maximum number of input tokens the model accepts, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:33
  def context_window; end

  # Builds a Cost for +tokens+ (a Tokens object, or anything responding
  # to +tokens+) using this model's pricing.
  #
  #   cost = model.cost_for(response.tokens)
  #   puts cost.total
  #
  # Pass <tt>tier: :batch</tt> to use the model's explicit batch rates.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:160
  def cost_for(tokens, tier: T.unsafe(nil)); end

  # The model's release timestamp as a UTC Time, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:30
  def created_at; end

  # The model family as a String, e.g. <tt>"gpt"</tt>, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:27
  def family; end

  # The provider's identifier for the model, e.g. <tt>"gpt-5.6"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:18
  def id; end

  # The model's training data cutoff as a Date, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:39
  def knowledge_cutoff; end

  # Returns the provider display name and model name combined,
  # e.g. <tt>"OpenAI - GPT-5.6"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:115
  def label; end

  # The maximum number of tokens the model can generate, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:36
  def max_output_tokens; end

  # Provider-specific metadata as a Hash.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:56
  def metadata; end

  # The supported input and output modalities as a Model::Modalities object.
  #
  #   model.modalities.input   # => ["text", "image", "pdf"]
  #   model.modalities.output  # => ["text"]
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:46
  def modalities; end

  # The human-readable model name, e.g. <tt>"GPT-5.6"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:21
  def name; end

  # Returns the standard text-token price for +kind+ in USD per million
  # tokens, or +nil+ if the registry has no such price. Valid kinds are
  # +:input+, +:output+, +:cache_read+, and +:cache_write+.
  #
  #   model.price(:input)   # => 2.5
  #   model.price(:output)  # => 10.0
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:145
  def price(kind); end

  # The model's pricing as a Model::Pricing object, in USD per million tokens.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:53
  def pricing; end

  # The provider slug as a String, e.g. <tt>"openai"</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:24
  def provider; end

  # Returns the Provider class registered for this model's provider slug,
  # or +nil+ if no such provider is registered.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:168
  def provider_class; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:120
  def reasoning_option(type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:124
  def reasoning_option_values(type); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:63
  def reasoning_options; end

  # Returns whether #capabilities includes +capability+, given as a String
  # or Symbol.
  #
  #   model.supports?(:function_calling) # => true
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:99
  def supports?(capability); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:187
  def to_h; end

  # Returns the model's primary function, inferred from its output
  # modalities: +:chat+, +:embedding+, +:moderation+, +:image+, +:audio+,
  # +:video+, or +:rerank+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:175
  def type; end

  # Returns whether the configured provider has stopped listing the model.
  # An unlisted model is kept only because application records still
  # reference it, and it may already be failing at the provider.
  #
  #   model.unlisted? # => false
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:109
  def unlisted?; end

  # The time the configured provider stopped listing the model, as a UTC
  # Time, or +nil+ while the provider still lists it. Only a store that keeps
  # unlisted entries, such as the Rails model table, sets it.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:61
  def unlisted_at; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:245
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:233
  def normalize_reasoning_options(options); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:209
  def pricing_data_with_long_context(pricing); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:222
  def reasoning_options_from(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:226
  def store_reasoning_options_metadata; end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/model.rb:65
    def default(model_id, provider); end
  end
end

# A Model::Modalities lists the kinds of content a model accepts and
# produces, as arrays of Strings. Instances come from Model#modalities.
#
#   model = RubyLLM.models.find('gpt-5.6')
#   model.modalities.input   # => ["text", "image", "pdf"]
#   model.modalities.output  # => ["text"]
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:12
class RubyLLM::Model::Modalities
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:21
  def initialize(data); end

  # The input modalities as an array of Strings,
  # e.g. <tt>["text", "image", "pdf"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:15
  def input; end

  # The output modalities as an array of Strings,
  # e.g. <tt>["text"]</tt> or <tt>["embeddings"]</tt>.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:19
  def output; end

  # Returns the modalities as a Hash with +:input+ and +:output+ keys.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/modalities.rb:27
  def to_h; end
end

# The standard text-token price columns, keyed by the symbol #price
# accepts.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model.rb:130
RubyLLM::Model::PRICES = T.let(T.unsafe(nil), Hash)

# A Pricing groups a model's prices by usage category: text tokens,
# images, audio tokens, and embeddings. Each category is a
# PricingCategory. Prices are in USD per million tokens. Instances come
# from Model#pricing.
#
#   model = RubyLLM.models.find "claude-sonnet-5"
#   model.pricing.text_tokens.input   # => 3
#   model.pricing.text_tokens.output  # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:14
class RubyLLM::Model::Pricing
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:18
  def initialize(data); end

  # Returns the PricingCategory for audio token prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:40
  def audio_tokens; end

  # Returns the PricingCategory for embedding prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:46
  def embeddings; end

  # Returns the PricingCategory for image generation prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:34
  def images; end

  # Returns the PricingCategory for text token prices, or an empty
  # category if the model has none.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:28
  def text_tokens; end

  # Returns the pricing data as a nested Hash keyed by category.
  # Categories without prices are omitted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:52
  def to_h; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:58
  def category(name); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:62
  def empty_pricing?(data); end
end

# The pricing categories a model may define.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing.rb:16
RubyLLM::Model::Pricing::CATEGORIES = T.let(T.unsafe(nil), Array)

# A PricingCategory holds the standard, batch, and long-context pricing
# tiers for one kind of model usage, such as text tokens or images.
# Model#pricing returns a Pricing collection whose categories are
# PricingCategory instances. Prices are in USD per million tokens.
#
#   model    = RubyLLM.models.find "claude-sonnet-5"
#   category = model.pricing.text_tokens
#   category.input  # => 3
#   category.output # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:15
class RubyLLM::Model::PricingCategory
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:35
  def initialize(data = T.unsafe(nil)); end

  # The batch-tier PricingTier, or +nil+ when the model has no batch
  # pricing for this category.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:25
  def batch; end

  # Returns the standard-tier cache read price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:58
  def cache_read_input; end

  # Returns the standard-tier cache write price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:64
  def cache_write_input; end

  # Returns the standard-tier input price in USD per million tokens,
  # or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:46
  def input; end

  # The long-context PricingTier, or +nil+ when the model has no
  # separate rates for prompts above #long_context_threshold.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:29
  def long_context; end

  # Prompt-size threshold (in tokens) above which long-context rates
  # apply, or +nil+ when the model has no long-context tier.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:33
  def long_context_threshold; end

  # Returns the standard-tier output price in USD per million tokens,
  # or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:52
  def output; end

  # Returns the standard-tier reasoning output price in USD per million
  # tokens, or +nil+ if the price is missing.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:70
  def reasoning_output; end

  # The standard-tier PricingTier, or +nil+ when the model has no
  # standard pricing for this category.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:21
  def standard; end

  # Returns the PricingTier that applies for a prompt of the given size.
  # Uses #long_context when that tier exists and +prompt_tokens+ is
  # greater than #long_context_threshold; otherwise returns #standard.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:77
  def tier_for(prompt_tokens); end

  # Returns a Hash with present tier hashes and optional
  # +:long_context_threshold+, omitting absent entries.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:88
  def to_h; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:139
  def empty_tier?(tier_data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:133
  def tier_from(tier_data); end

  class << self
    # Builds long-context rates and threshold from a models.dev-style cost
    # Hash (as stored on Model#metadata under +:cost+). Returns
    # <tt>[rates_hash, threshold]</tt>, or <tt>[nil, nil]</tt> when the
    # cost has no context tier.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:101
    def long_context_from_cost(cost); end

    private

    # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:118
    def context_cost(cost); end
  end
end

# The billing tiers a category may define.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_category.rb:17
RubyLLM::Model::PricingCategory::TIERS = T.let(T.unsafe(nil), Array)

# A PricingTier holds the prices a model charges within one billing tier,
# such as standard, batch, or long_context. Each price is in USD per one
# million tokens. Prices missing from the registry read as +nil+. A zero
# price means the usage is free.
#
# Instances come from PricingCategory#standard, #batch, and #long_context:
#
#   model = RubyLLM.models.find "claude-sonnet-5"
#   tier  = model.pricing.text_tokens.standard
#   tier.input_per_million  # => 3
#   tier.output_per_million # => 15
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:17
class RubyLLM::Model::PricingTier
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:27
  def initialize(data = T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:68
  def cache_read_input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:68
  def cache_write_input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:68
  def input_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:68
  def output_per_million; end

  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:68
  def reasoning_output_per_million; end

  # Returns a new Hash of the tier's prices with Symbol keys. Missing
  # prices are omitted.
  #
  #   tier.to_h
  #   # => {input_per_million: 3, output_per_million: 15, ...}
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:79
  def to_h; end
end

# The names of the price readers a tier responds to.
#
# pkg:gem/ruby_llm#lib/ruby_llm/model/pricing_tier.rb:19
RubyLLM::Model::PricingTier::ATTRIBUTES = T.let(T.unsafe(nil), Array)

# Raised when a requested model id is not in the model registry.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:73
class RubyLLM::ModelNotFoundError < ::StandardError; end

# Raised when a model registry cannot be fetched, parsed, or persisted.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:76
class RubyLLM::ModelRegistryError < ::StandardError; end

# A Models registry is the catalog of AI models RubyLLM knows about,
# including their capabilities, context windows, and pricing. The global
# registry is available through RubyLLM.models.
#
#   RubyLLM.models.find 'claude-sonnet-5'
#   RubyLLM.models.by_provider(:openai).chat_models
#   RubyLLM.models.refresh
#
# Filter methods return new Models instances, so calls chain. Models is
# enumerable over its Model entries. Class-level calls such as
# Models.find delegate to the global registry.
#
# pkg:gem/ruby_llm#lib/ruby_llm/models.rb:17
class RubyLLM::Models
  include ::Enumerable

  # :startdoc:
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:542
  def initialize(models = T.unsafe(nil)); end

  # Returns an array of the Model entries the configured provider still
  # lists. Models it has stopped listing are left out; #find still resolves
  # them, and #unlisted reports them.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:579
  def all; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:597
  def all_including_unlisted; end

  # Returns a new Models registry containing only models with audio
  # output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:637
  def audio_models; end

  # Returns a new Models registry containing only models in +family+.
  #
  #   RubyLLM.models.by_family('claude3_sonnet')
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:651
  def by_family(family); end

  # Returns a new Models registry containing only models from +provider+.
  # Accepts a symbol or a string.
  #
  #   RubyLLM.models.by_provider(:openai).select { |model| model.supports?(:vision) }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:660
  def by_provider(provider); end

  # Returns a new Models registry containing only chat models.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:626
  def chat_models; end

  # Yields each Model in the registry.
  #
  #   RubyLLM.models.each { |model| puts model.id }
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:605
  def each(&); end

  # Returns a new Models registry containing only embedding models.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:631
  def embedding_models; end

  # Returns the Model matching +model_id+, resolving aliases along the
  # way. Without +provider+, picks the preferred provider that carries
  # the model, first-party providers before aggregators. Raises
  # RubyLLM::ModelNotFoundError if no model matches.
  #
  #   RubyLLM.models.find 'gpt-5.6'
  #   RubyLLM.models.find 'claude-sonnet-5', provider: :bedrock
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:617
  def find(model_id, provider: T.unsafe(nil), config: T.unsafe(nil)); end

  # Returns a new Models registry containing only models with image
  # output.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:643
  def image_models; end

  # Returns an array of the Model entries the configured provider still
  # lists. Reads the same as #all, which already excludes the rest.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:595
  def listed; end

  # Replaces the models in this registry with those read from the JSON
  # +file+. The default is the configured
  # <tt>RubyLLM.config.model_registry_file</tt>. A missing or invalid
  # file falls back to the registry bundled with the gem.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:550
  def load_from_json(file = T.unsafe(nil)); end

  # Replaces the models in this registry with entries from the configured
  # model-registry store.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:557
  def load_from_store; end

  # Replaces the registry with the latest published RubyLLM catalog,
  # merged with models discovered from configured providers. The result is
  # saved to the platform cache, or to the database in Rails applications.
  # Pass +remote_only:+ +true+ to skip local providers such as Ollama and
  # GPUStack. Returns +self+.
  #
  # Raises ModelRegistryError when the catalog cannot be fetched or the
  # result cannot be persisted, leaving the current registry unchanged.
  #
  #   RubyLLM.models.refresh
  #   RubyLLM.models.refresh(remote_only: true).chat_models
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:676
  def refresh(remote_only: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:689
  def refresh_from_providers(remote_only: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:694
  def resolve(model_id, provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), config: T.unsafe(nil)); end

  # Exports this registry to +file+ as pretty-printed JSON. The default is
  # the configured <tt>RubyLLM.config.model_registry_file</tt>. A regular
  # #refresh already persists to the active registry store.
  #
  #   RubyLLM.models.save_to_json('/tmp/models.json')
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:571
  def save_to_json(file = T.unsafe(nil)); end

  # Returns an array of the Model entries the configured provider has
  # stopped listing. Only a store that keeps them, such as the Rails model
  # table, ever reports one.
  #
  #   RubyLLM.models.unlisted.map(&:id)
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:589
  def unlisted; end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:720
  def fetch_published_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:706
  def file_store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:796
  def find_with_provider(model_id, provider, config = T.unsafe(nil)); end

  # A name can be one provider's exact id and another's alias:
  # claude-opus-4 is exact on vertexai, an alias on anthropic.
  # Provider preference settles it, not the kind of match.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:814
  def find_without_provider(model_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:734
  def merge_discovered_models(published, remote_only:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:752
  def persist_registry!(models, published:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:833
  def preferred_match(candidates); end

  # A provider that answered replaces its own models and the published
  # catalog replaces what it covers. Everything else survives the refresh,
  # including the local providers a remote_only run never asks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:745
  def preserved_providers(provider_fetch, published); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:727
  def published_catalog; end

  # The ETag identifies the published catalog, not the merged registry, so
  # it may only be sent while the catalog it stands for is still on disk.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:715
  def published_store; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:822
  def raise_model_not_found(model_id, provider: T.unsafe(nil)); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:829
  def refresh_registry_guidance; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:804
  def resolve_provider_registry_id(model_id, provider, config = T.unsafe(nil)); end

  # Filters keep the unlisted entries so #find and #unlisted still see them
  # after a chain such as by_provider(:openai).unlisted.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:702
  def select_models(&); end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:790
  def store_description(store); end

  # A store keeps entries the merge dropped, such as the unlisted rows a
  # Rails application still references, so its answer wins over the merge.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:775
  def stored_models; end

  # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:786
  def write_published_catalog(published); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:349
    def add_provider_metadata(models_dev_model, provider_model); end

    # Returns an array of the Model entries the configured provider still
    # lists. Models it has stopped listing are left out; #find still resolves
    # them, and #unlisted reports them.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def all(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def all?(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def any?(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def as_json(*args, **kwargs, &block); end

    # Returns a new Models registry containing only models with audio
    # output.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def audio_models(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:381
    def augment_capabilities(provider_slug, capabilities, model_id, modalities); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:374
    def augment_model_capabilities(model); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:409
    def blank_value?(value); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:88
    def bundled_registry_file; end

    # Returns a new Models registry containing only models in +family+.
    #
    #   RubyLLM.models.by_family('claude3_sonnet')
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def by_family(*args, **kwargs, &block); end

    # Returns a new Models registry containing only models from +provider+.
    # Accepts a symbol or a string.
    #
    #   RubyLLM.models.by_provider(:openai).select { |model| model.supports?(:vision) }
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def by_provider(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def chain(*args, **kwargs, &block); end

    # Returns a new Models registry containing only chat models.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def chat_models(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def chunk(*args, **kwargs, &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/models.rb:79
    def chunk_while(*args, **kwargs, &block); end

