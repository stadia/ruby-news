  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:395
  def current_message; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/gemini/chat.rb:446
  def format_tool_result(message, tool_name); end

  # functionResponse parts carry no call id, so Gemini pairs them with
  # the functionCall parts by position. Results that arrived out of
  # call order have to be put back in it.
