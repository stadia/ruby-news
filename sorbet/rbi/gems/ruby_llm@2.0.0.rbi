    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:109
    def parse_completion_body(data, raw:); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:92
    def parse_count_tokens_response(response); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:626
    def parse_reasoning_content_block(block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:605
    def parse_thinking(content_blocks); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:621
    def parse_thinking_blocks(content_blocks); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:637
    def parse_tool_calls(content_blocks); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:288
    def prompt_cache_options(caching); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:104
    def provider_file_attachable?(attachment); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:495
    def ranged_budget(effort, schema); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/chat.rb:422
    def reasoning_budget(thinking, effort, model, max_output_tokens); end

    # Bedrock only publishes Converse metadata for some regional entries, so use the
    # schema from another entry for the same foundation model when needed.
