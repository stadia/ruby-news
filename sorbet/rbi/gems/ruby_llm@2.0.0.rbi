# pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:9
module RubyLLM::Protocol::Streaming
  private

  # Parser state lives on the env so every retry attempt starts fresh;
  # ErrorMiddleware clears it per attempt. Faraday v1 passes no env to
  # on_data, so it falls back to one state for the whole request.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:66
  def build_on_data_handler(progress = T.unsafe(nil), &handler); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:181
  def build_stream_error_response(parsed_data, env, status); end

  # An error event split across network reads reaches here in pieces, so only
  # a whole one takes this shortcut; the rest go to the parser, which buffers
  # them until the event is complete.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:101
  def error_chunk?(chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:191
  def failed_http_status(env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:59
  def faraday_1?; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:145
  def handle_data(data, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:113
  def handle_error_chunk(chunk, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:154
  def handle_error_event(data, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:118
  def handle_failed_response(chunk, buffer, env); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:109
  def handle_json_error_chunk(chunk, env); end

  # Marking progress just before a chunk reaches the user lets the retry
  # middleware know this stream already delivered, so a mid-stream failure
  # must not be retried into the same accumulator and user block. An error
  # event raises out of handle_data first, leaving the stream retriable.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:130
  def handle_sse(chunk, parser, env, progress); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:51
  def handle_stream(&block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:105
  def json_error_payload?(chunk); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:174
  def parse_error_from_json(data, env, error_message); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:158
  def parse_streaming_error(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:86
  def process_stream_chunk(chunk, state, env, progress, &); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:167
  def raise_stream_error(raw_data, parsed_data, env); end

  # Posts +payload+ to +url+ as a server-sent event stream, yielding each
  # parsed event Hash. Returns the Faraday response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:34
  def stream_events(url, payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:18
  def stream_response(payload, additional_headers = T.unsafe(nil), &block); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:80
  def stream_state(env, fallback_state); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:51
    def handle_stream(&block); end

    # Posts +payload+ to +url+ as a server-sent event stream, yielding each
    # parsed event Hash. Returns the Faraday response.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:34
    def stream_events(url, payload, additional_headers = T.unsafe(nil), &block); end

    # pkg:gem/ruby_llm#lib/ruby_llm/protocol/streaming.rb:18
    def stream_response(payload, additional_headers = T.unsafe(nil), &block); end
  end
end

