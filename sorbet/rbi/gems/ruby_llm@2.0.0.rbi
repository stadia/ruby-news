# A Rerank is the result of ordering documents by relevance to a query.
# RubyLLM.rerank returns one:
#
#   rerank = RubyLLM.rerank("what is ruby",
#                           ["Ruby is a programming language", "Paris is in France"],
#                           model: "voyageai/rerank-2.5-lite", provider: :openrouter)
#   rerank.results.first.document # => "Ruby is a programming language"
#   rerank.results.first.score    # => 0.80078125
#
# pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:13
class RubyLLM::Rerank
  include ::RubyLLM::Support::Inspectable
  include ::RubyLLM::Accounting::Usage::Result

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:30
  def initialize(results:, model:, raw: T.unsafe(nil), input_tokens: T.unsafe(nil), reported_cost: T.unsafe(nil)); end

  # Returns the rerank cost across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:46
  def cost; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:58
  def inspect_attributes; end

  # The id of the model that ranked the documents, as a String.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:25
  def model; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:52
  def model_info; end

  # The raw provider response body.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:28
  def raw; end

  # The reranked results, most relevant first, as an array of Result.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:22
  def results; end

  # Returns usage aggregated across every provider attempt.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:39
  def tokens; end

  class << self
    # Ranks +documents+ (an array of strings) by relevance to +query+ and
    # returns a Rerank. +model:+ is required; rerank catalogs are
    # provider-specific and have no cross-provider default. +top_n:+
    # limits how many results come back. +provider_options:+ merges
    # options into the request in the provider's vocabulary.
    #
    #   RubyLLM.rerank "what is ruby", docs, model: "voyageai/rerank-2.5-lite", provider: :openrouter
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:70
    def rerank(query, documents, model:, provider: T.unsafe(nil), assume_model_exists: T.unsafe(nil), context: T.unsafe(nil), top_n: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil)); end
  end
end

# One reranked document: its +index+ in the input array, the
# +document+ text, and the provider's relevance +score+.
#
# pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
class RubyLLM::Rerank::Result < ::Struct
  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def document; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def document=(_); end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def index; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def index=(_); end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def score; end

  # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
  def score=(_); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
    def [](*_arg0); end

    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
    def inspect; end

    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
    def keyword_init?; end

    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
    def members; end

    # pkg:gem/ruby_llm#lib/ruby_llm/rerank.rb:19
    def new(*_arg0); end
  end
end

# A hosted, single-turn research task. RubyLLM.research_later returns a
# job immediately; #wait polls it and #message returns its report.
# The provider's agent identity is separate from an inference model.
#
#   job = RubyLLM.research_later(question, provider: provider, agent: agent_id)
#   job.wait
#   puts job.message.content
#
# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:12
class RubyLLM::ResearchJob
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:121
  def initialize(id:, provider:, agent:, protocol:, **state); end

  # The hosted agent's identity, separate from a model ID.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:53
  def agent; end

  # Requests cancellation and returns self. Only the provider's response
  # can confirm cancellation; this does not delete stored task data.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:178
  def cancel(timeout: T.unsafe(nil)); end

  # The error from an unsuccessful automatic cancellation attempt, if any.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:66
  def cancellation_error; end

  # Returns whether the provider confirmed cancellation.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:145
  def cancelled?; end

  # Returns whether the task finished with a complete report.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:136
  def completed?; end

  # Returns the reported cost, or unknown cost when the provider supplies
  # no price. Agent IDs are never used to look up model token prices.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:201
  def cost; end

  # Returns whether the task reached any terminal state.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:133
  def done?; end

  # The provider's failure explanation, if any.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:60
  def error; end

  # Returns whether the provider reported failure.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:142
  def failed?; end

  # The provider-assigned job ID.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:47
  def id; end

  # Returns whether the provider stopped before completing the report.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:139
  def incomplete?; end

  # Returns the report, or +nil+ while pending. An incomplete report has
  # Message#finish_reason +:max_tokens+. Raises Error for failed or
  # cancelled tasks.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:190
  def message; end

  # Returns whether the task is waiting or running.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:130
  def pending?; end

  # The provider slug.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:50
  def provider; end

  # The original provider response from submission or the latest poll.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:63
  def raw; end

  # Fetches the latest state and returns self. Does nothing after the
  # task finishes. +timeout:+ limits this request in seconds.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:149
  def refresh(timeout: T.unsafe(nil)); end

  # The normalized state: +:pending+, +:completed+, +:incomplete+,
  # +:failed+, or +:cancelled+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:57
  def status; end

  # Returns the provider-reported task usage. Unreported fields are nil.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:197
  def tokens; end

  # Polls until a terminal state and returns self. A timeout leaves the
  # independent task running and raises TimeoutError with this job.
  # Incomplete reports remain available through #message.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:161
  def wait(timeout: T.unsafe(nil), interval: T.unsafe(nil)); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:219
  def apply_state(state); end

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:227
  def attempt_cancellation; end

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:237
  def inspect_attributes; end

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:233
  def monotonic_time; end

  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:207
  def request_with_timeout(timeout, &); end

  class << self
    # Retrieves an existing task by ID without submitting another one.
    # Use the same provider configuration that created the task.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:110
    def find(id, provider:, context: T.unsafe(nil)); end

    # Runs a research task and returns its Message. On a timeout or
    # interrupt, attempts to cancel the remote task before raising an
    # error retaining the job. +timeout:+ and +interval:+ are seconds.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:88
    def research(prompt, timeout: T.unsafe(nil), interval: T.unsafe(nil), **options); end

    # Submits one research task without waiting. +provider:+ and +agent:+
    # are required; +with:+ attaches documents or images where supported.
    # +provider_tools:+ accepts an array of aliases or a Hash of aliases
    # and their options, as on Chat#with_provider_tools.
    #
    # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:72
    def research_later(prompt, provider:, agent:, with: T.unsafe(nil), provider_tools: T.unsafe(nil), context: T.unsafe(nil), provider_options: T.unsafe(nil), metadata: T.unsafe(nil)); end

    # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:115
    def validate_polling_options(timeout, interval); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:15
class RubyLLM::ResearchJob::DeadlineExpired < ::StandardError; end

# A research failure that retains the job for inspection or recovery.
#
# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:19
class RubyLLM::ResearchJob::Error < ::RubyLLM::Error
  # Creates an error retaining +job+ and the optional HTTP response.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:24
  def initialize(message, job:, response: T.unsafe(nil)); end

  # The research job, including its remote ID and last known state.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:21
  def job; end
end

# An interrupted blocking research call retaining its remote job.
#
# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:35
class RubyLLM::ResearchJob::InterruptedError < ::Interrupt
  # Creates an interruption retaining +job+ for recovery.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:40
  def initialize(message, job:); end

  # The job whose cancellation was attempted before interrupting.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:37
  def job; end
end

# Raised when polling exceeds its deadline. The independent job may
# still be running; Error#job retains its ID.
#
# pkg:gem/ruby_llm#lib/ruby_llm/research_job.rb:32
class RubyLLM::ResearchJob::TimeoutError < ::RubyLLM::ResearchJob::Error; end

# A SearchResults wraps documents a Tool returns so the model can cite
# each source. RubyLLM renders them in the selected provider's citation
# format; cited passages appear on Message#citations.
#
#   def execute(query:)
#     docs = MyVectorStore.search(query)
#
#     RubyLLM::SearchResults.new(
#       *docs.map { |doc| { title: doc.name, url: doc.link, text: doc.body } }
#     )
#   end
#
# Cited passages come back on the response as Message#citations.
#
# pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:17
class RubyLLM::SearchResults
  # Returns a new SearchResults built from one or more result hashes, or
  # from a single result given as keywords.
  #
  #   RubyLLM::SearchResults.new(title: 'Q4 Report', url: report_url, text: report_text)
  #   RubyLLM::SearchResults.new({ title: 'A', text: '...' }, { title: 'B', text: '...' })
  #
  # Each result is reduced to its +:title+, +:url+, and +:text+ entries.
  # Raises ArgumentError if no results are given or a result is missing
  # +:title+ or +:text+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:33
  def initialize(*results, **result); end

  # The normalized results, as an array of hashes with +:title+, +:text+,
  # and optional +:url+ keys.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:22
  def results; end

  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:51
  def to_h; end

  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:55
  def to_json(*args); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:61
  def normalize(entry); end

  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:39
    def from_content(content); end
  end
end

# pkg:gem/ruby_llm#lib/ruby_llm/search_results.rb:18
RubyLLM::SearchResults::KEY = T.let(T.unsafe(nil), String)

# Raised for HTTP 500 responses when the provider reports a server error.
#
# pkg:gem/ruby_llm#lib/ruby_llm/error.rb:164
class RubyLLM::ServerError < ::RubyLLM::Error
  class << self
    # pkg:gem/ruby_llm#lib/ruby_llm/error.rb:165
    def default_message; end
  end
end

# A ServerToolCall records one provider-executed tool step in an assistant
# response: a web search the model ran, a code execution, or the results
# block a provider returned for one. They appear on
# Message#server_tool_calls when a chat enables tools with
# Chat#with_provider_tools.
#
#   response = chat.with_provider_tools(:web_search).ask "What changed in Ruby 3.5?"
#   response.server_tool_calls.map(&:type) # => ["server_tool_use", "web_search_tool_result"]
#
# RubyLLM does not model each tool's result schema. #raw always holds the
# provider's block exactly as received, and is what RubyLLM replays to the
# provider in subsequent turns when the wire format requires it.
#
# pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:16
class RubyLLM::ServerToolCall
  include ::RubyLLM::Support::Inspectable

  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:48
  def initialize(type:, raw:, name: T.unsafe(nil), id: T.unsafe(nil), input: T.unsafe(nil), result: T.unsafe(nil)); end

  # The provider's identifier for the call, or +nil+.
  #
  # pkg:gem/ruby_llm#lib/ruby_llm/server_tool_call.rb:28
  def id; end

  # The input the model gave the tool (a query, code to run), in the
  # provider's shape, or +nil+.
  #
