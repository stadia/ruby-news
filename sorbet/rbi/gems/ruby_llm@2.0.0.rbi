  def cancel_batch(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:16
  def create_batch(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:29
  def find_batch(id); end

  private

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:82
  def batch_create_url; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:78
  def batch_endpoint; end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:63
  def batch_jsonl(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:67
