  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:71
  def format_audio_attachment(attachment); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/converse/media.rb:10
  def format_content(content, attachments = T.unsafe(nil), used_document_names: T.unsafe(nil), citations: T.unsafe(nil)); end

