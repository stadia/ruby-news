  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:86
  def batch_url(id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:59
  def download_batch_file(file_id); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:90
  def parse_batch_response(data); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:113
  def parse_batch_result(line); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:103
  def parse_batch_status(raw_status, completed:); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:51
  def upload_batch_file(requests); end

  # pkg:gem/ruby_llm#lib/ruby_llm/protocols/openai/batches.rb:76
