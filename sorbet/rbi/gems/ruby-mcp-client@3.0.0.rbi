  # pkg:gem/ruby-mcp-client#lib/mcp_client/client.rb:696
  def log_level=(level); end

  # @return [Logger] logger for client operations
  #
  # pkg:gem/ruby-mcp-client#lib/mcp_client/client.rb:55
  def logger; end

  # Register the host's control over a multi round-trip request's
