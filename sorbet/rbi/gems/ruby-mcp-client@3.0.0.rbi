  def data; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/schema_validator/evaluation.rb:49
  def data=(_); end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/schema_validator/evaluation.rb:49
  def dialect; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/schema_validator/evaluation.rb:49
