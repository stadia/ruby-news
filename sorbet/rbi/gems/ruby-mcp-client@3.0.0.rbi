  def evaluated; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def evaluated=(_); end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def request_method; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def request_method=(_); end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def spent; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def spent=(_); end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def value; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
  def value=(_); end

  class << self
    # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
    def [](*_arg0); end

    # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
    def inspect; end

    # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
    def keyword_init?; end

    # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
    def members; end

    # pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:85
    def new(*_arg0); end
  end
end

# pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:275
