    #
    # pkg:gem/ruby-mcp-client#lib/mcp_client/auth.rb:471
    def from_h(data); end

    # RFC 8414 makes authorization_response_iss_parameter_supported a JSON
    # boolean. A document (or a persisted record) carrying anything else —
