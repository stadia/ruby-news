# Marks an attempt that has not built its request yet: the parameters
# of the previous request on this thread say nothing about it.
#
# pkg:gem/ruby-mcp-client#lib/mcp_client/request_metadata.rb:59
MCPClient::RequestMetadata::UNRECORDED_PARAMS = T.let(T.unsafe(nil), Symbol)

