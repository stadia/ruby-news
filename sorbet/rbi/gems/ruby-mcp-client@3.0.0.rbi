  # @!attribute [r] annotations
  #   @return [Hash, nil] optional annotations describing tool behavior (e.g., readOnly, destructive)
  # @!attribute [r] server
  #   @return [MCPClient::ServerBase, nil] the server this tool belongs to
  # @!attribute [r] task_support
