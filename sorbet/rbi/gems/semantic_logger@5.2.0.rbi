  def close; end

  # Flush all pending logs to disk.
  #  Waits for all queued log messages to be written to disk.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/wrapper.rb:66
  def flush; end

  # Pass log calls to the underlying Rails, log4j or Ruby logger
  #  trace entries are mapped to debug since :trace is not supported by the
  #  Ruby or Rails Loggers
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/wrapper.rb:58
  def log(log); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/wrapper.rb:7
  def logger; end
end

