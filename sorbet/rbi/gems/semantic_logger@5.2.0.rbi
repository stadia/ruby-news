  def duration; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/color.rb:130
  def exception; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/color.rb:85
  def level; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/color.rb:112
