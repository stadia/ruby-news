  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:8
  def need_process_info; end

  # Ignore process fields: pid, thread, file and line by default.
  # These are rarely useful under Fluentd (e.g. containerized processes
  # usually have pid 1), so they are only included when explicitly requested
  # via `need_process_info: true`.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:24
  def pid; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:28
  def thread_name; end
end

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/json.rb:4
class SemanticLogger::Formatters::Json < ::SemanticLogger::Formatters::Raw
  # Default JSON time format is ISO8601
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/json.rb:6
  def initialize(time_format: T.unsafe(nil), time_key: T.unsafe(nil), **args); end

  # Returns a batch of log messages as a single JSON array.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/json.rb:16
  def batch(logs, logger); end

  # Returns log messages in JSON format
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/json.rb:11
  def call(log, logger); end
end

# Produces logfmt formatted messages
#
# The following fields are extracted from the raw log and included in the formatted message:
#   :timestamp, :level, :name, :message, :duration, :tags, :named_tags
#
# E.g.
#   timestamp="2020-07-20T08:32:05.375276Z" level=info name="DefaultTest" base="breakfast"
#   spaces="second breakfast" double_quotes="\"elevensies\"" single_quotes="'lunch'" tag="success"
#
# All timestamps are ISO8601 formatteed
# All user supplied values are escaped and surrounded by double quotes to avoid ambiguious message delimeters
# `tags` are treated as keys with boolean values.
# In every key (tags, named tags, payload), spaces, control and format characters, `=`, and `"`
# are replaced with `_`, so that untrusted data cannot inject fields or lines, or disguise a key.
# `tags`, `named_tags`, and `payload` are flattened into the top level fields. A key named like
# one of the entry's own fields (the time key, `level`, `name`, `message`, `duration`,
# `duration_ms`, `tag`) or an exception field is prefixed with its source, as in `payload.level`,
# so that logged data cannot replace those fields. So is a key that starts with `tags.`,
# `named_tags.`, or `payload.`, so that it cannot forge another source's field. Other keys that
# are the same once encoded, such as `:user` and `"user"`, or `"a b"` and `"a=b"`, are written
# once, with the value from the later source: `payload` values take precedence over
# `named_tags`, and `named_tags` over `tags`.
# An exception is emitted as `exception_name`, `exception_message`, `stack_trace`, and `cause`,
# and with `log_exception_details` also `exception_details`.
#
# Futher Reading https://brandur.org/logfmt
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:31
class SemanticLogger::Formatters::Logfmt < ::SemanticLogger::Formatters::Raw
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:70
  def initialize(time_format: T.unsafe(nil), time_key: T.unsafe(nil), **args); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:81
  def call(log, logger); end

  # Also writes and reserves the new time key in place of the old one.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:76
  def time_key=(time_key); end

  private

  # Adds a field from logged data, under the name returned by #field_name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:128
  def add_field(prefix, key, value); end

  # Returns [String] the logfmt name of a key from logged data: the key encoded by #logfmt_key,
  # prefixed with its source, as in "payload.level", when it names one of the entry's own fields
  # or starts with a source's prefix, so that untrusted data cannot replace or forge that field,
  # or a field from another source.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:137
  def field_name(prefix, key); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:153
  def flatten_log; end

  # Integers, true, false, and nil have a single JSON form, so they skip the cost of `to_json`.
  # Strings, the most common values, are checked first.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:164
  def format_value(value); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:120
  def handle_exception; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:107
  def handle_payload; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:102
  def handle_tags; end

  # Returns [String] the key as valid UTF-8, with every character that would break the logfmt
  # structure replaced by an underscore. Keys come from tags, named tags, and payloads, which
  # can hold untrusted data; unescaped, they could inject fields or forge an entire line.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:199
  def logfmt_key(key); end

  # Names the entry's own fields from the time key, and reserves those names and the
  # exception's, so that logged data cannot use them.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:182
  def name_entry_fields; end

  # Whether the name is already a valid logfmt key, made of ASCII characters that are all safe.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:192
  def plain_name?(name); end

  # @parsed maps the logfmt name of each field to its value. Logged data is added after the
  # entry's own fields, and a field with the same name as an earlier one replaces its value, so
  # the payload takes precedence over named tags, and named tags over tags.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:92
  def raw_to_logfmt; end

  # Remembers the name of a Symbol key that is not reserved, while there is room. The cache is
  # replaced rather than updated, since a formatter can be shared by several threads.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:148
  def remember_symbol(symbol, name); end
end

# The entry's own fields in the Raw hash, written in this order after the time key.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:33
SemanticLogger::Formatters::Logfmt::ENTRY_FIELDS = T.let(T.unsafe(nil), Array)

# The exception's fields in the Raw hash, mapped to their logfmt names, so that the exception's
# name and message do not replace the entry's own.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:40
SemanticLogger::Formatters::Logfmt::EXCEPTION_FIELDS = T.let(T.unsafe(nil), Hash)

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:51
SemanticLogger::Formatters::Logfmt::NAMED_TAGS_PREFIX = T.let(T.unsafe(nil), String)

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:52
SemanticLogger::Formatters::Logfmt::PAYLOAD_PREFIX = T.let(T.unsafe(nil), String)

# The most Symbol keys to remember the names of, so that untrusted keys cannot grow the cache
# without bound.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:68
SemanticLogger::Formatters::Logfmt::PLAIN_SYMBOL_CACHE_SIZE = T.let(T.unsafe(nil), Integer)

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:53
SemanticLogger::Formatters::Logfmt::SOURCE_PREFIXES = T.let(T.unsafe(nil), Array)

# Prefixes that mark a key from logged data with its source, when the key alone would name
# one of the entry's own fields, or look like a key marked this way.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:50
SemanticLogger::Formatters::Logfmt::TAGS_PREFIX = T.let(T.unsafe(nil), String)

# The field that tells an entry with an exception from one without.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:36
SemanticLogger::Formatters::Logfmt::TAG_FIELD = T.let(T.unsafe(nil), String)

# The ASCII subset of UNSAFE_KEY_CHARS, which is much faster to match against the ASCII keys
# that make up nearly every log event.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:64
SemanticLogger::Formatters::Logfmt::UNSAFE_ASCII_KEY_CHARS = T.let(T.unsafe(nil), Regexp)

# Characters that cannot appear in a logfmt key: spaces and control characters (including
# NEL), which would end the key or the line, the `=` and `"` delimiters, LINE SEPARATOR and
# PARAGRAPH SEPARATOR, which some readers treat as newlines, and the invisible format
# characters, such as ZERO WIDTH SPACE and RIGHT-TO-LEFT OVERRIDE, which would let a key pass
# for another one, such as "level" followed by a ZERO WIDTH SPACE for "level".
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/logfmt.rb:60
SemanticLogger::Formatters::Logfmt::UNSAFE_KEY_CHARS = T.let(T.unsafe(nil), Regexp)

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:5
class SemanticLogger::Formatters::Loki < ::SemanticLogger::Formatters::Base
  # Returns [String] a JSON batch of logs
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:17
  def batch(logs, logger); end

  # Returns [String] a single JSON log
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:9
  def call(log, logger); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:6
  def payload_value; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:6
  def payload_value=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:6
  def stream; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:6
  def stream=(_arg0); end

  private

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:56
  def application; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:30
  def build_stream; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:80
  def context; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:119
  def duration; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:60
  def environment; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:126
  def exception; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:96
  def format_time(log); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:52
  def host; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:64
  def level; end

  # Returns [String] the value as Loki accepts it.
  #
  # A structure is written once, as JSON, depth-limited and repaired by Utils.to_json.
  # Encoding each nested level into a String that the next level encodes again doubled the
  # escaping at every level, so a request parameter 30 levels deep produced gigabytes. A
  # structure's #to_s is its #inspect, which would also expose the instance variables of any
  # object it holds.
