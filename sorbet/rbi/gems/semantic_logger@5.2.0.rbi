class SemanticLogger::Appender::Syslog < ::SemanticLogger::Subscriber
  # Create a Syslog appender instance.
  #
  # Parameters
  #   url: [String]
  #     Default: 'syslog://localhost'
  #     For writing logs to a remote syslog server
  #     URL of server: protocol://host:port
  #     Uses port 514 by default for TCP and UDP.
  #     local syslog example:          'syslog://localhost'
  #     TCP example with default port: 'tcp://logger'
  #     TCP example with custom port:  'tcp://logger:8514'
  #     UDP example with default port: 'udp://logger'
  #     UDP example with custom port:  'udp://logger:8514'
  #     When using the :syslog protocol, logs will always be sent to the localhost syslog
  #
  #   host: [String]
  #     Host name to provide to the remote syslog.
  #     Default: SemanticLogger.host
  #
  #   tcp_client: [Hash]
  #     Default: {}
  #     Only used with the TCP protocol.
  #     Specify custom parameters to pass into Net::TCPClient.new
  #     For a list of options see the net_tcp_client documentation:
  #       https://github.com/reidmorrison/net_tcp_client/blob/master/lib/net/tcp_client/tcp_client.rb
  #
  #   level: [:trace | :debug | :info | :warn | :error | :fatal]
  #     Override the log level for this appender.
  #     Default: SemanticLogger.default_level
  #
  #   filter: [Regexp|Proc]
  #     RegExp: Only include log messages where the class name matches the supplied.
  #     regular expression. All other messages will be ignored.
  #     Proc: Only include log messages where the supplied Proc returns true
  #           The Proc must return true or false.
  #
  #   application: [String]
  #     Identity of the program.
  #     Default: SemanticLogger.application
  #
  #   max_size: [Integer]
  #     Set your own packet size.
  #     Default: 1024 bytes
  #
  #   options: [Integer]
  #     Default: ::Syslog::LOG_PID | ::Syslog::LOG_CONS (when logging to a local syslog daemon)
  #     Any of the following (options can be logically OR'd together)
  #       ::Syslog::LOG_CONS
  #       ::Syslog::LOG_NDELAY
  #       ::Syslog::LOG_NOWAIT
  #       ::Syslog::LOG_ODELAY
  #       ::Syslog::LOG_PERROR
  #       ::Syslog::LOG_PID
  #    Note:
  #      - Only applicable when logging to a local syslog instance.
  #        I.e. When `url: 'syslog://localhost'`
  #
  #   facility: [Integer]
  #     Default: ::Syslog::LOG_USER (the same value as SemanticLogger::Formatters::Syslog::LOG_USER)
  #     Type of program (can be logically OR'd together)
  #       ::Syslog::LOG_AUTH
  #       ::Syslog::LOG_AUTHPRIV
  #       ::Syslog::LOG_CONSOLE
  #       ::Syslog::LOG_CRON
  #       ::Syslog::LOG_DAEMON
  #       ::Syslog::LOG_FTP
  #       ::Syslog::LOG_KERN
  #       ::Syslog::LOG_LRP
  #       ::Syslog::LOG_MAIL
  #       ::Syslog::LOG_NEWS
  #       ::Syslog::LOG_NTP
  #       ::Syslog::LOG_SECURITY
  #       ::Syslog::LOG_SYSLOG
  #       ::Syslog::LOG_USER
  #       ::Syslog::LOG_UUCP
  #       ::Syslog::LOG_LOCAL0
  #       ::Syslog::LOG_LOCAL1
  #       ::Syslog::LOG_LOCAL2
  #       ::Syslog::LOG_LOCAL3
  #       ::Syslog::LOG_LOCAL4
  #       ::Syslog::LOG_LOCAL5
  #       ::Syslog::LOG_LOCAL6
  #       ::Syslog::LOG_LOCAL7
  #
  #   level_map: [Hash | SemanticLogger::Formatters::Syslog::LevelMap]
  #     Supply a custom map of SemanticLogger levels to syslog levels.
  #
  #   Example:
  #     # Change the warn level to LOG_NOTICE level instead of a the default of LOG_WARNING.
  #     SemanticLogger.add_appender(appender: :syslog, level_map: {warn: ::Syslog::LOG_NOTICE})
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:125
  def initialize(url: T.unsafe(nil), facility: T.unsafe(nil), max_size: T.unsafe(nil), level_map: T.unsafe(nil), options: T.unsafe(nil), tcp_client: T.unsafe(nil), **args, &); end

  # Returns [SemanticLogger::Formatters::Base] default formatter for this Appender
  # depending on the protocol selected
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:229
  def default_formatter; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def facility; end

  # Flush is called by the semantic_logger during shutdown.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:218
  def flush; end

  # The url without any credentials. See Subscriber#inspect.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:248
  def inspect_details; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def level_map; end

  # Write the log using the specified protocol and server.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:201
  def log(log); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def max_size; end

  # Over UDP, a log message too large for a datagram (Errno::EMSGSIZE) cannot be sent by retrying.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:223
  def message_error?(exception); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def options; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def port; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def protocol; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def remote_syslog; end

  # After forking an active process call #reopen to re-open
  # open the handles to resources
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:183
  def reopen; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def server; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:33
  def url; end

  private

  # Returns the supplied `formatter:` argument, with this appender's facility, level map, and
  # maximum packet size added when it names one of the PACKET_FORMATTERS, so that they are not
  # silently ignored. Options in a
  # `{syslog: {...}}` Hash take precedence. A formatter instance keeps its own settings.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/syslog.rb:258
  def with_packet_options(formatter); end
end

# The formatters that build remote syslog packets, and so need this appender's facility, level map,
