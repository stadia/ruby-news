# Proxy that allows any appender to run asynchronously in a separate thread.
#
# The worker thread and the in-memory queue are owned by an internal
# SemanticLogger::QueueProcessor. This proxy forwards log/flush/close/reopen on to the
# processor, and forwards the remaining appender methods (name, level, ...) directly to
# the wrapped appender so they keep executing on the caller's thread.
#
# pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:11
class SemanticLogger::Appender::Async
  extend ::Forwardable

  # Appender proxy to allow an existing appender to run asynchronously in a separate thread.
  #
  # Parameters:
  #   appender: [SemanticLogger::Subscriber]
  #     The appender to log to in a separate thread.
  #
  #   max_queue_size: [Integer]
  #     The maximum number of log messages to hold on the queue before blocking attempts to add to the queue.
  #     -1: The queue size is uncapped and will never block no matter how long the queue is.
  #     Default: 10,000
  #
  #   lag_threshold_s [Float]
  #     Log a warning when a log message has been on the queue for longer than this period in seconds.
  #     Default: 30
  #
  #   lag_check_interval: [Integer]
  #     Number of messages to process before checking for slow logging.
  #     Default: 1,000
  #     Note: Not applicable when batch: true.
  #
  #   batch: [true|false]
  #     Process log messages in batches via the appender's #batch method, instead of one at a time.
  #     The appender must implement #batch.
  #     Default: false
  #
  #   batch_size: [Integer]
  #     Maximum number of messages to batch up before sending.
  #     Default: 300
  #     Note: Only applicable when batch: true.
  #
  #   batch_seconds: [Integer]
  #     Maximum number of seconds between sending batches.
  #     Default: 5
  #     Note: Only applicable when batch: true.
  #
  #   non_blocking: [true|false]
  #     Whether to drop log messages instead of blocking the calling thread when the queue is full.
  #     When true and the queue is capped, attempts to add to a full queue return immediately and
  #     the message is dropped. The number of dropped messages is logged to the internal logger
  #     periodically (see dropped_message_report_seconds). Only applies to a capped queue.
  #     Default: false
  #
  #   dropped_message_report_seconds: [Integer]
  #     When non_blocking is enabled, log the count of dropped messages to the internal logger
  #     at most once every this number of seconds. Also limits how often messages discarded
  #     because their content could not be written are reported, after the first.
  #     Default: 30
  #
  #   async_max_retries: [Integer]
  #     Maximum number of consecutive times to restart the worker thread (with a back-off)
  #     after it raises an exception while processing messages, before giving up and stopping
  #     the thread. The counter resets after any message is processed successfully.
  #     -1: Retry indefinitely and never stop the thread (the pre-v5 behaviour).
  #     Default: 100
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:87
  def initialize(appender:, **args); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def active?(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:14
  def appender; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def application(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def batch?(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def capped?(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def close(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def console_output?(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def console_stream(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def dropped_count(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def environment(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def failed_count(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def filter(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def flush(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def host(*, **, &); end

  # Returns [String] the class and object address of this proxy, whether it batches, and the
  # wrapped appender's own #inspect, which shows only what that appender says is safe, but none of
  # the instance variables of this proxy or its queue processor. See Subscriber#inspect.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:95
  def inspect; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def lag_check_interval(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def lag_check_interval=(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def lag_threshold_s(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def lag_threshold_s=(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def level(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def level=(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def log(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def logger(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def logger=(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def max_queue_size(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def name(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def non_blocking=(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def non_blocking?(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def processed_count(*, **, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:14
  def processor; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def queue(*, **, &); end

  # Re-open appender after a fork.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:101
  def reopen; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:17
  def should_log?(*, **, &); end

  # Returns [Hash] operational statistics for this appender.
  #
  #   name:           [String]  Name of the wrapped appender.
  #   async:          [true]    This appender logs asynchronously via a separate thread.
  #   thread_active:  [Boolean] Whether the worker thread is currently running.
  #   queue_size:     [Integer] Number of log messages currently waiting to be written.
  #   capped:         [Boolean] Whether the queue has a maximum size.
  #   max_queue_size: [Integer] Maximum queue size, or nil when uncapped.
  #   processed:      [Integer] Cumulative number of log messages written since startup.
  #   dropped:        [Integer] Cumulative number of log messages dropped because the queue
  #                             was full (only possible when non_blocking is enabled).
  #   failed:         [Integer] Cumulative number of log messages discarded because their
  #                             content could not be written (see Subscriber#message_error?).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:119
  def stats; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/async.rb:26
  def thread(*, **, &); end
end

# Abstract base appender for Elasticsearch-compatible search engines.
#
# Implements the shared bulk-indexing pipeline used by both the
# {Elasticsearch} and {OpenSearch} appenders. Subclasses only need to
# supply the backing client class.
#
# This class is internal: applications add an appender via
# `SemanticLogger.add_appender(appender: :elasticsearch, ...)` or
# `appender: :opensearch`, never by referencing this class directly.
#
# pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:14
class SemanticLogger::Appender::ElasticsearchBase < ::SemanticLogger::Subscriber
  # Create an Elasticsearch-compatible appender over persistent HTTP(S).
  #
  # Parameters:
  #   index: [String]
  #     Prefix of the index to store the logs in.
  #     The final index appends the date so that indexes are used per day.
  #       I.e. The final index will look like 'semantic_logger-YYYY.MM.DD'
  #     Default: 'semantic_logger'
  #
  #   date_pattern: [String]
  #     The time format used to generate the full index name. Useful
  #       if you want monthly indexes ('%Y.%m') or weekly ('%Y.%W').
  #     Default: '%Y.%m.%d'
  #
  #   type: [String]
  #     Deprecated and ignored. Document `_type` has been unused since
  #     Elasticsearch 7 and is ignored by OpenSearch. Passing it logs a
  #     deprecation warning; it will be removed in v6.
  #
  #   level: [:trace | :debug | :info | :warn | :error | :fatal]
  #     Override the log level for this appender.
  #     Default: SemanticLogger.default_level
  #
  #   formatter: [Object|Proc|Symbol|Hash]
  #     An instance of a class that implements #call, or a Proc to be used to format
  #     the output from this appender
  #     Default: :raw_json (See: #call)
  #
  #   filter: [Regexp|Proc]
  #     RegExp: Only include log messages where the class name matches the supplied.
  #     regular expression. All other messages will be ignored.
  #     Proc: Only include log messages where the supplied Proc returns true
  #           The Proc must return true or false.
  #
  #   host: [String]
  #     Name of this host to appear in log messages.
  #     Default: SemanticLogger.host
  #
  #   application: [String]
  #     Name of this application to appear in log messages.
  #     Default: SemanticLogger.application
  #
  # Client Parameters (passed through to the backing client):
  #   url: [String]
  #     Fully qualified address to the service.
  #     Default: 'http://localhost:9200'
  #
  #   hosts: [String|Hash|Array]
  #     Single host passed as a String or Hash, or multiple hosts
  #     passed as an Array; `host` or `url` keys are also valid.
  #     Note:
  #       :url above is ignored when supplying this option.
  #
  #   resurrect_after [Float]
  #     After how many seconds a dead connection should be tried again.
  #
  #   reload_connections [true|false|Integer]
  #     Reload connections after X requests.
  #     Default: false
  #
  #   randomize_hosts [true|false]
  #     Shuffle connections on initialization and reload.
  #     Default: false
  #
  #   sniffer_timeout [Integer]
  #     Timeout for reloading connections in seconds.
  #     Default: 1
  #
  #   retry_on_failure [true|false|Integer]
  #     Retry X times when request fails before raising and exception.
  #     Default: false
  #
  #   retry_on_status [Array<Number>]
  #     Retry when specific status codes are returned.
  #
  #   reload_on_failure [true|false]
  #     Reload connections after failure.
  #     Default: false
  #
  #   request_timeout [Integer]
  #     The request timeout to be passed to transport in options.
  #
  #   adapter [Symbol]
  #     A specific adapter for Faraday (e.g. `:patron`)
  #
  #   transport_options [Hash]
  #     Options to be passed to the `Faraday::Connection` constructor.
  #
  #   transport_class [Constant]
  #     A specific transport class to use, will be initialized by
  #     the client and passed hosts and all arguments.
  #
  #   transport [Object]
  #     A specific transport instance.
  #
  #   serializer_class [Constant]
  #     A specific serializer class to use, will be initialized by
  #     the transport and passed the transport instance.
  #
  #   selector
  #     An instance of a connection selector strategy.
  #
  #   send_get_body_as [String]
  #     Specify the HTTP method to use for GET requests with a body.
  #     Default: 'GET'
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:123
  def initialize(url: T.unsafe(nil), index: T.unsafe(nil), date_pattern: T.unsafe(nil), type: T.unsafe(nil), level: T.unsafe(nil), formatter: T.unsafe(nil), filter: T.unsafe(nil), application: T.unsafe(nil), environment: T.unsafe(nil), host: T.unsafe(nil), data_stream: T.unsafe(nil), **client_args, &); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:169
  def batch(logs); end

  # The whole batch is formatted into a single bulk request before anything is sent.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:180
  def batch_all_or_nothing?; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def batch_size; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def batch_size=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def client; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def client=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def client_args; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def client_args=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def date_pattern; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def date_pattern=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def flush_interval; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def flush_interval=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def index; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def index=(_arg0); end

  # The url without its credentials, and the index. See Subscriber#inspect.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:185
  def inspect_details; end

  # Log to the index for today
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:164
  def log(log); end

  # The url is left to the client gem to parse, since it also takes a comma separated list of
  # urls, an Array of them, or hosts without a scheme.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:159
  def reopen; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def timeout_interval; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def timeout_interval=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def url; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:15
  def url=(_arg0); end

  private

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:224
  def bulk_index(log); end

  # Returns [String] the log message formatted as a bulk line, serialized by Utils.to_json
  # and handed to the client as a String. The client gem's serializer writes Infinity and NaN
  # as bare words, which is not JSON, and does not repair invalid UTF-8, a structure nested too
  # deeply, or a Struct (written through its #inspect), so such an entry was dropped or its
  # objects' instance variables were written. Serializing is part of formatting, so an error
  # doing so discards the message rather than stalling the appender (see #format_log). A
  # formatter that returns a String is taken to have serialized the line itself.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:204
  def bulk_line(log); end

  # Serializes the action lines; the documents already are (see #bulk_line).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:209
  def bulk_write(messages); end

  # The backing client class, e.g. ::Elasticsearch::Client or ::OpenSearch::Client.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:193
  def client_class; end

  # pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_base.rb:231
  def default_formatter; end
end

# pkg:gem/semantic_logger#lib/semantic_logger/appender/elasticsearch_http.rb:15
class SemanticLogger::Appender::ElasticsearchHttp < ::SemanticLogger::Appender::Http
  # Create Elasticsearch appender over persistent HTTP(S)
  #
  # Parameters:
  #   index: [String]
  #     Prefix of the index to store the logs in Elasticsearch.
  #     The final index appends the date so that indexes are used per day.
  #       I.e. The final index will look like 'semantic_logger-YYYY.MM.DD'
  #     Default: 'semantic_logger'
  #
  #   type: [String]
  #     Deprecated and ignored. Document `_type` has been unused since
  #     Elasticsearch 7. Passing it logs a deprecation warning; it will be
  #     removed in v6.
  #
