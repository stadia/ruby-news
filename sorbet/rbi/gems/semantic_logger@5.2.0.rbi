  def loki_value(value); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:92
  def message; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:112
  def metric; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:76
  def named_tags; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:100
  def payload; end

  # Loki only accepts Strings as keys and values.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:137
  def stringify_hash(hash); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:72
  def tags; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:68
  def thread; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/loki.rb:88
  def time; end
end

# Formatter for reporting to NewRelic's Logger
#
# New Relic gracefully handles (and flattens) any JSON-based logs
# We construct the JSON and pass it to New Relic for further processing.
#
# == Reference
# * Logging specification
#   * https://github.com/newrelic/newrelic-exporter-specs/tree/master/logging
#
# * Metadata APIs
#   * https://www.rubydoc.info/gems/newrelic_rpm/NewRelic/Agent#linking_metadata-instance_method
#   * https://www.rubydoc.info/gems/newrelic_rpm/NewRelic/Agent/Tracer#current_trace_id-class_method
#   * https://www.rubydoc.info/gems/newrelic_rpm/NewRelic/Agent/Tracer#current_span_id-class_method
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/new_relic_logs.rb:38
class SemanticLogger::Formatters::NewRelicLogs < ::SemanticLogger::Formatters::Raw
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/new_relic_logs.rb:39
  def initialize(**args); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/new_relic_logs.rb:46
  def call(log, logger); end

  private

  # returns "entity.name", "trace.id" etc from NewRelic::Agent.linking_metadata
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/new_relic_logs.rb:119
  def linking_metadata(log); end
end

# Only output one line for each log entry.
#
# Notes:
# * New lines and carriage returns are stripped from every text field: the name, thread name,
#   file name, tags, named tags, message, payload and exception message.
#   With `escape_control_chars: true` they, and all other control characters, are escaped
#   instead, like the other text formatters.
# * Exceptions only include the class and message, the stack trace is not shown.
# * Exception details, when enabled, are joined onto the same line.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:12
class SemanticLogger::Formatters::OneLine < ::SemanticLogger::Formatters::Default
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:50
  def exception; end

  # The exception details, with each line trimmed and joined by a space.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:58
  def exception_details; end

  # A log call can supply the backtrace that the file name comes from.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:36
  def file_name_and_line; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:41
  def message; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:31
  def name; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:23
  def named_tags; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:45
  def payload; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:17
  def tags; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:13
  def thread_name; end

  private

  # Off by default, so that existing one line output does not change.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:68
  def default_log_exception_details; end

  # Returns [String] the value without line breaks, so that the entry stays on one line.
  #
  # A String with invalid bytes, such as a request parameter decoded from "%FF", or in another
  # encoding, such as a binary request body, is converted to valid UTF-8 first, since deleting
  # from it, or joining it with UTF-8 text, would raise and lose the entry.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/one_line.rb:77
  def one_line(value); end
end

# pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:4
class SemanticLogger::Formatters::OpenTelemetry < ::SemanticLogger::Formatters::Raw
  # Returns the attributes hash submitted to the OpenTelemetry SDK.
  #
  # Unlike the JSON formatters there is no single `.to_json` boundary here:
  # the hash is handed to the OTLP exporter, which requires valid UTF-8. Cleanse
  # the whole structure so binary / non UTF-8 strings cannot break the export.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:13
  def call(log, logger); end

  # Log level
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:18
  def level; end

  # Payload is submitted directly as attributes, which must be a Hash. A log call can supply
  # any value as the payload, such as a String parsed from a request body, so any other value
  # is submitted as a single "payload" attribute.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:26
  def payload; end

  private

  # A primitive as-is, and anything else as a String: a structure (such as a Hash, Struct, or
  # Set) as JSON, depth-limited and repaired by Utils.to_json, rather than its #to_s, which is
  # its #inspect and would expose the instance variables of any object it holds.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:42
  def coerce_element(v); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:49
  def coerce_map(h); end

  # An attribute value: a primitive, or an Array of them.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:35
  def coerce_value(v); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:57
  def severity_number(severity); end
end

# primitives allowed by OTLP logs in Ruby: String, Integer, Float, TrueClass, FalseClass
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:6
SemanticLogger::Formatters::OpenTelemetry::PRIMS = T.let(T.unsafe(nil), Array)

# Formats log messages using a configurable pattern string, so a custom
# log line layout can be specified directly in the configuration without
# having to write a new formatter class.
#
# Pattern placeholders use the form `%{directive}`, where `directive` is the
# name of any of the formatting methods (inherited from Default, or defined
# below). Named tags support a parameterized form: `%{named_tags:request_id}`
# returns the value of a single named tag. Use `%%{...}` to emit a literal
# `%{...}` without interpolation.
#
# Example:
#   SemanticLogger.add_appender(
#     io:        $stdout,
#     formatter: {
#       pattern: { pattern: "%{time} %{level} %{name} -- %{message}" }
#     }
#   )
#
# Available directives:
#   time                 Formatted timestamp. Optionally accepts a strftime
#                        format, e.g. time:%Y-%m-%dT%H:%M:%S.%6N.
#   level                Full level name, e.g. "debug".
#   level_short          Single character level, e.g. "D".
#   name                 Logger / class name.
#   message              Log message.
#   payload              Payload rendered as a string.
#   exception_class      Class of the logged exception, e.g. "RuntimeError".
#   exception_message    Message of the logged exception.
#   exception_details    Detail Ruby adds to the exception's message, such as
#                        did_you_mean suggestions (see the log_exception_details option).
#   backtrace            Backtrace of the logged exception.
#   duration             Human readable duration, e.g. "1.2ms".
#   duration_ms          Duration in milliseconds (numeric).
#   thread_name          Name of the thread that logged the message.
#   pid                  Process id.
#   file_name            Ruby file name that logged the message, e.g. "app.rb".
#   line                 Line number within the Ruby file, e.g. 42.
#   tags                 Tags, comma separated.
#   named_tags           All named tags, or one tag with named_tags:key.
#   host                 Host name.
#   application          Application name.
#   environment          Environment name.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:47
class SemanticLogger::Formatters::Pattern < ::SemanticLogger::Formatters::Default
  # Parameters:
  #   pattern: [String]
  #     The pattern string used to format every log entry.
  #     Default: DEFAULT_PATTERN
  #
  # Plus all the options supported by SemanticLogger::Formatters::Base.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:89
  def initialize(pattern: T.unsafe(nil), **args); end

  # Application name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:191
  def application; end

  # Backtrace of the logged exception.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:138
  def backtrace; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:200
  def call(log, logger); end

  # Human readable duration (without the Default formatter's surrounding parentheses).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:143
  def duration; end

  # Duration in milliseconds.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:148
  def duration_ms; end

  # Environment name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:196
  def environment; end

  # Class of the logged exception, e.g. "RuntimeError".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:128
  def exception_class; end

  # Message of the logged exception.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:133
  def exception_message; end

  # Name of the Ruby file that logged the message, e.g. "app.rb". Escaped like the other
  # fields, since a log call can supply the backtrace it comes from.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:154
  def file_name; end

  # Host name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:186
  def host; end

  # Full level name, e.g. "debug" (Default formatter uses the short "D").
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:108
  def level; end

  # Single character level, e.g. "D".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:113
  def level_short; end

  # Line number within the Ruby file that logged the message.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:159
  def line; end

  # Log message (without the "-- " prefix the Default formatter adds).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:118
  def message; end

  # With a key: the value of a single named tag, e.g. %{named_tags:request_id}.
  # Without a key: all named tags rendered as "key: value, ...".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:172
  def named_tags(key = T.unsafe(nil)); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:48
  def pattern; end

  # Raw payload rendered as a string.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:123
  def payload; end

  # Tags joined by a comma (without the Default formatter's surrounding brackets).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:164
  def tags; end

  # Formatted timestamp. With a strftime format argument, e.g.
  # %{time:%Y-%m-%dT%H:%M:%S.%6N}, the time is formatted with that string.
  # Without an argument it uses the formatter's configured time_format.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:101
  def time(format = T.unsafe(nil)); end

  private

  # Parse the pattern string into an array of tokens: frozen literal strings
  # and Token structs for each %{directive} placeholder. %%{...} is an escape
  # that produces a literal %{...}.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:214
  def compile(string); end
end

# Approximates the Default formatter's output.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:51
SemanticLogger::Formatters::Pattern::DEFAULT_PATTERN = T.let(T.unsafe(nil), String)

# The directives that may appear in a pattern. The value is whether the
