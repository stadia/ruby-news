    # pkg:gem/rdf#lib/rdf/vocabulary.rb:275
    def term(*args); end

    # pkg:gem/rdf#lib/rdf/vocabulary.rb:459
    def to_enum(method = T.unsafe(nil), *args); end

    # For IRI compatibility
    #
    # pkg:gem/rdf#lib/rdf/vocabulary.rb:446
    def to_iri; end

    # Returns a string representation of this vocabulary class.
    #
    # @return [String]
    #
    # pkg:gem/rdf#lib/rdf/vocabulary.rb:481
    def to_s; end

    # Returns the base URI for this vocabulary class.
