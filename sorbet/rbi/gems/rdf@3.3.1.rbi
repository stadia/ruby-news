  # pkg:gem/rdf#lib/rdf/model/uri.rb:937
  def normalized_scheme; end

  # Normalized version of user
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/model/uri.rb:963
  def normalized_user; end

  # Normalized version of userinfo
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/model/uri.rb:1219
  def normalized_userinfo; end

  # Returns object representation of this URI, broken into components
  #
  # @return [Hash{Symbol => String}]
