  # pkg:gem/rdf#lib/rdf/writer.rb:374
  def encoding; end

  # Flushes the underlying output buffer.
  #
  # @return [self]
  #
  # pkg:gem/rdf#lib/rdf/writer.rb:409
  def flush; end

  # pkg:gem/rdf#lib/rdf/writer.rb:413
  def flush!(*args, &block); end

  # @param  [RDF::List] value
  # @param  [Hash{Symbol => Object}] options = ({})
