    # @yieldreturn [void] ignored
    # @return [Enumerator]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:63
    def each(&block); end

    # Finds an RDF writer class based on the given criteria.
    #
    # @overload for(format)
    #   Finds an RDF writer class based on a symbolic name.
    #
    #   @param  [Symbol] format
    #   @return [Class]
    #
    # @overload for(filename)
    #   Finds an RDF writer class based on a file name.
    #
    #   @param  [String] filename
    #   @return [Class]
    #
    # @overload for(options = {})
    #   Finds an RDF writer class based on various options.
    #
    #   @param  [Hash{Symbol => Object}] options
    #   @option options [String, #to_s]   :file_name      (nil)
    #   @option options [Symbol, #to_sym] :file_extension (nil)
    #   @option options [String, #to_s]   :content_type   (nil)
    #   @return [Class]
    #
    # @return [Class]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:92
    def for(*arg, &block); end

    # Retrieves the RDF serialization format class for this writer class.
    #
    # @return [Class]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:109
    def format(klass = T.unsafe(nil)); end

    # pkg:gem/rdf#lib/rdf/writer.rb:159
    def format_class(klass = T.unsafe(nil)); end

    # @private
    # @return [void]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:638
    def inherited(child); end

    # Writes output to the given `filename`.
    #
    # @param  [String, #to_s] filename
    # @param [Symbol] format (nil)
    # @param  [Hash{Symbol => Object}] options
    #   any additional options (see {RDF::Writer#initialize} and {RDF::Format.for})
    # @return [RDF::Writer]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:236
    def open(filename, format: T.unsafe(nil), **options, &block); end

    # Options suitable for automatic Writer provisioning.
    # @return [Array<RDF::CLI::Option>]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:123
    def options; end

    # Returns a symbol appropriate to use with RDF::Writer.for()
    # @return [Symbol]
    #
    # pkg:gem/rdf#lib/rdf/writer.rb:250
    def to_sym; end
  end
end

# The base class for RDF serialization errors.
#
# pkg:gem/rdf#lib/rdf/writer.rb:646
class RDF::WriterError < ::IOError; end

