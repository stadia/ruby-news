# A RemoteDocument contains the body and headers of a remote resource.
#
# Link headers are parsed using the `LinkHeader` gem
# @see https://github.com/asplake/link_header
#
# pkg:gem/rdf#lib/rdf/util/file.rb:351
class RDF::Util::File::RemoteDocument < ::StringIO
  # Set content
  # @param [String] body entity content of request.
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:392
  def initialize(body, options = T.unsafe(nil)); end

  # Base URI based on resource location or returned Location header.
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:354
  def base_uri; end

  # Encoding of resource (from Content-Type), downcased. Also applied to content if it is UTF
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:362
  def charset; end

  # Response code
  # @return [Integer]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:370
  def code; end

  # Returns a list of encodings in Content-Encoding field as an array of strings.
  #
  # The encodings are downcased for canonicalization.
  # @return [Array<String>]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:441
  def content_encoding; end

  # Content-Type of the returned resource
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:358
  def content_type; end

  # ETag from headers
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:375
  def etag; end

  # Raw headers from response
  # @return [Hash{Symbol => Object}]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:383
  def headers; end

  # Last-Modified time from headers
  # @return [DateTime]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:379
  def last_modified; end

  # Return links from the Link header.
  #
  # Links can be returned in array form, or searched.
  #
  # @example
  #
  #     d = RemoteDocument.new(...)
  #     describedby = links.find_link(['rel', 'describedby']).href
  #
  # @return [::LinkHeader]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:456
  def links; end

  # Parameters from Content-Type
  # @return {Symbol => String}]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:366
  def parameters; end

  # Originally requested URL
  # @return [String]
  #
  # pkg:gem/rdf#lib/rdf/util/file.rb:387
  def requested_url; end
end

