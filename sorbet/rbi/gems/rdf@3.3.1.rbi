  # pkg:gem/rdf#lib/rdf/model/statement.rb:490
  def reified(subject: T.unsafe(nil), id: T.unsafe(nil), graph_name: T.unsafe(nil)); end

  # @overload statement?
  #   Returns `true` if `self` is a {RDF::Statement}.
  #
  #   @return [Boolean]
