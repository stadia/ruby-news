  # @param [RDF::Enumerable] delete (RDF::Graph.new)
  # @yield  [changes]
  # @yieldparam [RDF::Changeset] changes
  #
  # pkg:gem/rdf#lib/rdf/changeset.rb:74
  def initialize(insert: T.unsafe(nil), delete: T.unsafe(nil), &block); end

  # pkg:gem/rdf#lib/rdf/changeset.rb:178
  def <<(*statements); end

  # pkg:gem/rdf#lib/rdf/changeset.rb:194
  def >>(*statements); end

  # Applies this changeset to the given mutable RDF::Enumerable.
  #
  # This operation executes as a single write transaction.
  #
  # @param  [RDF::Mutable] mutable
  # @param  [Hash{Symbol => Object}] options
  # @return [void]
