  # pkg:gem/rdf#lib/rdf/model/statement.rb:280
  def object?; end

  # @return [Hash{Symbol => Object}]
  #
  # pkg:gem/rdf#lib/rdf/model/statement.rb:61
  def options; end

  # @return [Hash{Symbol => Object}]
