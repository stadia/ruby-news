    #
    # pkg:gem/rdf#lib/rdf/vocabulary.rb:313
    def ontology(*args); end

    #  @return [Array<RDF::URI>] a list of properties in the current vocabulary
    #
    # pkg:gem/rdf#lib/rdf/vocabulary.rb:333
    def properties; end

    # @overload property
    #   Returns `property` in the current vocabulary
