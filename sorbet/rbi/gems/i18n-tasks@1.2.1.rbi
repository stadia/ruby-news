  # pkg:gem/i18n-tasks#lib/i18n/tasks/data/router/pattern_router.rb:57
  def select_leaves(forest, leaves); end

  private

  # pkg:gem/i18n-tasks#lib/i18n/tasks/data/router/pattern_router.rb:67
  def compile_routes(routes); end
end

