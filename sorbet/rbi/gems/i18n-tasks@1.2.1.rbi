# Wraps a {FileFinder} and caches the results.
#
# @note This class is thread-safe. All methods are cached.
# @since 0.9.0
#
# pkg:gem/i18n-tasks#lib/i18n/tasks/scanners/files/caching_file_finder.rb:12
class I18n::Tasks::Scanners::Files::CachingFileFinder < ::I18n::Tasks::Scanners::Files::FileFinder
  # @param (see FileFinder#initialize)
  #
  # pkg:gem/i18n-tasks#lib/i18n/tasks/scanners/files/caching_file_finder.rb:14
  def initialize(**args); end

  # @note This method is cached, it will only access the filesystem on the first invocation.
  # @return (see FileFinder#find_files)
  #
  # pkg:gem/i18n-tasks#lib/i18n/tasks/scanners/files/caching_file_finder.rb:31
  def find_files; end

  private

  # Traverse the paths and yield the matching ones.
  #
  # @note This method is cached, it will only access the filesystem on the first invocation.
  # @param (see FileFinder#traverse_files)
  # @yieldparam (see FileFinder#traverse_files)
  # @return (see FileFinder#traverse_files)
  #
  # pkg:gem/i18n-tasks#lib/i18n/tasks/scanners/files/caching_file_finder.rb:26
  def uncached_find_files; end
end

# Finds the files and provides their contents.
#
# @note This class is thread-safe. All methods are cached.
# @since 0.9.0
#
# pkg:gem/i18n-tasks#lib/i18n/tasks/scanners/files/caching_file_finder_provider.rb:11
